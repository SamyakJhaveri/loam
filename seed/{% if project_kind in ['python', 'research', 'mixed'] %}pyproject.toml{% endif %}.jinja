[project]
name = "{{ project_name }}"
version = "0.0.0"
description = ""
requires-python = ">=3.10"
dependencies = []

[project.optional-dependencies]
dev = [
  "pytest>=8.0",
  "ruff>=0.5",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
# The core set (E4, E7, E9, F) plus import order (I), pyupgrade (UP), and bugbear (B).
# Pinned so a ruff upgrade does not silently change the enforced rules.
select = ["E4", "E7", "E9", "F", "I", "UP", "B"]

[tool.pytest.ini_options]
testpaths = ["tests"]
