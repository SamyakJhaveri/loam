#!/usr/bin/env python3
"""bin/frozen-checks - hash list for the acceptance checks no worker edits.

  bin/frozen-checks sign <file>...   the owner's sign-off: record each file's sha256 in checks/FROZEN.sha256
  bin/frozen-checks verify           exit 1 naming each listed file that changed or is gone, and when the
                                     list is missing or differs from its copy on the signed ref; exit 0
                                     when neither checks/ nor a list on the signed ref exists

The signed ref is $FROZEN_REF, else origin/main, else main. The owner signs in a commit of their own
on that ref after reading the change; a list re-signed anywhere else differs from the ref's copy.
Opt-in signed sign-off: when the signed ref holds .github/allowed_signers, a list that differs from the
ref's copy (or that the ref lacks) also passes when a commit in <ref>..HEAD holds exactly that list and an
SSH signature from a key in the ref's copy of that file; the branch's own copy is never read.
The list is `sha256sum` format, so `sha256sum -c checks/FROZEN.sha256` also reads it.
"""

from __future__ import annotations

import hashlib
import os
import pathlib
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
LIST = "checks/FROZEN.sha256"
SIGNERS = ".github/allowed_signers"
SSH_SIG = b"-----BEGIN SSH SIGNATURE-----"


def digest(path: pathlib.Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_list() -> dict[str, str]:
    entries = {}
    for line in (ROOT / LIST).read_text(encoding="utf-8").splitlines():
        if line.strip():
            sha, _, name = line.partition("  ")
            entries[name] = sha
    return entries


def signed_ref() -> str | None:
    env = os.environ.get("FROZEN_REF")
    for ref in [env] if env else ["origin/main", "main"]:
        r = subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "-q", "--verify", ref + "^{commit}"],
            capture_output=True,
        )
        if r.returncode == 0:
            return ref
    return None


def sign(files: list[str]) -> int:
    entries = read_list() if (ROOT / LIST).is_file() else {}
    for f in files:
        path = pathlib.Path(f).absolute()
        path = path.parent.resolve() / path.name
        if not path.is_file() or not path.is_relative_to(ROOT):
            sys.exit(f"frozen-checks: {f} is not a file in this project")
        name = path.relative_to(ROOT).as_posix()
        if name == LIST:
            sys.exit(f"frozen-checks: {LIST} lists the checks; it is not one")
        entries[name] = digest(path)
    (ROOT / LIST).parent.mkdir(exist_ok=True)
    lines = [f"{sha}  {name}\n" for name, sha in sorted(entries.items())]
    (ROOT / LIST).write_text("".join(lines), encoding="utf-8")
    print(f"signed {len(files)} file(s) into {LIST}; commit it on the signed ref")
    return 0


def on_ref(ref: str | None) -> bool:
    if ref is None:
        return False
    r = subprocess.run(
        ["git", "-C", str(ROOT), "cat-file", "-e", f"{ref}:./{LIST}"],
        capture_output=True,
    )
    return r.returncode == 0


def git(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True)


def ssh_signed(commit: str) -> bool:
    """True when every signature header of commit is an SSH signature. verify-commit picks its verifier from
    the signature, not gpg.format: an OpenPGP one goes to gpg and the host's keyring, never allowed_signers."""
    header = git("cat-file", "commit", commit).stdout.partition(b"\n\n")[0]
    sigs = [value for key, _, value in (line.partition(b" ") for line in header.split(b"\n"))
            if key in (b"gpgsig", b"gpgsig-sha256")]
    return bool(sigs) and all(sig.startswith(SSH_SIG) for sig in sigs)


def signed_off(ref: str, listed: bytes) -> bool:
    """True when a commit in ref..HEAD holds exactly the list `listed` and an SSH signature from a key in
    the ref's allowed signers file. Matching the content, not HEAD, lets a later unsigned commit or a PR's
    merge commit through and refuses a list re-signed unsigned after a valid sign-off."""
    signers = git("show", f"{ref}:./{SIGNERS}")
    if signers.returncode != 0:
        return False
    commits = git("rev-list", f"{ref}..HEAD").stdout.decode().split()
    with tempfile.NamedTemporaryFile(prefix="allowed_signers.") as f:
        f.write(signers.stdout)
        f.flush()
        for c in commits:
            if not ssh_signed(c):
                continue
            held = git("show", f"{c}:./{LIST}")
            if held.returncode != 0 or held.stdout != listed:
                continue
            check = git("-c", "gpg.format=ssh", "-c", "gpg.ssh.program=ssh-keygen", "-c", "gpg.minTrustLevel=fully",
                        "-c", f"gpg.ssh.allowedSignersFile={f.name}", "verify-commit", c)
            if check.returncode == 0:
                return True
    return False


def verify() -> int:
    env, ref = os.environ.get("FROZEN_REF"), signed_ref()
    if env and ref is None:
        print(f"FAIL: FROZEN_REF={env} does not resolve")
        return 1
    if not (ROOT / LIST).is_file():
        if not (ROOT / "checks").exists() and not on_ref(ref):
            return 0
        print(f"FAIL: {LIST} is missing; the owner restores it or signs again")
        return 1
    failed = False
    for name, sha in read_list().items():
        path = ROOT / name
        if not path.is_file():
            print(f"FAIL: frozen check missing: {name}")
            failed = True
        elif digest(path) != sha:
            print(f"FAIL: frozen check changed since sign-off: {name}")
            failed = True
    if ref is None:
        print(f"FAIL: no signed ref to compare {LIST} with; set FROZEN_REF")
        return 1
    listed = (ROOT / LIST).read_bytes()
    signed = git("show", f"{ref}:./{LIST}")
    if (signed.returncode != 0 or signed.stdout != listed) and not signed_off(ref, listed):
        if signed.returncode != 0:
            print(f"FAIL: {ref} has no {LIST}; the owner signs in a commit on {ref}")
        else:
            print(f"FAIL: {LIST} differs from its copy on {ref}, where the owner signs")
        failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    if len(sys.argv) >= 3 and sys.argv[1] == "sign":
        sys.exit(sign(sys.argv[2:]))
    if sys.argv[1:] == ["verify"]:
        sys.exit(verify())
    sys.exit(__doc__)
