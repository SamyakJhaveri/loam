#!/usr/bin/env bash
# bin/install-pstack-skills - let agents invoke the pstack skills listed below.
# pstack ships each skill with `disable-model-invocation: true`, and skillOverrides cannot change a
# plugin skill, so this copies each skill below from the newest installed pstack to
# ~/.claude/skills/<name>/ without that line, with its links into the plugin made absolute.
# Run it on each host after every pstack update (docs/WORKERS.md, pstack); a re-run refreshes the
# copies this script made from any project, refuses any other folder of the same name, and never
# writes to the plugin cache. Exit 0 means every skill below is installed from that version.
set -euo pipefail

# When agents use these, and which pstack skills stay human-only: docs/WORKERS.md, pstack.
SKILLS="blast-radius benchmark-checklist show-me-your-work maintain-formal-verification-skill
interrogate how why tdd
principle-attack-the-premise principle-boundary-discipline principle-build-the-lever
principle-encode-lessons-in-structure principle-explain-the-number principle-fix-root-causes
principle-guard-the-context-window principle-laziness-protocol principle-make-operations-idempotent
principle-migrate-callers-then-delete-legacy-apis principle-minimize-reader-load
principle-prove-it-works principle-separate-before-serializing-shared-state
principle-sequence-verifiable-units principle-test-behavior-not-implementation"
# "pstack <version> <source folder>", naming no project, so any project's copy of this script owns
# the folder; a folder without it is not this script's.
MARKER=.pstack-install

CACHE="$HOME/.claude/plugins/cache/cursor-plugins/pstack"
# Claude Code leaves a replaced version's folder behind with an .orphaned_at file in it.
VERSION="$(
  for d in "$CACHE"/*/; do
    if [ -d "$d/skills" ] && [ ! -e "$d/.orphaned_at" ]; then basename "$d"; fi
  done | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1
)"
if [ -z "$VERSION" ]; then
  echo "install-pstack-skills: no installed pstack under $CACHE"
  exit 1
fi
ROOT="$CACHE/$VERSION"
echo "pstack $VERSION at $ROOT"

FAIL=0
mkdir -p "$HOME/.claude/skills"
for name in $SKILLS; do
  src="$ROOT/skills/$name"
  dest="$HOME/.claude/skills/$name"
  if [ ! -f "$src/SKILL.md" ]; then
    echo "$name: FAILED, pstack $VERSION has no such skill"
    FAIL=1
    continue
  fi
  old=""
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    if [ ! -f "$dest/$MARKER" ]; then
      echo "$name: REFUSED, $dest has no $MARKER, so this script did not make it"
      FAIL=1
      continue
    fi
    old="$(cut -d' ' -f2 "$dest/$MARKER")"
  fi

  stage="$(mktemp -d "${TMPDIR:-/tmp}/pstack-skill.XXXXXX")"
  cp -R "$src/." "$stage/"
  # A link that leaves the skill's folder (../other-skill/SKILL.md, ../../docs/...) would resolve
  # under ~/.claude after the copy, so point it at the plugin. "../" counts up from each file's depth.
  find "$stage" -name '*.md' | while IFS= read -r f; do
    rel="${f#"$stage"/}"
    up='\.\./'
    slashes="${rel//[!\/]/}"
    for ((i = 0; i < ${#slashes}; i++)); do up="$up"'\.\./'; done
    sed -e "s|](${up}"'\.\./'"|](${ROOT}/|g" -e "s|](${up}|](${ROOT}/skills/|g" "$f" > "$f.new"
    mv "$f.new" "$f"
  done
  # Drop the line from the frontmatter only, and say where <pstack> is for the skills the text
  # names without a link (the Claude Code adapter's rule: <pstack>/skills/<name>/SKILL.md).
  note="Copied from pstack $VERSION by \`bin/install-pstack-skills\`. Here \`<pstack>\` is \`$ROOT\`: read a pstack skill named below at \`<pstack>/skills/<name>/SKILL.md\`."
  awk -v note="$note" '
    NR == 1 && $0 == "---" { fm = 1; print; next }
    fm && $0 == "disable-model-invocation: true" { next }
    fm && $0 == "---" { fm = 0; print; print ""; print note; next }
    { print }' "$stage/SKILL.md" > "$stage/SKILL.md.new"
  mv "$stage/SKILL.md.new" "$stage/SKILL.md"
  if grep -q '^disable-model-invocation:' "$stage/SKILL.md"; then
    echo "$name: FAILED, its SKILL.md still sets disable-model-invocation after the edit"
    FAIL=1
    continue
  fi
  printf 'pstack %s %s\n' "$VERSION" "$src" > "$stage/$MARKER"
  chmod 755 "$stage"

  if [ -n "$old" ]; then rm -r "$dest"; fi
  mv "$stage" "$dest"
  if [ -n "$old" ]; then
    echo "$name: refreshed, pstack $old to $VERSION"
  else
    echo "$name: installed from pstack $VERSION"
  fi
done
exit "$FAIL"
