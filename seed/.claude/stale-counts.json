{
  "truths": {
    "seed_skills": "find seed -name SKILL.md | wc -l",
    "marketplace_skills": "find cultivation/marketplace -name SKILL.md | wc -l",
    "sam_cc_skills": "find cultivation/marketplace/sam-cc-setup/skills -name SKILL.md | wc -l",
    "claude_hook_handlers": "python3 -c \"import json;h=json.load(open('seed/.claude/settings.json'))['hooks'];print(sum(len(g['hooks']) for e in h.values() for g in e))\""
  },
  "checks": [
    {
      "pattern": "(\\d+) (?:core|seed) skills?",
      "truth": "seed_skills",
      "message": "seed skill count"
    },
    {
      "pattern": "(\\d+) marketplace skills?",
      "truth": "marketplace_skills",
      "message": "marketplace skill count"
    },
    {
      "pattern": "(\\d+) sam-cc-setup skills?",
      "truth": "sam_cc_skills",
      "message": "sam-cc-setup skill count"
    },
    {
      "pattern": "(\\d+) (?:shipped|seed) (?:Claude )?hooks?\\b",
      "truth": "claude_hook_handlers",
      "message": "shipped Claude hook count"
    }
  ],
  "search": ["."],
  "skip": [
    ".git",
    "worktrees",
    "node_modules",
    "codex-reviews",
    "soil",
    ".superpowers",
    "_archive",
    "__pycache__"
  ],
  "exempt_markers": []
}
