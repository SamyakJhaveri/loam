# {{ project_name }} .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
env*/
venv/

# IDE / editors
.idea/
.vscode/
*.swp
*~
.DS_Store

# OS
Thumbs.db
.directory

# Build / packaging
build/
dist/
*.egg

# Test / coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Logs / local data
*.log
logs/
.local/

# Claude Code session artifacts
.codex_review_done
# Worker briefs, reports, and plans; local-only
.superpowers/
.claude/worktrees/
.claude/codex-reviews/
# Playwright MCP screenshots and logs
.playwright-mcp/

# Personal permission grants (the template invites creating this from
# settings.local.json.template; it can grant Bash(*) and must never be committed)
.claude/settings.local.json

# Session handoff note (local-only; stale the moment HEAD moves past it)
/HANDOFF.md

# Empty read-only files the Claude Code sandbox creates on Linux to mask
# protected paths (anthropics/claude-code#46165). Only untracked files are
# ignored, so a tracked .gitmodules or .mcp.json is unaffected.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc
/.claude/.cc-writes
/.claude/launch.json
/.claude/loop.md
/.claude/scheduled_tasks.json
# Claude Code also reads these as real directories: ignore the placeholder
# file, re-include the directory so a project's own agent still reaches git.
/.claude/agents
!/.claude/agents/
/.claude/commands
!/.claude/commands/
/.claude/output-styles
!/.claude/output-styles/
/.claude/routines
!/.claude/routines/
/.claude/workflows
!/.claude/workflows/

{% if memory %}# Loam memory (a symlink to the per-user store)
.loam/memory

{% endif %}# Secrets
.env
.env.*
*.pem
*.key
secrets/
