{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-route.py\"", "timeout": 5}]
      },
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/no-foreground-sleep.py\"", "timeout": 5},
                  {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/remote-command-shape.py\"", "timeout": 5}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-context.py\"", "timeout": 5}]
      }
    ]
  }
}
