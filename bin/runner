#!/usr/bin/env bash
# bin/runner <cmd>   runs <cmd> on the runner from the repo root there.
# bin/runner sync    mirrors the two gitignored input trees to the runner (#36).
set -euo pipefail
HOST="${LOOP_HOST:-jhaveris}"
if [ "${1:-}" = sync ]; then
  cd "$(dirname "$0")/.."
  for tree in .superpowers/lean-v3 .superpowers/factory; do
    rsync -az --delete --exclude __pycache__ --exclude runs "$tree/" "$HOST:Desktop/loam/$tree/"
  done
  exit 0
fi
[ $# -eq 1 ] || { echo "usage: bin/runner <cmd> | bin/runner sync" >&2; exit 2; }
ssh "$HOST" bash -lc "'cd ~/Desktop/loam && $1'"
