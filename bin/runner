#!/usr/bin/env bash
# bin/runner [-C <dir>] <cmd>   runs <cmd> on the runner from <dir> there, ~/Desktop/loam by default.
#   Quote a tilde (-C '~/Desktop/parbench_ipdps') so the runner's shell expands it, not this one (F8).
# bin/runner sync    mirrors the gitignored factory tree to the runner (#36).
set -euo pipefail
HOST="${LOOP_HOST:-jhaveris}"
if [ "${1:-}" = sync ]; then
  cd "$(dirname "$0")/.."
  for tree in .superpowers/factory; do
    rsync -az --delete --exclude __pycache__ --exclude runs "$tree/" "$HOST:Desktop/loam/$tree/"
  done
  exit 0
fi
DIR='~/Desktop/loam'
if [ "${1:-}" = -C ] && [ $# -ge 2 ]; then DIR="$2"; shift 2; fi
[ $# -eq 1 ] || { echo "usage: bin/runner [-C <dir>] <cmd> | bin/runner sync" >&2; exit 2; }
ssh "$HOST" bash -lc "'cd $DIR && $1'"
