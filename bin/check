#!/usr/bin/env bash
# bin/check - the one check for Loam.
# The agent runs it by choice; CI runs it on every push and PR. Nothing else
# runs ruff or the tests. Exit 0 means green. Design law 4 and 6.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
FAIL=0
step() { printf '\n== %s ==\n' "$1"; }
bad()  { echo "FAIL: $*"; FAIL=1; }

step "ruff (tracked .py)"
# No `mapfile`: it is bash 4+, and macOS ships bash 3.2 as /bin/bash. Under 3.2
# `mapfile` errors, PY stays unset, the ruff step silently skips, and check still
# prints PASSED - a false green on the owner's own platform. Read into an indexed
# array (supported in 3.2) instead.
PY=()
while IFS= read -r f; do PY+=("$f"); done < <(git ls-files '*.py')
if [ "${#PY[@]}" -gt 0 ]; then
  ruff check "${PY[@]}"        || bad "ruff check"
  # `ruff format --check` is NOT run yet. On the tree this check was added to, 19
  # of 25 tracked .py files are unformatted, and every one of them lives in a
  # directory another in-flight ticket owns (bin/, seed/, cultivation/). Adding
  # the gate here would mean reformatting files this ticket may not touch. Most
  # offenders are deleted by the hot-path cut; add the line back after it, when
  # the survivors can be formatted in one commit that owns them.
fi

step "shell syntax + whitespace"
while IFS= read -r sh; do
  [ -n "$sh" ] || continue
  bash -n "$sh" || bad "bash -n $sh"
done < <(git ls-files '*.sh')
git diff --check HEAD -- || bad "git diff --check (trailing whitespace or conflict markers)"

step "pytest"
# -n auto needs pytest-xdist (pinned in .github/ci/python-requirements.txt).
pytest -n auto bin/tests || bad "pytest"

step "SKILL.md frontmatter name gate"
# Folded from the old verify-template-stages.sh stage 6. Every SKILL.md must
# carry a name: in its first frontmatter block and must NOT use the fake
# auto-activate key (use disable-model-invocation: true).
while IFS= read -r skill; do
  [ -n "$skill" ] || continue
  awk '/^---$/{n++} n==1 && /^name:/{ok=1} END{exit !ok}' "$skill" \
    || bad "$skill has no name: in frontmatter"
  awk '/^---$/{n++; next} n==1 && /^auto-activate:/{bad=1} END{exit !bad}' "$skill" \
    && bad "$skill uses the non-existent auto-activate field"
done < <(find seed cultivation/marketplace -name SKILL.md -not -path '*/node_modules/*')

step "skill-listing token weight"
python3 bin/skill_listing_weight.py --root "$ROOT" --budget-tokens "${LISTING_BUDGET:-2750}" \
  || bad "skill-listing weight over budget"

step "claude plugin validate"
if command -v claude >/dev/null 2>&1; then
  # seed/.claude holds internal symlinks (skills -> ../../.agents/skills). The
  # validator skips them with a WARNING ("entries here are symlinks and were not
  # read"), and --strict turns any warning into a failure. So validate seed/.claude
  # NON-strict and validate the real symlink targets (seed/.agents/skills) strict.
  # Verified live 2026-09-06: `claude plugin validate --strict seed/.claude` exits 1;
  # non-strict exits 0 ("passed with warnings"); the other two pass under --strict.
  claude plugin validate seed/.claude || bad "claude plugin validate seed/.claude"
  for t in seed/.agents/skills cultivation/marketplace; do
    claude plugin validate --strict "$t" || bad "claude plugin validate --strict $t"
  done
elif [ "${LOAM_ALLOW_MISSING_AGENT_CLIS:-0}" = "1" ]; then
  echo "SKIPPED: claude CLI not found (LOAM_ALLOW_MISSING_AGENT_CLIS=1)"
else
  bad "claude CLI not found; install it or set LOAM_ALLOW_MISSING_AGENT_CLIS=1"
fi

if [ "$FAIL" -ne 0 ]; then echo; echo "check: FAILED"; exit 1; fi
echo; echo "check: PASSED"
