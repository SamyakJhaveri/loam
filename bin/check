#!/usr/bin/env bash
# bin/check - the one check for Loam. CI runs it on every push and PR. Exit 0 means green.
# Needs jq: the factory verdict-gate step (#64) sources bin/factory, whose verdict_consistent runs jq.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
FAIL=0
SKIPS=""
step() { printf '\n== %s ==\n' "$1"; }
bad()  { echo "FAIL: $*"; FAIL=1; }
# A step that did not run is named on the final line, so a reduced run never reads as a full pass.
skip() { echo "SKIPPED: $1${2:+ ($2)}"; SKIPS="${SKIPS:+$SKIPS, }$1"; }  # $1 = what, $2 = why

# Tracked scripts by extension or shebang: bin/check, bin/factory and other extensionless scripts
# carry only the shebang. Templates (*.jinja) are skipped; the render smoke checks them rendered.
scripts() {  # $1 = extension, $2 = interpreter regex
  local re="^#!.*[/ ]($2)([[:space:]]|\$)"
  { git ls-files -- "*.$1"
    git grep -I -l -E "$re" -- . ':(exclude)*.jinja' | while IFS= read -r f; do
      head -n 1 "$f" | grep -qE "$re" && echo "$f"
    done
  } | sort -u
}

step "ruff (tracked Python)"
# No `mapfile` (bash 4+): macOS ships bash 3.2, where it fails and the step would silently skip.
PY=()
while IFS= read -r f; do PY+=("$f"); done < <(scripts py 'python[0-9.]*')
[ "${#PY[@]}" -eq 0 ] || ruff check "${PY[@]}" || bad "ruff check"

step "shell syntax + whitespace"
while IFS= read -r sh; do
  [ -n "$sh" ] || continue
  bash -n "$sh" || bad "bash -n $sh"
done < <(scripts sh 'bash|sh')
# Two diffs: empty tree vs HEAD covers every committed line (the clean checkout CI has), and
# HEAD vs index and working tree covers the change about to be committed.
WS_EXCLUDE=(":(exclude)*.patch" ":(exclude)*.diff")
git diff --check "$(git hash-object -t tree /dev/null)" HEAD -- . "${WS_EXCLUDE[@]}" || bad "git diff --check (trailing whitespace or conflict markers)"
git diff --check HEAD -- . "${WS_EXCLUDE[@]}" || bad "git diff --check HEAD (whitespace or conflict markers in staged or unstaged edits)"

step "commit identities (ip-sweep identity only)"
# Needs no private term file, so it gates every PR; release.sh still runs the full strict sweep.
IP_SWEEP_IDENTITY_ONLY=1 bash bin/ip-sweep.sh || bad "ip-sweep identity check"

step "pytest"
# Always `python3 -m pytest`: hook tests mint a receipt with sys.executable and re-validate it with `python3`.
# Without pytest-xdist the suite takes ~117 s serial, so build a venv from the CI pins (.venv/ is gitignored).
PYTEST_PY=python3
if ! python3 -c 'import xdist' 2>/dev/null; then
  VENV="$ROOT/.venv/check"
  "$VENV/bin/python3" -c 'import xdist' 2>/dev/null || {
    echo "NOTE: no pytest-xdist for this python3; building $VENV from .github/ci/python-requirements.txt"
    rm -rf "$VENV"
    python3 -m venv "$VENV" >/dev/null 2>&1 && "$VENV/bin/python3" -m pip install -q -r .github/ci/python-requirements.txt >/dev/null 2>&1 || rm -rf "$VENV"
  }
  if "$VENV/bin/python3" -c 'import xdist' 2>/dev/null; then
    PATH="$VENV/bin:$PATH"; export PATH; PYTEST_PY="$VENV/bin/python3"
  else
    echo "NOTE: could not provide pytest-xdist; running serial"
  fi
fi
# -rs prints each skip reason; the skip count goes on the final line.
PYTEST_ARGS=(-rs bin/tests)
"$PYTEST_PY" -c 'import xdist' 2>/dev/null && PYTEST_ARGS=(-n auto "${PYTEST_ARGS[@]}")
PYTEST_LOG="$(mktemp)"
"$PYTEST_PY" -m pytest "${PYTEST_ARGS[@]}" | tee "$PYTEST_LOG" || bad "pytest"
n="$(tail -n 1 "$PYTEST_LOG" | grep -oE '[0-9]+ skipped' | cut -d' ' -f1)"
[ -z "$n" ] || skip "$n pytest test(s)" "reasons in the short test summary above"
rm -f "$PYTEST_LOG"

step "skill and agent frontmatter + references"
# SKILL.md needs name: and description: in its first frontmatter block; auto-activate is not a real field.
# Every SKILL.md and agent .md must name only paths, skills and agents that exist.
python3 - <<'PY' || bad "skill or agent frontmatter or reference (see the lines above)"
import pathlib, re, subprocess

# Paths a skill or agent writes, or reads only if present, in the project it runs in.
OPTIONAL = {".claude/rules/", ".claude/codex-reviews/", "docs/hypothesis_tree.md"}
SPAN = re.compile(r"(?<!`)`([^`\n]+)`(?!`)")
PATH = re.compile(r"[A-Za-z0-9_.][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)+/?")
NAMED = re.compile(r"(?<!`)`([a-z0-9][a-z0-9:-]*)` (?:skill|subagent|agent)s?\b")


tracked = subprocess.run(["git", "ls-files", "--", "seed", "cultivation/marketplace"],
                         capture_output=True, text=True, check=True).stdout.splitlines()
skills = [pathlib.Path(f) for f in tracked if f.endswith("/SKILL.md")]
agents = [pathlib.Path(f) for f in tracked if f.endswith(".md") and pathlib.Path(f).parent.name == "agents"]
known = {p.parent.name for p in skills} | {p.stem for p in agents}
# `plugin:name` resolves only inside that marketplace plugin.
owned = {}
for p in skills + agents:
    if p.parts[:2] == ("cultivation", "marketplace"):
        owned.setdefault(p.parts[2], set()).add(p.parent.name if p.name == "SKILL.md" else p.stem)
errors = []
for doc in skills + agents:
    text = doc.read_text(encoding="utf-8")
    if doc.name == "SKILL.md":
        fm = re.match(r"---\n(.*?)\n---", text, re.S)
        keys = set(re.findall(r"^([A-Za-z0-9_-]+):", fm.group(1), re.M)) if fm else set()
        errors += [f"{doc}: frontmatter lacks {k}:" for k in ("name", "description") if k not in keys]
        if "auto-activate" in keys:
            errors.append(f"{doc}: auto-activate is not a skill field")
    bases = [pathlib.Path("."), pathlib.Path("seed"), *doc.parents]
    fenced = False
    for n, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith("```"):
            fenced = not fenced
        if fenced:
            continue
        for span in SPAN.findall(line):
            if not PATH.fullmatch(span) or span in OPTIONAL:
                continue
            # A file path names a file type, a directory, or a directory that exists; `origin/main` does none.
            first, last = span.split("/")[0], span.rstrip("/").rsplit("/", 1)[-1]
            if not (span.endswith("/") or "." in last.lstrip(".") or any((b / first).is_dir() for b in bases)):
                continue
            # A rendered path also exists when the seed holds it as a template (`docs/WORKERS.md.jinja`).
            if not any((b / span).exists() or (b / (span + ".jinja")).exists() for b in bases):
                errors.append(f"{doc}:{n}: path `{span}` does not exist")
        for name in NAMED.findall(line):
            plugin, _, short = name.rpartition(":")
            if plugin and not pathlib.Path("cultivation/marketplace", plugin).is_dir():
                continue  # another plugin's skill or agent; this repo cannot resolve it
            if short not in (owned.get(plugin, set()) if plugin else known):
                errors.append(f"{doc}:{n}: no skill or agent named `{name}`")
for e in errors:
    print("FAIL:", e)
raise SystemExit(1 if errors else 0)
PY

step "skill-listing token weight"
# No-growth ceilings on the uncalibrated chars/4 estimate, each set to the measured weight:
# seed after the catchup trim and hypothesis-tree went manual-only, sam-cc-setup after
# plan-review and surprise-me went manual-only and the plan-reviewer description was trimmed.
# Lower one when its listing shrinks; never raise it without saying why.
python3 bin/skill_listing_weight.py --root "$ROOT" --budget seed=85 --budget "sam-cc-setup=${LISTING_BUDGET:-365}" \
  || bad "skill-listing weight over budget"

step "always-loaded prose cap"
# Root CLAUDE.md, AGENTS.md and what they load reach every Loam session. No-growth cap in bytes,
# equal to the measured size: the step fails over it and under it, so a PR that shrinks the
# prose lowers it. Raise it only in the PR that grows the prose, with the reason in that PR.
python3 bin/always_loaded_prose.py --root "$ROOT" --cap 2447 || bad "always-loaded prose not at its cap"

step "no em dash in Loam-owned text"
# The owner's standing rule (#237), raw or JSON-escaped. Exempt only text Loam does not own or must not rewrite.
EM_EXEMPT=(
  ":(exclude)cultivation/parked/"                                       # parked assets kept as they were removed; not live text
  ":(exclude)docs/archive/"                                             # frozen historical records
  ":(exclude)docs/research/primary-2026-09-08/"                         # quoted upstream pages
  ":(exclude)evals/"                                                    # recorded grader prompts; a replay must see them unchanged
)
# --untracked: a new file not yet added fails here, as it will in CI. git grep exits 1 when nothing
# matched, and also after an error it does not treat as fatal, so any stderr fails the step too.
# The [4] keeps this line from matching its own escape pattern.
EM_ERR="$(mktemp)"
git grep --untracked -n -I -e $'\xe2\x80\x94' -e '\\u201[4]' -- . "${EM_EXEMPT[@]}" 2>"$EM_ERR"
case "$?:$(wc -c <"$EM_ERR" | tr -d ' ')" in
  1:0) ;;
  0:0) bad "em dash in the lines above (raw or JSON-escaped); use a plain dash '-' instead" ;;
  *)   cat "$EM_ERR"; bad "the em-dash search did not read every file; fix the git grep errors above" ;;
esac
rm -f "$EM_ERR"

step "claude plugin validate"
if command -v claude >/dev/null 2>&1; then
  # seed/.claude holds internal symlinks the validator skips with a warning, and --strict fails on warnings,
  # so seed/.claude runs non-strict and the real targets run strict (verified 2026-09-06).
  claude plugin validate seed/.claude || bad "claude plugin validate seed/.claude"
  for t in seed/.agents/skills cultivation/marketplace; do
    claude plugin validate --strict "$t" || bad "claude plugin validate --strict $t"
  done
elif [ "${LOAM_ALLOW_MISSING_AGENT_CLIS:-0}" = "1" ]; then
  skip "claude plugin validate" "claude CLI not found, LOAM_ALLOW_MISSING_AGENT_CLIS=1"
else
  bad "claude CLI not found; install it or set LOAM_ALLOW_MISSING_AGENT_CLIS=1"
fi

step "plugin versions"
# The bump rule diffs against the merge base with origin/main; test.yml's fetch-depth 0 gives CI that ref.
python3 -I bin/plugin_versions.py --root "$ROOT"
case $? in
  0) ;;
  3) skip "plugin version-bump rule" "no merge base with origin/main or main" ;;
  *) bad "plugin versions (see the lines above)" ;;
esac

step "factory ticket lint"
for t in bin/factory.d/fixtures/S[1-5].md; do
  bin/factory lint "$t" || bad "bin/factory lint $t"
done
# Lint must reject the S5.before.md fixture on its forbidden word 'skip' (CONTRACT.md Lint rules, #37).
reject_out=$(bin/factory lint bin/factory.d/fixtures/S5.before.md 2>&1); reject_rc=$?
{ [ "$reject_rc" -eq 1 ] && grep -q "'skip'" <<<"$reject_out"; } \
  || bad "bin/factory lint did not reject S5.before.md on 'skip' (exit $reject_rc)"

step "factory verdict gate"
# verdict_consistent must refute a pass that ships a fix, and accept the same object as a fail (#64).
# Both fixtures carry every row the judge schema requires, so only the fix decides.
# Capture first (these checks run under pipefail), then compare. The refute half also requires empty
# output: a broken guard exits non-zero with usage text, and that must not count as a refutation.
out=$(FACTORY_SOURCED=1 bash -c '. bin/factory; verdict_consistent bin/factory.d/fixtures/grader-inconsistent.json bin/factory.d/judge.schema.json' 2>&1); r=$?
{ [ "$r" -ne 0 ] && [ -z "$out" ]; } || bad "verdict_consistent did not refute the inconsistent grader fixture (exit $r): $out"
out=$(FACTORY_SOURCED=1 bash -c '. bin/factory; verdict_consistent bin/factory.d/fixtures/grader-consistent.json bin/factory.d/judge.schema.json' 2>&1); r=$?
[ "$r" -eq 0 ] || bad "verdict_consistent refuted the consistent grader fixture (exit $r): $out"

step "factory grader model and effort"
bin/factory graders-check || bad "bin/factory graders-check"

if [ "$FAIL" -ne 0 ]; then echo; echo "check: FAILED"; exit 1; fi
echo; echo "check: PASSED${SKIPS:+ (skipped: $SKIPS)}"
