#!/usr/bin/env bash
# bin/transfer-coverage - is every Loam capability in a project, and does a project ticket carry each one?
#   bin/transfer-coverage [--manifest <tsv>] --target <dir>
#     Runs each row's presence test with TARGET set to <dir>. A carry, carry-if or delete row whose test
#     fails prints `MISSING <id> <capability>`; one whose ticket is not F<n> prints `UNCOVERED <id> <capability>`.
#     nothing and decline rows are reported, never missing. Exit 1 when either count is above 0.
#   bin/transfer-coverage [--manifest <tsv>] --commits <pin> <head>
#     Prints `UNMAPPED <sha> <subject>` for each Loam commit in <pin>..<head> that touches seed/ or
#     copier.yml and that no row's loam_source names. Exit 1 when any is unmapped.
# The manifest (default bin/transfer-manifest.tsv) is tab-separated, one row per capability:
#   id  kind  disposition  capability  loam_source  ticket  present   (`-` for none; no field is empty)
# A malformed row, a manifest with no rows, or a usage error exits 2.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST="$ROOT/bin/transfer-manifest.tsv"
TARGET="" PIN="" HEAD=""
usage() { echo "usage: bin/transfer-coverage [--manifest <tsv>] --target <dir> | --commits <pin> <head>" >&2; exit 2; }
while [ $# -gt 0 ]; do
  case "$1" in
    --manifest) [ $# -ge 2 ] || usage; MANIFEST="$2"; shift 2 ;;
    --target) [ $# -ge 2 ] || usage; TARGET="$2"; shift 2 ;;
    --commits) [ $# -ge 3 ] || usage; PIN="$2"; HEAD="$3"; shift 3 ;;
    *) usage ;;
  esac
done
{ [ -n "$TARGET" ] || [ -n "$PIN" ]; } && { [ -z "$TARGET" ] || [ -z "$PIN" ]; } || usage
[ -f "$MANIFEST" ] || { echo "transfer-coverage: no manifest at $MANIFEST" >&2; exit 2; }

# Print each row as its seven tab-separated fields, after checking it; fail closed on a bad row.
rows() {
  local n=0 kept=0 line id kind disp cap src ticket present
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case "$line" in ''|'#'*) continue ;; esac
    IFS=$'\t' read -r id kind disp cap src ticket present <<<"$line"
    [ "$(printf '%s' "$line" | tr -cd '\t' | wc -c | tr -d ' ')" = 6 ] && [ -n "$present" ] || {
      echo "transfer-coverage: $MANIFEST:$n: want 7 tab-separated, non-empty fields" >&2; return 2; }
    case "$kind" in seed|plugin|user-config|runner) ;; *)
      echo "transfer-coverage: $MANIFEST:$n: unknown kind '$kind'" >&2; return 2 ;; esac
    case "$disp" in carry|carry-if|delete|nothing|decline) ;; *)
      echo "transfer-coverage: $MANIFEST:$n: unknown disposition '$disp'" >&2; return 2 ;; esac
    printf '%s\n' "$line"
    kept=$((kept + 1))
  done < "$MANIFEST"
  # An empty or comment-only manifest checks nothing, so it must not report the transfer complete.
  [ "$kept" -gt 0 ] || { echo "transfer-coverage: no rows in $MANIFEST" >&2; return 2; }
}
ROWS=$(rows) || exit 2

if [ -n "$PIN" ]; then
  cd "$ROOT" || exit 2
  # Every hex token of 7 or more characters in a loam_source cell names a commit.
  SHAS=$(while IFS=$'\t' read -r _ _ _ _ src _; do printf '%s\n' "$src"; done <<<"$ROWS" | tr ' ' '\n' | grep -E '^[0-9a-f]{7,40}$')
  LOG=$(git log --no-merges --format='%H %s' "$PIN..$HEAD" -- seed copier.yml) || exit 2
  unmapped=0
  while read -r sha subject; do
    [ -n "$sha" ] || continue
    hit=0
    for s in $SHAS; do case "$sha" in "$s"*) hit=1; break ;; esac; done
    [ "$hit" = 1 ] || { echo "UNMAPPED ${sha:0:8} $subject"; unmapped=$((unmapped + 1)); }
  done <<<"$LOG"
  echo "unmapped: $unmapped"
  [ "$unmapped" -eq 0 ]
  exit
fi

[ -d "$TARGET" ] || { echo "transfer-coverage: no target directory $TARGET" >&2; exit 2; }
TARGET="$(cd "$TARGET" && pwd)"
missing=0 uncovered=0
while IFS=$'\t' read -r id kind disp cap src ticket present; do
  [ -n "$id" ] || continue
  # stdin from /dev/null, so a test that reads stdin cannot eat the rows after it.
  if (cd "$TARGET" && TARGET="$TARGET" bash -c "$present") </dev/null >/dev/null 2>&1; then got=present; else got=absent; fi
  case "$disp" in
    nothing|decline) echo "$disp $id $cap ($got)"; continue ;;
  esac
  if [ "$got" = present ]; then echo "ok $id $cap"; else echo "MISSING $id $cap"; missing=$((missing + 1)); fi
  [[ "$ticket" =~ ^F[0-9]+$ ]] || { echo "UNCOVERED $id $cap"; uncovered=$((uncovered + 1)); }
done <<<"$ROWS"
echo "missing: $missing"
echo "uncovered: $uncovered"
[ "$missing" -eq 0 ] && [ "$uncovered" -eq 0 ]
