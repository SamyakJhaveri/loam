#!/usr/bin/env bash
# bin/claude-account - hold one long-lived Claude Code token per account and switch between them.
#   bin/claude-account set <name>   read a `claude setup-token` value from stdin into <dir>/<name>.token (0600)
#   bin/claude-account use <name>   name that account active in <dir>/active, and drop a token key from the env block of
#                                   the settings file (a settings env value beats the launch env, so none may stay there)
#   bin/claude-account exec [--as <name>] <command> [args...]
#                                   run the command with the active account's token in its environment (with --as, the
#                                   token of <name>, which a caller read from `active` once and also records; an empty
#                                   <name> reads `active`); with no active account, or none stored, the environment is
#                                   left as it is, but a non-empty --as <name> with no stored token exits 1 and runs nothing
#   bin/claude-account other        print the next stored account after the active one (name order, wrapping), non-zero when there is none
#   bin/claude-account status       print `active: <name>; stored: <names>` and nothing else
#   bin/claude-account switch <from> [<to>]
#                                   the host-wide switch every caller on the host shares (bin/factory's limit_switch
#                                   keeps its own copy for now): under a flock on <runs root>/limit-switch.lock (waits
#                                   60 s), switch nothing and exit 0 when the active account is no longer <from> (another
#                                   caller switched), exit 3 when <runs root>/limit-switch holds an epoch under 300 s ago,
#                                   else `use` <to> (default: what `other` prints) and write the epoch there; exit 1 on no
#                                   lock, no other account or a failed `use`. Runs root: FACTORY_RUNS_ROOT, as bin/factory.
# Tokens live only in their 0600 files, never in the settings file, so a switch never needs the browser and no copy of
# the settings file holds one; each is valid one year. A call reaches the active token only through `exec`.
# No command prints, echoes, or logs a token value; `set -x` is never used here.
# The account directory, settings file and runs root are overridable so the factory loop can drive this against a temp home.
set -euo pipefail

dir=${CLAUDE_ACCOUNTS_DIR:-$HOME/.config/claude-accounts}
f=${CLAUDE_SETTINGS_FILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json}
cmd=${1:-status}
name=${2:-}

# The active account name, from the file `use` writes; empty when nothing is active yet.
active_name() { [ -f "$dir/active" ] && cat "$dir/active" || true; }

# Name account $1 active. A token key left in the settings file (written by `use` before #644) is dropped first, since a
# settings env value beats the launch env `exec` sets; the file is never created. Each step returns 1 on failure, so
# `active` is never written ahead of the settings file, also when a caller tests the result; a settings file jq cannot
# read or parse is a failure too, not a token-free file. The token is not read here. `active` is replaced by a rename,
# never truncated in place, so a concurrent `exec` reads the old name or the new one, never an empty file; the new file
# is 0600 whatever the caller's umask.
use_name() {
  local tmp rc=0
  [ -f "$dir/$1.token" ] || { echo "no stored token for '$1'; run: bin/claude-account set $1" >&2; return 1; }
  if [ -f "$f" ]; then
    jq -e '.env | type == "object" and has("CLAUDE_CODE_OAUTH_TOKEN")' "$f" > /dev/null 2>&1 || rc=$?
    case $rc in
      0) tmp=$(mktemp "$f.XXXXXX") || return 1
         jq 'del(.env.CLAUDE_CODE_OAUTH_TOKEN)' "$f" > "$tmp" || { rm -f "$tmp"; return 1; }
         mv "$tmp" "$f" && chmod 600 "$f" || return 1 ;;
      1) ;;
      *) echo "could not read $f with jq (exit $rc); active not changed" >&2; return 1 ;;
    esac
  fi
  (umask 077; printf '%s\n' "$1" > "$dir/active.$$") && mv -f "$dir/active.$$" "$dir/active" || { rm -f "$dir/active.$$"; return 1; }
  echo "active: $1" >&2
}
# Round robin in name order: the first stored account after the active one, wrapping to the first, so
# repeated switches visit every stored account instead of bouncing between the first two.
other_name() {
  local a p n first="" next=""
  a=$(active_name)
  for p in "$dir"/*.token; do
    [ -f "$p" ] || continue
    n=$(basename "$p" .token)
    [ "$n" = "$a" ] && continue
    [ -n "$first" ] || first=$n
    if [[ -z "$next" && "$n" > "$a" ]]; then next=$n; fi
  done
  [ -n "${next:-$first}" ] && { printf '%s\n' "${next:-$first}"; return 0; }
  echo "no stored account other than '${a:-none}'" >&2
  return 1
}

case "$cmd" in
  set)
    [ -n "$name" ] || { echo "usage: bin/claude-account set <name>" >&2; exit 2; }
    [ -t 0 ] && printf 'Paste the setup token for %s, then Enter: ' "$name" >&2
    IFS= read -rs t || true   # a paste without a trailing newline still lands in $t under set -e
    [ -t 0 ] && echo >&2
    case "$t" in
      sk-ant-oat01-*) ;;
      *) echo "not a valid setup token (expected the sk-ant-oat01- prefix)" >&2; exit 1 ;;
    esac
    umask 077
    mkdir -p "$dir"; chmod 700 "$dir"
    printf '%s\n' "$t" > "$dir/$name.token"; chmod 600 "$dir/$name.token"
    echo "stored $dir/$name.token" >&2
    ;;
  use)
    [ -n "$name" ] || { echo "usage: bin/claude-account use <name>" >&2; exit 2; }
    use_name "$name" || exit 1
    ;;
  other)
    other_name || exit 1
    ;;
  exec)
    shift; a=
    if [ "${1-}" = --as ]; then
      [ $# -ge 2 ] || { echo "usage: bin/claude-account exec [--as <name>] <command> [args...]" >&2; exit 2; }
      a=$2; shift 2
    fi
    [ $# -gt 0 ] || { echo "usage: bin/claude-account exec [--as <name>] <command> [args...]" >&2; exit 2; }
    # A caller that names an account wants that token, never the launch environment's or the host's /login: its read
    # is not gated on the file test, so a token file removed after a caller's check still exits 1 below.
    named=$a
    [ -n "$a" ] || a=$(active_name)
    if [ -n "$named" ] || { [ -n "$a" ] && [ -f "$dir/$a.token" ]; }; then
      # Into this process's environment only, never onto a command line (/proc shows argv). A token file with no
      # trailing newline still reads under set -e; a missing or unreadable one, or one whose first line is empty, exits
      # 1 rather than pass the launch value.
      unset CLAUDE_CODE_OAUTH_TOKEN
      IFS= read -r CLAUDE_CODE_OAUTH_TOKEN 2> /dev/null < "$dir/$a.token" || true
      [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || { echo "could not read the token of '$a' from $dir/$a.token" >&2; exit 1; }
      export CLAUDE_CODE_OAUTH_TOKEN
    fi
    exec "$@"
    ;;
  switch)
    [ -n "$name" ] || { echo "usage: bin/claude-account switch <from> [<to>]" >&2; exit 2; }
    runs=${FACTORY_RUNS_ROOT:-$HOME/.local/state/loam-factory/runs}
    mkdir -p "$runs" && exec {fd}>> "$runs/limit-switch.lock" || exit 1
    flock -w 60 "$fd" || { echo "no lock on $runs/limit-switch.lock within 60 s" >&2; exit 1; }
    a=$(active_name)
    [ "$a" = "$name" ] || { echo "active: ${a:-none}; already switched from $name" >&2; exit 0; }
    last=$(cat "$runs/limit-switch" 2> /dev/null) || last=""
    if [[ "$last" =~ ^[0-9]+$ ]] && [ "$(( $(date +%s) - last ))" -lt 300 ]; then
      echo "active: $a; another switch on this host was under 300 s ago" >&2; exit 3
    fi
    to=${3:-}
    [ -n "$to" ] || to=$(other_name) || exit 1
    use_name "$to" || exit 1
    date +%s > "$runs/limit-switch"
    ;;
  status)
    a=$(active_name)
    stored=""
    for p in "$dir"/*.token; do
      [ -f "$p" ] || continue
      stored="$stored $(basename "$p" .token)"
    done
    echo "active: ${a:-none}; stored:${stored}"
    ;;
  *)
    echo "usage: bin/claude-account set|use <name> | other | status | switch <from> [<to>] | exec <command> [args...]" >&2
    exit 2
    ;;
esac
