#!/bin/bash
# bin/limit-alarm: keep the distbench lead on a Claude account that has usage left, and never leave the paid
# rental running while no account can work. Installed by bin/limit-alarm-install as ~/.distbench/limit-alarm.sh
# and run in tmux limit-alarm on jhaveris; accounts come from bin/claude-account.
# - Trigger: the lead's last assistant line in its transcript is an API error starting "You've hit your" or
#   "You've reached your" (Claude Code's limit lines; Fable and fast-mode limits excluded), so a relayed message
#   or the pane layout cannot trigger or hide it. The "resets 6am" time in it marks when that account is usable.
# - On a limit: switch (claude-account use) to the first usable account in ORDER (Samyak, 23 Oct: gmail, then uci,
#   npds only when both are out); restart the lead on the same conversation with --resume, paste a resume message, post to Slack.
#   When no other account is usable but the active one's own reset has passed, paste a resume message into the
#   running lead instead (no restart, so its background agents survive).
# - No usable account: if the soonest reset is more than HOLD_S away and the pair has been idle IDLE_S or more
#   (idle_s in the runner's PAIR status file), touch the live rental's stop file so the driver tears the pair down
#   (Samyak, 23 Oct: do not pay for an idle pair). A busy pair, or a PAIR file that is missing, unreadable or has no
#   idle_s, keeps the pair and is checked again each minute: the core's sessions run on OpenRouter, not on these
#   accounts, so a live run must outlast them. A reset within HOLD_S: post the wait and retry.
# - Back up the ORDER (only when BACK=1): when an account ranked above the active one is usable again and the lead
#   is idle for 3 min, switch to it. Off by default (Samyak, 23 Oct): a restart kills the lead's background agents,
#   and an idle prompt does not mean no agent is running.
# Test overrides: T, PROJ, S, ALERT, LAUNCH, STOPF, PAIR, ORDER, HOLD_S, IDLE_S, BOOT_S, BACK, and claude-account's
# CLAUDE_ACCOUNTS_DIR / CLAUDE_SETTINGS_FILE.
set -u
export PATH=$HOME/.local/bin:$PATH TZ=America/Los_Angeles
T=${T:-distbench-lead}
PROJ=${PROJ:-$HOME/.claude/projects/-home-samyak-distbench-lead}
S=${S:-$HOME/.local/state/distbench/limit-alarm}   # <acct>.hit / <acct>.until (epoch s), seen, switched
ALERT=${ALERT:-sh $HOME/.distbench/alert.sh}
LAUNCH=${LAUNCH:-cd ~/distbench-lead && claude --remote-control distbench-lead-jhaveris --model claude-opus-5-5 --effort xhigh --permission-mode auto --settings ~/.distbench/night-1021-settings.json}
STOPF=${STOPF:-$HOME/.distbench/hyperstack.STOP}
ORDER=${ORDER:-gmail uci npds}
PAIR=${PAIR:-$HOME/.local/state/distbench/block-1/state/pair-status.json}   # the runner's watchdog rewrites it
HOLD_S=${HOLD_S:-7200}
IDLE_S=${IDLE_S:-1800}
BOOT_S=${BOOT_S:-45}
BACK=${BACK:-0}
ACC=${CLAUDE_ACCOUNTS_DIR:-$HOME/.config/claude-accounts}
mkdir -p "$S"
log() { echo "$(date -u +%m-%dT%H:%M:%SZ) $*"; }
num() { cat "$1" 2>/dev/null || echo 0; }

# Print "<uuid> <sessionId> <reset or ->" when the newest transcript's last assistant line is a usage-limit error.
limit_line() {
  f=$(ls -t "$PROJ"/*.jsonl 2>/dev/null | head -1); [ -n "$f" ] || return
  tac "$f" | grep -m1 '"type":"assistant"' | jq -r 'select(.isApiErrorMessage == true)
    | ([.message.content[]? | select(.type == "text") | .text] | join(" ")) as $t
    | select(($t | test("^You.ve (hit|reached) your")) and ($t | test("Fable|fast limit") | not))
    | "\(.uuid) \(.sessionId) \((($t | capture("resets (?<r>[0-9]{1,2}(:[0-9]{2})? ?(am|pm))") | .r) // "-") | gsub(" "; ""))"' 2>/dev/null
}

# Epoch second of the next "6am"-style reset, or an hour from now when the message names none.
until_of() {
  [ "$1" = - ] && { echo $(( $(date +%s) + 3600 )); return; }
  e=$(date -d "today $1" +%s) || { echo $(( $(date +%s) + 3600 )); return; }
  [ "$e" -gt "$(date +%s)" ] || e=$(date -d "tomorrow $1" +%s)
  echo "$e"
}
usable() { [ "$(num "$S/$1.until")" -le "$(date +%s)" ]; }
stored() { for p in "$ACC"/*.token; do [ -f "$p" ] && basename "$p" .token; done; }
# Whole seconds since the pair last ran work; empty when PAIR is missing or unreadable or no rental is open
# (idle_s null). The caller keeps the pair then: a teardown is the step that cannot be undone.
pair_idle() { jq -r '.idle_s // empty | floor' "$PAIR" 2>/dev/null; }

# The first usable stored account in ORDER other than $1; none -> empty. rank: its place in ORDER (99 if absent).
pick() { for n in $ORDER; do [ "$n" != "$1" ] && [ -f "$ACC/$n.token" ] && usable "$n" && { echo "$n"; return; }; done; }
rank() { i=0; for n in $ORDER; do [ "$n" = "$1" ] && { echo $i; return; }; i=$((i + 1)); done; echo 99; }

# Stop the lead's claude process, relaunch it on session $1 in the same pane, then paste the resume message ($2).
restart() {
  pp=$(tmux display -p -t "$T" '#{pane_pid}')
  for c in $(pgrep -P "$pp"); do kill -TERM "$c"; done
  for _ in $(seq 20); do [ -z "$(pgrep -P "$pp")" ] && break; sleep 1; done
  for c in $(pgrep -P "$pp"); do kill -KILL "$c"; done
  sleep 2
  tmux send-keys -t "$T" "$LAUNCH --resume $1" Enter
  sleep "$BOOT_S"
  nudge "$2"
}
# Paste message $1 into the lead's pane and submit it.
nudge() {
  printf '%s\n' "$1" > "$S/msg.txt"
  tmux load-buffer -b limitmsg "$S/msg.txt"; tmux paste-buffer -b limitmsg -t "$T"
  sleep 1; tmux send-keys -t "$T" Enter; sleep 2; tmux send-keys -t "$T" Enter
}
switch() { # from to session why
  claude-account use "$2" >/dev/null 2>&1 || { log "claude-account use $2 failed"; return 1; }
  date +%s > "$S/switched"; log "switched $1 -> $2 ($4); restarting lead on $3"
  restart "$3" "Watch alarm ($(date -u +%H:%MZ)): $4. limit-alarm.sh on jhaveris switched you from $1 to $2 (claude-account use $2) and restarted you with --resume. Your background shells, monitors and agents from before the restart are gone. Resume from the ledger RESUME POINTER: re-arm the monitors you need, check block 1's driver and op-* panes, then carry on. Record this switch in the ledger."
  $ALERT "WATCH: $4. limit-alarm switched the distbench lead from $1 to $2 and restarted it with --resume. Nothing to do unless the lead stays idle; check tmux distbench-lead."
}

log "armed: target $T, active $(cat "$ACC/active"), order $ORDER, stop file $STOPF"
told=""
while true; do
  now=$(date +%s); cur=$(cat "$ACC/active")
  read -r uuid sid reset <<< "$(limit_line)"
  gap=$(( now - $(num "$S/switched") ))
  if [ -n "${uuid:-}" ]; then
    if [ "$uuid" != "$(cat "$S/seen" 2>/dev/null)" ]; then
      echo "$uuid" > "$S/seen"; echo "$now" > "$S/$cur.hit"; until_of "$reset" > "$S/$cur.until"
      log "limit on $cur ($uuid), usable again $(date -d @"$(num "$S/$cur.until")" '+%a %H:%M %Z')"; told=""
    fi
    to=$(pick "$cur")
    if [ -n "$to" ] && [ "$gap" -ge 900 ]; then
      switch "$cur" "$to" "$sid" "the lead hit its Claude usage limit on $cur" && told=""
    elif [ -z "$to" ] && usable "$cur" && [ "$gap" -ge 900 ]; then   # cur's reset came first: wake the lead, no restart
      date +%s > "$S/switched"; log "$cur usable again, no other account is; pasted a resume message into the lead"; told=""
      nudge "Watch alarm ($(date -u +%H:%MZ)): the Claude usage limit on $cur has reset. limit-alarm.sh on jhaveris did not restart you, so your background shells, monitors and agents are still running. Carry on from where the limit stopped you, and record this in the ledger."
      $ALERT "WATCH: the Claude usage limit on $cur has reset. limit-alarm pasted a resume message into the distbench lead on $cur (no restart). Nothing to do unless the lead stays idle; check tmux distbench-lead."
    elif [ -z "$to" ] && [ "$told" != 1 ]; then   # told: empty, held (pair busy, alert sent, check again) or 1
      soon="" who=""
      for n in $(stored); do u=$(num "$S/$n.until"); if [ -z "$soon" ] || [ "$u" -lt "$soon" ]; then soon=$u; who=$n; fi; done
      at=$(date -d @"$soon" '+%a %H:%M %Z')
      if [ $(( soon - now )) -gt "$HOLD_S" ]; then
        idle=$(pair_idle)
        if [ -n "$idle" ] && [ "$idle" -ge "$IDLE_S" ]; then
          if [ ! -e "$STOPF" ]; then touch "$STOPF"; log "all accounts limited; next is $who at $at; pair idle ${idle}s; touched $STOPF"; fi
          $ALERT "WATCH: every Claude account is at its usage limit (next: $who at $at) and the pair has been idle $((idle / 60)) min. limit-alarm touched $STOPF, so the driver tears the paid pair down now. The lead resumes on $who after the reset; a new rental is needed for the remaining lines."
          told=1
        else
          why="pair idle ${idle}s, under ${IDLE_S}s"; [ -n "$idle" ] || why="no idle_s in $PAIR (missing, unreadable or no rental open)"
          log "all accounts limited; next is $who at $at; stop file not touched: $why"
          [ -n "$told" ] || $ALERT "WATCH: every Claude account is at its usage limit (next: $who at $at), but the pair is kept: $why. limit-alarm checks each minute and touches $STOPF once the pair has been idle $((IDLE_S / 60)) min."
          told=held
        fi
      else
        log "all accounts limited; next is $who at $at, within $((HOLD_S / 60)) min; pair kept"
        $ALERT "WATCH: every Claude account is at its usage limit; next: $who at $at, within $((HOLD_S / 60)) min, so the pair is kept. The lead restarts on $who then."
        told=1
      fi
    fi
  elif [ "$BACK" = 1 ] && to=$(pick "$cur") && [ -n "$to" ] && [ "$(rank "$to")" -lt "$(rank "$cur")" ] && [ "$gap" -ge 900 ]; then
    f=$(ls -t "$PROJ"/*.jsonl 2>/dev/null | head -1)
    if [ -n "$f" ] && [ $(( now - $(stat -c %Y "$f") )) -ge 180 ]; then
      sid=$(basename "$f" .jsonl)
      switch "$cur" "$to" "$sid" "$to has usage again and ranks above $cur in Samyak's order ($ORDER)"
    fi
  fi
  sleep 60
done
