{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(*distbench*)",
      "Bash(*/DistBench*)",
      "Bash(gh issue edit * --add-label ready-for-agent *)",
      "Bash(sudo *)",
      "Bash(crontab *)",
      "Bash(rm -rf *)",
      "ScheduleWakeup",
      "CronCreate",
      "Edit(~/loam/bin/overnight/**)",
      "Write(~/loam/bin/overnight/**)",
      "Edit(~/.local/state/loam-driver/**)",
      "Write(~/.local/state/loam-driver/**)"
    ]
  },
  "autoMemoryEnabled": false,
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/.local/state/loam/overnight",
        "~/.local/state/loam/worktrees",
        "~/.local/state/loam/alerts.jsonl"
      ],
      "denyWrite": [
        "~/loam/bin/overnight"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com"
      ]
    }
  }
}
