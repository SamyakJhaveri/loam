#!/usr/bin/env bash
# bin/factory - factory tooling. Subcommands: lint, eval, eval-freeze, run, status, stop, merge, next, graders-check, skills.
#   bin/factory lint <file|issue>   statically checks a ticket body against docs/factory/CONTRACT.md.
#   bin/factory eval <grader>       replays the frozen evals/ cases through the production grader call, recording scores.jsonl.
#   bin/factory eval-freeze <run-dir>...  freezes each run's last round, when both graders passed it, into evals/clean/.
#   bin/factory run <issue|file>    the supervisor: one ticket to a pull request (docs/factory/LOOP.md).
#   bin/factory status              run states, spend, denials, worktrees, PRs, preconditions.
#   bin/factory status --criteria   the ARCHITECTURE.md trust criteria, measured from the run dirs and the target's git log.
#   bin/factory stop <issue>        writes FACTORY_STOP into the run dir; the run halts before its next call.
#   bin/factory merge <pr> <sha>    merges the PR only when sha is its head and every check reported there passed.
#   bin/factory next [--install]    the F9 frontier timer's step: launch the next unblocked ready-for-agent ticket.
#   bin/factory graders-check       fails when judge.md or reviewer.md drifts from GRADER_MODEL and GRADER_EFFORT; warns STALE.
#   bin/factory skills              lists each installed pstack skill's lines that name a ~/ path or ask the user.
#   -C <repo>, before the subcommand or right after it, points lint, run, status, stop, merge, and next at another repository (F8).
# Lint never executes a check; it reads the body and shells out only to `bash -n`, `gh`, and python3 for the hidden-text rule.
# Run and stop, when the operator runs them, add a line to the run dir's owner-events.jsonl (status --criteria); lint of
# an issue adds one to <runs>/<issue>/owner-events.jsonl, which the issue's next launch moves into its run dir.
set -uo pipefail

# FACTORY_ROOT is set when a run execs its frozen copy of this file out of the run directory.
ROOT="${FACTORY_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
RUNS_BASE="${FACTORY_RUNS_ROOT:-$HOME/.local/state/loam-factory/runs}"

# ROOT is the factory home: bin/factory, bin/factory.d/, bin/claude-account, and the graders' fallback copy.
# TARGET is the repository a command works on: its tree, origin, issues, worktrees, and bin/check. It is ROOT
# unless `-C <repo>` names another (F8); exec_frozen passes another target on with -C, never through the environment,
# so a done-check that sets FACTORY_ROOT to its worktree still reads that worktree's tree.
# Worktrees are siblings of the target's main checkout. Loam's runs live in RUNS_BASE itself, as before F8;
# another target's live in RUNS_BASE/<owner>__<repo>/, so two repositories' #12 never share a run directory.
git_common() { git -C "$1" rev-parse --path-format=absolute --git-common-dir 2> /dev/null; }
target_is_loam() { [ "$TARGET_IS_LOAM" = 1 ]; }
# <owner>/<repo> from the target's GitHub origin URL, read locally; empty without one. Every gh call about the
# target passes it as -R, so a fork's issues and PRs never go to the parent gh would pick by default.
target_repo() {
  git -C "$TARGET" remote get-url origin 2> /dev/null \
    | sed -nE 's#^.*github\.com[:/]([^/]+)/([^/]+)$#\1/\2#p' | sed 's/\.git$//'
}
# Every gh call, and every git call that reaches a remote (fetch, push, ls-remote), runs under NET_TIMEOUT_SEC
# (LOOP.md, Caps): a call cut off at the limit fails like any other failure of that call, so a hung network call
# never holds a run, its slot and its heartbeat for good. A program runs under GNU timeout without --foreground
# (neither needs a terminal, and timeout then signals the call's whole process group), with KILL 5 s after TERM
# for a call that ignores TERM. A shell function (a test's stub, or one exported into the environment), or any
# call on a machine without timeout (a Mac), goes through net_watch instead, since timeout can only start a program.
net() {
  if [ "$(type -t "$1")" != function ] && command -v timeout > /dev/null 2>&1; then
    timeout -k 5 "$NET_TIMEOUT_SEC" "$@"
  else net_watch "$@"
  fi
}
# net's watchdog: job control gives the call its own process group, which gets TERM (and CONT, so a stopped call
# takes it) at NET_TIMEOUT_SEC and KILL 5 s later. At the deadline the watchdog first sends USR1 to this subshell,
# whose trap marks the call late (GNU timeout's flag): a late call returns 124 whatever it exited with, since one
# that traps TERM may exit 0, and its group is killed at once, since a member that ignores TERM may outlive the
# leader and hold the pipes. The USR1 cuts the first wait short, so a late call is waited on again. A bash whose
# wait returns when the call stops (bash manual, wait -f) has the call killed rather than left holding the pipes.
# bash 3.2 has no BASHPID, so a child sh reports this subshell's pid. The subshell's stderr goes to /dev/null so
# job notices stay out of the output; the call keeps the caller's stdin and stderr.
net_watch() {
  ( exec 3>&2 2> /dev/null; set -m
    local self pid wd rc=0 late=""
    self=$(exec sh -c 'echo "$PPID"')
    trap 'late=1' USR1
    "$@" <&0 2>&3 3>&- &
    pid=$!
    { sleep "$NET_TIMEOUT_SEC"; kill -USR1 "$self"; kill -TERM -- "-$pid"; kill -CONT -- "-$pid"; sleep 5
      kill -KILL -- "-$pid"; } > /dev/null 2>&1 < /dev/null &
    wd=$!
    wait "$pid" || rc=$?
    [ -n "$late" ] && { wait "$pid"; kill -KILL -- "-$pid"; rc=124; }
    kill -0 "$pid" && { kill -KILL -- "-$pid"; wait "$pid"; rc=137; }
    kill -- "-$wd"
    exit "$rc" )
}
target_slug() { target_repo | sed 's#/#__#'; }   # a GitHub owner name has no _, so the first __ splits it
use_target() { # dir -> 1 when dir is not in a git checkout, or is another repository with no GitHub origin
  local common slug
  TARGET=$(cd "$1" 2> /dev/null && git rev-parse --show-toplevel 2> /dev/null) || return 1
  common=$(git_common "$TARGET")
  MAIN_CHECKOUT=$(dirname "$common")
  TARGET_IS_LOAM=0; [ "$common" = "$(git_common "$ROOT")" ] && TARGET_IS_LOAM=1
  RUNS_ROOT="$RUNS_BASE"
  target_is_loam && return 0
  slug=$(target_slug)
  [ -n "$slug" ] || return 1
  RUNS_ROOT="$RUNS_BASE/$slug"
}
# A test that sources this file through `bash -c` has $0 = bash, so ROOT is the parent of its cwd and may sit
# outside any checkout; there the default target keeps the values the pre-F8 code derived.
use_target "$ROOT" || { TARGET="$ROOT"; MAIN_CHECKOUT=$(dirname "$ROOT"); TARGET_IS_LOAM=1; RUNS_ROOT="$RUNS_BASE"; }

# The ticket sections, in contract order. Six are required; Approach, Merge checklist,
# Rows measured, and a trailing Comments are optional.
CANON=("Goal and why" "Do not touch" "Out of scope" "Approach" "Done checks" \
       "Merge checklist" "Rows measured" "Worker" "Decisions" "Comments")
REQUIRED=("Goal and why" "Do not touch" "Out of scope" "Done checks" "Worker" "Decisions")
CAPS=" MAX_ROUNDS ROUND_BUDGET_USD GRADER_BUDGET_USD TICKET_BUDGET_USD DAILY_BUDGET_USD \
MAX_HOURS MAX_TURNS CALL_TIMEOUT_SEC NET_TIMEOUT_SEC MAX_PARALLEL "
# A cap is a positive whole number, or for a *_USD cap a positive decimal in JSON's form, since jq --argjson reads
# the budgets. Nothing else: GNU timeout reads 0 as no limit while net_watch kills at once, and text fails each
# path its own way (#427). cap_value_ok <name> <value> only answers; its callers report, with cap_form's words.
cap_value_ok() {
  case "$1" in
    *_USD) [[ "$2" =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?$ && "$2" =~ [1-9] ]] ;;
    *)     [[ "$2" =~ ^[1-9][0-9]*$ ]] ;;
  esac
}
cap_form() { case "$1" in *_USD) echo "a positive decimal such as 2.5" ;; *) echo "a positive whole number" ;; esac; }

# `claude --output-format json` prints one object, or an array whose last result element is it.
RESULT_OBJ='if type == "array" then ((last(.[] | select(.type == "result")) // .[-1]) // {}) else . end'

# The one rule for whether a reviewer reply blocks a round: a finding rated high or medium (LOOP.md, Grader-round
# cap). run_review, eval, eval-freeze, and status read it here, and eval_score.py's BLOCKING names the same set.
# The reviewer's verdict word is never read: it is not bound to a severity (2026-09-12), so it carries no weight.
REVIEW_BLOCKING='[.findings[]? | select(.severity == "high" or .severity == "medium")]'
REVIEW_OUTCOME="if ($REVIEW_BLOCKING | length) > 0 then \"fix\" else \"merge\" end"
# The Codex review's rule: a critical or high finding blocks; its verdict word is not read either.
CODEX_BLOCKING='[.findings[]? | select(.severity == "critical" or .severity == "high")]'

SRC=""
BODY=""
ERRS=0
# The one account whose issues next launches: it must have written the body and, when edited, last edited it.
TICKET_OWNER=SamyakJhaveri

err() { echo "LINT $SRC: $*" >&2; ERRS=$((ERRS + 1)); }

# The body above the first section: title, Brief:/Part of, Blocked by:.
header() { awk '/^## /{exit} {print}' <<<"$BODY"; }

# The body of one section, without its heading.
section() { awk -v want="## $1" '$0 == want {inb=1; next} /^## /{inb=0} inb {print}' <<<"$BODY"; }

# The done-checks fenced block, without its fences.
dc_block() { awk '/^```done-checks$/{inb=1; next} /^```/{if (inb) exit} inb {print}' <<<"$BODY"; }

# The block has no line continuations: lint rejects, and round 0 refuses, a raw line that ends in a backslash
# (dc_continued), so every reader below takes one raw line as one line, and no round runs half of a predict line.
dc_continued() { dc_block | grep -m1 '\\$'; }

# The block's lines with indentation dropped.
dc_lines() { dc_block | sed 's/^[[:space:]]*//'; }

# The block's checks one per line: blank lines, comments, and predict lines dropped.
dc_checks() { dc_lines | sed -e '/^#/d' -e '/^$/d' -e '/^predict[[:space:]]/d'; }

# The block's predict lines, `predict NAME CMD...` (CONTRACT.md, Done checks).
dc_predicts() { dc_lines | grep -E '^predict[[:space:]]'; }

# The block as checks.sh runs it: every predict line dropped, so no round after round 0 runs its text.
dc_script() { dc_block | grep -vE '^[[:space:]]*predict[[:space:]]'; }

# Sets the caller's name and cmd from one dc_predicts line; read would trim cmd's trailing whitespace, which may be
# escaped (`a\ `), so the prefix comes off by parameter expansion.
predict_split() {
  cmd=${1#predict}; cmd=${cmd#"${cmd%%[![:space:]]*}"}
  name=${cmd%%[[:space:]]*}; cmd=${cmd#"$name"}; cmd=${cmd#"${cmd%%[![:space:]]*}"}
}

# The NAME after each `pass` in the check lines on stdin, quotes stripped, one per line.
pass_names() { grep -oE '(^|[[:space:]])pass[[:space:]]+"?[A-Za-z0-9_.-]+' | awk '{print $NF}' | tr -d '"' | sort -u; }

# Like pass_names, but only where pass is the command word (after && || ; { ( ) then do else, or at the start), so a
# fail reason such as "lint does not pass greeting" names no check; ) ends a case pattern. check_predicts reads it: a
# name too many there would demand a predict line, while round 0's guard names only exempt, so they keep pass_names.
pass_cmd_names() {
  grep -oE '(^|&&|\|\||[;{()]|(then|do|else)[[:space:]])[[:space:]]*pass[[:space:]]+"?[A-Za-z0-9_.-]+' \
    | awk '{print $NF}' | tr -d '"' | sort -u
}

# A check that calls `guard` is a regression guard allowed to pass on base (CONTRACT.md, Done checks): `guard` as the
# command word, at the start or after ; & | ( { or !, as in `out=$(guard cmd)`, with any of the keywords if then else
# elif do while until time, or NAME=value assignments, between, as in `if guard cmd; then` or `LOAM_HOOK= guard cmd`.
# guard_checks matches each check against this with quoted strings and # comments removed, so a word that only holds
# it, like "safeguard", a check named env-guard, or a reason like "x; guard y", is not one.
GUARD_RE='(^|[;&|({!])([[:space:]]*((if|then|else|elif|do|while|until|time)[[:space:]]|[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]))*[[:space:]]*guard[[:space:]]'

# The dc_checks lines that call guard, or with -v the lines that do not; lint and round 0 both read guards here.
# A double-quoted string is kept up to its first inner quote when it opens a $(...) capture, so
# `<<<"$(guard cmd "$x")"` stays a guard; a later quoted reason is still removed.
guard_checks() { # [-v]
  local line code
  while IFS= read -r line; do
    code=$(sed -E -e "s/(\"[^\"]*\\\$\\([^\"]*\")|'[^']*'|\"([^\"\\\\\$]|\\\\.|\\\$[^(\"])*\"/\\1/g" \
      -e 's/(^|[[:space:]])#.*//' <<<"$line")
    if grep -qE "$GUARD_RE" <<<"$code"; then
      [ "${1:-}" = -v ] || printf '%s\n' "$line"
    elif [ "${1:-}" = -v ]; then
      printf '%s\n' "$line"
    fi
  done < <(dc_checks)
}

# Word-like tokens in stdin, backticks and sentence punctuation stripped. A token holding a glob or a
# shell expansion is not a path a ticket promises.
tokens() { tr -s ' \t' '\n\n' | tr -d '`",' | sed 's/[.,;:)]*$//' | grep -vE '[*$?{}]'; }

# Path-looking tokens: anything with a slash.
paths() { tokens | grep -E '^[.A-Za-z0-9_][A-Za-z0-9_./-]*/[A-Za-z0-9_./-]*$' | sort -u; }

# Keep only the tokens whose first segment is a tracked top-level entry: what a ticket really names.
only_tracked_tops() {
  local tops
  # tops is space-joined: macOS awk rejects a newline inside a -v value.
  tops=$(git -C "$TARGET" ls-files | cut -d/ -f1 | sort -u | tr '\n' ' ')
  awk -v tops="$tops" 'BEGIN {n = split(tops, a, " "); for (i = 1; i <= n; i++) t[a[i]] = 1}
                       {s = $0; sub(/\/.*/, "", s); if (s in t) print}'
}

# The paths a ticket promises: backtick-wrapped tokens that survive both filters.
promised_paths() { grep -o '`[^`]*`' | tr -d '`' | paths | only_tracked_tops; }

# ---- rules ----

check_sections() {
  local h j k prev=-1 r
  while IFS= read -r h; do
    j=-1
    for k in "${!CANON[@]}"; do [ "${CANON[$k]}" = "$h" ] && { j=$k; break; }; done
    if [ "$j" -lt 0 ]; then
      err "unknown section '## $h'"
    elif [ "$j" -le "$prev" ]; then
      err "section '## $h' is duplicated or out of contract order"
    else
      prev=$j
    fi
  done < <(grep '^## ' <<<"$BODY" | sed 's/^## //')
  for r in "${REQUIRED[@]}"; do
    grep -qxF "## $r" <<<"$BODY" || err "missing section '## $r'"
  done
}

check_header() {
  local head
  head=$(header)
  grep -qE '^(Brief:|Part of )' <<<"$head" || err "header has no 'Brief:' or 'Part of' line"
  grep -qE '^Blocked by:' <<<"$head" || err "header has no 'Blocked by:' line"
}

check_no_skip() {
  grep -qiE '(^|[^A-Za-z_-])skip(s|ped|ping)?([^A-Za-z_-]|$)' <<<"$BODY" && err "the body says 'skip'; a check leaves a ticket only through the abandon exit"
  return 0
}

# Text a reader of the issue on GitHub cannot see still reaches the worker, so lint rejects it by Unicode category,
# never by a fixed list (loop-engineering, MIT, scripts/github-triage.mjs: /[\p{Cc}\p{Cf}]/gu): a Cf (zero-width,
# bidi controls, tags, BOM, word joiner), a Cc other than tab, newline and CR, the variation selectors and the other
# default-ignorable code points a Cf rule misses (Mn, Lo or unassigned, yet drawn as nothing; the whole plane-14
# block U+E0000 to U+E0FFF carries bytes the way tags do), and the same through a character reference. Unassigned
# code points in general (Cn) pass, since Python's Unicode data reads newer emoji as Cn. The body is read as UTF-8 by
# Python, since BSD and GNU grep differ on Unicode ranges; split('\n'), not splitlines(), so VT, FF and U+2028 are
# still read, and a CR with no LF after it is rejected, since GitHub breaks the line there.
# Markdown GitHub hides or draws over its text is found by one code-aware scan, failing closed (#452): text is code
# only inside a column-0 fence or a code span paired on its own line, and everything else is prose, where any <
# (comment, tag, autolink, declaration, CDATA), ![ (image), ]: (link or footnote definition), ]( (an inline link,
# whose destination and title are not shown), a second $ in one block (math, a reference to $ included), and an
# indented or contained fence are rejected. A misread rejects a visible example and never passes a hidden one:
# whatever the scan calls code, GitHub shows as code. A backtick run left unpaired or longer than 80 (cmark-gfm's
# MAXBACKTICKS), a backtick in a bare URL (to ASCII whitespace or <, as cmark-gfm ends it), and a | inside a span in
# a table block turn spans off to the block's end. A ] in a span after a [ left open in the block is rejected, since
# GitHub reads a link reference definition before spans, and so is a table row with more cells than the narrowest
# delimiter row above it (a \| never splits a cell). Numeric references are decoded as cmark-gfm does (up to 8
# digits; 0, surrogates and past U+10FFFF read as U+FFFD). A mermaid, geojson, topojson, stl or math fence is drawn,
# a fence opener longer than 255 closes at a shorter run, and an info string outside INFO is not shown.
# Each error names the line and the construct or code point, never the hidden text.
IFS= read -r -d '' HIDDEN_PY << 'PY' || :
import html, re, sys, unicodedata
IGNORABLE = {0x034F, 0x115F, 0x1160, 0x17B4, 0x17B5, 0x180B, 0x180C, 0x180D, 0x180F, 0x3164, 0xFFA0}
DRAWN = {"mermaid", "geojson", "topojson", "stl", "math"}
CONTAINER = re.compile(r"(?:[ \t]*(?:>|[-+*](?=[ \t])|\d{1,9}[.)](?=[ \t])))*[ \t]*")
ENTITY = re.compile(r"&(?:#([0-9]{1,8})|#[xX]([0-9A-Fa-f]{1,8})|[A-Za-z][A-Za-z0-9]{0,31});")
INFO = {"", "done-checks", "sh", "bash", "python", "json", "yaml", "text", "diff", "md"}
text = sys.stdin.buffer.read().decode("utf-8", "surrogateescape")
lines = text.split("\n")
said = set()

def say(n, what):
    if (n, what) not in said:
        said.add((n, what))
        print(f"line {n} {what}")

def hidden(c):
    o, cat = ord(c), unicodedata.category(c)
    return (cat == "Cf" or (cat == "Cc" and c not in "\t\r") or 0xFE00 <= o <= 0xFE0F or 0xE0000 <= o <= 0xE0FFF
            or 0xFFF0 <= o <= 0xFFF8 or o in IGNORABLE)

def unref(m):  # the text a character reference stands for: numeric ones as cmark-gfm decodes them
    if not (m.group(1) or m.group(2)):
        return html.unescape(m.group())
    o = int(m.group(1), 10) if m.group(1) else int(m.group(2), 16)
    return chr(o) if 0 < o < 0x110000 and not 0xD800 <= o < 0xE000 else "\ufffd"

def dollar(n):  # a second $ in one block outside code can open math
    global dollars
    dollars += 1
    if dollars > 1:
        say(n, "holds a $ after another in its block outside code, so GitHub may draw the text between them as math")

def fence_open(s):  # the fence run when s opens a fence, else None
    m = re.match(r"`{3,}|~{3,}", s)
    return m.group() if m and not (s[0] == "`" and "`" in s[m.end():]) else None

def blank(s):
    return s.strip(" \t") == ""

def cells(s):  # the cells GitHub splits a table row into, after any quote or list prefix
    s = s[CONTAINER.match(s).end():].strip(" \t")
    return len(re.findall(r"(?<!\\)\|", s[s.startswith("|"):len(s) - s.endswith("|")])) + 1

def delimiter(s):  # whether s may be a GFM table delimiter row
    return "-" in s and ("|" in s or ":" in s) and re.fullmatch(r"[ \t>|:-]*", s)

def table_from(i):  # whether the block that starts at lines[i] holds a table delimiter row
    for s in lines[i:]:
        s = s.rstrip("\r")
        if blank(s) or fence_open(s):
            return False
        if delimiter(s):
            return True
    return False

def escaped(s, i):  # whether an odd backslash run comes before s[i]
    b = i
    while b > 0 and s[b - 1] == "\\":
        b -= 1
    return (i - b) % 2 == 1

def prose(n, s):
    global spans, brackets
    i = 0
    while i < len(s):
        c = s[i]
        if c == "`":
            j = i
            while j < len(s) and s[j] == "`":
                j += 1
            width = j - i - escaped(s, i)
            if spans and 0 < width <= 80:
                k = j
                while k < len(s):
                    if s[k] != "`":
                        k += 1
                        continue
                    e = k
                    while e < len(s) and s[e] == "`":
                        e += 1
                    if e - k == width:
                        break
                    k = e
                if k < len(s) and not (table and "|" in s[j:k]):
                    if brackets and "]" in s[j:k]:
                        say(n, "holds a ] in a code span after an open [, which GitHub may read as a link reference definition it does not show")
                    i = k + width
                    continue
                spans = False
            i = j
            continue
        if s.startswith("<!--", i):
            say(n, "holds an HTML comment (<!--) outside code, which GitHub does not show")
        elif c == "<":
            say(n, "holds a < outside code, which GitHub may read as a tag, an autolink or other markup it does not show")
        elif c == "$":
            dollar(n)
        elif s.startswith("![", i):
            say(n, "holds an image (![) outside code, which GitHub draws instead of its text")
        elif s.startswith("]:", i):
            say(n, "holds ]: outside code, which opens a link reference or footnote definition GitHub does not show")
        elif s.startswith("](", i):
            say(n, "holds a link (]() outside code, whose destination and title GitHub does not show")
            brackets -= brackets > 0 and not escaped(s, i)
        elif s.startswith(("://", "www."), i):
            if "`" in re.match(r"[^ \t\r\n\v\f<]*", s[i:]).group():
                spans = False
        elif c == "&" and (m := ENTITY.match(s, i)):
            for d in unref(m):
                if d == "$":
                    dollar(n)
                elif hidden(d):
                    say(n, f"holds a character reference to U+{ord(d):04X} ({unicodedata.category(d)}), a character GitHub does not show")
        elif c == "[":
            brackets += 1
        elif c == "]" and brackets and not escaped(s, i):
            brackets -= 1
        i += 1

if re.search(r"\r(?!\n|\Z)", text):
    say(text[:re.search(r"\r(?!\n|\Z)", text).start()].count("\n") + 1,
        "holds a carriage return with no newline after it, which GitHub reads as a line break")
fence, spans, table, cols, brackets, dollars = None, True, table_from(0), 0, 0, 0
for n, line in enumerate(lines, 1):
    for c in line:
        if hidden(c):
            say(n, f"holds U+{ord(c):04X} ({unicodedata.category(c)}), a character GitHub does not show")
    s = line[:-1] if line.endswith("\r") else line
    if fence:
        m = re.match(r" {0,3}(`+|~+)[ \t]*$", s)
        if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence):
            fence, spans, table, cols, brackets, dollars = None, True, table_from(n), 0, 0, 0
        continue
    if run := fence_open(s):
        fence, info = run, s[len(run):].strip(" \t")
        if len(run) > 255:
            say(n, "opens a fence longer than 255 characters, which GitHub closes at a shorter run")
        if (info.split() or [""])[0].lower() in DRAWN:
            say(n, "opens a fence GitHub draws as a diagram, map, model or math instead of its text")
        elif info not in INFO:
            say(n, "gives its fence an info string GitHub does not show; use none, done-checks or a plain language name")
        continue
    if blank(s):
        spans, table, cols, brackets, dollars = True, table_from(n), 0, 0, 0
        continue
    m = CONTAINER.match(s)
    if m.end() and fence_open(s[m.end():]):
        say(n, "indents a code fence or puts it in a list or quote, where GitHub may end it early")
    if delimiter(s):
        cols = min(cols or cells(s), cells(s))
    elif cols and cells(s) > cols:
        say(n, "holds more table cells than its delimiter row, and GitHub drops the extra")
    prose(n, s)
PY
check_hidden_text() {
  local out e
  out=$(printf '%s' "$BODY" | python3 -I -X utf8 -c "$HIDDEN_PY") \
    || { err "python3 could not read the body for hidden text"; return; }
  while IFS= read -r e; do
    [ -z "$e" ] || err "$e; delete it"
  done <<<"$out"
}

check_block_syntax() {
  local n tmp line
  n=$(grep -cxF '```done-checks' <<<"$BODY")
  if [ "$n" -ne 1 ]; then
    err "expected exactly one fenced done-checks block, found $n"
    return
  fi
  line=$(dc_continued)
  [ -z "$line" ] || err "done-checks line ends in a backslash; write each check and predict line on one line: $line"
  # bare mktemp ignores TMPDIR on macOS and fails inside the Claude Code sandbox
  tmp=$(mktemp "${TMPDIR:-/tmp}/factory-lint.XXXXXX")
  { cat "$ROOT/bin/factory.d/lib.sh"; echo; dc_script; } > "$tmp"
  bash -n "$tmp" || err "the done-checks block plus lib.sh does not pass bash -n"
  rm -f "$tmp"
}

# Every check line reports through pass NAME and fail NAME, and a line that leans on a test
# file or on pytest may only name test paths the ticket already fenced off under Do not touch.
# A predict line is not a check: round 0 alone runs its text, as a bash command of its own, and check_predicts reads it.
check_check_lines() {
  local line owned c covered e name cmd
  owned=$(section "Do not touch" | paths)
  while IFS= read -r line; do
    line=${line#"${line%%[![:space:]]*}"}
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac
    # Round 0 runs the text after NAME whole, so bash parses it as written; lint checks only that there is one and
    # that it parses alone, as round 0 will run it.
    if [[ "$line" == predict[[:space:]]* ]]; then
      predict_split "$line"
      if [ -z "$cmd" ] || [[ "$cmd" == \#* ]]; then
        err "predict line has no command: $line"
      elif ! bash -n -c "$cmd" 2> /dev/null; then
        err "predict line's command does not pass bash -n on its own line: $line"
      fi
      continue
    fi
    grep -qE '(^|[[:space:]])pass[[:space:]]' <<<"$line" \
      || err "check line does not report a pass: $line"
    grep -qE '(^|[[:space:]])fail[[:space:]]' <<<"$line" \
      || err "check line does not report a fail: $line"
    grep -qE '(^|[[:space:]])pytest|[^[:space:]]*test[^[:space:]]*\.py|[^[:space:]]*_test\.sh' <<<"$line" || continue
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      case "$c" in *test*) ;; *) continue ;; esac
      covered=0
      while IFS= read -r e; do
        [ -n "$e" ] || continue
        e=${e%/}
        [ "$c" = "$e" ] || [ "${c#"$e"/}" != "$c" ] && covered=1
      done <<<"$owned"
      [ "$covered" = 1 ] || err "self-graded oracle: the check names $c, which Do not touch does not fence off"
    done < <(printf '%s\n' "$line" | paths)
  done < <(dc_lines)
}

check_worker() {
  local w line name skill
  w=$(section Worker)
  grep -qE '^worker: (claude|codex)$' <<<"$w" || err "Worker has no 'worker: claude|codex' line"
  grep -qE '^codex-review: (yes|no)$' <<<"$w" || err "Worker has no 'codex-review: yes|no' line"
  grep -qE '^effort: (low|medium|high|xhigh)$' <<<"$w" || err "Worker has no 'effort: low|medium|high|xhigh' line"
  grep -qE '^goal: .*or stop after [0-9]+ turns$' <<<"$w" \
    || err "Worker has no 'goal:' line ending 'or stop after <N> turns'"
  # `size:` is optional (default small); large routes round 1 through the fan-out workflow (F12).
  if grep -qE '^size:' <<<"$w"; then
    grep -qE '^size: (small|large)$' <<<"$w" || err "Worker 'size:' must be 'small' or 'large'"
  fi
  # `contract:` is optional; `contract: 2` makes check_predicts want one predict line per non-guard check.
  if grep -qE '^contract:' <<<"$w"; then
    [ "$(grep -E '^contract:' <<<"$w")" = 'contract: 2' ] || err "Worker 'contract:' must be one line 'contract: 2'"
  fi
  # Every `skills:` name is a line of bin/factory.d/skills.txt, matched byte for byte (#37), or a
  # pstack:<name>, any installed pstack skill (#385; owner ruling 30 Oct 2026), which needs no line but
  # must be plain letters, digits, - or _, since skill_file passes it to find -path as a glob; either
  # must resolve through skill_file, since the worker reads that SKILL.md by path. Skipped under
  # fixtures/, whose historical bodies predate the allowlist, as check_paths is (lint).
  # A pstack skill whose steps write under ~/ gets an advisory warning, never a refusal: the worker's file
  # tools are denied there and its sandboxed shell cannot write there (worker-settings.json, #409).
  case "$SRC" in *bin/factory.d/fixtures/*) ;; *)
    while IFS= read -r skill; do
      [ -n "$skill" ] || continue
      case "$skill" in
        pstack:*)
          [[ "$skill" =~ ^pstack:[A-Za-z0-9_-]+$ ]] \
            || { err "skill '$skill': a pstack name must be pstack:<letters, digits, - or _>"; continue; }
          case "${skill#pstack:}" in
            setup-pstack|reflect|automate-me)  # SKILL.md writes ~/.cursor/rules or ~/.cursor/skills (~/.claude/ in Claude Code)
              echo "warning: $skill writes under ~/ (operator settings); a Claude worker's file tools are denied there and its sandboxed shell cannot write there (#409)" >&2 ;;
          esac ;;
        *)
          grep -qxF "$skill" "$ROOT/bin/factory.d/skills.txt" \
            || { err "unknown skill '$skill': not a line of bin/factory.d/skills.txt"; continue; } ;;
      esac
      skill_file "$skill" > /dev/null || err "skill '$skill' resolves to no SKILL.md"
    done < <(sed -n 's/^skills: *//p' <<<"$w" | head -1 | tr ',' '\n' | sed 's/^ *//;s/ *$//')
  ;; esac
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    case "$line" in worker:*|codex-review:*|effort:*|goal:*|skills:*|size:*|contract:*) continue ;; esac
    name=${line%%=*}
    if [ "$name" = "$line" ] || [ "${CAPS/ $name /}" = "$CAPS" ]; then
      err "unrecognized Worker line: $line"
    elif ! cap_value_ok "$name" "${line#*=}"; then
      err "Worker cap $line: $name must be $(cap_form "$name")"
    fi
  done <<<"$w"
}

# In a `contract: 2` body each non-guard check name has exactly one `predict NAME CMD...` line, and every predict
# line names a non-guard check, so round 0 proves each check fails on base for the reason its author predicted.
# A body with no contract line may carry predict lines, which round 0 runs, but needs none.
check_predicts() {
  local names guards line name seen=""
  grep -qxE 'contract: 2' <<<"$(section Worker)" || return 0
  names=$(guard_checks -v | pass_cmd_names)
  guards=$(guard_checks | pass_cmd_names)
  # A check whose pass takes no literal name, as `pass "$n"` in a loop, gives no name a predict line could cover.
  while IFS= read -r line; do
    [ -n "$(pass_cmd_names <<<"$line")" ] \
      || err "check line reports pass with no literal name, so no predict line can name it: $line"
  done < <(guard_checks -v)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    read -r _ name _ <<<"$line"
    name=${name//[\"\']/}
    if ! grep -qxF -- "$name" <<<"$names"; then
      if grep -qxF -- "$name" <<<"$guards"; then
        err "predict line names $name, a guard check; a guard may pass on base and takes no predict line"
      else
        err "predict line names $name, which no non-guard check reports with pass"
      fi
    elif grep -qxF -- "$name" <<<"$seen"; then
      err "a second predict line names $name; each non-guard check has exactly one"
    fi
    seen=$(printf '%s\n%s' "$seen" "$name")
  done < <(dc_predicts)
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    grep -qxF -- "$name" <<<"$seen" \
      || err "check $name has no predict line; a contract: 2 body has one 'predict $name CMD...' line per non-guard check"
  done <<<"$names"
}

# A check that greps source text proves the text, not the behavior. A rejection, not a warning: every S1-S5
# fixture has at least one other check. Frozen evals/clean tickets 81, 84 and 89 do not once a guarded bin/check
# counts as a guard (2026-10-19); they are old eval cases, not tickets that run again.
check_not_grep_only() {
  local line n=0 g=0
  while IFS= read -r line; do
    n=$((n + 1))
    grep -qE '^(![[:space:]]*)?grep[[:space:]]' <<<"$line" && g=$((g + 1))
  done < <(guard_checks -v)
  if [ "$n" -eq 0 ]; then
    err "every done-check is a guard; add one that fails on main and drives the real behavior"
  elif [ "$g" -eq "$n" ]; then
    err "all $n non-guard done-checks grep source text; drive the real behavior in at least one (run the command, render the template, or call the function and check its output)"
  fi
  return 0
}

check_merge_checklist() {
  local n
  grep -qE '^Track: B([[:space:]]|$)' <<<"$(header)" || return 0
  n=$(section "Merge checklist" | grep -c '[^[:space:]]')
  [ "$n" -le 3 ] || err "a Track B ticket allows at most three merge-checklist lines, found $n"
}

# Every path the ticket names must already be in the tree, or be one the ticket says it creates.
check_paths() {
  local p created
  created=$(section "Do not touch" | grep -F 'Except:' | paths)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$TARGET/$p" ] && continue
    grep -qxF "$p" <<<"$created" && continue
    err "names $p, which is not in the tree and is not one the ticket creates"
  done < <( { { header | grep -E '^Where:'; } | paths; { section "Do not touch"; section Approach; } | promised_paths; } | sort -u)
}

# ---- eval ----
# Replays evals/<grader>/<case>/prompt.md through the grader call in docs/factory/LOOP.md and
# compares the verdict with expected.json. The rubric comes from the live grader file, so a
# grader prompt edit changes the result; that is the point (LOOP.md, Grader change protocol).

EVAL_MODEL=claude-opus-5-5   # ARCHITECTURE.md, Models and roles (2026-09-24)
EVALS_DIR=evals
GRADERS_DIR=""

# Graders are plugin agents; a run and an eval both resolve them from the installed plugin cache, taking only a
# cached file whose sha256 equals this checkout's copy, so both grade with the prompts the repo ships, and the
# ledger records which file. --graders-dir replaces the search.
grader_file() {
  local dirs=("$GRADERS_DIR") ship="$ROOT/cultivation/marketplace/sam-cc-setup/agents" want other="" d f
  if [ -z "$GRADERS_DIR" ]; then
    # `claude plugin update` leaves old versions in the cache, and the newest cached one can still trail the
    # checkout (every distbench run of 2026-10-13 to 10-17 graded with 0.9.4). Only the prompt's bytes count:
    # a version bump that leaves this file alone still matches, and a prompt edit not yet installed does not.
    want=$(sha256_of < "$ship/$1.md" | cut -d' ' -f1)
    # Newest version first, so the ledger names the newest matching copy; bash 3.2 (macOS) has no mapfile.
    dirs=()
    while IFS= read -r d; do
      [ -d "$d" ] || continue
      if [ -f "$d/$1.md" ] && [ "$(sha256_of < "$d/$1.md" | cut -d' ' -f1)" = "$want" ]; then dirs+=("$d")
      else other="$other $(basename "$(dirname "$d")")"; fi
    done < <(printf '%s\n' "$HOME"/.claude/plugins/cache/*/sam-cc-setup/*/agents | sort -rV)
    if [ ${#dirs[@]} -eq 0 ] && [ -n "$other" ]; then
      echo "$1.md in the plugin cache (sam-cc-setup$other) differs from $ship/$1.md; run claude plugin update sam-cc-setup@seed-skills (cultivation/marketplace/UPGRADING.md)" >&2
      return 1
    fi
    # With no sam-cc-setup installed at all, the checkout's own copy is the shipped prompt by construction.
    [ ${#dirs[@]} -gt 0 ] || dirs=("$ship")
  fi
  for d in "${dirs[@]}"; do
    f="$d/$1.md"
    [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  echo "found no $1.md in ${dirs[*]}" >&2
  return 1
}

# A worker's skill name (a line of bin/factory.d/skills.txt or a pstack:<name>, lint-checked) -> its SKILL.md path.
# A bare name lives under ~/.claude/skills/<name>/; a plugin:name lives under the installPath that
# ~/.claude/plugins/installed_plugins.json gives the plugin's first `<plugin>@<marketplace>` entry, the
# folder Claude Code loads (docs/PSTACK.md), so a stale or other-marketplace cache folder never resolves.
# No installed_plugins.json, or no entry for the plugin, resolves to nothing: no cache-search fallback
# (owner ruling 30 Oct 2026, #437). A plugin may nest its skills under a category dir
# (skills/<category>/<name>/SKILL.md), so match SKILL.md at any depth
# under the plugin's skills tree, not only skills/<name>/.
skill_file() { # skill-name -> SKILL.md path on stdout, non-zero when it resolves to no file
  local name="$1" plugin sub dir f
  case "$name" in
    *:*)
      plugin=${name%%:*}; sub=${name#*:}
      dir=$(jq -r --arg p "$plugin" 'first(.plugins | to_entries[] | select(.key | startswith($p + "@"))
        | .value[0].installPath // empty)' "$HOME/.claude/plugins/installed_plugins.json" 2> /dev/null) || dir=""
      [ -n "$dir" ] && f=$(find "$dir/skills" -path "*/$sub/SKILL.md" 2> /dev/null | sort | head -1)
      [ -n "${f:-}" ] && { printf '%s\n' "$f"; return 0; } ;;
    *)
      f="$HOME/.claude/skills/$name/SKILL.md"
      [ -f "$f" ] && { printf '%s\n' "$f"; return 0; } ;;
  esac
  return 1
}

# The ticket's `skills:` names, one per line, as build_worker_prompt and worker_round read them.
worker_skills() { section Worker | sed -n 's/^skills: *//p' | head -1 | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep .; }

# Which named skills a round called: a Read tool_use of the name's skill_file path (how a Claude worker opens
# a pstack skill, which refuses the Skill tool) or a Skill tool_use naming it. A call whose tool_result is an
# error read nothing (Claude Code refuses the Skill tool for a disable-model-invocation skill, #508), so it
# does not count; a call with no tool_result yet does. Each line parses alone, so one bad line drops only itself.
skills_called() { # stream.jsonl name... -> the called names, sorted, unique and comma-joined, on stdout
  local stream="$1" s sf want='[]'
  shift
  for s; do
    sf=$(skill_file "$s") || sf=""
    want=$(jq -c --arg n "$s" --arg f "$sf" '. + [{n:$n, f:$f}]' <<< "$want")
  done
  jq -nrR --argjson want "$want" '[inputs | fromjson? | objects] as $ev
    | [$ev[] | select(.type == "user") | .message.content[]? | objects
      | select(.type == "tool_result" and .is_error == true) | .tool_use_id] as $bad
    | [$ev[] | select(.type == "assistant") | .message.content[]? | objects
      | select(.type == "tool_use" and (.id as $i | $bad | index([$i]) | not))] as $uses
    | [$want[] | . as $w | select($uses | any((.name == "Read" and $w.f != "" and .input.file_path == $w.f)
        or (.name == "Skill" and .input.skill == $w.n))) | .n] | unique | join(",")' "$stream" 2> /dev/null
}

# A plugin agent file opens with frontmatter; strip it. One that asks for prose is also asked for the
# JSON form; judge.md and reviewer.md carry their own `## Output` section and keep it byte-identical.
grader_rubric() {
  # `sed '/./,$!d'` drops the blank line after the frontmatter, so the rubric a grader reads is the
  # agent file's body byte for byte.
  if [ "$(head -n 1 "$1")" = "---" ]; then
    awk 'f; /^---$/ { c++; if (c == 2) f = 1 }' "$1" | sed '/./,$!d'
  else cat "$1"; fi
  grep -qxF '## Output' "$1" && return 0
  printf '\n## Output for this call\n\nRespond with exactly one JSON object and nothing else: no prose before or after, no code fences, no closing sentence; put anything you could not verify in the "unverified" array. Scope: the diff below and the worker-authored files. Severity as defined above.\n'
}

# The grader under test must not find the answer keys it is scored against in the tree it reads, so every
# eval call runs in a fresh export of the checkout's committed tree with evals/ removed, and with the evals
# directory removed too when it lies inside the checkout; the rest of the tree stays, as in a ticket
# worktree. This fences the working directory only: no permission rule stops a Read of an absolute path.
eval_tree() { # work: exports into work/tree
  local top ev wd
  top=$(cd "$ROOT" && pwd -P)
  ev=$(cd "$EVALS_DIR" 2> /dev/null && pwd -P)
  wd=$(cd "$1" && pwd -P)
  case "$wd/" in "$top"/*|"${ev:-/nonexistent}"/*)
    echo "eval: TMPDIR ($wd) lies inside the checkout or the evals directory" >&2; return 1 ;; esac
  mkdir "$1/tree" && git -C "$ROOT" archive HEAD | tar -x -C "$1/tree" ||
    { echo "eval: could not export the HEAD of $ROOT" >&2; return 1; }
  rm -rf "$1/tree/evals"
  case "$ev/" in "$top"/?*) rm -rf "$1/tree/${ev#"$top"/}" ;; esac
}

# A grader reads the tree it runs in, and the loop runs it in the round's worktree, so a frozen case is graded in
# that tree rebuilt: the diff's real base, keys removed as above, with every file of the Diff applied. The base is
# expected.json's tree_base (eval-freeze records the merge base of the run's base and graded commits, which a
# three-dot diff starts from), else the commit the `## Diff (<base>...HEAD)` heading names. The case fails instead of
# grading a tree the round never had when the Diff is not the whole change (build_evidence caps it, passes a large
# added file as stat only, and leaves deleted files out) or a file does not apply; a failure that names the Diff is
# a property of the case (model-eval caches it), any other is the environment. A recorded tree_base this checkout
# lacks fails too; only a case without one whose heading's commit is missing (run-only, lean-v3) reads the HEAD
# export. Graded in HEAD, a case drifts as main moves: a reviewer flagged a gh call for skipping a wrapper main
# gained six weeks later.
case_tree() { # case-dir work -> the tree to grade in on stdout; non-zero, with the reason on stderr, when it cannot be rebuilt
  local base tb top ev d="$2/case" p bad="" cap omit total held
  tb=$(jq -r '.tree_base // empty' "$1/expected.json" 2> /dev/null)
  base=${tb:-$(sed -n 's/^## Diff (\([0-9a-f]\{7,40\}\)\.\.\.HEAD)$/\1/p' "$1/prompt.md" | head -1)}
  if [ -n "$tb" ] && ! git -C "$ROOT" cat-file -e "$tb^{commit}" 2> /dev/null; then
    echo "tree_base $tb is not a commit in $ROOT; fetch it" >&2; return 1
  fi
  if [ -z "$base" ] || ! git -C "$ROOT" cat-file -e "$base^{commit}" 2> /dev/null; then echo "$2/tree"; return 0; fi
  rm -rf "$d" "$2/patch" && mkdir "$d" "$2/patch" || { echo "could not create $d" >&2; return 1; }
  awk -v fence="$FENCE" '/^## Diff \(/ {s = 1; next} s == 1 && $0 == fence {s = 2; next} s == 2 && $0 == fence {exit}
    s == 2' "$1/prompt.md" > "$2/patch/diff"
  cap=$(grep -m 1 '^\[content diff capped' "$2/patch/diff")
  [ -z "$cap" ] || { echo "the Diff is capped, so it is not the whole change: $cap" >&2; return 1; }
  # evals/ is removed from every tree, so a stat-only frozen prompt under it leaves nothing out.
  omit=$(sed -n 's/^\[stat only, content omitted as data: \(.*\)\]$/\1/p' "$2/patch/diff" | tr ' ' '\n' | grep -v '^evals/' | grep .)
  [ -z "$omit" ] || { echo "the Diff omits the content of:" $omit >&2; return 1; }
  awk -v out="$2/patch/" '/^diff --git / {n++} n {print > (out n)}' "$2/patch/diff"
  # Every changed file is a patch or a stat-only name; build_evidence gives a deleted file neither.
  total=$(sed -n 's/^ \([0-9][0-9]*\) files\{0,1\} changed.*/\1/p' "$2/patch/diff" | head -1)
  held=$(( $(find "$2/patch" -name '[0-9]*' | wc -l) + \
    $(sed -n 's/^\[stat only, content omitted as data: \(.*\)\]$/\1/p' "$2/patch/diff" | wc -w) ))
  [ -z "$total" ] || [ "$held" -ge "$total" ] ||
    { echo "the Diff holds $held of the $total changed files (a deleted file has no content)" >&2; return 1; }
  top=$(cd "$ROOT" && pwd -P); ev=$(cd "$EVALS_DIR" 2> /dev/null && pwd -P)
  git -C "$ROOT" archive "$base" | tar -x -C "$d" || { echo "could not export $base" >&2; return 1; }
  rm -rf "$d/evals"
  case "$ev/" in "$top"/?*) rm -rf "$d/${ev#"$top"/}" ;; esac
  for p in "$2/patch"/[0-9]*; do
    [ -f "$p" ] || continue
    ( cd "$d" && git apply --whitespace=nowarn "$p" ) > /dev/null 2>&1 || bad="$bad $(sed -n '1s|^diff --git a/\([^ ]*\) .*|\1|p' "$p")"
  done
  [ -z "$bad" ] || { echo "the Diff does not apply at ${base:0:8}:$bad" >&2; return 1; }
  echo "$d"
}

# One work directory per eval, outside the checkout, holding the export and the rubric. It is made, and its
# traps set, before the export starts, so a signal at any point removes it. The traps sit in this shell, not
# a subshell, so a TERM to bin/factory's pid alone still ends the case loop, once the in-flight call returns.
run_eval() {
  local rc
  EVAL_WORK=$(mktemp -d "${TMPDIR:-/tmp}/factory-eval.XXXXXX") || return 2
  trap 'rm -rf "$EVAL_WORK"' EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
  if eval_tree "$EVAL_WORK"; then
    run_eval_cases "$1" "$EVAL_WORK"
    rc=$?
  else
    rc=2
  fi
  rm -rf "$EVAL_WORK"
  trap - EXIT INT TERM HUP
  return "$rc"
}

run_eval_cases() { # grader work
  local grader="$1" tree="$2/tree" rubric="$2/rubric" budget="${EVAL_BUDGET_USD:-10}" gf schema settings dir name out res exp got erows grows
  local spent=0 cases=0 mism=0 clean=0 ok attempt eline
  gf=$(grader_file "$grader") || return 2
  schema=$(schema_for "$grader" 2> /dev/null)
  [ -n "$schema" ] || { echo "eval: no bin/factory.d/$grader.schema.json" >&2; return 2; }
  settings="$(cd "$(dirname "$0")" && pwd)/factory.d/role-settings.json"
  [ -d "$EVALS_DIR/$grader" ] || { echo "eval: no cases under $EVALS_DIR/$grader" >&2; return 2; }
  grader_rubric "$gf" > "$rubric"
  for dir in "$EVALS_DIR/$grader"/*/; do
    [ -f "$dir/prompt.md" ] && [ -f "$dir/expected.json" ] || continue
    exp=$(jq -r .verdict "$dir/expected.json")
    # A clean case expects the passing verdict; any other is a mutant (scores.jsonl, below), a TREE failure included.
    case "$grader/$exp" in judge/pass | reviewer/merge | lean-critic/merge) clean=$((clean + 1)) ;; esac
    tree=$(case_tree "$dir" "$2" 2> "$2/tree.err") || {
      echo "eval $grader/$(basename "$dir"): TREE $(cat "$2/tree.err"); not graded"; cases=$((cases + 1)); mism=$((mism + 1))
      [ -z "${EVAL_OUT:-}" ] || { mkdir -p "$EVAL_OUT"; jq -nc --arg r "TREE $(cat "$2/tree.err")" \
        '{type: "result", is_error: true, total_cost_usd: 0, result: $r}' > "$EVAL_OUT/$grader-$(basename "$dir").json"; }
      continue; }
    if awk -v s="$spent" -v b="$budget" 'BEGIN {exit !(s >= b)}'; then
      echo "eval $grader: EVAL_BUDGET_USD $budget reached after \$$spent and $cases cases" >&2
      return 2
    fi
    name=$(basename "$dir")
    cases=$((cases + 1))
    # Two attempts, as the loop's grader call takes.
    for attempt in 1 2; do
      # The same flags as the production grader call (LOOP.md, Grader calls), so the replay grades the
      # way the loop does: --json-schema routes the reply through the schema, --strict-mcp-config and
      # --disable-slash-commands drop the prefix the grader never uses. Two things differ: the call runs
      # in the eval_tree export, not a ticket worktree, and each call gets the remaining headroom, so
      # EVAL_BUDGET_USD caps the sum over cases. role-settings.json is read beside the schema, for the
      # reason schema_for gives.
      out=$(cat "$rubric" "$dir/prompt.md" | ( cd "$tree" && claude -p --model "$EVAL_MODEL" --effort "${EVAL_EFFORT:-$GRADER_EFFORT}" \
        --tools Read,Grep,Glob --strict-mcp-config --disable-slash-commands --no-session-persistence \
        --json-schema "$schema" \
        --max-budget-usd "$(awk -v b="$budget" -v s="$spent" 'BEGIN {printf "%.4f", b - s}')" \
        --setting-sources user --settings "$settings" --output-format json 2>/dev/null ))
      spent=$(awk -v a="$spent" -v b="$(jq -r "$RESULT_OBJ | .total_cost_usd // 0" <<<"$out" 2>/dev/null)" \
        'BEGIN {printf "%.4f", a + (b + 0)}')
      # When a run's measure step drives this eval (FACTORY_LEDGER is set), book each reply's cost to
      # that run's ledger and daily ledger, so the ticket and daily caps see it (#76). A stand-alone
      # eval has no FACTORY_LEDGER and books nothing. run_eval is a child process with its own globals,
      # so it cannot call record; it writes the two line shapes record writes, itself.
      if [ -n "${FACTORY_LEDGER:-}" ]; then
        eline=$(jq -c --argjson round "${FACTORY_ROUND:-0}" --arg role eval --arg model "$EVAL_MODEL" --arg ts "$(now)" \
          "$RESULT_OBJ | {round:\$round, role:\$role, model:\$model, cost_usd:(.total_cost_usd // 0), \
duration_ms:(.duration_ms // 0), num_turns:(.num_turns // 0), denials:0, subtype:(.subtype // \"unknown\"), \
served_models:(.modelUsage | if type == \"object\" then keys else [] end), ts:\$ts}" \
          <<<"$out" 2>/dev/null)
        [ -n "$eline" ] || eline=$(jq -nc --argjson round "${FACTORY_ROUND:-0}" --arg role eval --arg model "$EVAL_MODEL" --arg ts "$(now)" \
          '{round:$round, role:$role, model:$model, cost_usd:0, duration_ms:0, num_turns:0, denials:0, subtype:"unknown", served_models:[], ts:$ts}')
        printf '%s\n' "$eline" >> "$FACTORY_LEDGER"
        [ -z "${FACTORY_DAILY:-}" ] || printf '%s' "$eline" | jq -c --arg date "$(today)" --arg ticket "${FACTORY_KEY:-}" \
          '{date:$date, ticket:$ticket, role:.role, cost_usd:.cost_usd}' >> "$FACTORY_DAILY"
      fi
      res=$(jq -r "$RESULT_OBJ | .result // \"\"" <<<"$out" 2>/dev/null)
      # Fallback: if a reply still carries code fences or prose around the object, the object runs
      # from the first brace to the last, so cut to those before parsing the verdict.
      if ! jq -e .verdict <<<"$res" > /dev/null 2>&1 && [ "${res#*\{}" != "$res" ]; then
        res="{${res#*\{}"; res="${res%\}*}}"
      fi
      # A usage limit or an API error answers with is_error and no cost. That is the environment,
      # not a verdict: say so and stop, rather than reporting it as a grader disagreement.
      if [ "$(jq -r "$RESULT_OBJ | .is_error // false" <<<"$out" 2>/dev/null)" = true ]; then
        echo "eval $grader/$name: the call failed: $res" >&2
        return 2
      fi
      jq -e .verdict <<<"$res" > /dev/null 2>&1 && break
      echo "eval $grader/$name: attempt $attempt output not parseable" >&2
    done
    # EVAL_OUT keeps each case's raw reply, so a comparison can read findings, not only verdicts.
    [ -z "${EVAL_OUT:-}" ] || { mkdir -p "$EVAL_OUT"; printf '%s\n' "$out" > "$EVAL_OUT/$grader-$name.json"; }
    got=$(jq -r '.verdict // "unparseable"' <<<"$res" 2>/dev/null) || got=unparseable
    [ -n "$got" ] || got=unparseable
    # A reviewer reply is scored on what the loop does with it, REVIEW_OUTCOME, never on its verdict word.
    [ "$grader" = reviewer ] && [ "$got" != unparseable ] && got=$(jq -r "$REVIEW_OUTCOME" <<<"$res")
    ok=1
    [ "$got" = "$exp" ] || ok=0
    # The failing-row set is compared only for a case that lists one.
    if [ "$ok" = 1 ] && jq -e 'has("failing_rows")' "$dir/expected.json" > /dev/null 2>&1; then
      erows=$(jq -r '.failing_rows | sort | join(",")' "$dir/expected.json")
      grows=$(jq -r '[(.rows // {}) | to_entries[] | select(.value != "pass") | .key] | sort | join(",")' <<<"$res" 2>/dev/null)
      [ "$grows" = "$erows" ] || { ok=0; got="$got rows=[$grows]"; exp="$exp rows=[$erows]"; }
    fi
    if [ "$ok" = 1 ]; then
      echo "eval $grader/$name: OK $got"
    else
      echo "eval $grader/$name: MISMATCH got '$got', expected '$exp'"
      mism=$((mism + 1))
    fi
  done
  echo "eval $grader: $cases cases, $mism mismatch, \$$spent"
  [ "$cases" -gt 0 ] || return 2
  # Only a replay that reached every case records a line; graders-check reads it to tell a replayed grader
  # file from an edited one. sha256 covers the grader file alone, not the schema or role-settings.json.
  jq -nc --arg grader "$grader" --arg sha256 "$(sha256_of < "$gf" | cut -d' ' -f1)" --argjson cases "$cases" \
    --argjson clean "$clean" --argjson mutants "$((cases - clean))" --argjson mismatch "$mism" \
    --arg evals_dir "$EVALS_DIR" --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{grader:$grader, sha256:$sha256, cases:$cases, clean:$clean, mutants:$mutants, mismatch:$mismatch,
      evals_dir:$evals_dir, date:$date}' >> "$EVALS_DIR/scores.jsonl"
  [ "$mism" -eq 0 ]
}

# ---- eval-freeze ----
# Copies a run's last round into <evals-dir>/clean/{judge,reviewer}/<key>-<sha8>/ when the judge passed it and no
# reviewer finding blocks (REVIEW_OUTCOME merge); never over an existing case.
FREEZE_KEY_RE='(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{30,}'

# A saved grader prompt from its `## Ticket` line on, since run_eval prepends the live rubric. Trailing
# whitespace goes: a blank diff context line is a lone space, which bin/check's `git diff --check` rejects.
freeze_prompt() { awk 'f || $0 == "## Ticket" {f = 1; print}' "$1" | sed 's/[[:space:]]*$//'; }

cmd_eval_freeze() { # run-dir...
  local run d k key sha name why g p jv rv tmp tb rc=0
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/factory-freeze.XXXXXX") || return 1
  for run in "$@"; do
    [ -d "$run" ] || { echo "eval-freeze: $run is not a directory" >&2; rc=1; continue; }
    d=${run%/}
    sha=$(basename "$d"); key=$(basename "$(dirname "$d")"); name="$key-$sha"
    k=$(ls "$d" | sed -n 's/^round-\([0-9]*\)\.judge\.json$/\1/p' | sort -n | tail -1)
    jv=""; rv=""; why=""
    if [ -n "$k" ]; then
      jv=$(jq -r '.verdict // empty' "$d/round-$k.judge.json" 2> /dev/null)
      rv=$(jq -r "select(.verdict != null) | $REVIEW_OUTCOME" "$d/round-$k.review.json" 2> /dev/null)
    fi
    if [ -z "$jv" ]; then why="no judge verdict"
    elif [ "$jv" != pass ]; then why="round-$k judge verdict $jv"
    elif [ -z "$rv" ]; then why="no reviewer verdict"
    elif [ "$rv" != merge ]; then why="round-$k reviewer has a high or medium finding"
    elif [ -e "$EVALS_DIR/clean/judge/$name" ] || [ -e "$EVALS_DIR/clean/reviewer/$name" ]; then why="exists"
    fi
    for g in judge review; do
      [ -z "$why" ] || break
      p="$d/round-$k.$g.prompt.md"
      [ -f "$p" ] || { why="no round-$k.$g.prompt.md"; break; }
      freeze_prompt "$p" > "$tmp/$g" || { why="write failed"; break; }
      if [ ! -s "$tmp/$g" ]; then why="no ## Ticket line in round-$k.$g.prompt.md"
      elif [ "$(wc -c < "$tmp/$g")" -gt 100000 ]; then why="prompt too large"
      elif grep -qE "$FREEZE_KEY_RE" "$tmp/$g"; then why="key-shaped string"
      fi
    done
    # The Diff is three-dot, from the merge base of the run's base and the graded commit; case_tree rebuilds the tree
    # there. A case without it would fall back to the heading's commit, which need not be that base, so none is frozen.
    if [ -z "$why" ]; then
      tb=$(git -C "$ROOT" merge-base "$(cat "$d/base.sha" 2> /dev/null)" "$(cat "$d/round-$k.graded.sha" 2> /dev/null)" 2> /dev/null) ||
        why="no tree base: the merge base of base.sha and round-$k.graded.sha does not resolve in $ROOT"
    fi
    [ -z "$why" ] || { echo "not frozen $run: $why"; continue; }
    rm -rf "$tmp/case"
    if ! { mkdir -p "$tmp/case/judge" "$tmp/case/reviewer" \
      && jq -nc --arg source "$key/$sha round-$k" --arg tb "$tb" '{source: $source, verdict: "pass", tree_base: $tb}' > "$tmp/case/judge/expected.json" \
      && jq -nc --arg source "$key/$sha round-$k" --arg tb "$tb" '{source: $source, verdict: "merge", tree_base: $tb}' > "$tmp/case/reviewer/expected.json" \
      && mv "$tmp/judge" "$tmp/case/judge/prompt.md" \
      && mv "$tmp/review" "$tmp/case/reviewer/prompt.md" \
      && mkdir -p "$EVALS_DIR/clean/judge" "$EVALS_DIR/clean/reviewer" \
      && mv "$tmp/case/judge" "$EVALS_DIR/clean/judge/$name" \
      && mv "$tmp/case/reviewer" "$EVALS_DIR/clean/reviewer/$name"; }; then
      rm -rf "$EVALS_DIR/clean/judge/$name" "$EVALS_DIR/clean/reviewer/$name"
      echo "not frozen $run: write failed"
      continue
    fi
    echo "frozen $run: $name round-$k"
  done
  rm -rf "$tmp"
  return "$rc"
}

lint() {
  SRC="$1"
  ERRS=0
  if [ -f "$SRC" ]; then
    BODY=$(cat "$SRC")
    # A file may open with the front matter publish.sh reads: title:, then optional
    # labels: and blocked_by:, then ---. The body is what follows the --- line.
    local first
    first=$(head -n 1 "$SRC")
    if grep -q '^title: ' <<<"$first"; then
      if grep -qxF -- '---' "$SRC"; then
        BODY=$(sed '1,/^---$/d' "$SRC")
      else
        err "front matter has no --- line"
      fi
    else
      grep -q '^# ' <<<"$first" || err "first line is not a '# ' title"
    fi
  elif [[ "$SRC" =~ ^[0-9]+$ ]]; then
    BODY=$(net gh issue view "$SRC" -R "$(target_repo)" --json body -q .body) \
      || { echo "LINT $SRC: could not read the issue body with gh (failed, or no reply in ${NET_TIMEOUT_SEC}s)" >&2; return 1; }
    # Into the issue's own owner-events.jsonl, beside its run dirs, since lint usually precedes a body edit that
    # names another run dir; the next launch moves the lines into its run dir. A file is a fixture or a
    # rehearsal, so only an issue counts.
    owner_ran && owner_event "$RUNS_ROOT/$SRC" lint
  else
    echo "no such file: $SRC" >&2
    return 1
  fi
  lint_body
}

# The rules over BODY, each error on stderr as `LINT $SRC: ...`; returns 1 on any. lint resolves a file or
# an issue into BODY first, and cmd_next calls this directly with the body the frontier query already holds.
lint_body() {
  check_sections
  check_header
  check_no_skip
  check_hidden_text
  check_block_syntax
  check_check_lines
  check_worker
  check_merge_checklist
  check_not_grep_only
  # Fixture bodies are historical tickets that name paths later tickets removed, and predate predict lines.
  case "$SRC" in *bin/factory.d/fixtures/*) ;; *) check_paths; check_predicts ;; esac

  [ "$ERRS" -eq 0 ] || return 1
  echo "lint: OK $SRC"
}

# ---- run, status, stop ----
# The supervisor: one ticket to a pull request, in the steps docs/factory/LOOP.md sets out.
# Run state lives under RUNS_ROOT, outside every checkout; use_target sets it from FACTORY_RUNS_ROOT.

CAP_NAMES="MAX_ROUNDS ROUND_BUDGET_USD GRADER_BUDGET_USD TICKET_BUDGET_USD DAILY_BUDGET_USD \
MAX_HOURS MAX_TURNS CALL_TIMEOUT_SEC NET_TIMEOUT_SEC MAX_PARALLEL"
# Defaults, then the ticket's Worker section, then FACTORY_<NAME> in the environment. The bare names
# are never read: a Claude Code session already exports WORKER_MODEL and CALL_TIMEOUT_SEC of its own.
MAX_ROUNDS=100; ROUND_BUDGET_USD=15; GRADER_BUDGET_USD=5; TICKET_BUDGET_USD=1000000
DAILY_BUDGET_USD=1000000; MAX_HOURS=1000; MAX_TURNS=200; CALL_TIMEOUT_SEC=5400; MAX_PARALLEL=1
# Seeded from the environment here too, since lint, next and status call gh without apply_caps; env_caps_ok
# checks the value before any subcommand runs.
NET_TIMEOUT_SEC="${FACTORY_NET_TIMEOUT_SEC:-120}"
WORKER_MODEL="${FACTORY_WORKER_MODEL:-claude-opus-5-5}"   # ARCHITECTURE.md, Models and roles (2026-09-22)
GRADER_MODEL="${FACTORY_GRADER_MODEL:-claude-opus-5-5}"   # ARCHITECTURE.md, Models and roles (2026-09-24)
CODEX_MODEL="${FACTORY_CODEX_MODEL:-codex}"   # ledger label for a `worker: codex` round; Codex holds the real model in its own config, and its dollar cost is null (F4)
WORKER_ADVISOR="${FACTORY_WORKER_ADVISOR-claude-opus-5-5}"   # mid-round advisor on the worker call (ARCHITECTURE.md, Models and roles, 2026-09-24); FACTORY_WORKER_ADVISOR= (explicit empty) disables the flag. No colon: :- could never disable. The bare name is never read.
WORKER_EFFORT=high         # the ticket's `effort:` line overrides (ARCHITECTURE.md, Models and roles)
GRADER_EFFORT=high
GRADER_FAIL_ROUNDS=2      # grader-fail rounds allowed once the checks pass (LOOP.md, Grader-round cap)
FENCE='~~~~~~~~~~~~ evidence'   # fixed marker; never a per-run string (#38)

# REPO, RUN, and LOG keep a pre-set value: the sourced-test contract (file_backlog's backlog-filed-once
# check) passes these three in the environment, and load_ticket and cmd_run set all three before a run
# uses them, so `bin/factory run` is unchanged.
REPO="${REPO:-}"; ISSUE=""; KEY=""; IS_FILE=0; RUN="${RUN:-}"; ROUND=0; REVIEW_BLOCKED=0; GRADED_SHA=""; GRADER_FAILS=0
LOG="${LOG:-/dev/null}"; LEDGER=""; DAILY=""; DECISIONS=""; WORKTREE=""; BRANCH=""
# Worker kind and the Codex review stage, read from the ticket in cmd_run (F4). CODEX_REVIEW_BLOCKED is
# separate from REVIEW_BLOCKED so a Claude-reviewer block never consumes the Codex review's one block.
WORKER_KIND=claude; CODEX_REVIEW=no; CODEX_REVIEW_BLOCKED=0
CODEX_PATH="$HOME/.local/bin"   # Codex is not on the non-interactive PATH (#41); every Codex call prepends this
# util-linux flock(1), and bash 4.1+ for the {var} descriptors the lease opens: a Mac has neither (bash 3.2 reads
# `exec {fd}< file` as running a command named {fd}, which exits the shell), and runs keep the owner line's rules (#425).
HAVE_FLOCK=$( { [ "${BASH_VERSINFO[0]}" -gt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 1 ]; }; } \
  && command -v flock 2> /dev/null)

now()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
today() { date -u +%Y-%m-%d; }
log()   { printf '%s %s\n' "$(now)" "$*" | tee -a "$LOG" >&2; }
sha256_of() { if command -v sha256sum > /dev/null 2>&1; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }
set_status() { printf '%s\n' "$1" > "$RUN/status"; log "status: $1"; }

# Every factory write to GitHub passes through scrub: notify's issue comment, each filed issue's title and body,
# and the PR title and body. Check output and model text can hold a secret, and the repo may be public.
# Token-shaped strings become [redacted]. SUBS holds every pattern of seed/.claude/hooks/mem-capture.sh's
# scrubber verbatim, so the public path redacts at least what the private memory store does
# (bin/tests/test_factory_publish_scrub.py checks), then the factory's own and bin/alert's secrets.
# -X utf8 passes bytes that are not UTF-8 through unchanged.
IFS= read -r -d '' SCRUB_PY << 'PY' || :
import os, re, sys
SUBS = [
    (re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----(?:.*?-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|(?:(?:\r?\n|(?:\\+r)?\\+n)(?:[ \t]|\\+t)*[A-Za-z][A-Za-z0-9-]*: [^\"\\\r\n]*)*(?:(?:\s|\\+[nrt])+[A-Za-z0-9+/=]+)*)", re.DOTALL), "[redacted]"),
    (re.compile(r"([a-zA-Z][a-zA-Z0-9+.\-]*://[^:@/\s]+:)[^@/\s]+@"), r"\1[redacted]@"),
    (re.compile(r"sk-ant-[A-Za-z0-9_-]{10,}"), "[redacted]"),
    (re.compile(r"(?:(?<=\\[nrt])|(?<![A-Za-z0-9]))sk-[A-Za-z0-9_-]{20,}"), "[redacted]"),
    (re.compile(r"ghp_[A-Za-z0-9]{36,255}"), "[redacted]"),
    (re.compile(r"github_pat_[A-Za-z0-9_]{22,}"), "[redacted]"),
    (re.compile(r"gh[ousr]_[A-Za-z0-9]{36,255}"), "[redacted]"),
    (re.compile(r"xox[abpr]-[A-Za-z0-9-]{10,}"), "[redacted]"),
    (re.compile(r"AKIA[0-9A-Z]{16}"), "[redacted]"),
    (re.compile(r"AIza[0-9A-Za-z_-]{35}"), "[redacted]"),
    (re.compile(r"npm_[A-Za-z0-9]{36}"), "[redacted]"),
    (re.compile(r"glpat-[A-Za-z0-9_-]{20,}"), "[redacted]"),
    (re.compile(r"dop_v1_[a-f0-9]{64}"), "[redacted]"),
    (re.compile(r"eyJ[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}\.[A-Za-z0-9_-]{6,}"), "[redacted]"),
    (re.compile(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]{10,}"), r"\1[redacted]"),
    (re.compile(r"(?i)((?:api[_-]?key|secret|token|password|passwd|pwd)(?:\\?[\"'])?\s*[:=]\s*(?:\\?[\"'])?)([^\s\\\"',;]{6,})"), r"\1[redacted]"),
    # The factory's own: any Authorization value of 8 or more characters, and Slack's xoxs- tokens.
    (re.compile(r"(?i)(authorization[\"']?\s*[:=]\s*[\"']?(?:(?:bearer|basic|token)\s+)?)[^\s\\\"',]{8,}"), r"\1[redacted]"),
    (re.compile(r"xoxs-[A-Za-z0-9-]{10,}"), "[redacted]"),
    # bin/alert's secrets: Slack webhook and healthchecks ping URLs, and every value in its config files.
    (re.compile(r"https://(?:hooks\.slack\.com|hc-ping\.com)/[^\s\"'<>]+"), "[redacted]"),
]
text = sys.stdin.read()
for rx, rep in SUBS:
    text = rx.sub(rep, text)
conf = os.path.expanduser("~/.config/loam/alerts")
try:
    names = os.listdir(conf)
except OSError:
    names = []
for name in names:
    try:
        for word in open(os.path.join(conf, name)).read().split():
            text = text.replace(word, "[redacted]") if len(word) >= 8 else text
    except (OSError, UnicodeDecodeError):
        pass
sys.stdout.write(text)
PY
scrub() { python3 -I -X utf8 -c "$SCRUB_PY"; }

# The ticket's title: an issue's GitHub title, frozen at launch (its body has no '# ' line), else a file
# ticket's '# ' line.
ticket_title() {
  if [ -s "$RUN/frozen/title" ]; then cat "$RUN/frozen/title"
  else grep -m1 '^# ' "$RUN/frozen/issue.md" 2> /dev/null | sed 's/^# //'; fi
}

# "issue <n> (<title>)": how every alert names the ticket, so Samyak need not look the number up.
ticket_name() {
  local title
  title=$(ticket_title)
  printf 'issue %s%s' "$KEY" "${title:+ ($title)}"
}

# The run's frozen bin/alert, or the live one before freeze (an exit at launch).
alert() { if [ -x "$RUN/frozen/alert" ]; then "$RUN/frozen/alert" "$@"; else "$ROOT/bin/alert" "$@"; fi; }

# Slack, the event log and healthchecks through bin/alert (LOOP.md, Notify), else a comment on the ticket;
# a failure of both leaves notify.failed. The text passes scrub first: it can carry worker text.
notify() { # level title message
  log "[notify] $2: $3"
  [ "$IS_FILE" = 1 ] && return 0   # a file ticket is a rehearsal with no issue to comment on
  printf '%s. %s' "$2" "$3" | scrub | {
    alert --level "$1" --source factory --project "$(printf '%s' "${REPO#*/}" | tr 'A-Z' 'a-z')" \
      --run "issue $ISSUE" "$(cat)"; } 2>> "$LOG" && return 0
  if [ -n "$ISSUE" ] && printf '**%s**\n\n%s\n' "$2" "$3" | scrub \
    | net gh issue comment "$ISSUE" -R "$REPO" --body-file - > /dev/null 2>&1; then return 0
  fi
  printf '%s %s: %s\n' "$(now)" "$2" "$3" >> "$RUN/notify.failed"
}

# Each exit in words Samyak reads without the status table, and how loud it is (LOOP.md, Notify).
exit_words() { # status -> "<level> <words>"
  case "$1" in
    # Loam's own PRs go to the overnight driver, which reviews, fixes and merges them and alerts on one it
    # leaves open; another target's PR waits for its owner.
    pr-opened) if target_is_loam; then echo "info opened a pull request; the overnight driver reviews, fixes and merges it, and alerts you if it leaves it open"
               else echo "needs-you opened a pull request; it waits for your review and merge"; fi ;;
    ticket-defect) echo "needs-you cannot run as the ticket is written; fix the ticket" ;;
    abandon) echo "needs-you gave up: the worker says the ticket cannot be done as written" ;;
    stopped) echo "info stopped, as FACTORY_STOP asked" ;;
    stopped-cap) echo "fail stopped at a limit on rounds, money or hours" ;;
    stopped-daily) echo "info stopped at today's daily budget; the timer relaunches it tomorrow" ;;
    stuck) echo "fail stopped: the same checks failed twice in a row" ;;
    no-change) echo "fail stopped: a round changed nothing" ;;
    stopped-environment) echo "fail stopped on a machine or tool problem, not on the ticket" ;;
    *) echo "fail stopped ($1)" ;;
  esac
}

# The host's healthchecks check: a beat at launch, then every 5 minutes while this run's process lives, so a
# killed run or host goes red. The loop's TERM trap runs only after an in-flight beat returns (the sleep is
# waited on, so it does not delay the trap), and heartbeat_stop waits for it, so no beat lands after the pause.
# The loop closes the run's lease (FACTORY_SLOT_FD), so a beat left after the supervisor died, by finish, a signal
# or SIGKILL, never holds the slot.
heartbeat_start() {
  alert --ping beat >> "$LOG" 2>&1 || log "healthchecks beat failed; see bin/alert's line above"
  ( [ -n "$HAVE_FLOCK" ] && [ -n "${FACTORY_SLOT_FD:-}" ] && exec {FACTORY_SLOT_FD}>&- 2> /dev/null
    trap 'exit 0' TERM
    while sleep 300 & wait $!; kill -0 "$$"; do alert --ping beat; done ) < /dev/null > /dev/null 2>&1 &
  HEARTBEAT=$!
}

# Another live run on this host, Loam's or another target's; a hard-killed run holds its slot until holds_slot
# finds no process of it left and alerts. holds_slot is the whole test: a run beats only after cmd_run takes its lease
# and writes `running` (exec_frozen keeps the fd), so a run that has beaten holds its slot, and one that has not beats later.
other_live_run() {
  local d
  for d in "$RUNS_BASE"/*/*/ "$RUNS_BASE"/*/*/*/; do
    [ "${d%/}" = "${RUN%/}" ] && continue
    holds_slot "$d" && return 0
  done
  return 1
}

# The host's last live run pauses the check. A run launched meanwhile holds its slot before its first beat,
# so the second look sees it and beats again, and the pause never outlives a live run.
heartbeat_stop() {
  [ -n "${HEARTBEAT:-}" ] && kill "$HEARTBEAT" 2> /dev/null && wait "$HEARTBEAT" 2> /dev/null
  other_live_run && return 0
  alert --ping pause >> "$LOG" 2>&1 || log "healthchecks pause failed; see bin/alert's line above"
  other_live_run && { alert --ping beat >> "$LOG" 2>&1 || log "healthchecks beat failed"; }
  return 0
}

# Exit code, status, and the final log line are decided together (LOOP.md, Exits).
finish() { # status message
  local code words
  case "$1" in
    pr-opened) code=0 ;; ticket-defect) code=3 ;; stopped-environment) code=4 ;; abandon) code=5 ;; *) code=2 ;;
  esac
  set_status "$1"
  heartbeat_stop
  words=$(exit_words "$1")
  notify "${words%% *}" "$(ticket_name) ${words#* }" "$2"
  log "EXIT $1 ($code): $2"
  exit "$code"
}

# ---- the ticket -------------------------------------------------------------

load_ticket() { # <issue|file>
  SRC="$1"
  if [ -f "$SRC" ]; then
    IS_FILE=1
    BODY=$(cat "$SRC")
    grep -q '^title: ' <<<"$(head -n 1 "$SRC")" && BODY=$(sed '1,/^---$/d' "$SRC")
    KEY=$(basename "$SRC"); KEY=${KEY%.md}
  elif [[ "$SRC" =~ ^[0-9]+$ ]]; then
    ISSUE="$SRC"; KEY="$SRC"
    REPO=$(target_repo)
    [ -n "$REPO" ] || { echo "factory run: $TARGET has no GitHub origin to read the issue from" >&2; exit 4; }
    # The body, its author and its last editor come from one GraphQL read, so the owner check next made is made
    # again on the very body this run freezes (#389): an edit by another account after next's check, or between
    # this pass and the frozen one (which fetches again), is refused here, and so is a null editor with a lastEditedAt:
    # an edit by an account GitHub no longer names. jq -r strips trailing newlines in $(...)
    # the way gh issue view -q .body did, so the run key is unchanged.
    local json who editor edited why pid=""
    if ! json=$(net gh api graphql -f owner="${REPO%%/*}" -f name="${REPO#*/}" -F number="$ISSUE" \
      -f query='query($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { issue(number: $number) { body author { login } editor { login } lastEditedAt } } }' 2> /dev/null) \
      || ! jq -e '.data.repository.issue' > /dev/null 2>&1 <<<"$json"; then
      why="gh api graphql #$ISSUE failed, or got no reply in ${NET_TIMEOUT_SEC}s"
    else
      who=$(jq -r '.data.repository.issue.author.login // ""' <<<"$json")
      editor=$(jq -r '.data.repository.issue.editor.login // ""' <<<"$json")
      edited=$(jq -r '.data.repository.issue.lastEditedAt // ""' <<<"$json")
      if [ "$who" != "$TICKET_OWNER" ] || { [ -n "$editor" ] && [ "$editor" != "$TICKET_OWNER" ]; }; then
        [ "$who" = "$TICKET_OWNER" ] && who=$editor
        why="not owner #$ISSUE: written or last edited by ${who:-a deleted account}; edit the body as $TICKET_OWNER or remove ready-for-agent"
      elif [ -z "$editor" ] && [ -n "$edited" ]; then
        why="not owner #$ISSUE: last edited by an account GitHub no longer names; edit the body as $TICKET_OWNER or remove ready-for-agent"
      else
        BODY=$(jq -r '.data.repository.issue.body // ""' <<<"$json") && return 0
        why="jq could not read the body of #$ISSUE"
      fi
    fi
    # The frozen pass runs after cmd_run wrote owner and running, so a run this process owns ends through
    # finish; a bare exit would leave it `running` with a dead owner until holds_slot reaps it.
    [ -n "${FACTORY_FROZEN:-}" ] && read -r pid _ < "${FACTORY_FROZEN%/frozen/factory}/owner" 2> /dev/null
    if [ "$pid" = "$$" ]; then
      RUN="${FACTORY_FROZEN%/frozen/factory}"; LOG="$RUN/factory.log"
      finish stopped-environment "$why"
    fi
    echo "factory run: could not read issue #$ISSUE: $why" >&2; exit 4
  else
    echo "factory run: no such ticket file, and not an issue number: $SRC" >&2; exit 2
  fi
}

apply_caps() { # the ticket's Worker section, then any FACTORY_<NAME> override
  local line name v
  while IFS= read -r line; do
    case "$line" in *=*) name=${line%%=*} ;; *) continue ;; esac
    case " $CAP_NAMES " in *" $name "*) ;; *) continue ;; esac
    cap_value_ok "$name" "${line#*=}" \
      || { echo "factory: Worker cap $line: $name must be $(cap_form "$name")" >&2; exit 2; }
    eval "$name=\${line#*=}"
  done <<< "$(section Worker)"
  env_caps_ok || exit 2
  for name in $CAP_NAMES; do
    v="FACTORY_$name"
    [ -z "${!v:-}" ] || eval "$name=\${!v}"
  done
}

# Every FACTORY_<NAME> cap set in the environment passes cap_value_ok, or it names the first that does not.
# An empty value counts as unset, as apply_caps reads it.
env_caps_ok() {
  local name v
  for name in $CAP_NAMES; do
    v="FACTORY_$name"
    [ -z "${!v:-}" ] || cap_value_ok "$name" "${!v}" \
      || { echo "factory: $v=${!v}: $name must be $(cap_form "$name")" >&2; return 1; }
  done
}

# What a ticket section fences off: like promised_paths, but a bare name (VERSION) counts too.
ticket_paths() { tokens | grep -E '^[.A-Za-z0-9_][A-Za-z0-9_./-]*$' | only_tracked_tops | sort -u; }

# The standing do-not-touch list: the `- ` lines under `## Standing do-not-touch list` in the target's one home
# for it, Loam's docs/factory/ARCHITECTURE.md or another target's docs/factory/STANDING.md (F8). An entry counts only
# when its first segment is tracked in the target; another target with no entry is refused by assert_target_ready.
standing_file() {
  if target_is_loam; then echo "$TARGET/docs/factory/ARCHITECTURE.md"; else echo "$TARGET/docs/factory/STANDING.md"; fi
}
standing_list() {
  local f
  f=$(standing_file)
  [ -f "$f" ] || return 0
  awk '/^## Standing do-not-touch list$/ {inb = 1; next} /^## / {inb = 0} inb && /^- /' "$f" | ticket_paths
}

under() { # path list -> 0 when path equals or sits under a list entry
  local p="$1" e
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    e=${e%/}
    { [ "$p" = "$e" ] || [ "${p#"$e"/}" != "$p" ]; } && return 0
  done <<< "$2"
  return 1
}

# ---- steps 2 and 3: worktree, freeze ----------------------------------------

prepare_worktree() {
  local base
  if [ ! -s "$RUN/base.sha" ]; then
    net git -C "$MAIN_CHECKOUT" fetch -q origin 2> /dev/null
    git -C "$MAIN_CHECKOUT" rev-parse origin/main > "$RUN/base.sha" 2> /dev/null \
      || git -C "$MAIN_CHECKOUT" rev-parse HEAD > "$RUN/base.sha"
  fi
  base=$(cat "$RUN/base.sha")
  if [ ! -d "$WORKTREE" ]; then
    if git -C "$MAIN_CHECKOUT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$MAIN_CHECKOUT" worktree add "$WORKTREE" "$BRANCH" > /dev/null 2>&1
    else
      git -C "$MAIN_CHECKOUT" worktree add "$WORKTREE" -b "$BRANCH" "$base" > /dev/null 2>&1
    fi
    [ -d "$WORKTREE" ] || finish stopped-environment "could not create the worktree $WORKTREE from $base"
  fi
  [ "$IS_FILE" = 1 ] && return 0
  net gh issue edit "$ISSUE" -R "$REPO" --add-assignee @me > /dev/null 2>&1 || log "could not assign #$ISSUE; continuing"
}

FROZEN_SET="factory lib.sh _common.md role-settings.json worker-settings.json checks.sh \
judge.md reviewer.md judge.schema.json reviewer.schema.json issue.md protected.txt exempt.txt \
factory-round.js review-output.schema.json codex-review.prompt.md unattended.md alert"
# The line freeze writes after the block, before checks.sh exits; run_checks reads output that does not end
# on CHECKS-END as an abort (#277).
CHECKS_END="printf '\nCHECKS-END\n'"

freeze() {
  local g src cgd ccd user
  [ -f "$RUN/frozen/sha256" ] && return 0
  printf '%s\n' "$BODY" > "$RUN/frozen/issue.md"
  [ -n "$ISSUE" ] && { net gh issue view "$ISSUE" -R "$REPO" --json title -q .title > "$RUN/frozen/title" 2> /dev/null || rm -f "$RUN/frozen/title"; }
  cp "$ROOT/bin/factory" "$RUN/frozen/factory"
  cp "$ROOT/bin/factory.d/factory-round.js" "$RUN/frozen/factory-round.js"  # the worker runs its frozen copy, so it cannot edit the script (F12)
  cp "$ROOT/bin/factory.d/review-output.schema.json" "$RUN/frozen/review-output.schema.json"  # the Codex review reads the frozen copy, so a mid-run edit of it cannot change the review (#38, F4)
  cp "$ROOT/bin/factory.d/codex-review.prompt.md" "$RUN/frozen/codex-review.prompt.md"  # the Codex review reads the frozen prompt, so a mid-run edit of it cannot change the review (#38, F4)
  cp "$ROOT/bin/factory.d/unattended.md" "$RUN/frozen/unattended.md"  # the Opus 5.5 guide's "Unattended agentic runs" paragraph, appended to every Claude worker call (#210)
  cp "$ROOT/bin/factory.d/lib.sh" "$RUN/frozen/lib.sh"
  cp "$ROOT/bin/alert" "$RUN/frozen/alert"   # a mid-run edit of bin/alert cannot change this run's alerts
  cp "$ROOT/bin/factory.d/role-settings.json" "$RUN/frozen/role-settings.json"
  # Claude Code copies settings env over the launch env, so the worker call's model pins also go in this frozen
  # copy's env, after the user tier's env it carries, or a ~/.claude/settings.json env entry would undo them (#379).
  # The worker's Bash runs in the sandbox, which writes only the worktree and $TMPDIR by default; a commit also
  # needs the worktree gitdir and objects/refs/logs under the common dir (the Codex worker's roots), and the shell
  # writes decisions.md and mechanism.md in the worker directory and result.json in tasks/ (#409).
  # uv gets a cache and tool directory of the run's own, so the operator's shared uv cache and tools are kept out of
  # the worker's reach. Claude Code merges sandbox lists across tiers, and the user tier's excludedCommands or
  # allowWrite would widen the boundary, so the worker call loads no settings tier (--setting-sources ''): this copy
  # carries the user tier without its sandbox block, arrays concatenated and the worker's keys winning, as Claude
  # Code merges them. It also drops the user tier's permissions.allow and permissions.additionalDirectories: Claude
  # Code adds Edit(...) allow paths and additionalDirectories to the sandbox's writable paths and WebFetch(domain:...)
  # allow domains to its network allowlist even under strictAllowlist, and allow rules do nothing under
  # bypassPermissions.
  cgd=$(git -C "$WORKTREE" rev-parse --absolute-git-dir 2> /dev/null) && ccd=$(git_common "$WORKTREE") \
    && [ -n "$cgd" ] && [ -n "$ccd" ] || finish stopped-environment "could not read the git directories of $WORKTREE for the worker sandbox"
  # bin/claude-account switches accounts by rewriting the user tier's CLAUDE_CODE_OAUTH_TOKEN, so the copy leaves it
  # out and worker_round passes the live one. The rest of the user env may hold secrets too, so the copy is private
  # to the operator, as ~/.claude/settings.json is.
  user="${CLAUDE_SETTINGS_FILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json}"
  [ -f "$user" ] || user=/dev/null
  mkdir -p "$RUN/uv/cache" "$RUN/uv/tools"
  ( umask 077; jq --slurpfile u "$user" --arg m "$WORKER_MODEL" --arg gd "$cgd" --arg cd "$ccd" --arg w "${DECISIONS%/*}" \
    --arg t "$RUN/tasks" --arg uv "$RUN/uv" '
    def merge($a; $b): if ($a|type) == "object" and ($b|type) == "object"
      then reduce ($b|keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]))
      elif ($a|type) == "array" and ($b|type) == "array" then $a + $b else $b end;
    merge($u[0] // {} | del(.sandbox, .env.CLAUDE_CODE_OAUTH_TOKEN, .permissions.allow, .permissions.additionalDirectories); .) | .env = (.env // {}) + {CLAUDE_CODE_SUBAGENT_MODEL: $m, CLAUDE_CODE_SUBAGENT_MODEL_FORCE: "1",
    ANTHROPIC_DEFAULT_SONNET_MODEL: $m, ANTHROPIC_DEFAULT_HAIKU_MODEL: $m,
    UV_CACHE_DIR: "\($uv)/cache", UV_TOOL_DIR: "\($uv)/tools"}
    | .sandbox.filesystem.allowWrite += [$gd, "\($cd)/objects", "\($cd)/refs", "\($cd)/logs", $w, $t, "\($uv)/cache", "\($uv)/tools"]' \
    "$ROOT/bin/factory.d/worker-settings.json" > "$RUN/frozen/worker-settings.json" ) 2>> "$LOG" \
    || finish stopped-environment "could not merge $user into the frozen worker settings"
  sed -e "s|<issue>|${ISSUE:-$KEY}|g" -e "s|<decisions>|$DECISIONS|g" -e "s|<mechanism>|${DECISIONS%/*}/mechanism.md|g" \
    "$ROOT/bin/factory.d/_common.md" > "$RUN/frozen/_common.md"
  for g in judge reviewer; do
    src=$(grader_file "$g" 2>&1) || finish stopped-environment "$src"
    grader_rubric "$src" > "$RUN/frozen/$g.md"
    schema_for "$g" > "$RUN/frozen/$g.schema.json"
    printf '{"ts":"%s","event":"grader","role":"%s","file":"%s","sha256":"%s"}\n' \
      "$(now)" "$g" "$src" "$(sha256_of < "$src" | cut -d' ' -f1)" >> "$LEDGER"
  done
  { cat "$RUN/frozen/lib.sh"; echo; dc_script; echo; echo "$CHECKS_END"; echo 'exit $((n_fail > 0))'; } > "$RUN/frozen/checks.sh"
  { standing_list; section "Do not touch" | sed 's/[Ee]xcept:.*//' | ticket_paths; } | sort -u > "$RUN/frozen/protected.txt"
  section "Do not touch" | grep -o '[Ee]xcept:.*' | ticket_paths > "$RUN/frozen/exempt.txt"
  chmod +x "$RUN/frozen/checks.sh" "$RUN/frozen/factory" "$RUN/frozen/alert"
  # shellcheck disable=SC2086
  ( cd "$RUN/frozen" && sha256_of $FROZEN_SET > sha256 )
  chmod a-w "$RUN/frozen"/*
}

check_frozen() {
  ( cd "$RUN/frozen" && sha256_of -c sha256 --status ) \
    || finish stopped-environment "the frozen set under $RUN/frozen changed mid-run"
}

# The supervisor runs its frozen copy, so a ticket that edits bin/factory takes effect next run.
exec_frozen() {
  [ "${FACTORY_FROZEN:-}" = "$RUN/frozen/factory" ] && return 0
  export FACTORY_FROZEN="$RUN/frozen/factory" FACTORY_ROOT="$ROOT"
  # A Loam run re-execs exactly as before F8, so a resumed run whose frozen copy predates -C still starts.
  if target_is_loam; then exec "$RUN/frozen/factory" run "$SRC"; fi
  exec "$RUN/frozen/factory" -C "$TARGET" run "$SRC"
}

# ---- ledger and caps --------------------------------------------------------

ticket_spent() { jq -s '[.[].cost_usd // 0] | add // 0' "$LEDGER"; }
daily_spent()  { jq -s --arg d "$(today)" '[.[] | select(.date == $d) | .cost_usd // 0] | add // 0' "$DAILY"; }

# Advisor usd for a worker round's result.json, or null with no transcript. Splits each advisor model's
# modelUsage cost by its transcript advisor_message tokens (weights 1/5/0.05/2): exact for a distinct model, an estimate when shared.
advisor_usd() {
  local sid tr
  sid=$(jq -r "$RESULT_OBJ | .session_id // empty" "$1" 2> /dev/null)
  [ -n "$sid" ] && tr=$(find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -maxdepth 2 -name "$sid.jsonl" 2> /dev/null | head -1)
  [ -n "${tr:-}" ] || { echo null; return 0; }
  jq -r --slurpfile t "$tr" "$RESULT_OBJ"' | (.modelUsage // {}) as $mu
    | def w: (.inputTokens // .input_tokens // 0) + 5 * (.outputTokens // .output_tokens // 0)
        + 0.05 * (.cacheReadInputTokens // .cache_read_input_tokens // 0)
        + 2 * (.cacheCreationInputTokens // .cache_creation_input_tokens // 0);
    [$t[] | select(.type == "assistant" and .message.id != null)] | unique_by(.message.id)
    | [.[].message.usage.iterations[]? | select(.type == "advisor_message")] | group_by(.model)
    | map(($mu[.[0].model] // {}) as $u | if ($u | w) == 0 then 0 else $u.costUSD * (map(w) | add) / ($u | w) end)
    | add // 0 | . * 10000 | round / 10000' "$1" 2> /dev/null || echo null
}

# The served models of the ledger lines on stdin, as one JSON array, that start with none of the configured names
# nor their own line's requested .model (a [1m] or dated suffix still matches; per line, so an override at
# launch does not warn later). An empty name, as FACTORY_WORKER_ADVISOR= leaves, is dropped, since every model
# starts with "". A malformed line is skipped, not the whole ledger. cmd_status and record share this rule.
off_models() {
  jq -cnR --arg w "$WORKER_MODEL" --arg g "$GRADER_MODEL" --arg a "$WORKER_ADVISOR" \
    '[inputs | fromjson? | objects | ([$w, $g, $a, (.model | strings)] - [""]) as $ok | (.served_models | arrays)[] | strings
      | select(. as $m | $ok | any(. as $p | $m | startswith($p)) | not)] | unique'
}

record() { # round role model result.json [advisor_calls] [advisor_usd] [workflow_agents] [workflow_usd] [codex] [skills_called]
  # workflow_agents and workflow_usd come from workflow_ledger (0 0 on every round but a claude worker's
  # round 1, and on every Codex round). codex is 1 for a Codex call: cost_usd is null (the dollar caps do
  # not bound Codex, #41) and `usage` carries its verbatim token counters; ticket_spent, daily_spent, and
  # cmd_status all read cost_usd // 0, so null is safe.
  # served_models is the sorted modelUsage keys of the result, the models that answered (not the one asked
  # for); [] when the result has none, as a Codex round's does. cmd_status warns on one it does not expect.
  # skills_called is skills_called's comma list, passed only for a Claude worker round; its line then carries
  # skills_called as an array ([] for none) and every other line has no such field.
  local line acalls="${5:-0}" ausd="${6:-0}" wagents="${7:-0}" wusd="${8:-0}" codex="${9:-0}" skills=null
  [ $# -ge 10 ] && skills=$(jq -cn --arg s "${10}" '$s | split(",")')
  line=$(jq -c --argjson round "$1" --arg role "$2" --arg model "$3" --arg ts "$(now)" --arg nav "${FACTORY_NAV_ARM:-base}" \
    --argjson acalls "$acalls" --argjson ausd "$ausd" --argjson wagents "$wagents" --argjson wusd "$wusd" --argjson codex "$codex" \
    --argjson skills "$skills" "$RESULT_OBJ | {round:\$round, role:\$role, model:\$model, cost_usd:(if \$codex == 1 then null else (.total_cost_usd // 0) end), \
duration_ms:(.duration_ms // 0), num_turns:(.num_turns // 0), denials:((.permission_denials // []) | length), \
subtype:(.subtype // \"unknown\"), usage:(.usage // null), advisor_calls:\$acalls, advisor_usd:\$ausd, \
workflow_agents:\$wagents, workflow_usd:\$wusd, served_models:(.modelUsage | if type == \"object\" then keys else [] end), \
nav_arm:\$nav, ts:\$ts} + (if \$skills == null then {} else {skills_called:\$skills} end)" "$4" 2> /dev/null) \
    || line=$(jq -nc --argjson round "$1" --arg role "$2" --arg model "$3" --arg ts "$(now)" --arg nav "${FACTORY_NAV_ARM:-base}" \
      --argjson acalls "$acalls" --argjson ausd "$ausd" --argjson wagents "$wagents" --argjson wusd "$wusd" --argjson codex "$codex" \
      --argjson skills "$skills" '{round:$round, role:$role, model:$model, cost_usd:(if $codex == 1 then null else 0 end), duration_ms:0, num_turns:0, denials:0, subtype:"unknown", usage:null, advisor_calls:$acalls, advisor_usd:$ausd, workflow_agents:$wagents, workflow_usd:$wusd, served_models:[], nav_arm:$nav, ts:$ts} + (if $skills == null then {} else {skills_called:$skills} end)')
  printf '%s\n' "$line" >> "$LEDGER"
  printf '%s' "$line" | jq -c --arg date "$(today)" --arg ticket "$KEY" \
    '{date:$date, ticket:$ticket, role:.role, cost_usd:.cost_usd}' >> "$DAILY"
  log "$2 round $1: $(printf '%s' "$line" | jq -r '"cost=\(.cost_usd) usd, turns=\(.num_turns), denials=\(.denials), \(.duration_ms)ms, \(.subtype)" + (if .role == "worker" then ", advisor_calls=\(.advisor_calls), advisor_usd=\(.advisor_usd)" else "" end)')"
  # A call answered by a model nobody configured (a refusal fallback, #419) alerts once, now, rather than only
  # in a later status WARN; the run goes on. A Codex row's served_models is [], so it never alerts.
  local off
  off=$(printf '%s' "$line" | off_models 2> /dev/null)
  [ -n "$off" ] && [ "$off" != "[]" ] || return 0
  off=$(jq -r --argjson off "$off" "$RESULT_OBJ"' | (.modelUsage // {}) as $mu
    | $off | map("\(.) (\(($mu[.].costUSD // 0) * 100 | round / 100) usd)") | join(", ")' "$4" 2> /dev/null)
  log "off-model $2 round $1: $off"
  notify needs-you "$(ticket_name): the $2 call in round $1 was answered by a model nobody configured" \
    "$off. The run goes on unless you stop it"
}

# The daily cap says nothing about the ticket, so it has its own status, which next relaunches on a later UTC day.
assert_caps() { # before every model call; the daily cap is "the next call could exceed it"
  local spent daily hours
  spent=$(ticket_spent); daily=$(daily_spent)
  jq -en --argjson a "$spent" --argjson b "$TICKET_BUDGET_USD" '$a >= $b' > /dev/null \
    && finish stopped-cap "ticket budget: spent $spent of $TICKET_BUDGET_USD usd"
  hours=$(( ( $(date -u +%s) - $(cat "$RUN/launched") ) / 3600 ))
  [ "$hours" -lt "$MAX_HOURS" ] || finish stopped-cap "wall clock: ${hours}h of ${MAX_HOURS}h since this launch"
  jq -en --argjson a "$daily" --argjson b "$ROUND_BUDGET_USD" --argjson c "$DAILY_BUDGET_USD" '($a + $b) > $c' > /dev/null \
    && finish stopped-daily "daily budget: $daily spent today, the next call could exceed $DAILY_BUDGET_USD usd"
  return 0
}

stop_requested() { [ -f "$RUN/FACTORY_STOP" ] || [ -f "$RUNS_ROOT/FACTORY_STOP" ]; }

# owner.lock orders a launch's owner write against a reaper's recheck (a relaunch reuses the run dir);
# a lock older than 60 s was left by a killed holder and is removed first.
owner_lock() { # <run dir> <tries>
  local i
  for ((i = 1; ; i++)); do
    [ -n "$(find "$1/owner.lock" -maxdepth 0 -mmin +1 2> /dev/null)" ] && rm -rf "$1/owner.lock"
    mkdir "$1/owner.lock" 2> /dev/null && return 0
    [ "$i" -lt "$2" ] || return 1
    sleep 1
  done
}

# A run's `owner` line, printed as read when it is well formed and names a gone supervisor (owner_gone); a missing or
# malformed line is not gone. holds_slot's lease and owner paths both judge it here.
dead_owner() { # <run dir>
  local o t re='^[0-9]+ [A-Z][a-z]{2} [A-Z][a-z]{2} [ 0-9][0-9] [0-9]{2}:[0-9]{2}:[0-9]{2} [0-9]{4}$'
  o=$(cat "$1/owner" 2> /dev/null) || return 1
  t=${o%"${o##*[![:space:]]}"}   # a line written on macOS before #448 ends in lstart's padding
  [[ "$t" =~ $re ]] && owner_gone "${t%% *}" "${t#* }" && printf '%s' "$o"
}

# The owner's pid is gone, a zombie (kill -0 succeeds on one), or reused by a process that started over 300 s
# from the stored start: lstart is boot time plus ticks, so a wall-clock step moves it, and a reuse that close
# would need the pid space to wrap. A ps or date that fails or prints nothing cannot tell, so the slot holds.
# macOS pads lstart with trailing spaces and has BSD date, so the start is trimmed and parsed either way.
# A gone or zombie pid also holds while a live process has it as its process group id; Linux does not reuse that
# number meanwhile. The heartbeat loop is such a member and exits within 300 s of the supervisor, so a reap waits at
# most one beat. A model call has a session of its own, so holds_slot finds it through the run's `call` file.
owner_gone() { # <pid> <ps lstart>
  local stat= start a b
  if kill -0 "$1" 2> /dev/null; then
    stat=$(ps -o stat= -p "$1" 2> /dev/null) && [ -n "$stat" ] || return 1
  fi
  if [ -z "$stat" ] || [[ "$stat" =~ ^[[:space:]]*Z ]]; then
    ! group_live "$1"; return
  fi
  start=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$1" 2> /dev/null) && start=${start%"${start##*[![:space:]]}"} \
    && [ -n "$start" ] || return 1
  [ "$start" = "$2" ] && return 1
  a=$(lstart_epoch "$start") && b=$(lstart_epoch "$2") || return 1
  [ $((a > b ? a - b : b - a)) -gt 300 ]
}

lstart_epoch() { # <ps lstart> -> seconds since the epoch, through GNU date or else BSD date (macOS); fails unless digits
  local e
  e=$(date -u -d "$1" +%s 2> /dev/null || LC_ALL=C date -j -u -f '%a %b %d %T %Y' "$1" +%s 2> /dev/null) \
    && [[ "$e" =~ ^[0-9]+$ ]] && echo "$e"
}

group_live() { # <pgid> -> 0 when a process other than a zombie has it as its group id, or ps fails
  local g
  g=$(ps -e -o pgid=,stat= 2> /dev/null) && [ -n "$g" ] || return 0
  awk -v p="$1" '$1 == p && $2 !~ /^Z/ { f = 1 } END { exit !f }' <<< "$g"
}

# The model call a run's `call` file names (call_start) still lives: its wrapper's group, or the call's own group named
# in `call.group`, has a member that is not a zombie or, on Linux, a process carries its FACTORY_CALL_TAG. One
# predicate for holds_slot and cmd_run's relaunch refusal.
call_live() { # <run dir>
  local c g
  c=$(cat "$1/call" 2> /dev/null) || return 1
  g=$(call_group "$1")
  group_live "${c%% *}" || { [ -n "$g" ] && group_live "$g"; } || call_tagged 0 "${c#* }"
}

# The call's own process group id, the first field of the run's `call.group` (call_start), or nothing.
call_group() { # <run dir>
  local g= _
  { read -r g _ < "$1/call.group"; } 2> /dev/null
  echo "$g"
}

# The project a run dir belongs to, from where it sits, not the caller's REPO: other_live_run walks every
# target's runs. Loam's sit at RUNS_BASE/<issue>/<sha8>, another target's one level down under <owner>__<repo>;
# a dir elsewhere (a sourced test's) names none.
run_project() { # <run dir>
  local t
  t=$(dirname "$(dirname "${1%/}")")
  if [ "$t" = "${RUNS_BASE%/}" ]; then echo loam
  elif [ "$(dirname "$t")" = "${RUNS_BASE%/}" ]; then printf '%s' "${t#*__}" | tr 'A-Z' 'a-z'
  fi
}

# MAX_PARALLEL counts the other tickets already holding a slot: a run is live while its status reads running or
# waiting-limit and some process holds the flock lease on its `lease` (cmd_run; every child inherits the fd), or the
# model call named in its `call` lives (below; a child that closed the fd). Getting the lock with no such call means no
# process of the run is left: still holding it, the caller re-reads the status, writes
# stopped-environment if it still reads running or waiting-limit, and only that caller alerts; a relaunch waits on
# the same lease, so it never interleaves with the reap. A run dir with no `lease`, or a host with no flock(1) (a Mac),
# keeps the rules below (#381): a run is live while its
# status reads running or waiting-limit and its `owner` line (pid and ps start time, written by
# cmd_run) names a live process (owner_gone: 300 s start-time tolerance, a failed ps holds, a live
# member of the pid's process group holds), or while it has written `launched` and no status yet
# (#156 #167). A missing or malformed `owner` holds the slot. A launch writes `owner` and `running`
# right after `launched`, so a relaunch holds its slot from then on, and a launch killed during
# preparation is reaped like any other dead owner.
# The first caller to find the owner gone writes stopped-environment, under owner.lock and only if
# `owner` still reads the line it judged, so a relaunch that rewrote it keeps its slot; that caller
# sends the one alert. A run killed between `launched` and its owner write keeps whatever status it
# had; with no status at all it holds the slot until the operator removes its directory, or, where it has a `lease`,
# until no process holds that lease.
# In its own session a model call (call_start) outlives a SIGKILLed supervisor, reparented to init, and keeps writing
# the worktree until CALL_TIMEOUT_SEC, so a gone owner's call is killed first (orphan_call_kill), and the slot holds
# while the call still lives: its wrapper's or its own group has a member that is not a zombie or, on Linux, a process
# carries its FACTORY_CALL_TAG. On the lease path above the call holds the lease it inherited, so a gone owner's call is
# killed there too, under owner.lock, and the lease then decides.
# holds_slot may return held in the very call that killed, while the call's wrapper still reaps reparented children;
# the next caller frees the slot.
# With `peek` (cmd_next --dry-run) it only looks: a run the reap above would free reads free, and it takes no
# owner.lock, kills nothing, writes no status and sends no alert. So a gone owner's run reads held while its call lives
# (a real call kills it and may free the slot), and free while another caller holds owner.lock.
holds_slot() { # <run dir> [peek]
  local st o pid fd peek=${2-}
  if [ -f "$1/status" ]; then
    st=$(cat "$1/status")
    [ "$st" = running ] || [ "$st" = waiting-limit ] || return 1
    # Read-only, so a run dir with no lease never gets one here.
    if [ -n "$HAVE_FLOCK" ] && [ -f "$1/lease" ] && exec {fd}< "$1/lease"; then
      if ! flock -n "$fd"; then
        exec {fd}>&-
        [ -n "$peek" ] && return 0
        if o=$(dead_owner "$1") && owner_lock "$1" 1; then orphan_call_kill "$1" "$o"; rmdir "$1/owner.lock"; fi
        return 0
      fi
      # A process may close the descriptors it does not pass on (Node's child processes do), so a model call's tool
      # shell can outlive every holder; the call's group or tag still holds the slot, as on the owner path below.
      call_live "$1" && { exec {fd}>&-; return 0; }
      [ -n "$peek" ] && { exec {fd}>&-; return 1; }
      st=$(cat "$1/status" 2> /dev/null)
      [ "$st" = running ] || [ "$st" = waiting-limit ] && printf 'stopped-environment\n' > "$1/status"
      exec {fd}>&-   # before the alert, whose children would otherwise inherit this run's lease
      [ "$st" = running ] || [ "$st" = waiting-limit ] || return 1
      log "stopped-environment: ${1%/} was $st, but no process of the run holds its lease"
      alert --level fail --source factory --project "$(run_project "$1")" \
        --run "issue $(basename "$(dirname "$1")")" \
        "issue $(basename "$(dirname "$1")") stopped on a machine or tool problem: no process of the run is left \
(its supervisor and every child exited) while it read $st; ${1%/} is now stopped-environment and its slot is free" \
        >> "$LOG" 2>&1 || log "the alert for ${1%/} failed; see bin/alert's line above"
      return 1
    fi
    o=$(dead_owner "$1") || return 0
    if [ -n "$peek" ]; then call_live "$1" && return 0; return 1; fi
    pid=${o%% *}
    owner_lock "$1" 1 || return 0
    if [ "$(cat "$1/owner" 2> /dev/null)" != "$o" ]; then rmdir "$1/owner.lock"; return 0; fi
    st=$(cat "$1/status" 2> /dev/null)
    if [ "$st" != running ] && [ "$st" != waiting-limit ]; then rmdir "$1/owner.lock"; return 1; fi
    if ! orphan_call_kill "$1" "$o" || call_live "$1"; then rmdir "$1/owner.lock"; return 0; fi
    printf 'stopped-environment\n' > "$1/status"
    rm -f "$1/call" "$1/call.tmp" "$1/call.group" "$1/call.group.tmp"
    rmdir "$1/owner.lock"
    log "stopped-environment: ${1%/} was $st, but its supervisor pid $pid is gone"
    alert --level fail --source factory --project "$(run_project "$1")" \
      --run "issue $(basename "$(dirname "$1")")" \
      "issue $(basename "$(dirname "$1")") stopped on a machine or tool problem: its supervisor pid $pid exited, \
became a zombie, or its pid was reused while the run read $st; ${1%/} is now stopped-environment and its slot is free" \
      >> "$LOG" 2>&1 || log "the alert for ${1%/} failed; see bin/alert's line above"
    return 1
  else
    [ -f "$1/launched" ] || return 1
    # A launch killed between `launched` and its first status: its lease, where it has one, decides; a dir with no
    # lease holds until the operator removes it.
    [ -n "$HAVE_FLOCK" ] && [ -f "$1/lease" ] && exec {fd}< "$1/lease" || return 0
    flock -n "$fd"; st=$?
    exec {fd}>&-
    [ "$st" != 0 ]
  fi
}

# A gone supervisor's model call, in a session of its own, keeps writing the worktree until CALL_TIMEOUT_SEC; holds_slot,
# under owner.lock with `owner` unchanged, so no relaunch has started a call of its own, kills each process group named
# in `call` or `call.group` whose leader still has the start time recorded after its id (call_start writes it to
# call.group), so a pgid reused since is spared: TERM, a 2 s grace, KILL, then up to 5 s for the group to be gone.
# In production `call` holds `<wrapper pid> <tag>` and never matches; its read serves a `<pgid> <lstart>` line there,
# the layout the ticket's dead-owner-group-reaped check writes. Before KILL each group is kept only while its leader is
# gone (members remain) or still has its recorded start, so a pgid reused during the grace is spared.
# `owner` is re-read just before TERM, since an aged owner.lock can be taken over; a changed line kills nothing, return 1.
orphan_call_kill() { # <run dir> <owner line judged>
  local f g s now gs=() ss=() ks=() i
  for f in "$1/call" "$1/call.group"; do
    g= s=
    { read -r g s < "$f"; } 2> /dev/null
    [[ "$g" =~ ^[1-9][0-9]*$ ]] && [ "$g" != 1 ] && [ -n "$s" ] || continue
    s=${s%"${s##*[![:space:]]}"}
    now=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$g" 2> /dev/null) || continue
    [ "${now%"${now##*[![:space:]]}"}" = "$s" ] && gs+=("$g") && ss+=("$s")
  done
  [ "$(cat "$1/owner" 2> /dev/null)" = "$2" ] || return 1
  [ "${#gs[@]}" -gt 0 ] || return 0
  log "the supervisor of ${1%/} is gone and its model call still runs; sending TERM to process group(s) ${gs[*]}"
  orphan_signal TERM "${gs[@]}"; orphan_signal CONT "${gs[@]}"
  for ((i = 0; i < 20; i++)); do orphan_signal 0 "${gs[@]}" || return 0; sleep 0.1; done
  for ((i = 0; i < ${#gs[@]}; i++)); do
    now=$(TZ=UTC LC_ALL=C ps -o lstart= -p "${gs[i]}" 2> /dev/null)
    [ -z "$now" ] || [ "${now%"${now##*[![:space:]]}"}" = "${ss[i]}" ] && ks+=("${gs[i]}")
  done
  [ "${#ks[@]}" -gt 0 ] || return 0
  gs=("${ks[@]}")
  orphan_signal KILL "${gs[@]}"
  for ((i = 0; i < 50; i++)); do orphan_signal 0 "${gs[@]}" || return 0; sleep 0.1; done
  log "process group(s) ${gs[*]} of ${1%/} are still alive 5 s after KILL"
}
orphan_signal() { # signal, or 0 to look; pgid... -> 0 when a process in one of the groups took it
  local s="$1" g r=1; shift
  for g; do kill -"$s" -- "-$g" 2> /dev/null && r=0; done
  return "$r"
}

assert_parallel() {
  local d n=0
  for d in "$RUNS_ROOT"/*/*/; do
    [ "$(basename "$(dirname "$d")")" = "$KEY" ] && continue
    holds_slot "$d" || continue
    n=$((n + 1))
  done
  [ "$n" -lt "$MAX_PARALLEL" ] \
    || finish stopped-environment "parallel cap: $n other live run(s), MAX_PARALLEL=$MAX_PARALLEL"
}

# A Loam run still requires both exports, though bin/check stopped reading them when ruling R6 removed its
# Node gate; the gate stays until the factory tests stop expecting it. One stderr line naming the variable, return 1.
assert_toolchain_env() {
  local fix="export it in ~/.profile on the runner; see CONTRIBUTING.md"
  if [ -z "${LOAM_FACTORY_TOOLCHAIN:-}" ] || [ ! -x "$LOAM_FACTORY_TOOLCHAIN/bin/node" ]; then
    echo "LOAM_FACTORY_TOOLCHAIN is unset or has no node binary under it: $fix" >&2
    return 1
  fi
  if [ -z "${LOAM_FACTORY_COPIER:-}" ] || [ ! -x "$LOAM_FACTORY_COPIER" ]; then
    echo "LOAM_FACTORY_COPIER is unset or not executable: $fix" >&2
    return 1
  fi
}

# The launch gate for the target: Loam needs the toolchain exports above; another target needs its
# own executable bin/check, which every done-checks block guards, and a standing do-not-touch list with at least
# one entry, so an unattended worker never runs with nothing fenced off (F8). One stderr line, return 1.
assert_target_ready() {
  local how="a factory target needs one (LOOP.md, Run the factory on another repository)"
  if target_is_loam; then assert_toolchain_env; return; fi
  [ -x "$TARGET/bin/check" ] || { echo "$TARGET has no executable bin/check; $how" >&2; return 1; }
  [ -n "$(standing_list)" ] && return 0
  echo "$(standing_file) is missing or has no tracked path under '## Standing do-not-touch list'; $how" >&2
  return 1
}

# The result subtypes that mean the worker stopped on a cap this supervisor gave its call: --max-budget-usd
# (ROUND_BUDGET_USD) and --max-turns (MAX_TURNS). The CLI reports them with is_error true, but the round
# ran and may have committed, so it is a finished round and Step 6 decides (LOOP.md, Exits). Every other
# is_error subtype is the environment; the list names caps, never failure names.
CAPPED_SUBTYPES=" error_max_budget_usd error_max_turns "

# result.json -> completed | environment | no-result. A missing file, or no result event (killed by
# CALL_TIMEOUT_SEC, or crashed), is no-result; is_error true outside CAPPED_SUBTYPES is environment.
classify_result() { # result.json
  local st err
  [ -s "$1" ] || { echo no-result; return 0; }
  st=$(jq -r "$RESULT_OBJ | .subtype // \"no-result\"" "$1" 2> /dev/null) || st=no-result
  err=$(jq -r "$RESULT_OBJ | .is_error // false" "$1" 2> /dev/null) || err=true
  if [ "$st" = no-result ]; then echo no-result
  elif [ "$err" != true ]; then echo completed
  else case "$CAPPED_SUBTYPES" in *" $st "*) echo completed ;; *) echo environment ;; esac
  fi
}

# no-result and environment stop the run; a capped round returns so the caller keeps its artifacts. A killed
# call may have committed (#319): with the round's start sha the stop message lists the commits since it, or
# says "no commits", and names the charge the result object carries.
assert_call_ok() { # role result.json [round-start-sha]
  local e c l
  case "$(classify_result "$2")" in
    completed)
      e=$(jq -r "$RESULT_OBJ | if .is_error == true then \"\\(.subtype) after \\(.num_turns // 0) turns\" else empty end" "$2" 2> /dev/null) || e=""
      [ -z "$e" ] || log "$1 round $ROUND: hit its own cap ($e); a finished round, the checks decide"
      return 0 ;;
    no-result)
      e="no result event (killed by CALL_TIMEOUT_SEC=$CALL_TIMEOUT_SEC, or crashed)"
      c=$(jq -r "$RESULT_OBJ | .total_cost_usd // empty" "$2" 2> /dev/null) || c=""
      [ -z "$c" ] || e="$e; charged $c usd, the call's ROUND_BUDGET_USD ceiling"
      if [ -n "${3:-}" ]; then
        l=$(git -C "$WORKTREE" log --oneline "$3..HEAD" 2> /dev/null | paste -sd ';' - | sed 's/;/; /g')
        e="$e; commits since the round began: ${l:-no commits}"
      fi
      finish stopped-environment "the $1 call ended with $e" ;;
    *) e=$(jq -r "$RESULT_OBJ | .result // \"unknown error\"" "$2" 2> /dev/null) || e="unknown error" ;;
  esac
  finish stopped-environment "the $1 call failed before doing work: $e"
}

# Usage limits are per account, so on a limit reply switch to the other stored account and retry at once,
# rather than idling this run while the other account sits unused. bin/claude-account owns the token files
# and the settings env channel; one switch per limit event, then a five-minute cooldown sends any further
# limit down the sleep path (both accounts are limited when a second reply lands within seconds). No token
# value ever reaches the log or the ledger: the switcher prints names only and the ledger line names only.
limit_switch() { # -> 0 after switching accounts, 1 when there is no other account or a switch is on cooldown
  local to from last
  to=$("$ROOT/bin/claude-account" other 2> /dev/null) || return 1
  if [ -f "$RUN/limit-switch" ]; then
    last=$(cat "$RUN/limit-switch" 2> /dev/null) || last=""
    [ -n "$last" ] && [ "$(( $(date +%s) - last ))" -lt 300 ] && return 1
  fi
  from=$("$ROOT/bin/claude-account" status 2> /dev/null | sed -n 's/^active: \([^;]*\);.*/\1/p')
  "$ROOT/bin/claude-account" use "$to" > /dev/null 2>&1 || return 1
  date +%s > "$RUN/limit-switch"
  log "usage limit: switched account ${from:-none} -> $to; retrying the call"
  printf '{"ts":"%s","event":"limit-switch","from":"%s","to":"%s"}\n' "$(now)" "${from:-none}" "$to" >> "$LEDGER"
  return 0
}

# A usage-limit reply names its reset ("You've hit your session limit - resets 1:30pm (America/Los_Angeles)").
# Waiting for it is loop behavior, not a round: switch accounts and retry at once, or sleep to the reset, or
# 20 minutes, then repeat the same call.
limit_wait() { # result.json -> 0 after waiting, 1 when the reply is not a usage limit
  local e t b tz at left secs=1200
  e=$(jq -r "$RESULT_OBJ | if .is_error == true then (.result // \"\") else empty end" "$1" 2> /dev/null) || e=""
  grep -qiE '(hit|reached) your .*limit' <<< "$e" || return 1
  limit_switch && return 0
  t=$(grep -oiE 'resets? [0-9]{1,2}(:[0-9]{2})? ?[ap]m' <<< "$e" | head -1 | sed -E 's/^[Rr]esets? //')
  tz=$(grep -oE '\([A-Za-z_]+/[A-Za-z_]+\)' <<< "$e" | head -1 | tr -d '()')
  b=${t// /}; b=${b%??}; [[ "$b" == *:* ]] || b=$b:00   # BSD date (macOS) has no -d; it reads "1:30:00pm"
  if [ -n "$t" ] && at=$(TZ="${tz:-UTC}" date -d "$t" +%s 2> /dev/null \
      || TZ="${tz:-UTC}" LC_ALL=C date -j -f '%I:%M:%S%p' "$b:00${t: -2}" +%s 2> /dev/null); then
    [ "$at" -gt "$(date +%s)" ] || at=$((at + 86400))
    secs=$((at - $(date +%s) + 60))
  fi
  left=$(( MAX_HOURS * 3600 - ( $(date +%s) - $(cat "$RUN/launched") ) ))
  [ "$secs" -le "$left" ] || finish stopped-environment "usage limit: $e; the reset is ${secs}s away, past MAX_HOURS=$MAX_HOURS"
  log "usage limit, not a round: $e; waiting ${secs}s"
  set_status waiting-limit
  sleep "$secs"
  return 0
}

# ---- step 4: round 0 --------------------------------------------------------
# Every non-guard check must fail on base; one that passes there cannot prove the ticket.

# Run the frozen checks from dir into out. A block that aborts or exits early is never green (#180, #277): output
# whose last line is not checks.sh's CHECKS-END line adds FAIL checks-aborted, whatever the exit code and the
# other FAIL lines say. A resumed run re-execs the frozen factory that froze its checks.sh, so the two always
# match. The added line starts a fresh line as lib.sh's results do, so output with no trailing newline cannot
# hide it from the ^FAIL reads. Check names are not read from the block, because a check can quote a ticket
# body or a script whose pass and fail words are not top-level checks.
run_checks() { # dir out
  local rc
  ( cd "$1" && "$RUN/frozen/checks.sh" ) > "$2" 2>&1
  rc=$?
  [ "$(tail -n 1 "$2")" = CHECKS-END ] && return 0
  log "checks.sh exited $rc before its end line"
  printf '\nFAIL checks-aborted: checks.sh exited %s before its end line\n' "$rc" >> "$2"
}

round_zero() {
  # The block writes round-0.out; only a clean verdict renames it to round-0.checks, the file cmd_run
  # resumes on, so a relaunch after a defect, or after a kill mid-block, runs round 0 again.
  local out="$RUN/round-0.out" why="" guards line name cmd rc base wt msg
  base=$(cat "$RUN/base.sha"); wt="${WORKTREE}-base"
  # A line continuation would split one line across the readers (dc_continued); lint rejects it, and a run never linted
  # (bin/factory run) stops here, before any of the block runs.
  [ -z "$(dc_continued)" ] || finish ticket-defect "a done-checks line ends in a backslash; the block takes no line continuations"
  # Round 0 belongs to base only: run the frozen checks at base.sha in a detached temporary
  # worktree, never in the ticket worktree, which a relaunch may leave ahead of base with the
  # checks already passing. Remove and prune clear a leftover from a killed round 0 before the
  # add; a bare directory git does not track is reported, not deleted. Remove the worktree
  # before the scan so it is gone on both the defect and the clean path.
  git -C "$MAIN_CHECKOUT" worktree remove --force "$wt" > /dev/null 2>&1
  git -C "$MAIN_CHECKOUT" worktree prune > /dev/null 2>&1
  if ! git -C "$MAIN_CHECKOUT" worktree add --detach "$wt" "$base" > /dev/null 2>&1; then
    msg="could not add the round-0 worktree $wt at $(cut -c1-8 "$RUN/base.sha")"
    [ -e "$wt" ] && msg="$msg; the path exists but is not a registered worktree, delete it by hand"
    finish stopped-environment "$msg"
  fi
  # Each predict line's text after NAME runs whole, as one bash command after lib.sh, on the clean base before the
  # checks run, so bash parses it as written; checks.sh leaves it out (dc_script), so no later round runs it. Its
  # output is dropped, so it cannot print a PASS line. The first miss, a non-zero exit or no text, ends the loop.
  while IFS= read -r line; do
    predict_split "$line"
    if [ -z "$cmd" ] || [[ "$cmd" == \#* ]]; then
      why="has no command"
    else
      ( cd "$wt" && bash -c "$(printf '. %q\n%s\n' "$RUN/frozen/lib.sh" "$cmd")" ) < /dev/null > /dev/null 2>&1
      rc=$?
      [ "$rc" -eq 0 ] || why="exits $rc"
    fi
    [ -n "$why" ] && break
  done < <(dc_predicts)
  run_checks "$wt" "$out"
  git -C "$MAIN_CHECKOUT" worktree remove --force "$wt" > /dev/null 2>&1
  grep -q '^FAIL checks-aborted' "$out" \
    && finish ticket-defect "checks.sh aborted on $(cut -c1-8 "$RUN/base.sha") before the block ended; see $out"
  # A predict line whose command exits non-zero, or that has none: the check fails on base, but not for the reason
  # its author predicted.
  [ -z "$why" ] || finish ticket-defect "the predict line for check $name $why on $(cut -c1-8 "$RUN/base.sha"), so base does not show the predicted failure"
  guards=$(guard_checks | pass_names)
  while read -r _ name _; do
    grep -qxF "$name" <<<"$guards" && continue
    finish ticket-defect "check $name passes on $(cut -c1-8 "$RUN/base.sha"), so it cannot prove the ticket; see $out"
  done < <(grep '^PASS ' "$out")
  mv "$out" "$RUN/round-0.checks"
  log "round 0 at $(cut -c1-8 "$RUN/base.sha"): every non-guard check fails on base, and every predict line holds"
}

# ---- steps 5 and 6: the worker round ----------------------------------------

# A large claude ticket runs round 1 as the fan-out workflow (F12); this is the one test of the three
# values (worker kind, size, round) that gate it. A Codex worker never fans out (it has no Workflow tool).
runs_workflow() { [ "$WORKER_KIND" = claude ] && [ "${WORKER_SIZE:-small}" = large ] && [ "$1" -eq 1 ]; }

# workflow_agents and workflow_usd for a worker round's ledger line. Only a claude worker's round 1 runs
# the fan-out; every other round and every Codex round is 0 0. workflow_agents is the Workflow tool_use
# blocks in the round's stream (the worker's own calls) plus one per builder artifact the integrator left
# under tasks/ when it wrote tasks/result.json - a lower bound, since a builder that wrote no artifact is
# counted unmet, not here (the planner and integrator are the Workflow's own subagents, absent from this
# round's subagent_stats). workflow_usd is the round's total cost only when result.json exists, else 0:
# the F4 run planned solo, wrote no result.json, and spent nothing on fan-out.
workflow_ledger() { # round stream.jsonl result.json -> "<agents> <usd>" on stdout
  local round="$1" stream="$2" resj="$3" agents=0 usd=0
  if runs_workflow "$round"; then
    agents=$(jq -s '[.[] | select(.type == "assistant") | .message.content[]?
      | select(.type == "tool_use" and .name == "Workflow")] | length' "$stream" 2> /dev/null)
    [ -n "$agents" ] || agents=0
    if [ -f "$RUN/tasks/result.json" ]; then
      agents=$(( agents + $(find "$RUN/tasks" -maxdepth 1 -name '[0-9]*.md' 2> /dev/null | wc -l) ))
      usd=$(jq -r "$RESULT_OBJ | .total_cost_usd // 0" "$resj" 2> /dev/null)
      [ -n "$usd" ] || usd=0
    fi
  fi
  printf '%s %s\n' "$agents" "$usd"
}

# NAV-01 (docs/research/memory-design-v2-2026-09-21.md): the arm-C worker prompt gets the Semble
# search instruction appended; base and arm B append nothing. Reads the immutable source through
# $ROOT, so no freeze copy is needed and nobody hand-edits the frozen _common.md between launches.
nav_c_append() { [ "${FACTORY_NAV_ARM:-}" = C ] && cat "$ROOT/bin/factory.d/_nav_c.md" >> "$1"; return 0; }

# NAV-01: the arm of a launch. An environment FACTORY_NAV_ARM (even empty) wins and nothing is popped;
# otherwise the first line of $RUNS_ROOT/nav-order becomes the arm and is removed, so the timer launches
# the pre-registered order. No file, an empty file, or a blank first line means base. Runs once per
# launch: exec_frozen re-execs with the exported value, which stops a second pop.
nav_arm_resolve() { [ -n "${FACTORY_NAV_ARM+x}" ] && return 0; local f="$RUNS_ROOT/nav-order" a; [ -s "$f" ] || return 0; a=$(head -n 1 "$f"); [ -n "$a" ] || return 0; export FACTORY_NAV_ARM="$a"; tail -n +2 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; return 0; }

build_worker_prompt() { # round -> prompt path (pending until the call returns a result); non-zero when a skills: name resolves to no SKILL.md
  local round="$1" pf="$RUN/pending.prompt.md" prev=$((round - 1)) s sf ad=
  { printf '%s\n\n' "$BODY"; cat "$RUN/frozen/_common.md"; } > "$pf"
  nav_c_append "$pf"   # arm C appends the Semble instruction; base and arm B append nothing (NAV-01)
  # Skills per role (LOOP.md), each `skills:` name resolved by skill_file: a Claude worker gets one
  # sentence naming the SKILL.md path to read, since every pstack skill refuses the Skill tool
  # (disable-model-invocation, docs/PSTACK.md) and a slash command would swallow the body (#37/#40, #385);
  # a Codex worker swallows an unknown `/<skill>` line (#41), so it gets each named skill's body pasted.
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    if ! sf=$(skill_file "$s"); then
      # Lint guaranteed the name resolved, so no resolution now is an install gap, not a typo; a prompt
      # naming a skill the worker cannot read would be worse than stopping.
      # build_worker_prompt runs in $(...), so return non-zero; worker_round turns it into finish.
      log "skill \"$s\" resolves to no SKILL.md; the worker cannot be given it"
      return 3
    fi
    if [ "$WORKER_KIND" = codex ]; then
      printf '\n## Skill: %s\n\n%s\n' "$s" "$(cat "$sf")" >> "$pf"
    else
      # pstack skills use Cursor tool names, which pstack's Claude Code adapter maps; read it once first.
      if [ -z "$ad" ] && [[ "$s" == pstack:* ]] && [ -f "${sf%/skills/*}/docs/harness/claude-code.md" ]; then
        ad="${sf%/skills/*}/docs/harness/claude-code.md"
        printf 'Before the first pstack skill, read %s, which maps its tool names to Claude Code.\n' "$ad" >> "$pf"
      fi
      printf 'Before the first edit, read %s and follow its steps.\n' "$sf" >> "$pf"
    fi
  done < <(worker_skills)
  # A large claude ticket runs round 1 as the fan-out workflow; a Codex worker gets the ordinary round-1
  # prompt (runs_workflow is false for it). The F11 advisor is the second check on the split (F12).
  if runs_workflow "$round"; then
    {
      printf '\n\n## Large ticket, round 1: run the fan-out workflow\n\n'
      printf 'Run the Workflow tool with scriptPath `%s/frozen/factory-round.js` and args `{"ticket": "%s/frozen/issue.md", "run": "%s"}`. ' "$RUN" "$RUN" "$RUN"
      printf 'When it returns, read %s/tasks/result.json. If that file is absent, implement the ticket yourself as in any round. ' "$RUN"
      printf 'Otherwise the integrator has committed; copy its `unmet` and `abandoned` lists into %s.\n' "$DECISIONS"
      printf 'Then read the integrated diff and write its one-paragraph account of how the change works and why it is correct to %s/mechanism.md, as the instructions above ask.\n' "${DECISIONS%/*}"
    } >> "$pf"
  fi
  if [ "$round" -gt 1 ]; then
    {
      printf '\n\n## Previous round (%d)\n\n' "$prev"
      [ -f "$RUN/round-$prev.checks" ] && { printf 'Check lines that failed:\n\n```\n'
        grep '^FAIL' "$RUN/round-$prev.checks"; printf '```\n\n'; }
      [ -s "$RUN/round-$prev.fixes" ] && { printf 'Blocking findings, verbatim:\n\n'; cat "$RUN/round-$prev.fixes"; printf '\n'; }
    } >> "$pf"
  fi
  printf '%s\n' "$pf"
}

# Codex --json stream (round-<k>.jsonl) plus the exit code -> a result-shaped JSON on stdout that
# record and assert_call_ok read unchanged. The last `turn.completed` carries `usage`, passed through
# verbatim so the five token counters are not hardcoded (#41). No `turn.completed`, or a non-zero exit,
# is the environment, not a round (LOOP.md, Exits): subtype no-result / is_error true stops it.
codex_result() { # jsonl exit_code [duration_ms] -> result JSON on stdout; duration_ms is the caller's wall clock ($SECONDS), no sample shows a per-turn field (#41)
  jq -s --argjson rc "${2:-0}" --argjson dur "${3:-0}" '
    [.[] | select(.type == "turn.completed")] as $turns
    | [.[] | select(.type == "turn.failed" or .type == "error")] as $errs
    | {
        subtype: (if ($turns | length) > 0 then "success" else "no-result" end),
        is_error: ($rc != 0 or ($errs | length) > 0),
        num_turns: ($turns | length),
        duration_ms: $dur,
        total_cost_usd: null,
        usage: ($turns[-1].usage // null),
        result: ((($errs[-1].message // $errs[-1].error) // (if $rc != 0 then "codex worker call exited " + ($rc | tostring) else "" end)) // "")
      }' "$1" 2> /dev/null \
    || printf '{"subtype":"no-result","is_error":true,"num_turns":0,"duration_ms":0,"total_cost_usd":null,"usage":null,"result":"codex result parse failed"}\n'
}

# A model call (the worker, a grader, the Codex review) runs under a wrapper, a perl process (a Mac has no setsid(1))
# that starts a session of its own, so its process group, whose id is the wrapper's pid, CALL_PID, reaches none of the
# supervisor's processes. The wrapper forks the call into a child group (GNU timeout makes its own group anyway, and
# at CALL_TIMEOUT_SEC signals it, KILL 5 s after TERM). On Linux the wrapper is a child subreaper (prctl PR_SET_CHILD_SUBREAPER, 36, by syscall number: 157 on x86_64, 167 on aarch64), so the
# kernel makes it the parent of every process the call orphans, whatever its session or environment: Claude Code
# starts each Bash tool shell in a new session, and a tool child can clear its environment and call setsid too
# (#434). When the call exits, or the wrapper gets TERM, INT or HUP, it sends the call's group and every child it has
# TERM, then KILL after a 5 s grace, collects each, and exits with the call's own status once none is left, or 5 s
# after KILL with one still alive; it writes what it signalled to call.reap for call_end. The call's first process writes
# its group id and ps start time to call.group before it execs the command, so holds_slot can kill the group of a call
# whose supervisor is gone and spare a reused pgid. The wrapper's group, the call's group from call.group, and the call's
# FACTORY_CALL_TAG, unique to the call and kept by every process it starts but one that clears its environment, stay
# what call_signal ends and call_live reads (#384), so a wrapper killed or stuck leaves no group member behind: on
# Linux they are a second line behind the wrapper; on a host with no subreaper or /proc (a Mac) the group kills are all. The call keeps the caller's
# stdin (<&0, since a background command would get /dev/null), stdout and stderr. In its own session the call no
# longer gets the supervisor's Ctrl-C, TERM or HUP, so until call_end the supervisor traps them and ends the call's
# processes before it exits and its EXIT trap removes the worktree.
call_start() { # dir cmd... -> CALL_PID, CALL_TAG
  local dir="$1"; shift
  CALL_TAG="$$.$SECONDS.$RANDOM"; CALL_PID=; CALL_STUCK=
  rm -f "$RUN/call.reap" "$RUN/call.group" "$RUN/call.group.tmp"
  trap 'call_abort INT 130' INT; trap 'call_abort TERM 143' TERM; trap 'call_abort HUP 129' HUP
  ( cd "$dir" && export FACTORY_CALL_TAG="$CALL_TAG" && exec perl -MPOSIX -MTime::HiRes=time,sleep -e '
      POSIX::setsid() == $$ or die "setsid: $!\n";
      if ($^O eq "linux") {
        $nr = {x86_64 => 157, aarch64 => 167}->{(POSIX::uname())[4]} or die "no prctl number for this CPU\n";
        syscall($nr, 36, 1, 0, 0, 0) == 0 or die "prctl PR_SET_CHILD_SUBREAPER: $!\n" }
      ($rep, $grp) = splice @ARGV, 0, 2; defined($kid = fork) or die "fork: $!\n";
      unless ($kid) { setpgid(0, 0);
        ($s = `TZ=UTC LC_ALL=C ps -o lstart= -p $$ 2> /dev/null`) =~ s/\s+\z//;
        if (open my $h, ">", "$grp.tmp") { print $h join(" ", $$, $s || ()), "\n"; close $h; rename "$grp.tmp", $grp }
        exec { $ARGV[0] } @ARGV; print STDERR "exec $ARGV[0]: $!\n"; POSIX::_exit(127) }
      setpgid($kid, $kid);
      $SIG{$_} = sub { $sig = 1 } for qw(TERM INT HUP);
      sub kids { $^O eq "linux" or return; my @k;
        for (glob "/proc/[0-9]*/stat") { open(my $h, "<", $_) or next; local $/; my $s = <$h>; my ($pid) = m{(\d+)/stat$};
          push @k, $pid if defined $s && substr($s, rindex($s, ")") + 2) =~ /^\S+ (\d+)/ && $1 == $$ }
        @k }
      for (;;) {
        while (($p = waitpid(-1, WNOHANG)) > 0) { $st = $? if $p == $kid }
        if (defined $st || $sig) {
          $end //= time + 5;
          @p = grep { kill 0, $_ } -$kid, kids();
          last unless @p;
          if (time < $end) {
            @n = grep { !$seen{$_}++ } @p;
            if (@n) { kill "TERM", @n; kill "CONT", @n; push @{$r{TERM}}, @n } }
          elsif (time < $end + 5) { kill "KILL", @p; $r{KILL} ||= [@p] }
          else { $r{STUCK} = [@p]; last } }
        sleep 0.1 }
      if (%r && open my $h, ">", $rep) { print $h "$_ @{$r{$_}}\n" for grep { $r{$_} } qw(TERM KILL STUCK) }
      exit(!defined $st ? 137 : $st & 127 ? 128 + ($st & 127) : $st >> 8)' "$RUN/call.reap" "$RUN/call.group" "$@" ) <&0 &
  CALL_PID=$!
  printf '%s %s\n' "$CALL_PID" "$CALL_TAG" > "$RUN/call.tmp" && mv -f "$RUN/call.tmp" "$RUN/call" \
    || log "could not write $RUN/call; a SIGKILL now would free the slot while the call runs"
}
# However the call ends, by exit or by its limit, whatever it left behind, reparented to the wrapper, in its group or
# carrying its tag, gets TERM, then KILL after a 5 s grace, and must be gone 5 s later, or the run stops: a child left
# writing the tree would race the checks and the graders (LOOP.md, Exits). The wrapper ends its children first and
# call_end logs what it signalled; then call_reap ends whatever is left in the wrapper's or the call's group or carries
# its tag. The leader is reaped first, since a zombie leader keeps its group alive. A survivor sets CALL_STUCK, and the
# caller stops the run once its ledger row for the call is written.
call_end() { # role -> the call's own exit status
  local rc=0 s p
  wait "$CALL_PID" || rc=$?
  [ -f "$RUN/call.reap" ] && while read -r s p; do
    case $s in
      TERM) log "the $1 call left processes behind ($p, reparented to its wrapper or in its group); sending TERM" ;;
      KILL) log "the $1 call's processes outlived TERM by 5 s; sending KILL to $p" ;;
      STUCK) CALL_STUCK="the $1 call's processes ($p) are still alive 5 s after KILL"; log "$CALL_STUCK" ;;
    esac
  done < "$RUN/call.reap"
  rm -f "$RUN/call.reap"
  call_reap "$1" && [ -z "$CALL_STUCK" ] && rm -f "$RUN/call" "$RUN/call.tmp" "$RUN/call.group" "$RUN/call.group.tmp"
  trap - INT TERM HUP
  return "$rc"
}
call_reap() { # role
  call_gone 0 && return
  log "the $1 call left processes behind (groups $CALL_PID $(call_group "$RUN") or tag $CALL_TAG); sending TERM"
  call_signal TERM; call_signal CONT
  call_gone 50 && return
  log "the $1 call's processes outlived TERM by 5 s; sending KILL"
  call_signal KILL
  call_gone 50 && return
  CALL_STUCK="the $1 call's processes (groups $CALL_PID $(call_group "$RUN") or tag $CALL_TAG) are still alive 5 s after KILL"
  log "$CALL_STUCK"
  return 1
}
# The supervisor got a signal mid-call: it sends the call TERM, which starts the wrapper's own TERM and KILL 5 s later,
# sends KILL itself 10 s later if the wrapper is still up (sooner could kill the wrapper during its grace and leave its
# children to init), reaps the wrapper, ends what is left as call_end would, then exits as the signal would have. A
# second Ctrl-C is ignored until then, since it would kill the supervisor and let the EXIT trap remove the worktree
# under a child not yet killed.
call_abort() { # signal status
  local killer
  trap '' INT TERM HUP
  log "the supervisor got $1 during a model call; ending the call's processes"
  call_signal TERM; call_signal CONT
  ( sleep 10; call_signal KILL ) & killer=$!
  wait "$CALL_PID" 2> /dev/null
  kill -KILL "$killer" 2> /dev/null   # it inherits the ignored TERM
  call_gone 50 || { call_signal KILL; call_gone 50; } && rm -f "$RUN/call" "$RUN/call.tmp" "$RUN/call.group" "$RUN/call.group.tmp"
  exit "$2"
}
call_signal() { call_grouped "$1"; call_tagged "$1"; }
# The wrapper's group and, once the wrapper has written call.group, the call's own (call_start).
call_grouped() { # signal, or 0 to look -> 0 when a process in either group took it
  local g r=1
  for g in "$CALL_PID" $(call_group "$RUN"); do kill -"$1" -- "-$g" 2> /dev/null && r=0; done
  return "$r"
}
# Linux only: a host with no /proc (a Mac) finds no tagged process, and the group kill alone stands. A zombie's
# environ reads empty, so a zombie never counts.
call_tagged() { # signal, or 0 to look; [tag] -> 0 when a process carries FACTORY_CALL_TAG=tag (CALL_TAG by default)
  perl -e '($t, $s) = @ARGV; $n = 0;
    for $f (glob "/proc/[0-9]*/environ") {
      open($h, "<", $f) or next; local $/; $e = <$h>; close $h;
      next unless defined $e && grep { $_ eq $t } split /\0/, $e;
      ($p) = $f =~ m{^/proc/(\d+)/}; kill($s, $p); $n++ }
    exit($n ? 0 : 1)' "FACTORY_CALL_TAG=${2-$CALL_TAG}" "$1"
}
call_gone() { # tenths of a second to wait -> 0 once nothing is left in the call's groups or carries CALL_TAG
  local i=0
  while call_grouped 0 || call_tagged 0; do
    [ "$i" -lt "$1" ] || return 1
    sleep 0.1; i=$((i + 1))
  done
}

worker_round() { # round; leaves round-N.* only once the call produced a result
  local round="$1" pf out="$RUN/pending.jsonl" res="$RUN/pending.result.json" t=() login_retried=0 le head0 tok tok0 tok_set
  command -v timeout > /dev/null 2>&1 && t=(timeout -k 5 "$CALL_TIMEOUT_SEC")
  # The round's start, so a stop after a killed call can name the commits the call made (#319).
  head0=$(git -C "$WORKTREE" rev-parse HEAD 2> /dev/null) || head0=""
  # The first round this process runs; a login expired at launch retries only its call. A global,
  # not a local, so it survives the loop's later rounds.
  [ -n "${FIRST_WORKER_ROUND+x}" ] || FIRST_WORKER_ROUND="$round"
  # A retried round 1 must not inherit a builder artifact or result.json from an earlier attempt, which
  # workflow_ledger would count and the worker would read as an integrated round. The supervisor empties
  # tasks/ itself and keeps the directory: the integrator writes result.json under it and never recreates
  # it, and the worker cannot (rm -rf is denied by worker-settings.json). Codex review of #74.
  if runs_workflow "$round"; then
    find "$RUN/tasks" -mindepth 1 -delete 2> /dev/null || finish stopped-environment "could not empty $RUN/tasks before the fan-out round"
  fi
  pf=$(build_worker_prompt "$round") || finish ticket-defect "a skill this ticket names resolves to no SKILL.md under ~/.claude/skills or the plugin cache; see the log"
  if [ "$WORKER_KIND" = codex ]; then
    # The Codex worker: JSONL stream is stdout, -o is the last message, < /dev/null keeps Codex off the
    # caller's stdin (#41). No dollar budget bounds it (cost_usd null); CALL_TIMEOUT_SEC and MAX_HOURS do.
    local rc start wl wagents wusd swapped=0 codex_target cgd ccd add_dirs
    log "codex worker call: round $round model=$CODEX_MODEL (dollar caps do not bound it), prompt=$(wc -c < "$pf") bytes"
    # Each worker call writes its own mechanism.md, so an earlier call's account of a diff that has since moved
    # never opens the PR; a call that writes none gets open_pr's fallback line (#330).
    rm -f "$out" "${DECISIONS%/*}/mechanism.md"
    # Codex's workspace-write sandbox mounts the workspace .codex read-only, and bubblewrap refuses the
    # root .codex because it is a symlink into seed/ (D12, #77). Swap it for a real copy of its target for
    # the call; it is restored before grading below. The worktree's commit also needs four git roots
    # writable: the worktree gitdir, plus objects/refs/logs under the common dir (probe C2). The worker's
    # own directory outside the worktree holds decisions.md and mechanism.md, which it must write (#330).
    if [ -L "$WORKTREE/.codex" ]; then
      { codex_target=$(readlink -f "$WORKTREE/.codex") && rm "$WORKTREE/.codex" && cp -R "$codex_target" "$WORKTREE/.codex"; } \
        || finish stopped-environment "could not swap the .codex symlink for a real directory before the Codex round"
      swapped=1
      log "codex worker call: swapped the .codex symlink for a real copy of $codex_target for the workspace-write sandbox"
    fi
    cgd=$(git -C "$WORKTREE" rev-parse --absolute-git-dir)
    ccd=$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir)
    add_dirs=(--add-dir "$cgd" --add-dir "$ccd/objects" --add-dir "$ccd/refs" --add-dir "$ccd/logs" --add-dir "${DECISIONS%/*}")
    start=$SECONDS
    call_start "$WORKTREE" ${t[@]+"${t[@]}"} env PATH="$CODEX_PATH:$PATH" codex exec --json -s workspace-write "${add_dirs[@]}" "$(cat "$pf")" -o "$RUN/round-$round.last.txt" > "$out" < /dev/null
    call_end worker; rc=$?
    [ "$rc" -eq 0 ] || log "codex worker call exited $rc (the result decides)"
    # Restore the tracked .codex before codex_result so the clean-tree check and the graders see the
    # symlink, whatever the call's exit code (D12, #77). If the round committed the ` D .codex` deletion,
    # .codex has left the index, so there is nothing to check out and do_not_touch_hits counts the
    # committed change as a hit. A restore that fails is the environment, not a round.
    if [ "$swapped" -eq 1 ]; then
      rm -rf "$WORKTREE/.codex" || finish stopped-environment "could not remove the .codex copy after the Codex round"
      if git -C "$WORKTREE" ls-files --error-unmatch .codex > /dev/null 2>&1; then
        git -C "$WORKTREE" checkout -- .codex \
          || finish stopped-environment "could not restore the .codex symlink after the Codex round"
        log "codex worker call: restored the .codex symlink before grading"
      else
        log "codex worker call: the round removed the tracked .codex; do_not_touch_hits counts it as a hit"
      fi
    fi
    codex_result "$out" "$rc" "$(( (SECONDS - start) * 1000 ))" > "$res"
    wl=$(workflow_ledger "$round" "$out" "$res"); wagents=${wl% *}; wusd=${wl#* }
    record "$round" worker "$CODEX_MODEL" "$res" 0 0 "$wagents" "$wusd" 1
    [ -z "$CALL_STUCK" ] || finish stopped-environment "$CALL_STUCK"
    assert_call_ok worker "$res" "$head0"
    mv "$pf" "$RUN/round-$round.prompt.md"
    mv "$out" "$RUN/round-$round.jsonl"
    mv "$res" "$RUN/round-$round.result.json"
    return 0
  fi
  while :; do
    log "worker call: round $round model=$WORKER_MODEL effort=$WORKER_EFFORT advisor=${WORKER_ADVISOR:-off} budget=$ROUND_BUDGET_USD usd, prompt=$(wc -c < "$pf") bytes"
    rm -f "$out" "${DECISIONS%/*}/mechanism.md"   # also on a retried call, as for the Codex call above (#330)
    # The call loads no settings tier, so the account token bin/claude-account last wrote is read here, after any
    # switch, and passed in this call's environment only, never on a command line (freeze). The supervisor keeps its
    # launch value, which a call gets when the read is empty or fails, so a token the file has lost is never reused.
    tok=$(jq -r '.env.CLAUDE_CODE_OAUTH_TOKEN // empty' "${CLAUDE_SETTINGS_FILE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json}" 2> /dev/null)
    tok_set=${CLAUDE_CODE_OAUTH_TOKEN+1}; tok0=${CLAUDE_CODE_OAUTH_TOKEN-}
    [ -z "$tok" ] || { printf -v CLAUDE_CODE_OAUTH_TOKEN '%s' "$tok" && export CLAUDE_CODE_OAUTH_TOKEN; }
    call_start "$WORKTREE" ${t[@]+"${t[@]}"} env LOAM_CHECKS="$RUN/frozen/checks.sh" \
        CLAUDE_CODE_SUBAGENT_MODEL="$WORKER_MODEL" CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1 \
        ANTHROPIC_DEFAULT_SONNET_MODEL="$WORKER_MODEL" ANTHROPIC_DEFAULT_HAIKU_MODEL="$WORKER_MODEL" claude -p \
        --model "$WORKER_MODEL" --effort "$WORKER_EFFORT" ${WORKER_ADVISOR:+--advisor "$WORKER_ADVISOR"} --permission-mode bypassPermissions --strict-mcp-config \
        --setting-sources '' --settings "$RUN/frozen/worker-settings.json" --max-turns "$MAX_TURNS" \
        --append-system-prompt "$(cat "$RUN/frozen/unattended.md")" \
        --max-budget-usd "$ROUND_BUDGET_USD" --output-format stream-json --verbose --include-hook-events \
        < "$pf" > "$out" 2>> "$LOG"
    # The call has forked with the token; the supervisor gets its launch value back, or none.
    if [ -n "$tok_set" ]; then printf -v CLAUDE_CODE_OAUTH_TOKEN '%s' "$tok0"; else unset CLAUDE_CODE_OAUTH_TOKEN; fi
    call_end worker || log "worker exited non-zero (the result event decides)"
    jq -c 'select(.type == "result")' "$out" 2> /dev/null | tail -1 > "$res"
    # No result event (killed by CALL_TIMEOUT_SEC, or crashed) leaves no cost to read, yet the call may have
    # spent up to its --max-budget-usd ceiling. Charge that ceiling here, so record, ticket_spent, daily_spent
    # and cmd_status book one number and the ticket and daily caps stay bounds (#319). The ledger row keeps
    # subtype no-result, which tells a charge from a measured cost.
    [ -s "$res" ] || jq -nc --argjson usd "$ROUND_BUDGET_USD" '{subtype:"no-result", total_cost_usd:$usd}' > "$res"
    [ -z "$CALL_STUCK" ] || break   # recorded below, then the run stops
    # An `OAuth session expired` on the first call of a launch is a stale login, not a round: wait
    # once and relaunch the call. A second failure, or the same on a later round, stops as today.
    if ! limit_wait "$res"; then
      le=$(jq -r "$RESULT_OBJ | if .is_error == true then (.result // \"\") else empty end" "$res" 2> /dev/null) || le=""
      { [ "$round" -eq "$FIRST_WORKER_ROUND" ] && [ "$login_retried" -eq 0 ] && grep -q 'OAuth session expired' <<< "$le"; } || break
      login_retried=1
      log "login expired; waiting 60s and relaunching the call once"
      sleep 60
    fi
    assert_caps
  done
  # Advisor spend on this round: calls from the server_tool_use blocks in the stream, usd from advisor_usd.
  local acalls ausd
  acalls=$(jq -s '[.[] | select(.type == "assistant") | .message.content[]?
    | select(.type == "server_tool_use" and .name == "advisor")] | length' "$out" 2> /dev/null) || acalls=0
  [ -n "$acalls" ] || acalls=0
  ausd=$(advisor_usd "$res")
  # workflow_agents and workflow_usd for this round: 0 0 unless this is a large claude ticket's round 1 (F12).
  local wl wagents wusd
  wl=$(workflow_ledger "$round" "$out" "$res"); wagents=${wl% *}; wusd=${wl#* }
  # The ticket's `skills:` names this round read by path or called through the Skill tool; it informs, never grades.
  local names=() s
  while IFS= read -r s; do names+=("$s"); done < <(worker_skills)
  record "$round" worker "$WORKER_MODEL" "$res" "$acalls" "$ausd" "$wagents" "$wusd" 0 \
    "$(skills_called "$out" ${names[@]+"${names[@]}"})"
  [ -z "$CALL_STUCK" ] || finish stopped-environment "$CALL_STUCK"
  assert_call_ok worker "$res" "$head0"
  mv "$pf" "$RUN/round-$round.prompt.md"
  mv "$out" "$RUN/round-$round.jsonl"
  mv "$res" "$RUN/round-$round.result.json"
  # The paths the ticket or the worktree's CLAUDE.md or AGENTS.md names that a Read found gone (#403). It
  # informs and never grades, so a failed scan only logs, and removes the file so an empty one always means
  # none found. The Codex path has no Read tool_use to scan, so a Codex round has no file either.
  ( cd "$WORKTREE" && python3 -I "$ROOT/bin/factory.d/stale_paths.py" "$RUN/round-$round.jsonl" \
      "$RUN/frozen/issue.md" CLAUDE.md AGENTS.md ) > "$RUN/round-$round.stale-paths" 2>> "$LOG" \
    || { rm -f "$RUN/round-$round.stale-paths"; log "could not scan round $round for stale paths; continuing"; }
}

do_not_touch_hits() { # -> the changed paths the ticket fenced off
  local f
  git -C "$WORKTREE" diff --name-only "$(cat "$RUN/base.sha")...HEAD" | while IFS= read -r f; do
    under "$f" "$(cat "$RUN/frozen/protected.txt")" || continue
    under "$f" "$(cat "$RUN/frozen/exempt.txt")" && continue
    printf '%s ' "$f"
  done
}

# A row whose label or command names one of these words measures time, tokens, or cost, so one run is one
# sample; without a `runs=N` its MEASURE line says single sample, so the judge reads no trend from it (F9).
NOISY_ROW_RE='(^|[^A-Za-z])(time|seconds|latency|duration|wall|tokens?|cost|usd|spend)([^A-Za-z]|$)'

median_range() { # numbers on stdin, one per line -> "median min max"; non-zero when a line is not a number
  sort -n | awk '!/^[[:space:]]*-?[0-9]+(\.[0-9]+)?[[:space:]]*$/ {bad = 1} {v[NR] = $1 + 0}
    END {if (bad || NR == 0) exit 1
      printf "%.15g %.15g %.15g\n", (NR % 2 ? v[(NR + 1) / 2] : (v[NR / 2] + v[NR / 2 + 1]) / 2), v[1], v[NR]}'
}

measure_rows() { # round; Rows measured is `[runs=N] [<row>:] <command> | <baseline>` per line (CONTRACT.md)
  local out="$RUN/round-$1.measure" line row rest cmd note n i v lo hi vals
  # The row's command runs with the run's ledger, daily ledger, ticket key, and round in its environment
  # only, so a `bin/factory eval` row books its cost to this run (#76) and no later child of the
  # supervisor inherits a stale round; run_eval reads these four names, mirroring apply_caps's FACTORY_<NAME>.
  local env=(FACTORY_LEDGER="$LEDGER" FACTORY_DAILY="$DAILY" FACTORY_KEY="$KEY" FACTORY_ROUND="$1")
  : > "$out"
  while IFS= read -r line; do
    line=${line#- }
    [ -n "${line//[[:space:]]/}" ] || continue
    n=""
    [[ "$line" =~ ^runs=([1-9][0-9]*)[[:space:]]+(.*)$ ]] && { n=${BASH_REMATCH[1]}; line=${BASH_REMATCH[2]}; }
    row=${line%%:*}; rest=${line#*:}; cmd=${rest%%|*}
    note="baseline $(printf '%s' "${rest#*|}" | tr -d ' ')"
    if [ -z "$n" ]; then
      n=1
      # The label counts only when the line has one; with no colon, row is the whole line, baseline included.
      v=$cmd; [ "$row" = "$line" ] || v="$row $cmd"
      grep -qiE "$NOISY_ROW_RE" <<< "$v" && note="$note; single sample, no runs=N"
    fi
    vals=()
    for ((i = 0; i < n; i++)); do
      vals+=("$( cd "$WORKTREE" && export "${env[@]}" && eval "$cmd" 2>&1 | tail -1 )")
    done
    v=${vals[0]}
    if [ "$n" -gt 1 ]; then
      if read -r v lo hi < <(printf '%s\n' "${vals[@]}" | median_range); then
        note="median of $n runs, range $lo to $hi; $note"
      else
        v=$(printf '%s / ' "${vals[@]}"); v=${v% / }
        note="$n runs, not all numbers, so no median; $note"
      fi
    fi
    printf 'MEASURE %s %s (%s)\n' "$row" "$v" "$note" | tee -a "$out" >&2
  done <<< "$(section "Rows measured")"
}

# ---- step 7: the graders ----------------------------------------------------

# --json-schema routes the grader's last message through a structured-output tool, so .result is the
# bare object whatever the rubric's prose default asks for. Each schema's one home is its file next to
# the running factory (bin/factory.d/), not under $ROOT: an eval run from a worktree reads that
# worktree's schema even though the supervisor exports FACTORY_ROOT pointing at the main checkout.
# freeze copies judge's and reviewer's into frozen/; the eval reads them directly.
schema_for() { cat "$(dirname "$0")/factory.d/$1.schema.json"; }  # judge|reviewer|lean-critic -> JSON Schema on stdout

build_evidence() { # rubric_file diff_cap -> stdout
  local rubric="$1" cap="$2" base names stat_only content paths=() path diff="$RUN/round-$ROUND.diff"
  base=$(cat "$RUN/base.sha")
  cat "$rubric"
  printf '\n\n## Ticket\n\n%s\n' "$FENCE"; cat "$RUN/frozen/issue.md"; printf '\n%s\n' "$FENCE"
  printf '\n## Checks output\n\n%s\n' "$FENCE"; cat "$RUN/round-$ROUND.checks"; printf '\n%s\n' "$FENCE"
  printf '\n## Rows measured\n\n%s\n' "$FENCE"; cat "$RUN/round-$ROUND.measure" 2> /dev/null; printf '\n%s\n' "$FENCE"
  printf '\n## decisions.md (worker-authored)\n\n%s\n' "$FENCE"; cat "$DECISIONS"; printf '\n%s\n' "$FENCE"
  # Data files pass as stat only: evals/**/prompt.md and any added file over 400 lines (LOOP.md, Grader calls),
  # so a frozen grader prompt or a large fixture never floods the diff a grader reads.
  names=$( cd "$WORKTREE" && git diff -M --name-only --diff-filter=AMR "$base...HEAD" )
  stat_only=$( { grep -E '^evals/.*/prompt\.md$' <<< "$names" || true
                 ( cd "$WORKTREE" && git diff --numstat --diff-filter=A "$base...HEAD" ) \
                   | awk -F'\t' '$1 + 0 > 400 {print $3}'; } | sort -u )
  content=$( grep -vxF -f <(printf '%s\n' "$stat_only") <<< "$names" || true )
  printf '\n## Diff (%s...HEAD)\n\n%s\n' "${base:0:8}" "$FENCE"
  ( cd "$WORKTREE" && git diff -M --stat=200 "$base...HEAD" ); printf '\n'
  [ -z "$stat_only" ] || printf '[stat only, content omitted as data: %s]\n\n' "$(printf '%s' "$stat_only" | tr '\n' ' ')"
  if [ -n "$content" ]; then
    while IFS= read -r path; do paths+=("$path"); done <<< "$content"  # bash 3.2 (macOS) has no mapfile
    ( cd "$WORKTREE" && git diff -M --diff-filter=AMR "$base...HEAD" -- "${paths[@]}" ) > "$diff"
    head -"$cap" "$diff"
    [ "$(wc -l < "$diff")" -le "$cap" ] || printf '\n[content diff capped at %s lines; the stat above is complete]\n' "$cap"
  fi
  printf '%s\n' "$FENCE"
}

# A judge pass with a fix or a failing or missing row, or a fail with nothing to point at, refutes itself (LOOP.md,
# precedence). The rows a pass needs are the ones the schema requires, since all() is true on an empty set.
# A reviewer's verdict word is never checked: run_review reads REVIEW_OUTCOME, and a refutation of the word
# pushes the model to change its findings to fit it (2026-09-12).
verdict_consistent() { # json file, schema file
  jq -e --slurpfile s "$2" '(.verdict // "") as $v
    | ((.fixes // []) | length) as $blocking
    | (((.backlog // []) | length) + ((.findings // []) | length)) as $other
    | (.rows // {}) as $r
    | (([$r[]?] | all(. == "pass")) and ($s[0].properties.rows.required // [] | all($r[.] == "pass"))) as $rows_pass
    | if $v == "pass" then $blocking == 0 and $rows_pass
      elif $v == "fail" then ($blocking > 0 or $other > 0)
      else true end' "$1" > /dev/null 2>&1
}

grader_reply() { # raw claude -p envelope -> the grader's reply text, fences stripped
  jq -r "$RESULT_OBJ | .result // \"\"" "$1" 2> /dev/null | sed -e 's/^```json//' -e 's/^```//' -e 's/```$//'
}

call_json() { # round stem role prompt_file schema_file
  local round="$1" stem="$2" role="$3" pf="$4" schema="$5" final="$RUN/round-$1.$2.json" out res attempt=0
  while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    out="$RUN/round-$round.$stem.raw.$attempt.json"
    assert_caps
    stop_requested && finish stopped "FACTORY_STOP before the $role call"
    log "$role call (attempt $attempt): model=$GRADER_MODEL effort=$GRADER_EFFORT"
    # --tools Read,Grep,Glob is what makes a grader read-only (#40); with no MCP schemas and no
    # skills listing its prefix is 9.9k tokens instead of 27k (probed 2026-09-09). --setting-sources
    # user is what keeps the worktree's own hooks out, so a grader can still read the tree it grades.
    call_start "$WORKTREE" ${TIMEOUT_G[@]+"${TIMEOUT_G[@]}"} claude -p --model "$GRADER_MODEL" --effort "$GRADER_EFFORT" \
        --tools Read,Grep,Glob --strict-mcp-config --disable-slash-commands --no-session-persistence \
        --json-schema "$(cat "$schema")" \
        --max-budget-usd "$GRADER_BUDGET_USD" --setting-sources user --settings "$RUN/frozen/role-settings.json" \
        --output-format json < "$pf" > "$out" 2>> "$LOG"
    call_end "$role" || log "$role exited non-zero"
    if [ -z "$CALL_STUCK" ] && limit_wait "$out"; then attempt=$((attempt - 1)); continue; fi
    record "$round" "$role" "$GRADER_MODEL" "$out"
    [ -z "$CALL_STUCK" ] || finish stopped-environment "$CALL_STUCK"
    res=$(grader_reply "$out") || res=""
    if printf '%s' "$res" | jq -e '.verdict' > /dev/null 2>&1; then
      printf '%s' "$res" | jq '.' > "$final"
      verdict_consistent "$final" "$schema" && return 0
      log "$role verdict is inconsistent with its own lists; calling once more with the refutation"
      printf '\n\n## Refutation\n\nYour previous reply was `%s`, which contradicts the rows, fixes, findings, and backlog you listed. Grade again and return a consistent object.\n' \
        "$(jq -c '{verdict, rows: (.rows // {}), fixes: (.fixes // []), findings: ((.findings // []) | length), backlog: (.backlog // [])}' "$final")" >> "$pf"
      continue
    fi
    log "$role output not parseable"
  done
  # An absent or unparseable grader is a fail with one high finding, never a pass (LOOP.md). A worker cannot
  # rerun a grader, so the finding never goes to round-N.fixes (#312, the #306 shape): the reviewer's drafts
  # the PR and is filed from blocking_findings; the judge's is also its backlog line, which open_pr prints
  # and file_backlog files, since the PR body and the issues read a judge's backlog, not its findings.
  log "$role output unparseable or inconsistent after 3 attempts; see $out"
  jq -n --arg r "$role" '{verdict: (if $r == "judge" then "fail" else "fix" end), unparseable: true,
    rows: {}, evidence: {}, fixes: [],
    backlog: (if $r == "judge" then ["judge output unparseable or inconsistent after 3 calls; rerun the judge on this round"] else [] end),
    findings: [{severity: "high", file: "-", line: 0, defect: ($r + " output unparseable"),
                fix: ("rerun the " + $r + " on this round")}]}' > "$final"
}

run_judge() { # round -> 0 on a pass verdict
  local round="$1" pf="$RUN/round-$1.judge.prompt.md" f="$RUN/round-$1.judge.json"
  build_evidence "$RUN/frozen/judge.md" 4000 > "$pf"
  call_json "$round" judge judge "$pf" "$RUN/frozen/judge.schema.json"
  jq -r '.fixes[]? | "- " + .' "$f" > "$RUN/round-$round.fixes"
  log "judge verdict: $(jq -r .verdict "$f") rows=$(jq -c '.rows // {}' "$f")"
  [ "$(jq -r .verdict "$f")" = pass ]
}

run_review() { # round -> 0 when nothing blocks
  local round="$1" pf="$RUN/round-$1.review.prompt.md" f="$RUN/round-$1.review.json" blocking
  build_evidence "$RUN/frozen/reviewer.md" 6000 > "$pf"
  call_json "$round" review reviewer "$pf" "$RUN/frozen/reviewer.schema.json"
  blocking=$(jq "$REVIEW_BLOCKING | length" "$f")
  log "reviewer verdict: $(jq -r .verdict "$f") findings=$(jq '(.findings // []) | length' "$f") blocking=$blocking (high or medium)"
  [ "$blocking" -gt 0 ] || return 0
  if jq -e '.unparseable == true' "$f" > /dev/null 2>&1; then
    # A worker cannot rerun the reviewer (#312): the finding is not a fix, does not spend the one block, and
    # does not fail the graders; in the final round it drafts the PR and is filed as an issue.
    log "reviewer unparseable after 3 calls; not sent to the worker, and in the final round it drafts the PR and is filed as an issue"
    return 0
  fi
  if [ "$REVIEW_BLOCKED" = 1 ]; then
    log "the reviewer already blocked once on this ticket; its blocking findings make the PR a draft and are filed as issues"
    return 0
  fi
  REVIEW_BLOCKED=1
  # highs before mediums: sort_by(.severity != "high") keys false (high) before true (medium), and jq's sort is stable.
  jq -r "$REVIEW_BLOCKING"' | sort_by(.severity != "high") | .[]
    | "- " + (.file // "?") + ":" + ((.line // 0) | tostring) + " " + .defect + " Fix: " + .fix' "$f" >> "$RUN/round-$round.fixes"
  return 1
}

run_codex_review() { # round -> 0 when nothing blocks; needs-attention with a critical or high finding blocks once (LOOP.md)
  local round="$1" f="$RUN/round-$1.codex-review.json" jsonl res="$RUN/round-$1.codex-review.result.json" base blocking rc start call parsed=0
  base=$(cat "$RUN/base.sha")
  for call in 1 2; do
    jsonl="$RUN/round-$round.codex-review.$call.jsonl"   # one stream per call, so each log line points at its own call
    assert_caps
    stop_requested && finish stopped "FACTORY_STOP before the Codex review call"
    log "codex review call $call of 2: round $round schema=frozen/review-output.schema.json"
    # A review needs no write access, so it runs read-only: under workspace-write it could edit the tree the
    # judge and reviewer already graded. `codex exec review` ignores --output-schema, so the review is plain
    # `codex exec` with the schema (#41): the -o file holds the schema-validated JSON, the JSONL stream
    # (stdout) carries usage for the ledger. The one-line prompt is the frozen file with <base> filled in.
    start=$SECONDS
    call_start "$WORKTREE" ${TIMEOUT_G[@]+"${TIMEOUT_G[@]}"} env PATH="$CODEX_PATH:$PATH" codex exec --json --output-schema "$RUN/frozen/review-output.schema.json" -o "$f" -s read-only "$(sed "s/<base>/$base/" "$RUN/frozen/codex-review.prompt.md")" > "$jsonl" < /dev/null
    call_end "Codex review"; rc=$?
    [ "$rc" -eq 0 ] || log "codex review call exited $rc"
    codex_result "$jsonl" "$rc" "$(( (SECONDS - start) * 1000 ))" > "$res"
    record "$round" codex-review "$CODEX_MODEL" "$res" 0 0 0 0 1
    [ -z "$CALL_STUCK" ] || finish stopped-environment "$CALL_STUCK"
    # An absent, empty, or unparseable -o file gets one more call; -s also refuses a file holding more than one JSON value.
    if jq -se 'length == 1 and (.[0].verdict | type) == "string"' "$f" > /dev/null 2>&1; then parsed=1; break; fi
    log "codex review output absent or unparseable on call $call of 2; see $jsonl"
  done
  if [ "$parsed" = 0 ]; then
    # Two bad replies leave one high finding, never a pass (LOOP.md): it drafts the PR and is filed as an issue.
    # A worker cannot rerun Codex, so it is not a fix for the next round and does not fail the graders.
    jq -n '{verdict: "needs-attention", unparseable: true, summary: "Codex review output absent or unparseable", next_steps: [],
      findings: [{severity: "high", file: "-", line_start: 0, line_end: 0, confidence: 0,
                  title: "codex review output unparseable", body: "the -o file was absent, empty, or not one review object.",
                  recommendation: "rerun the Codex review on this round"}]}' > "$f"
    log "codex review unparseable twice; not sent to the worker, and in the final round it drafts the PR and is filed as an issue"
    return 0
  fi
  blocking=$(jq "$CODEX_BLOCKING | length" "$f")
  log "codex review verdict: $(jq -r '.verdict // "unparseable"' "$f" 2> /dev/null) findings=$(jq '(.findings // []) | length' "$f" 2> /dev/null) blocking=$blocking"
  [ "$blocking" -gt 0 ] || return 0
  if [ "$CODEX_REVIEW_BLOCKED" = 1 ]; then
    log "the Codex review already blocked once on this ticket; its blocking findings make the PR a draft and are filed as issues"
    return 0
  fi
  CODEX_REVIEW_BLOCKED=1
  jq -r "$CODEX_BLOCKING"' | .[]
    | "- " + (.file // "?") + ":" + ((.line_start // 0) | tostring) + " [" + .severity + "] " + .title + ": " + .body + " Fix: " + (.recommendation // "-")' "$f" >> "$RUN/round-$round.fixes"
  return 1
}

# The sha256 (64 hex) of a dir's HEAD sha followed by its porcelain status: the graders run
# read-only, so nothing should change between the signature taken before them and after the last one
# (docs/research/curation-2026-09-20.md, the LongHorizon auditor snapshot guard).
tree_signature() { # dir -> 64 hex
  { git -C "$1" rev-parse HEAD; git -C "$1" status --porcelain; } | sha256_of | cut -d' ' -f1
}

graders() { # round -> 0 when the judge passes and nothing blocks
  local ok=0 sig
  sig=$(tree_signature "$WORKTREE")
  GRADED_SHA=$(git -C "$WORKTREE" rev-parse HEAD)   # open_pr prints it, so a later push shows the verdict is stale
  run_judge "$1" || ok=1
  run_review "$1" || ok=1
  [ "$CODEX_REVIEW" = yes ] && { run_codex_review "$1" || ok=1; }
  [ "$(tree_signature "$WORKTREE")" = "$sig" ] || finish stopped-environment "grader changed the tree"
  # After every grader ran on an unchanged tree, so a relaunch can tell this round graded HEAD (cmd_run).
  printf '%s\n' "$GRADED_SHA" > "$RUN/round-$1.graded.sha"
  if [ ! -s "$RUN/round-$1.fixes" ] && jq -e '.unparseable == true' "$RUN/round-$1.judge.json" > /dev/null 2>&1; then
    # Not a pass, and not a worker round either: the judge's fallback queues no fix, so the next round would
    # have nothing to do and end no-change with no PR (#312). The draft PR carries the finding in the judge
    # backlog, so a human reads it and file_backlog files it. With reviewer or Codex fixes queued in this
    # round, it is a normal fail: the next worker round takes them and the judge runs again.
    log "judge unparseable or inconsistent after 3 calls: not a pass, and a worker cannot rerun the judge, so the PR opens as a draft with the finding in the judge backlog; with reviewer or Codex fixes queued, the next worker round takes them and the judge runs again"
    open_pr draft
  fi
  return "$ok"
}

# ---- step 8: the pull request -----------------------------------------------

# The reviewer's and the Codex review's blocking findings in the final round's files, highest severity first.
# After the graders pass, these are what a grader past its one block, or a reviewer or Codex review with no
# parseable reply, still reports.
# Each finding is joined onto one line, since file_issues files one issue per line.
blocking_findings() {
  jq -r "$REVIEW_BLOCKING"' | sort_by(.severity != "high") | .[]
    | "reviewer [" + .severity + "] " + (.file // "?") + ":" + ((.line // 0) | tostring) + " " + (.defect // "?") + " Fix: " + (.fix // "-")
    | gsub("\\s*\n\\s*"; " ")' "$RUN/round-$ROUND.review.json" 2> /dev/null
  [ "$CODEX_REVIEW" = yes ] || return 0
  jq -r "$CODEX_BLOCKING"' | sort_by(.severity != "critical") | .[]
    | "Codex review [" + .severity + "] " + (.file // "?") + ":" + ((.line_start // 0) | tostring) + " " + (.title // "?") + ": "
      + (.body // "") + " Fix: " + (.recommendation // "-")
    | gsub("\\s*\n\\s*"; " ")' "$RUN/round-$ROUND.codex-review.json" 2> /dev/null
}

# A judge backlog line, or a blocking finding left in a PR, lands only in the PR-body text, so a defect an
# unattended run finds is tracked by nobody; file each line once per run as a needs-triage issue. Never calls
# finish: a filing failure is logged and the run still opens its PR.
file_backlog() { # judge.json issue pr-url
  jq -r '.backlog[]? | gsub("\\s*\n\\s*"; " ")' "$1" 2> /dev/null | file_issues "judge backlog" "$2" "$3"
}

file_issues() { # source issue pr-url, one issue per stdin line, scrubbed before the title cuts it
  local src="$1" issue="$2" prurl="$3" line GH="${FACTORY_GH:-gh}"
  scrub | while IFS= read -r line; do
    [ -n "$line" ] || continue
    grep -Fxq "$line" "$RUN/filed.txt" 2> /dev/null && continue
    if printf 'From the %s of #%s, %s.\n\n%s\n' "$src" "$issue" "$prurl" "$line" \
      | net "$GH" issue create -R "$REPO" --title "${line:0:80}" --label needs-triage --body-file - > /dev/null 2>&1; then
      printf '%s\n' "$line" >> "$RUN/filed.txt"
    else
      log "file_issues: gh issue create failed for a $src line: $line"
    fi
  done
}

# Only each result's word and check name show, never its reason: lib.sh's `fail NAME "$out"` puts captured
# command output in the reason, which may hold a secret, and the repo is public with every body edit kept.
# A MEASURE value shows only when it is a number; a name outside lib.sh's [A-Za-z0-9_.-] is dropped, so a raw
# output line that starts with FAIL cannot close the fence. At most 50 lines, each cut to 300 characters, stay
# under GitHub's 65536-character body limit. The full file stays in the run dir, and the section names it.
checks_section() { # heading checks-file
  printf '## %s\n\n```\n' "$1"
  awk -v max=50 -v f="$2" '/^(PASS|FAIL|MEASURE) / {
      n++; if (n > max) next
      name = $2; sub(/:$/, "", name); line = $1
      if (name ~ /^[A-Za-z0-9_.-]+$/) line = line " " name
      if ($1 == "MEASURE" && NF == 3 && $3 ~ /^-?[0-9]+(\.[0-9]+)?$/) line = line " " $3
      print substr(line, 1, 300)}
    END {if (n > max) printf "... %d more lines in %s\n", n - max, f}' "$2"
  printf '```\n\nReasons and full output: %s\n\n' "$2"
}

# Each ^FAIL line's check name, once, in order; a name outside lib.sh's [A-Za-z0-9_.-] prints as ?. notify posts
# these and never a FAIL line: a reason is command output, and a raw output line can start with FAIL (pytest's
# FAILED, go test's FAIL<tab>package).
fail_names() { # checks-file
  awk '/^FAIL/ {n = $2; sub(/:$/, "", n); if (n !~ /^[A-Za-z0-9_.-]+$/) n = "?"; if (!seen[n]++) print n}' "$1"
}

open_pr() { # [draft]: opened at the grader-round cap
  local draft="${1:-}" body="$RUN/pr-body.md" base url num title rows blocking
  base=$(cat "$RUN/base.sha")
  blocking=$(blocking_findings)
  [ -n "$draft" ] || [ -z "$blocking" ] || draft=blocking
  {
    # A draft's reason opens the body, so a reader sees why it is a draft before anything else.
    if [ "$draft" = blocking ]; then
      printf 'Draft: the judge passed, but %s blocking reviewer or Codex finding(s) remain past the one block each grader may make or come from a reviewer or Codex review with no parseable reply, and each is filed as an issue. Read them before marking it ready. The first is %s\n\n' \
        "$(printf '%s\n' "$blocking" | grep -c .)" "$(printf '%s\n' "$blocking" | head -1)"
    elif [ -n "$draft" ] && jq -e '.unparseable == true' "$RUN/round-$ROUND.judge.json" > /dev/null 2>&1; then
      printf 'Draft: judge output unparseable or inconsistent after 3 calls, so this round is not a pass and no worker round followed; the Backlog section files it as an issue. Read the Judge section before marking it ready.\n\n'
    elif [ -n "$draft" ]; then
      # An absent, empty, or invalid judge file counts as a fail (LOOP.md), so jq may print nothing.
      rows=$(jq -r '[(.rows // {}) | to_entries[] | select(.value == "fail") | .key] | join(", ") | if . == "" then "no row; a reviewer or Codex finding blocked" else . end' "$RUN/round-$ROUND.judge.json" 2> /dev/null)
      printf 'Draft: opened at the grader-round cap; the judge failed %s. Read the Judge section before marking it ready.\n\n' "${rows:-no row; the judge output was absent or not parseable}"
    fi
    # The worker's own account of how the change works and why it is correct opens a ready PR's body (#330), so
    # the owner can judge the merge without trusting the graders; it sits beside decisions.md.
    printf '## How it works\n\n'
    if grep -q '[^[:space:]]' "${DECISIONS%/*}/mechanism.md" 2> /dev/null; then
      printf '%s\n\n' "$(sed '/./,$!d' "${DECISIONS%/*}/mechanism.md")"
    else
      printf '(the worker wrote no mechanism paragraph)\n\n'
    fi
    [ "$IS_FILE" = 1 ] || printf 'Closes #%s\n\n' "$ISSUE"
    printf '## Goal\n\n%s\n\n' "$(section "Goal and why" | sed '/./,$!d')"
    printf '## Commits\n\n```\n%s\n```\n\n' "$(git -C "$WORKTREE" log --oneline "$base..HEAD")"
    [ -s "$RUN/round-$ROUND.measure" ] && { printf '## Rows measured\n\n```\n'; cat "$RUN/round-$ROUND.measure"; printf '```\n\n'; }
    printf '## Merge checklist\n\n'; section "Merge checklist" | grep '^- ' | sed 's/^- /- [ ] /'; printf '\n'
    printf '## Decisions\n\n```\n'; cat "$DECISIONS"; printf '```\n\n'
    checks_section "Checks at base ${base:0:8} (round 0)" "$RUN/round-0.checks"
    checks_section "Checks at the graded sha (round $ROUND)" "$RUN/round-$ROUND.checks"
    printf '## Judge\n\ngraded at %s\n\n```json\n%s\n```\n\n' "$GRADED_SHA" \
      "$(jq -c '{verdict, rows: (.rows // {}), evidence: (.evidence // {})}' "$RUN/round-$ROUND.judge.json")"
    printf '## Reviewer\n\n'
    jq -r '.findings[]? | "- [" + .severity + "] " + (.file // "?") + ":" + ((.line // 0) | tostring) + " " + .defect + " Fix: " + .fix' "$RUN/round-$ROUND.review.json"
    jq -r '.unverified[]? | "- unverified: " + .' "$RUN/round-$ROUND.review.json"
    if [ "$CODEX_REVIEW" = yes ]; then
      printf '\n## Codex review\n\n'
      if [ -s "$RUN/round-$ROUND.codex-review.json" ] && jq -e . "$RUN/round-$ROUND.codex-review.json" > /dev/null 2>&1; then
        printf 'verdict: %s\n\n%s\n\n' "$(jq -r '.verdict // "?"' "$RUN/round-$ROUND.codex-review.json")" "$(jq -r '.summary // ""' "$RUN/round-$ROUND.codex-review.json")"
        jq -r '.findings[]? | "- [" + .severity + "] " + (.file // "?") + ":" + ((.line_start // 0) | tostring) + " " + .title + ": " + .body + " Fix: " + (.recommendation // "-")' "$RUN/round-$ROUND.codex-review.json"
      else
        printf '(no Codex review output for round %s)\n' "$ROUND"
      fi
    fi
    if [ "$WORKER_KIND" = codex ]; then
      printf '\n## Codex worker notes\n\n'
      printf -- '- Cost: the Codex worker rounds carry `cost_usd: null` in the ledger; the dollar caps (ROUND_BUDGET_USD, TICKET_BUDGET_USD, DAILY_BUDGET_USD) do not bound a Codex worker. Only token counts are recorded.\n'
      printf -- '- `.env` is readable by the Codex worker (D8, #41). No deny is configured; recorded risk.\n'
    fi
    printf '\n## Backlog\n\n'; jq -r '.backlog[]? | "- " + .' "$RUN/round-$ROUND.judge.json"
    printf '\n## Metrics\n\nrounds: %s, spend: %s usd, wall: %s min, denials: %s\nrun directory: %s\n' \
      "$ROUND" "$(ticket_spent)" "$(( ( $(date -u +%s) - $(cat "$RUN/started") ) / 60 ))" \
      "$(jq -s '[.[].denials // 0] | add // 0' "$LEDGER")" "$RUN"
  } | scrub > "$body" || finish stopped-environment "could not scrub the PR body"
  # The decision to publish, recorded before any network call: a relaunch whose HEAD is still this sha replays
  # open_pr with the same draft argument and no worker round (cmd_run), so a failed push or create loses nothing.
  # Each pr-opened exit removes it, so only a failed publish leaves it for a relaunch to replay.
  printf '%s %s\n' "$GRADED_SHA" "$draft" > "$RUN/publish.intent" \
    || finish stopped-environment "could not write $RUN/publish.intent"
  [ "$IS_FILE" = 1 ] && { rm -f "$RUN/publish.intent"; finish pr-opened "file ticket: no GitHub call; the PR body is at $body"; }
  net git -C "$WORKTREE" push -u origin "$BRANCH" >> "$LOG" 2>&1 \
    || finish stopped-environment "git push of $BRANCH failed, or got no reply in ${NET_TIMEOUT_SEC}s"
  if num=$(net gh pr view "$BRANCH" -R "$REPO" --json number --jq .number 2> /dev/null) && [ -n "$num" ]; then
    # gh pr edit has failed on a GraphQL deprecation; PR bodies are updated through the REST API.
    net gh api -X PATCH "repos/$REPO/pulls/$num" -f "body=$(cat "$body")" > /dev/null \
      || finish stopped-environment "could not update the body of PR #$num (failed, or no reply in ${NET_TIMEOUT_SEC}s)"
    url="https://github.com/$REPO/pull/$num"
  else
    title=$(ticket_title | scrub)
    url=$(net gh pr create -R "$REPO" --head "$BRANCH" --base main --title "${title:-$KEY}" --body-file "$body" ${draft:+--draft} 2>&1) \
      || finish stopped-environment "gh pr create for $BRANCH failed, or got no reply in ${NET_TIMEOUT_SEC}s: $url"
    url=$(printf '%s\n' "$url" | tail -1)
  fi
  [ "$IS_FILE" = 0 ] && file_backlog "$RUN/round-$ROUND.judge.json" "$ISSUE" "$url"
  [ "$IS_FILE" = 0 ] && printf '%s\n' "$blocking" | file_issues "blocking review findings" "$ISSUE" "$url"
  rm -f "$RUN/publish.intent"
  finish pr-opened "$url after $ROUND rounds, $(ticket_spent) usd"
}

# ---- the loop ---------------------------------------------------------------

# Step 7 on a round whose checks passed: a pass opens the PR, and the GRADER_FAIL_ROUNDS-th fail drafts it.
grade_round() {
  measure_rows "$ROUND"
  graders "$ROUND" && open_pr
  GRADER_FAILS=$((GRADER_FAILS + 1))
  [ "$GRADER_FAILS" -lt "$GRADER_FAIL_ROUNDS" ] \
    || { log "grader-round cap: $GRADER_FAIL_ROUNDS grader-fail rounds; the rest goes to the PR backlog"; open_pr draft; }
}

round_checks() { # out: a dirty tree or a do-not-touch hit fails the round without running the checks
  local dirty touched
  dirty=$(git -C "$WORKTREE" status --porcelain)
  touched=$(do_not_touch_hits)
  if [ -n "$dirty" ]; then
    printf 'FAIL worktree-dirty: %s\n' "$(printf '%s' "$dirty" | tr '\n' ' ')" > "$1"
  elif [ -n "$touched" ]; then
    printf 'FAIL do-not-touch %s\n' "$touched" > "$1"
  else
    run_checks "$WORKTREE" "$1"
  fi
}

main_loop() {
  local prev_fails="" prev_sig="" fails checks sig_now
  notify info "$(ticket_name) started" \
    "Branch $BRANCH in $WORKTREE; it stops at $MAX_ROUNDS rounds, $TICKET_BUDGET_USD USD or $MAX_HOURS hours"
  while :; do
    ROUND=$((ROUND + 1))
    [ "$ROUND" -le "$MAX_ROUNDS" ] || finish stopped-cap "round cap: $MAX_ROUNDS rounds"
    set_status running
    log "===== round $ROUND ====="
    check_frozen
    assert_caps
    stop_requested && finish stopped "FACTORY_STOP before the round-$ROUND call"
    worker_round "$ROUND"
    # Step 6, in order: abandon, the frozen set, a clean tree, do-not-touch, then the checks.
    # A worker sometimes writes the line as a markdown bullet (#158); accept `- ` or `* ` and strip it.
    abandon=$(grep -m1 -E '^(- |\* )?ABANDON ' "$DECISIONS" | sed -E 's/^(- |\* )//')
    [ -n "$abandon" ] && finish abandon "$abandon"
    check_frozen
    # The round signature is HEAD plus the digest of decisions.md, so a round that only relabels
    # decisions.md after a grader-only fail (#78) proceeds to the checks and graders; no-change fires
    # only when both are unchanged since the previous round.
    sig_now="$(git -C "$WORKTREE" rev-parse HEAD) $(sha256_of < "$DECISIONS" | cut -d' ' -f1)"
    [ "$sig_now" = "$prev_sig" ] && finish no-change "HEAD and decisions.md are unchanged since round $((ROUND - 1))"
    prev_sig="$sig_now"
    checks="$RUN/round-$ROUND.checks"
    round_checks "$checks"
    if grep -q '^FAIL' "$checks"; then
      fails=$(grep '^FAIL' "$checks" | awk '{print $2}' | tr -d ':' | sort -u | tr '\n' ',')
      log "checks failing: $fails"
      [ "$fails" = "$prev_fails" ] && finish stuck "the same checks failed twice: $(fail_names "$checks" | paste -sd, -)"
      prev_fails="$fails"
      [ $((ROUND % 2)) -eq 0 ] && notify info "$(ticket_name): checks still fail after round $ROUND; it keeps working" \
        "$(fail_names "$checks" | head -10 | sed 's/^/FAIL /'; printf 'Reasons and full output: %s\n' "$checks")"
      continue
    fi
    prev_fails=""
    log "checks: all pass"
    grade_round
  done
}

cmd_run() {
  # Before load_ticket, so a missing toolchain export or bin/check stops ahead of every GitHub call; exit 4
  # is stopped-environment's code, direct because finish needs RUN and its notify may comment on the issue.
  assert_target_ready || exit 4
  local cv
  cv=$(claude_version_ok) || { echo "factory run: claude --version reports '$cv'; the factory needs Claude Code $CLAUDE_MIN_VERSION+ (#379)" >&2; exit 4; }
  load_ticket "$1"
  apply_caps
  local effort
  effort=$(section Worker | sed -n 's/^effort: *//p' | head -1)
  WORKER_EFFORT="${effort:-$WORKER_EFFORT}"
  WORKER_SIZE=$(section Worker | sed -n 's/^size: *//p' | head -1)   # small|large; large routes round 1 to the workflow (F12)
  [ -n "$WORKER_SIZE" ] || WORKER_SIZE=small
  WORKER_KIND=$(section Worker | sed -n 's/^worker: *//p' | head -1)   # claude|codex; codex routes the worker call to Codex (F4)
  [ -n "$WORKER_KIND" ] || WORKER_KIND=claude
  CODEX_REVIEW=$(section Worker | sed -n 's/^codex-review: *//p' | head -1)   # yes adds a Codex review stage after the graders (F4)
  [ -n "$CODEX_REVIEW" ] || CODEX_REVIEW=no
  local sha8
  sha8=$(printf '%s' "$BODY" | sha256_of | cut -c1-8)
  RUN="$RUNS_ROOT/$KEY/$sha8"
  mkdir -p "$RUN/frozen" "$RUN/worker" "$RUN/tasks" || { echo "factory run: cannot create $RUN" >&2; exit 4; }
  # The daily ledger stays in RUNS_BASE for every target, so DAILY_BUDGET_USD bounds the runner's whole day.
  LOG="$RUN/factory.log"; LEDGER="$RUN/ledger.jsonl"; DAILY="$RUNS_BASE/ledger-daily.jsonl"
  DECISIONS="$RUN/worker/decisions.md"
  touch "$LOG" "$LEDGER" "$DAILY" "$DECISIONS"
  # The slot is the flock lease on $RUN/lease (#425), taken before the long preparation, so a relaunch holds its slot
  # at once, and before this launch writes any state the run dir shares: a launch that cannot take it while another
  # launch of the same ticket holds it says so and exits, leaving that run's status, `launched` (its MAX_HOURS clock)
  # and log (status --criteria's round) as they were. The fd is no close-on-exec, so the frozen re-exec and every
  # child inherit it: the run holds the lease until its last process exits. The frozen pass already holds it and must
  # not lock a second open of the file, which would wait on its own lease. The heartbeat loop alone closes it
  # (heartbeat_start). Where flock(1) is missing (a Mac) no lease is written and holds_slot judges the owner line below.
  if [ -n "$HAVE_FLOCK" ] && [ "${FACTORY_FROZEN:-}" != "$RUN/frozen/factory" ]; then
    exec {SLOT_FD}>> "$RUN/lease" && flock -w 65 "$SLOT_FD" \
      || { echo "factory run: could not take $RUN/lease in 65 s; another launch of this ticket, or a process one left running, holds it" >&2; exit 4; }
    export FACTORY_SLOT_FD=$SLOT_FD   # so the frozen pass's heartbeat can close it
  fi
  # A model call's tool process may have closed the lease (holds_slot), or there is no lease (no flock), and still
  # write the worktree this launch would prepare; refuse as above, writing nothing.
  [ "${FACTORY_FROZEN:-}" != "$RUN/frozen/factory" ] && call_live "$RUN" \
    && { echo "factory run: the model call named in $RUN/call still runs; wait for it to exit or kill it" >&2; exit 4; }
  # A file ticket's branch carries the run key too, so a relaunch with an edited body gets its own branch;
  # the EXIT trap below removes the worktree at exit, and the branch keeps the commits.
  BRANCH="factory/$KEY"; [ "$IS_FILE" = 1 ] && BRANCH="$BRANCH-$sha8"
  WORKTREE="${FACTORY_WORKTREE:-$MAIN_CHECKOUT-$(printf '%s' "$KEY" | tr '[:upper:]' '[:lower:]')}"
  [ "${FACTORY_FROZEN:-}" != "$RUN/frozen/factory" ] && issue_busy "$KEY" "$RUN" \
    && { echo "factory run: a run of another body of $KEY still runs or awaits merge in $WORKTREE; wait, or stop or merge it" >&2; exit 4; }
  [ -f "$RUN/started" ] || date -u +%s > "$RUN/started"
  date -u +%s > "$RUN/launched"
  # One line per launch, before any exit and not again from the frozen re-exec: status --criteria resets the
  # round on it, so a relaunch's early exit is not charged to the round a killed launch left open.
  [ "${FACTORY_FROZEN:-}" = "$RUN/frozen/factory" ] || log "===== launch ====="
  # The owner line, for status and the alert text, and for holds_slot on a host with no flock or a run dir with no
  # lease, written with the status under owner.lock, which a reaper judging the owner line takes too.
  # exec keeps the pid, so it still names the loop that runs finish; the frozen pass rewrites the same line.
  # Through a temp file, so a kill mid-write never leaves an empty owner (held for good).
  local start
  start=$(TZ=UTC LC_ALL=C ps -o lstart= -p "$$")
  start=${start%"${start##*[![:space:]]}"}   # macOS pads lstart with trailing spaces; holds_slot matches up to the year
  # env-stops changes with the status, under owner.lock, so env_park_alert never reads this launch's line beside the
  # last run's status; only in the live pass, so a run frozen before it counts too. The two early exits below count
  # their launch as well, or a launch that cannot take the lock would retry forever with no park.
  local live=1; [ "${FACTORY_FROZEN:-}" = "$RUN/frozen/factory" ] && live=0
  [ -n "$start" ] && owner_lock "$RUN" 65 \
    || { [ "$live" = 0 ] || record_env_stops "$RUN"
         finish stopped-environment "could not read this run's start time or take $RUN/owner.lock"; }
  printf '%s %s\n' "$$" "$start" > "$RUN/owner.tmp" && mv -f "$RUN/owner.tmp" "$RUN/owner" \
    || { [ "$live" = 0 ] || record_env_stops "$RUN"; rmdir "$RUN/owner.lock"; finish stopped-environment "could not write $RUN/owner"; }
  [ "$live" = 0 ] || record_env_stops "$RUN"
  set_status running
  rmdir "$RUN/owner.lock"
  # This launch's operator actions, once per launch as the launch line is; a file ticket makes no GitHub call.
  if [ "${FACTORY_FROZEN:-}" != "$RUN/frozen/factory" ]; then
    # The issue's lint lines since the last launch: appended, then removed, so a relaunch does not count them twice.
    local pending="$RUNS_ROOT/$KEY/owner-events.jsonl"
    [ -f "$pending" ] && cat "$pending" >> "$RUN/owner-events.jsonl" && rm -f "$pending"
    owner_ran && owner_event "$RUN" run
    [ "$IS_FILE" = 1 ] || owner_events "$RUN" launch "$REPO" "$ISSUE" \
      || log "could not read the events of #$ISSUE for owner-events.jsonl; continuing"
  fi
  nav_arm_resolve   # NAV-01: fix this launch's arm before freeze and round 0, so the whole run carries one arm
  stop_requested && finish stopped "FACTORY_STOP is present at launch"
  assert_parallel
  prepare_worktree
  freeze
  exec_frozen
  heartbeat_start   # after the re-exec, so the loop's pid lives in the process that runs finish
  BODY=$(cat "$RUN/frozen/issue.md")   # from here on the frozen body is the ticket
  [ "$IS_FILE" = 1 ] && trap 'git -C "$MAIN_CHECKOUT" worktree remove --force "$WORKTREE" > /dev/null 2>&1' EXIT
  TIMEOUT_G=()
  command -v timeout > /dev/null 2>&1 && TIMEOUT_G=(timeout -k 5 "$CALL_TIMEOUT_SEC")
  # The advisor attaches through a feature flag claude fetches; two env vars turn it silently off.
  # Refuse to launch rather than run a worker that thinks it has an advisor and does not (F11).
  if [ -n "$WORKER_ADVISOR" ]; then
    { [ -n "${DISABLE_TELEMETRY+x}" ] || [ -n "${CLAUDE_CODE_DISABLE_ADVISOR_TOOL+x}" ]; } \
      && finish stopped-environment "the advisor would be silently off: DISABLE_TELEMETRY or CLAUDE_CODE_DISABLE_ADVISOR_TOOL is set"
    log "advisor: $WORKER_ADVISOR (the first worker call proves it attaches)"
  fi
  # A relaunch with an edited body is a new run over a ticket worktree the last run left ahead of
  # base, where the checks may already pass; round 0 runs at base in its own detached worktree, so
  # base is what it proves. A resume (round-0.checks present, written only by a clean round 0) leaves
  # round 0 out: the rounds on disk already proved base, and ROUND resumes past them.
  if [ ! -f "$RUN/round-0.checks" ]; then
    round_zero
  else
    ROUND=$(last_round "$RUN")
    log "resuming after round $ROUND"
    # The cap spans relaunches: count the graded rounds (a graded.sha) whose graders failed, which is a judge
    # verdict other than pass or a non-empty fixes file, since a reviewer or Codex block always queues a fix there
    # and a judge pass queues none. A pass whose push or PR create failed has a graded.sha but is not a fail.
    local g
    for g in "$RUN"/round-*.graded.sha; do
      [ -e "$g" ] || continue
      g=${g%.graded.sha}
      { [ -s "$g.fixes" ] || [ "$(jq -r .verdict "$g.judge.json" 2> /dev/null)" != pass ]; } && GRADER_FAILS=$((GRADER_FAILS + 1))
    done
    # A publish whose push or PR create failed left its decision in publish.intent (open_pr): while HEAD is still the
    # sha it graded, replay it, ready or draft, with no new worker round. A moved HEAD resumes as below.
    local intent_sha="" intent_draft=""
    [ -f "$RUN/publish.intent" ] && read -r intent_sha intent_draft < "$RUN/publish.intent"
    if [ -n "$intent_sha" ] && [ "$intent_sha" = "$(git -C "$WORKTREE" rev-parse HEAD)" ]; then
      check_frozen   # freeze returns early on a resume, so re-hash here as main_loop does before each round
      GRADED_SHA=$intent_sha
      log "a publish${intent_draft:+ as a draft ($intent_draft)} at HEAD $GRADED_SHA did not finish; publishing it again with no worker round"
      open_pr ${intent_draft:+"$intent_draft"}
    # A round whose graders passed at HEAD with nothing blocking but crashed before open_pr wrote publish.intent: publish
    # it, with no new worker round. A judge fail, a blocking finding, or a moved HEAD resumes into the loop.
    elif [ "$(jq -r .verdict "$RUN/round-$ROUND.judge.json" 2> /dev/null)" = pass ] && [ -z "$(blocking_findings)" ] \
      && [ -s "$RUN/round-$ROUND.graded.sha" ] && [ "$(cat "$RUN/round-$ROUND.graded.sha")" = "$(git -C "$WORKTREE" rev-parse HEAD)" ]; then
      GRADED_SHA=$(cat "$RUN/round-$ROUND.graded.sha")
      log "round $ROUND passed the graders at HEAD $GRADED_SHA; opening the PR with no worker round"
      check_frozen   # freeze returns early on a resume, so re-hash here as main_loop does before each round
      open_pr
    # A round whose checks passed on a clean tree but whose graders never finished (a cap or FACTORY_STOP before
    # a grader call) is graded now, so the relaunch does not pay for, or cap out on, a new worker round. HEAD may
    # have moved while the run was stopped, so its checks run again at HEAD first, and only a pass is graded.
    elif [ "$ROUND" -ge 1 ] && ! grep -q '^FAIL' "$RUN/round-$ROUND.checks" \
      && [ "$(tail -n 1 "$RUN/round-$ROUND.checks")" = CHECKS-END ] && [ ! -e "$RUN/round-$ROUND.graded.sha" ] \
      && [ -z "$(git -C "$WORKTREE" status --porcelain)" ]; then
      check_frozen
      round_checks "$RUN/round-$ROUND.checks"
      if grep -q '^FAIL' "$RUN/round-$ROUND.checks"; then
        log "round $ROUND's graders did not finish, and its checks now fail at HEAD; resuming into the loop"
      else
        log "round $ROUND's graders did not finish, and its checks pass again at HEAD; grading it with no worker round"
        grade_round
      fi
    fi
  fi
  main_loop
}

# ---- owner-events.jsonl: the operator actions a run can see (ARCHITECTURE.md, Metrics) ----------------------
# One JSON line per action, {"phase":"launch"|"pr","kind":...,"at":...}, and an "id" on a GitHub event, so a
# relaunch does not add one twice. A subcommand counts only when the operator ran it: not from inside a model
# call (FACTORY_CALL_TAG), the worker's Stop hook (LOAM_HOOK) or a Claude Code session (CLAUDECODE: the stage-2
# session lints its own tickets, and an agent's command is not the operator's action), and a `run` not from next's
# timer (FACTORY_BY_NEXT). The count stays a lower bound: an operator's own command in Claude Code is left out too.
owner_ran() {
  [ -z "${FACTORY_CALL_TAG:-}" ] && [ -z "${LOAM_HOOK:-}" ] && [ -z "${CLAUDECODE:-}" ] && [ -z "${FACTORY_BY_NEXT:-}" ]
}
owner_event() { # run-dir kind
  mkdir -p "$1" && printf '{"phase":"launch","kind":"%s","at":"%s"}\n' "$2" "$(now)" >> "$1/owner-events.jsonl"
}
# The runner's gh account is the operator's (step 2 assigns the issue to @me), so the operator's events are that
# login's, less what the factory does with it: it assigns the issue and its notify fallback comments `**title**`.
# So only OWNER_KINDS count, a label set as the issue is created is part of its `opened`, and a merge's own
# `closed` is not a second action.
OWNER_KINDS='^(labeled|unlabeled|renamed|commented|closed|reopened|reviewed|merged|ready_for_review|convert_to_draft|review_requested|head_ref_force_pushed)$'
owner_events() { # run-dir phase repo number -> appends the operator's events on that issue or PR; non-zero on a gh failure
  local f="$1/owner-events.jsonl" me head events
  me=$(net gh api user --jq .login 2> /dev/null) && [ -n "$me" ] || return 1
  head=$(net gh api "repos/$3/issues/$4" --jq '"\(.user.login) \(.created_at)"' 2> /dev/null) || return 1
  events=$(net gh api "repos/$3/issues/$4/timeline" --paginate --jq '.[] | {actor: (.actor.login // .user.login // ""),
    kind: (.event // ""), id: ((.id // .node_id // "") | tostring), at: (.created_at // .submitted_at // ""),
    notify: ((.body // "") | startswith("**"))} | @json' 2> /dev/null) || return 1
  touch "$f" || return 1
  printf '%s\n' "$events" | jq -c -s --arg me "$me" --arg phase "$2" --arg author "${head%% *}" --arg created "${head#* }" \
    --arg kinds "$OWNER_KINDS" --slurpfile have "$f" '
    [$have[] | select(.phase == $phase) | .id // empty] as $ids | any(.[]; .kind == "merged") as $merged
    | (if $phase == "launch" and $author == $me then [{actor: $me, kind: "opened", id: "opened", at: $created}] else [] end) + .
    | .[] | select(.actor == $me and (.kind == "opened" or (.kind | test($kinds))))
    | select((.kind == "closed" and $merged) or ((.kind | endswith("labeled")) and .at == $created)
             or (.kind == "commented" and .notify == true) | not)
    | select(.id as $i | ($ids | index($i)) == null)
    | {phase: $phase, kind, id, at}' >> "$f"
}

# The PR a pr-opened run opened, from its EXIT line; empty for a file-ticket rehearsal, which opens none.
pr_url_of() { # <run dir>
  sed -n 's#^[^ ]* EXIT pr-opened ([0-9]*): \(https://github\.com/[^/ ]*/[^/ ]*/pull/[0-9]*\).*#\1#p' \
    "$1/factory.log" 2> /dev/null | tail -1
}

# The PR phase: a pr-opened run whose PR has closed (merged or not: the issues API reads both as closed) gets the
# operator's events on it, once (pr-closed marks it). A gh failure leaves the run for the next tick and never stops one.
pr_closed_events() {
  local d url repo num
  for d in "$RUNS_ROOT"/*/*/; do
    [ "$(cat "$d/status" 2> /dev/null)" = pr-opened ] && [ ! -e "$d/pr-closed" ] || continue
    url=$(pr_url_of "$d")
    [ -n "$url" ] || continue
    repo=${url#https://github.com/}; repo=${repo%/pull/*}; num=${url##*/}
    [ "$(net gh api "repos/$repo/issues/$num" --jq .state 2> /dev/null)" = closed ] || continue
    owner_events "$d" pr "$repo" "$num" && now > "$d/pr-closed"
  done
  return 0
}

cmd_stop() { # <issue|stem>
  local d n=0
  for d in "$RUNS_ROOT/$1"/*/; do
    [ -d "$d" ] || continue
    : > "$d/FACTORY_STOP"; n=$((n + 1))
    owner_ran && owner_event "$d" stop
    echo "FACTORY_STOP written to $d"
  done
  [ "$n" -gt 0 ] || { echo "factory stop: no run directory under $RUNS_ROOT/$1" >&2; return 1; }
}

# The manager's merge (LOOP.md, Status and the manager): <pr> merges only when <sha> is its head and every check
# reported at that head passed, read in one gh call; gh pr merge then gets --match-head-commit <sha>, so GitHub
# itself refuses a head that moved after the read. A CheckRun passes COMPLETED with SUCCESS or NEUTRAL, a
# StatusContext with SUCCESS; any other value refuses. A PR with no reported check is refused, not waited on.
# <pr> is a number of at most nine digits, since gh lets a PR URL override -R and reads a number it cannot parse as a branch; <sha> is a full lowercase sha, since gh drops an empty
# --match-head-commit and so would merge with no head guard.
cmd_merge() { # <pr> <sha>
  local pr="$1" sha="$2" repo view head bad
  [[ $pr =~ ^[1-9][0-9]{0,8}$ ]] || { echo "merge: refused: $pr is not a PR number" >&2; return 1; }
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || { echo "merge: refused: $sha is not a full lowercase commit sha" >&2; return 1; }
  repo=$(target_repo)
  view=$(net gh pr view "$pr" -R "$repo" --json headRefOid,statusCheckRollup) \
    || { echo "merge: refused: gh pr view $pr failed" >&2; return 1; }
  head=$(jq -r '.headRefOid // ""' <<<"$view" 2> /dev/null) \
    || { echo "merge: refused: gh pr view $pr printed no JSON" >&2; return 1; }
  [ "$head" = "$sha" ] || { echo "merge: refused: head of #$pr is ${head:-unknown}, not $sha" >&2; return 1; }
  case "$(jq -r '.statusCheckRollup // [] | if type != "array" then "bad" elif length == 0 then "none" else "ok" end' \
           <<<"$view" 2> /dev/null)" in
    ok) ;;
    none) echo "merge: refused: no check reported at $sha" >&2; return 1 ;;
    *) echo "merge: refused: unreadable statusCheckRollup at $sha" >&2; return 1 ;;
  esac
  bad=$(jq -r '[.statusCheckRollup[]
    | if .__typename == "CheckRun" then
        select(.status != "COMPLETED" or (.conclusion != "SUCCESS" and .conclusion != "NEUTRAL"))
        | "\(.name) \(.status)/\(.conclusion)"
      elif .__typename == "StatusContext" then select(.state != "SUCCESS") | "\(.context) \(.state)"
      else "\(.__typename) entry" end] | join(", ")' <<<"$view") \
    || { echo "merge: refused: unreadable statusCheckRollup at $sha" >&2; return 1; }
  [ -z "$bad" ] || { echo "merge: refused: not passed at $sha: $bad" >&2; return 1; }
  net gh pr merge "$pr" -R "$repo" --merge --match-head-commit "$sha"
}

run_dir_of() { # <issue> <body> -> the run dir cmd_run names for this body
  printf '%s/%s/%s' "$RUNS_ROOT" "$1" "$(printf '%s' "$2" | sha256_of | cut -c1-8)"
}

park_status() { # <issue> <body> -> the status of the run for this body, or none
  cat "$(run_dir_of "$1" "$2")/status" 2> /dev/null || echo none
}

stopped_daily_today() { # <run dir> -> 0 when its run stopped at the daily budget on today's UTC date
  [ "$(cat "$1/status" 2> /dev/null)" = stopped-daily ] && [ "$(date -u -r "$1/status" +%Y-%m-%d)" = "$(today)" ]
}

# stopped-environment pages at once, so a lasting machine fault relaunched every ten-minute tick would page every tick.
ENV_BACKOFF_SEC=3600
stopped_environment_recent() { # <run dir> -> 0 when its run stopped on the environment under ENV_BACKOFF_SEC ago
  local t
  [ "$(cat "$1/status" 2> /dev/null)" = stopped-environment ] || return 1
  # A status file removed since the cat leaves no mtime: not recent, rather than an arithmetic error ending the tick.
  t=$(date -u -r "$1/status" +%s 2> /dev/null)
  [[ "$t" =~ ^[0-9]+$ ]] || return 1
  [ $(( $(date -u +%s) - t )) -lt "$ENV_BACKOFF_SEC" ]
}

# A worker call with no result event is charged ROUND_BUDGET_USD and stops stopped-environment before its round-N.checks
# is written, and a relaunch rebuilds ROUND from round-*.checks, so the same round reruns and MAX_ROUNDS never trips (#547).
# So each launch, with its first status write and in the live checkout (a run frozen before this counts too), writes
# env-stops, `<last round> <stops> <launches>` (record_env_stops): the stopped-environment stops since the highest
# round-N.checks last moved. A new round or a pr-opened clears them; any other status, such as a stopped-daily or stopped
# that made no worker call, keeps them, so it does not reset the count. next parks the issue at ENV_PARK_STOPS.
# The launch number makes each line unique, so env_park_alert can name the stop it alerted for.
ENV_PARK_STOPS=3
last_round() { # <run dir> -> the highest N of its round-N.checks, or -1
  local n
  n=$(find "$1" -maxdepth 1 -name 'round-*.checks' | sed -n 's/.*round-\([0-9][0-9]*\)\.checks$/\1/p' | sort -n | tail -1)
  echo "${n:--1}"
}
env_stops() { # <run dir> -> its stopped-environment stops with no new round-N.checks since, the last run's own status counted
  local r0="" c0=""
  read -r r0 c0 _ 2> /dev/null < "$1/env-stops" || true
  { [[ "$c0" =~ ^[0-9]+$ ]] && [ "$r0" = "$(last_round "$1")" ]; } || c0=0
  case "$(cat "$1/status" 2> /dev/null)" in
    stopped-environment) echo $((c0 + 1)) ;;
    pr-opened) echo 0 ;;
    *) echo "$c0" ;;
  esac
}
record_env_stops() { # <run dir>, at launch while its status is still the last run's
  local n=""
  read -r _ _ n 2> /dev/null < "$1/env-stops" || true
  [[ "$n" =~ ^[0-9]+$ ]] || n=0
  printf '%s %s %s\n' "$(last_round "$1")" "$(env_stops "$1")" $((n + 1)) > "$1/env-stops.tmp" \
    && mv -f "$1/env-stops.tmp" "$1/env-stops"
}
env_parked() { # <run dir> -> 0 when its run stopped on the environment for the ENV_PARK_STOPS-th time with no new round since
  [ "$(cat "$1/status" 2> /dev/null)" = stopped-environment ] && [ "$(env_stops "$1")" -ge "$ENV_PARK_STOPS" ]
}
# One needs-you alert per parked stop, not one per tick: env-parked keeps the env-stops line the alert went out for. The
# line is read once, and that same line is written after the alert, so a launch that rewrites env-stops meanwhile keeps
# its own alert. Alerts are serialized by next.lock, which the runner's cron line and bin/overnight/driver.sh take
# (flock -n) around next; a next run by hand outside it can at worst send one duplicate alert (accepted).
env_park_alert() { # <run dir> <issue>
  local token
  # A launch writes env-stops and its status under owner.lock, so the line and the park are read together; the lock is
  # released before bin/alert, and one held elsewhere leaves the alert to a later tick.
  owner_lock "$1" 1 || return 0
  token=$(cat "$1/env-stops" 2> /dev/null) && env_parked "$1" || token=""
  rmdir "$1/owner.lock"
  [ -n "$token" ] && [ "$token" != "$(cat "$1/env-parked" 2> /dev/null)" ] || return 0
  if alert --level needs-you --source factory --project "$(run_project "$1")" --run "issue $2" \
    "issue $2 stopped on a machine or tool problem $ENV_PARK_STOPS times in a row with no new round since, so the timer \
no longer relaunches it; fix the cause, then relaunch it by hand or edit the body (run dir ${1%/})" >> "$LOG" 2>&1; then
    printf '%s\n' "$token" > "$1/env-parked"
  else
    log "the alert for ${1%/} failed; see bin/alert's line above"
  fi
}

# cmd_run refuses a relaunch, exiting 4 with no status written, while a process of the run's last launch holds its
# lease or the model call its `call` names still lives (a stuck call outlives finish); holds_slot frees a stopped run's
# slot all the same, so without this the issue would take the pick from every later candidate each tick.
run_busy() { # <run dir> -> 0 while a process cmd_run would refuse a relaunch on still runs
  local fd st
  call_live "$1" && return 0
  [ -n "$HAVE_FLOCK" ] && [ -f "$1/lease" ] && exec {fd}< "$1/lease" || return 1
  flock -n "$fd"; st=$?
  exec {fd}>&-
  [ "$st" != 0 ]
}

# Every body of an issue shares its branch and its worktree ($MAIN_CHECKOUT-<key>), so while a run of any body holds a
# slot, still runs a process, or awaits merge, no other body launches. A run awaits merge while it is pr-opened with a PR
# and no pr-closed marker, whatever its worktree: the overnight driver removes the worktree of a PR it leaves open, and
# a closed PR's worktree may stay. next writes the marker (pr_closed_events) before it reads candidates, so a gh
# failure holds the issue one more tick, never frees it early.
issue_busy() { # <key> <run dir to leave out, or ""> [peek] -> 0 while such a run exists
  local d
  for d in "$RUNS_ROOT/$1"/*/; do
    [ -d "$d" ] && [ "${d%/}" != "${2%/}" ] || continue
    holds_slot "$d" "${3-}" || run_busy "$d" && return 0
    [ "$(cat "$d/status" 2> /dev/null)" = pr-opened ] && [ ! -e "$d/pr-closed" ] && [ -n "$(pr_url_of "$d")" ] && return 0
  done
  return 1
}

# The issue has a run dir of some body: a runner-assigned issue at none then has an edited body, not a hand hold.
ran_before() { # <key>
  local d
  for d in "$RUNS_ROOT/$1"/*/; do [ -d "$d" ] && return 0; done
  return 1
}

# A ticket's Worker section can lower its own caps, so its daily stop alone does not show the shared ledger is spent.
daily_spent_at_runner_caps() { # -> 0 when the shared daily ledger has no room for one round at the runner's own caps
  ( BODY=""; apply_caps; DAILY="$RUNS_BASE/ledger-daily.jsonl"; [ -f "$DAILY" ] || exit 1
    jq -en --argjson a "$(daily_spent)" --argjson b "$ROUND_BUDGET_USD" --argjson c "$DAILY_BUDGET_USD" '($a + $b) > $c' > /dev/null )
}

# The F9 frontier timer's one step: launch the next unblocked ready-for-agent ticket, or say why not.
# --dry-run reports without launching or pulling, so a check can run it from inside a worktree.
# --install writes the ten-minute runner timer from bin/factory.d/next.crontab.
cmd_next() { # [--dry-run|--install]
  local dry=0 do_install=0 a
  for a in "$@"; do
    case "$a" in
      --dry-run) dry=1 ;;
      --install) do_install=1 ;;
      *)         usage next ;;
    esac
  done

  if [ "$do_install" = 1 ]; then
    local tmpl="$ROOT/bin/factory.d/next.crontab"
    [ -f "$tmpl" ] || { echo "factory next --install: no template at $tmpl" >&2; return 1; }
    command -v crontab > /dev/null 2>&1 || { echo "factory next --install: crontab not found" >&2; return 1; }
    # Install the cron line only (the comments would accumulate on reinstall); grep -vF strips the
    # prior copy so the result is idempotent.
    # The template names ~/Desktop/loam; the installed line names the checkout that ran --install, and
    # another target by -C, so each target keeps one line and a reinstall strips only its own (F8).
    local line cmd="bin/factory next"
    target_is_loam || cmd="bin/factory -C $TARGET next"
    line=$(grep -v '^#' "$tmpl" | grep -m1 . | sed -e "s|cd ~/Desktop/loam|cd $ROOT|" -e "s|bin/factory next|$cmd|")
    ( crontab -l 2> /dev/null | grep -vF "$cmd"; printf '%s\n' "$line" ) | crontab - \
      || { echo "factory next --install: crontab rejected the update" >&2; return 1; }
    echo "installed: $line"
    return 0
  fi

  # 1. FACTORY_STOP at the runs root pauses the timer.
  if [ -f "$RUNS_ROOT/FACTORY_STOP" ]; then
    echo paused
    return 0
  fi

  # 1b. A logged-out Claude fails every worker call (#78), so the timer refuses to launch rather than
  #     assign the ticket, run round 0, and page the owner when the first call fails. The probe is
  #     read-only and shared with precondition_lines; it runs under --dry-run too, since a check from
  #     inside a worktree may run it. The line goes to stderr (cron mails it) and returns 1, the same
  #     shape as `frontier query failed`; the ticket stays unassigned and launches on the first tick
  #     after the login returns. The target gate works the same way: it refuses Loam without the toolchain
  #     exports and another target without a bin/check, which would fail guard bin/check after its work (#158).
  assert_target_ready || return 1
  if ! claude_logged_in; then
    echo "login expired: claude auth status reports logged out; run claude login on the runner" >&2
    return 1
  fi
  local cv
  if ! cv=$(claude_version_ok); then
    echo "claude too old or unreadable: claude --version reports '$cv'; the factory needs Claude Code $CLAUDE_MIN_VERSION+" >&2
    return 1
  fi

  # 1c. Each closed PR's operator events, for status --criteria, on every tick the gates pass, before a full slot
  #     can return; not under --dry-run, which writes nothing.
  [ "$dry" = 1 ] || pr_closed_events

  # 2. A run holds a slot when holds_slot says so (assert_parallel's rule: running or waiting-limit with a
  #    live owner, or launched with no status yet), and so does a pr-opened run whose ticket worktree still exists: the merge ritual removes the worktree,
  #    so until then the PR awaits merge and the next ticket waits (LOOP.md: after each merge).
  #    FACTORY_MAX_PARALLEL bounds the count, as it does in cmd_run through apply_caps; default 1.
  #    --dry-run asks with peek, so a run holds_slot would reap counts free and is not reaped or alerted on.
  local d st n=0 max="${FACTORY_MAX_PARALLEL:-$MAX_PARALLEL}" peek=
  [ "$dry" = 1 ] && peek=peek
  for d in "$RUNS_ROOT"/*/*/; do
    st=$(cat "$d/status" 2> /dev/null || true)
    if [ "$st" = pr-opened ]; then
      [ -d "$MAIN_CHECKOUT-$(basename "$(dirname "$d")")" ] && n=$((n + 1))
      continue
    fi
    holds_slot "$d" "$peek" || continue
    n=$((n + 1))
  done
  if [ "$n" -ge "$max" ]; then
    echo "nothing to launch"
    return 0
  fi

  # 3. Fast-forward the checkout next runs from, so a merged loop change reaches the supervisor
  #    (freeze copies bin/factory from here) before the launch. Never under --dry-run, and only
  #    with a clean tree, since a dirty tree would abort the --ff-only merge mid-launch.
  #    A refused pull is logged (log writes to stderr, which cron mails) and never aborts the launch:
  #    the run proceeds on the stale checkout, with the cause on record. Another target's checkout is
  #    pulled the same way, since lint and the standing list read its tree (F8).
  if [ "$dry" = 0 ]; then
    local co pulls=("$ROOT")
    target_is_loam || pulls+=("$TARGET")
    for co in "${pulls[@]}"; do
      if [ "$(git -C "$co" rev-parse --abbrev-ref HEAD 2> /dev/null)" != main ]; then
        log "refused pull of $co: not on main"
      elif [ -n "$(git -C "$co" status --porcelain 2> /dev/null)" ]; then
        log "refused pull of $co: dirty checkout"
      elif ! net git -C "$co" fetch -q origin 2> /dev/null; then
        log "refused pull of $co: git fetch origin failed, or got no reply in ${NET_TIMEOUT_SEC}s"
      elif ! git -C "$co" merge --ff-only origin/main > /dev/null 2>&1; then
        log "refused pull of $co: not fast-forward"
      fi
    done
    # 3b. The pull may bring a judge.md or reviewer.md the plugin cache does not hold yet. A launched run would
    #     assign the ticket and then stop at freeze, and the frontier skips assigned issues, so every tick
    #     would burn one more ticket; refuse on stderr with grader_file's line, as the login gate does.
    #     Not under --dry-run: a check in a worktree whose grader edit is not installed runs it.
    local g
    for g in judge reviewer; do grader_file "$g" > /dev/null || return 1; done
  fi

  # 4. The frontier: open, ready-for-agent, unassigned issues with no open native blocker, lowest
  #    number first, plus the runner's own such issues whose current body has no run yet or whose run ended stopped-daily,
  #    stopped-environment or stopped. A gh failure (offline, unauthenticated, off cron's PATH, empty repo) prints
  #    `frontier query failed` and returns 1, so cron mails it rather than the timer stalling silent;
  #    only a successful, empty query falls through to `nothing to launch`.
  local repo ready num b64 body
  repo=$(target_repo)
  if [ -z "$repo" ]; then
    echo "frontier query failed: $TARGET has no GitHub origin" >&2
    return 1
  fi
  if ! ready=$(net gh api "repos/$repo/issues?labels=ready-for-agent&state=open&assignee=none&per_page=100" \
    --jq 'sort_by(.number)[] | select(.pull_request == null) | select(.issue_dependencies_summary.blocked_by == 0) | "\(.number) \(.user.login) \(.body // "" | @base64)"' 2> /dev/null); then
    echo "frontier query failed: gh api issues (failed, or no reply in ${NET_TIMEOUT_SEC}s)" >&2
    return 1
  fi
  # A launch assigns the issue to the runner and nothing unassigns it, so a relaunchable run's issue comes from
  # the runner's own ready-for-agent issues in this repository (/issues is the authenticated user's, so no login
  # lookup, and every page, since it spans all the runner's repositories and gh applies --jq per page); the loop takes
  # one of those only at none with a run of an earlier body (an edited body is a new ticket; with no run at all the
  # owner assigned it by hand to hold it), stopped-daily,
  # stopped-environment or stopped, since any other is in flight, awaits merge, or parks.
  local mine lrepo
  lrepo=$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')
  if ! mine=$(net gh api "/issues?filter=assigned&labels=ready-for-agent&state=open&per_page=100" --paginate \
    --jq '.[] | select(.pull_request == null) | select((.repository.full_name // "" | ascii_downcase) == "'"$lrepo"'") | select(.issue_dependencies_summary.blocked_by == 0) | "\(.number) \(.user.login) \(.body // "" | @base64)"' 2> /dev/null); then
    echo "frontier query failed: gh api issues assigned to the runner (failed, or no reply in ${NET_TIMEOUT_SEC}s)" >&2
    return 1
  fi

  # The run of the issue's current body decides (park_status): no such run launches; stopped-environment
  # and stopped relaunch (the environment, not the ticket, ended them), stopped-environment only ENV_BACKOFF_SEC after
  # the mtime of its status file, since it pages at once; every other exit parks the issue
  # until a human edits the body or removes the label, since the same body would fail the same way.
  # stopped-daily relaunches once the UTC date of its status file has passed, and until then waits without
  # launching, so the timer does not spin the issue against the spent budget every tick.
  # A run of an earlier body no longer parks the issue, so an edited body launches on the next tick.
  # The body travels as base64 so its newlines stay on one line; $(...) strips its trailing newlines
  # the way load_ticket's $(jq -r .body) of its gh api graphql read does, so the key matches the one cmd_run computes.
  # A ticket at pr-opened is assigned at launch, so it is skipped among the runner's own; if a human
  # unassigns it, its slot is already counted above while its worktree exists.
  # A launchable body is linted first (#314): the label alone does not make an issue a ticket, and a run of
  # a body with no done-checks block would burn a round. lint_body runs in a subshell on the body in hand
  # (no second gh call), its stdout dropped; its first LINT line is reported the way a parked issue is
  # (bash -n prints its own line about the deleted temp file first; the first line is the fallback),
  # and the frontier goes on to the next candidate, so one bad issue does not stall the timer.
  # Before lint, the owner check: the worker runs the body unattended and Loam is public, so a body another account
  # wrote, or last edited (GraphQL's editor, null for a body never edited), is passed over, and so is one whose
  # editor gh could not read, or a null editor with a lastEditedAt (an account GitHub no longer names; jq names it
  # "(unnamed)", which no login can be). Once a candidate is picked, later ones skip the editor call, so a stalled
  # GraphQL costs a tick one timeout, not one per candidate; they still get the author and lint lines.
  # </dev/null keeps gh off the candidate list this loop reads on stdin. This check only
  # picks; load_ticket checks the owner again on the body the run freezes.
  local pick="" st_last lint_err lint_line author editor run
  while read -r who num author b64; do
    [ -n "$num" ] || continue
    body=$(printf '%s' "$b64" | base64 -d)
    st_last=$(park_status "$num" "$body")
    if [ "$who" = mine ]; then
      case "$st_last" in
        none) ran_before "$num" || continue ;;
        stopped-daily|stopped-environment|stopped) ;;
        *) continue ;;
      esac
    fi
    run=$(run_dir_of "$num" "$body")
    # cmd_run exits stopped at once while the run dir holds FACTORY_STOP (bin/factory stop), so the issue is skipped,
    # without a line, until the operator removes the file; otherwise it would take the pick from every later candidate each tick.
    [ -f "$run/FACTORY_STOP" ] && continue
    if env_parked "$run"; then
      echo "parked #$num: stopped on the environment $ENV_PARK_STOPS times in a row with no new round since; fix the cause, then relaunch it by hand or edit the body" >&2
      [ "$dry" = 1 ] || env_park_alert "$run" "$num"
      continue
    fi
    if stopped_daily_today "$run"; then
      echo "waiting #$num: daily budget spent; relaunches after 00:00 UTC" >&2
      continue
    fi
    if stopped_environment_recent "$run"; then
      echo "waiting #$num: last run stopped on the environment; relaunches ${ENV_BACKOFF_SEC}s after its stop" >&2
      continue
    fi
    case "$st_last" in
      none|stopped-environment|stopped|stopped-daily)
        if run_busy "$run"; then
          echo "waiting #$num: a process of its last run still runs; kill it or wait for it to exit" >&2
          continue
        fi
        if issue_busy "$num" "" "$peek"; then
          echo "waiting #$num: a run of another body still runs or awaits merge; it shares the issue's worktree" >&2
          continue
        fi
        if [ "$author" != "$TICKET_OWNER" ]; then
          echo "not owner #$num: written or last edited by $author; edit the body as $TICKET_OWNER or remove ready-for-agent" >&2
          continue
        fi
        if [ -z "$pick" ]; then
          if ! editor=$(net gh api graphql -f owner="${repo%%/*}" -f name="${repo#*/}" -F number="$num" \
            -f query='query($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { issue(number: $number) { editor { login } lastEditedAt } } }' \
            --jq '.data.repository.issue | .editor.login // (if .lastEditedAt then "(unnamed)" else "" end)' < /dev/null 2> /dev/null); then
            echo "not owner #$num: could not read the last editor with gh (failed, or no reply in ${NET_TIMEOUT_SEC}s); passed over" >&2
            continue
          fi
          if [ "$editor" = "(unnamed)" ]; then
            echo "not owner #$num: last edited by an account GitHub no longer names; edit the body as $TICKET_OWNER or remove ready-for-agent" >&2
            continue
          fi
          if [ -n "$editor" ] && [ "$editor" != "$TICKET_OWNER" ]; then
            echo "not owner #$num: written or last edited by $editor; edit the body as $TICKET_OWNER or remove ready-for-agent" >&2
            continue
          fi
        fi
        if ! lint_err=$( { SRC="#$num"; BODY="$body"; ERRS=0; lint_body > /dev/null; } 2>&1 ); then
          lint_line=$(grep -m1 "^LINT #$num: " <<<"$lint_err") || lint_line=${lint_err%%$'\n'*}
          lint_err=${lint_line#"LINT #$num: "}
          echo "lint failed #$num: $lint_err; edit the body or remove ready-for-agent" >&2
        elif [ -z "$pick" ]; then
          pick="$num"
        fi ;;
      pr-opened) ;;
      *) echo "parked #$num: last run exited $st_last; edit the body or remove ready-for-agent" >&2 ;;
    esac
  done <<< "$( { sed 's/^/none /' <<< "$ready"; sed 's/^/mine /' <<< "$mine"; } | sort -s -n -k2,2 )"

  # A run stopped at today's daily budget, with the shared ledger (RUNS_BASE, every target's) also spent at the
  # runner's own caps, means a new launch would only assign, build, run round 0 and stop at its first cap check;
  # nothing launches today. The stop alone is not enough: that run's ticket may have set a lower DAILY_BUDGET_USD.
  if [ -n "$pick" ] && daily_spent_at_runner_caps; then
    for d in "$RUNS_BASE"/*/*/ "$RUNS_BASE"/*/*/*/; do
      stopped_daily_today "$d" || continue
      echo "waiting: a run stopped at today's daily budget; nothing launches before 00:00 UTC" >&2
      pick=""; break
    done
  fi

  if [ -z "$pick" ]; then
    echo "nothing to launch"
    return 0
  fi
  if [ "$dry" = 1 ]; then
    echo "would launch #$pick"
    return 0
  fi

  # Launch bin/factory run <N> detached in one tmux session per issue, output appended to the runs root.
  # Another target's session is named by its slug, with . and : (which tmux refuses in a name) as _, so
  # #12 of two repositories never shares a session.
  local sess="loam-$pick" envs=(-e FACTORY_BY_NEXT=1)   # a timer launch is not an operator's run (owner-events.jsonl)
  target_is_loam || sess="$(target_slug | tr '.:' '__')-$pick"
  if tmux has-session -t "$sess" 2> /dev/null; then
    echo "nothing to launch"
    return 0
  fi
  # cmd_run creates the run dir, but the detached shell opens the tmux log first; on a fresh install
  # RUNS_ROOT does not exist yet, so the redirection would fail before the run ever starts.
  # tmux gives the session the tmux server's environment, not this shell's, so the toolchain exports
  # checked above travel with -e; a server started without them would make the run exit 4 unrecorded.
  mkdir -p "$RUNS_ROOT"
  target_is_loam && envs+=(-e "LOAM_FACTORY_TOOLCHAIN=$LOAM_FACTORY_TOOLCHAIN" -e "LOAM_FACTORY_COPIER=$LOAM_FACTORY_COPIER")
  # The FACTORY_<NAME> caps travel too: without them the run fell back to MAX_PARALLEL=1, so every launch that
  # next's FACTORY_MAX_PARALLEL=2 allowed beside a live run stopped at once as a machine problem.
  local cap v
  for cap in $CAP_NAMES; do v="FACTORY_$cap"; [ -z "${!v:-}" ] || envs+=(-e "$v=${!v}"); done
  if tmux new-session -d -s "$sess" "${envs[@]}" "cd '$ROOT' && bin/factory -C '$TARGET' run $pick >> '$RUNS_ROOT/$pick.tmux.log' 2>&1"; then
    echo "launched #$pick"
  else
    echo "launch failed: tmux new-session -s $sess" >&2
    return 1
  fi
}

cmd_status() {
  local d led st rounds spend wall den grader clean notes off warns=""
  printf '%-14s %-9s %-20s %6s %8s %6s %8s %-22s %-5s %s\n' \
    ticket sha8 status rounds spend wall denials first-failing-grader clean notes
  for d in "$RUNS_ROOT"/*/*/; do
    [ -f "$d/status" ] || continue
    led="$d/ledger.jsonl"
    st=$(cat "$d/status")
    rounds=$(find "$d" -maxdepth 1 -name 'round-*.checks' 2> /dev/null | grep -vc 'round-0' || true)
    spend=$(jq -s '[.[].cost_usd // 0] | add // 0 | . * 100 | round / 100' "$led" 2> /dev/null || echo 0)
    wall=$(( ( $(date -u +%s) - $(cat "$d/started" 2> /dev/null || date -u +%s) ) / 60 ))
    den=$(jq -s '[.[].denials // 0] | add // 0' "$led" 2> /dev/null || echo 0)
    grader=$(grader_first_fail "$d")
    clean=$(run_clean "$d")
    notes=""
    [ -f "$d/notify.failed" ] && notes="notify.failed"
    [ -f "$d/FACTORY_STOP" ] && notes="$notes FACTORY_STOP"
    printf '%-14s %-9s %-20s %6s %8s %5sm %8s %-22s %-5s %s\n' \
      "$(basename "$(dirname "$d")")" "$(basename "$d")" "$st" "$rounds" "$spend" "$wall" "$den" "${grader:--}" "$clean" "$notes"
    off=$(off_models < "$led" 2> /dev/null | jq -r 'join(", ")' 2> /dev/null || true)
    [ -n "$off" ] && warns+="  WARN $(basename "$(dirname "$d")")/$(basename "$d") served by $off"$'\n'
  done
  printf '%s' "$warns"
  printf '\n== worktrees and PRs\n'
  git -C "$MAIN_CHECKOUT" worktree list 2> /dev/null | sed 's/^/  /'
  net gh pr list -R "$(target_repo)" --json number,headRefName,title \
    --jq '.[] | select(.headRefName | startswith("factory/")) | "  #\(.number) \(.headRefName) \(.title)"' 2> /dev/null \
    || echo "  (no PR list: gh is unavailable from here; run status on the runner)"
  printf '\n== preconditions\n'
  precondition_lines
}

# The criteria and thresholds stay in ARCHITECTURE.md; criteria.py reads them there and calls only git log.
cmd_criteria() {
  python3 -I "$ROOT/bin/factory.d/criteria.py" "$RUNS_ROOT" "$ROOT/docs/factory/ARCHITECTURE.md" "$TARGET"
}

grader_first_fail() { # run dir -> the first grader item that failed in the last graded round
  local j r
  j=$(find "$1" -maxdepth 1 -name 'round-*.judge.json' 2> /dev/null | sort -V | tail -1)
  [ -n "$j" ] || return 0
  # A judge fail with every row pass still fails the round, on its fixes or backlog (verdict_consistent).
  r=$(grader_fallback "$j" judge || jq -r 'first(((.rows // {}) | to_entries[] | select(.value != "pass") | "judge:" + .key),
    (select(.verdict == "fail") | "judge:fail"))' "$j" 2> /dev/null)
  [ -n "$r" ] || r=$(grader_fallback "${j%judge.json}review.json" review \
    || jq -r 'first('"$REVIEW_BLOCKING"'[] | "review:" + (.file // "?")) // empty' "${j%judge.json}review.json" 2> /dev/null)
  printf '%s' "$r"
}

# call_json writes one fallback whether no reply parsed or the last parsed but contradicted its own lists, so the
# last raw reply, read as call_json reads it, tells an inconsistent grader from an unreadable one.
grader_fallback() { # grader json, grader name -> <grader>:inconsistent|unparseable; 1 when the json is the grader's own
  jq -e '.unparseable == true' "$1" > /dev/null 2>&1 || return 1
  if grader_reply "${1%json}raw.3.json" | jq -e '.verdict' > /dev/null 2>&1; then
    printf '%s:inconsistent' "$2"
  else
    printf '%s:unparseable' "$2"
  fi
}

# run_clean: yes|no|- for the status clean column (D09 Option A). A run is clean when it reached
# pr-opened with zero grader-fail rounds and no other exit on the way; a hand fix after pr-opened
# does not change it. From the run dir: status is pr-opened, the only EXIT line in factory.log is
# pr-opened, every round-<k>.fixes for k>=1 is empty (a grader that fails or blocks queues fixes
# there), and no grader reply was unparseable in any round (that queues no fix, but the grader never ran).
# `-` marks a run not yet at pr-opened.
run_clean() { # run dir -> yes|no|-
  local d="$1" f exits
  [ "$(cat "$d/status" 2> /dev/null)" = pr-opened ] || { printf -- '-'; return; }
  # A herestring of nothing is one empty line, which grep -v would match, so test for EXIT lines first.
  exits=$(grep -h ' EXIT ' "$d/factory.log" 2> /dev/null || true)
  [ -n "$exits" ] && grep -vq ' EXIT pr-opened ' <<<"$exits" && { printf 'no'; return; }
  for f in "$d"/round-*.fixes; do
    [ -e "$f" ] || continue
    case "$f" in */round-0.fixes) continue ;; esac
    [ -s "$f" ] && { printf 'no'; return; }
  done
  for f in "$d"/round-*.judge.json "$d"/round-*.review.json "$d"/round-*.codex-review.json; do
    [ -e "$f" ] || continue
    jq -e '.unparseable == true' "$f" > /dev/null 2>&1 && { printf 'no'; return; }
  done
  printf 'yes'
}

# claude on PATH is not claude logged in: a logged-out Claude fails every worker call while claude
# stays on PATH (#78). claude auth status prints JSON with a loggedIn boolean and exits 0 either way.
# One probe, shared by precondition_lines (its PASS/FAIL line) and cmd_next (its launch gate).
claude_logged_in() {
  claude auth status 2> /dev/null | jq -e '.loggedIn' > /dev/null 2>&1
}

# The worker call's CLAUDE_CODE_SUBAGENT_MODEL_FORCE exists from Claude Code 2.1.257; an older claude ignores
# it and lets a subagent run on the model its call names (#379). Prints what `claude --version` reported
# ("2.1.312 (Claude Code)"); 0 only when that parses and is at least 2.1.257. Shared like claude_logged_in.
CLAUDE_MIN_VERSION=2.1.257
claude_version_ok() {
  local raw a b c
  raw=$(claude --version 2> /dev/null | head -1)
  printf '%s' "${raw:-no output}"
  [[ $raw =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]] || return 1
  a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}; c=${BASH_REMATCH[3]}
  [ "$a" -ne 2 ] && { [ "$a" -gt 2 ]; return; }
  [ "$b" -ne 1 ] && { [ "$b" -gt 1 ]; return; }
  [ "$c" -ge 257 ]
}

precondition_lines() { # LOOP.md, Preconditions
  local t f sbx=
  # The worker's Bash sandbox needs bubblewrap on Linux; on macOS Claude Code uses seatbelt, which ships with it (#409).
  [ "$(uname -s)" != Linux ] || sbx=bwrap
  for t in claude gh git jq python3 uv tmux timeout socat $sbx node; do
    command -v "$t" > /dev/null 2>&1 && echo "  PASS $t on PATH" || echo "  FAIL $t not on PATH"
  done
  echo "  INFO target $TARGET; runs root $RUNS_ROOT"
  # Only a Loam target needs the toolchain exports; another target needs its own bin/check instead (F8).
  if ! target_is_loam; then
    [ -x "$TARGET/bin/check" ] && echo "  PASS bin/check in the target" || echo "  FAIL no executable bin/check in the target"
  else
    if [ -n "${LOAM_FACTORY_TOOLCHAIN:-}" ] && [ -x "$LOAM_FACTORY_TOOLCHAIN/bin/node" ]; then
      echo "  PASS LOAM_FACTORY_TOOLCHAIN $LOAM_FACTORY_TOOLCHAIN"
    else
      echo "  FAIL LOAM_FACTORY_TOOLCHAIN unset or no node binary under it"
    fi
    if [ -n "${LOAM_FACTORY_COPIER:-}" ] && [ -x "$LOAM_FACTORY_COPIER" ]; then
      echo "  PASS LOAM_FACTORY_COPIER $LOAM_FACTORY_COPIER"
    else
      echo "  FAIL LOAM_FACTORY_COPIER unset or not executable"
    fi
  fi
  if [ -n "$(standing_list)" ]; then
    echo "  PASS standing do-not-touch list: $(standing_list | grep -c .) paths from $(standing_file)"
  elif target_is_loam; then
    echo "  INFO no standing do-not-touch list in $(standing_file); only each ticket's Do not touch section fences paths"
  else
    echo "  FAIL $(standing_file) is missing or has no tracked path under '## Standing do-not-touch list'; run and next refuse this target"
  fi
  if t=$(claude_version_ok); then
    echo "  PASS claude version $t"
  else
    echo "  FAIL claude --version reports '$t'; the worker call needs Claude Code $CLAUDE_MIN_VERSION+ for CLAUDE_CODE_SUBAGENT_MODEL_FORCE"
  fi
  if claude_logged_in; then
    echo "  PASS claude login"
  else
    echo "  FAIL claude login: claude auth status reports logged out; run claude login on the runner"
  fi
  net gh api rate_limit > /dev/null 2>&1 && echo "  PASS gh api rate_limit" || echo "  FAIL gh api rate_limit"
  # Capture the help first: piped into grep -q, a long help text dies of SIGPIPE and pipefail reads a miss (#279).
  local help
  help=$(claude -p --help 2>&1) && grep -q -- '--json-schema' <<<"$help" \
    && echo "  PASS claude -p accepts --json-schema" \
    || echo "  FAIL claude -p lacks --json-schema; every grader call needs it"
  for t in judge reviewer; do
    if f=$(grader_file "$t" 2>&1); then echo "  PASS $t.md at $f"; else echo "  FAIL $f"; fi
  done
  # Every worker skills.txt line must resolve to a SKILL.md, or lint refuses a ticket naming it and
  # build_worker_prompt stops (skill_file); a bare name and a plugin:name both, the latter at its installPath.
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    skill_file "$t" > /dev/null 2>&1 && echo "  PASS skill $t resolves" || echo "  INFO skill $t resolves to no SKILL.md (lint refuses a ticket naming it)"
  done < "$ROOT/bin/factory.d/skills.txt"
  # Codex login: Codex is not on the bare PATH (#41), so probe it under CODEX_PATH. Only a worker: codex
  # ticket needs it, so a logged-out or absent Codex is INFO here, not FAIL.
  if PATH="$CODEX_PATH:$PATH" command -v codex > /dev/null 2>&1; then
    if PATH="$CODEX_PATH:$PATH" codex login status > /dev/null 2>&1; then
      echo "  PASS codex login status"
    else
      echo "  INFO codex login status reports logged out; a worker: codex ticket needs a login"
    fi
  else
    echo "  INFO codex not on PATH; only a worker: codex ticket needs it"
  fi
  # With the advisor off (FACTORY_WORKER_ADVISOR= empty) the env check and probe are moot: neither
  # would run --advisor, so report the choice and skip both rather than FAIL a deliberate off (#68).
  if [ -n "$WORKER_ADVISOR" ]; then
    if [ -n "${DISABLE_TELEMETRY+x}" ]; then
      echo "  FAIL DISABLE_TELEMETRY is set; the advisor stays off"
    elif [ -n "${CLAUDE_CODE_DISABLE_ADVISOR_TOOL+x}" ]; then
      echo "  FAIL CLAUDE_CODE_DISABLE_ADVISOR_TOOL is set; --advisor has no effect"
    else
      echo "  PASS advisor env clean"
    fi
    if [ "${FACTORY_STATUS_PROBE:-}" = 1 ]; then
      # One paid Opus call with no --settings: the frozen worker settings carry a Stop hook that blocks
      # a one-turn probe. success means --advisor attached (docs/research/advisor-and-managed-agents.md).
      # Wrapped in timeout like every other model call; a hung probe must not hang status (#68).
      local pe po rc pt=()
      command -v timeout > /dev/null 2>&1 && pt=(timeout --foreground 120)
      pe=$(mktemp "${TMPDIR:-/tmp}/factory-probe.XXXXXX")
      po=$(${pt[@]+"${pt[@]}"} claude -p --model "$WORKER_MODEL" --advisor "$WORKER_ADVISOR" --max-turns 1 --output-format json \
        --strict-mcp-config --no-session-persistence 'Reply with the single word ok' 2> "$pe"); rc=$?
      if [ "$rc" -eq 124 ]; then
        echo "  FAIL advisor: probe timed out after 120s"
      elif [ "$rc" -eq 0 ] && [ "$(jq -r "$RESULT_OBJ | .subtype // \"\"" <<< "$po" 2> /dev/null)" = success ]; then
        echo "  PASS advisor attaches"
      else
        echo "  FAIL advisor: $(head -1 "$pe")"
      fi
      rm -f "$pe"
    else
      echo "  INFO advisor probe not run; FACTORY_STATUS_PROBE=1 bin/factory status runs it (one paid Opus call)"
    fi
  else
    echo "  INFO advisor off (FACTORY_WORKER_ADVISOR is empty)"
  fi
  local a="$HOME/.config/loam/alerts" p
  p=$(printf '%s' "$(target_repo)" | sed 's#.*/##' | tr 'A-Z' 'a-z')
  if [ -f "$a/slack-$p" ] || [ -f "$a/slack" ]; then echo "  INFO Slack webhook for $p present (bin/alert)"
  else echo "  INFO no Slack webhook for $p ($a/slack-$p or $a/slack); notifications comment on the ticket"; fi
  [ -f "$a/hc-ping-url" ] && echo "  INFO healthchecks check for this host present" \
    || echo "  INFO no healthchecks check ($a/hc-ping-url); a killed run raises no alarm"
}

# ---- skills ----
# An advisory listing, for the operator choosing a pstack skill to name in a ticket (#472): each installed pstack
# skill's SKILL.md, the copy skill_file resolves (the one a worker reads, not every cached version), and each of its
# lines that names a ~/ or $HOME/ path (`home`: the skill may write operator settings from a worker's unsandboxed
# shell, #409) or AskQuestion or AskUserQuestion (`asks`: it may wait on a person an unattended worker cannot reach).
# Every matching line, not only the first, since a skill's first home path may be a read and its write come later;
# whether a line reads or writes is left to the person reading. Reads files only, and exits 0 whatever it finds.
cmd_skills() {
  local cache="$HOME/.claude/plugins/cache" names n f found=""
  # Names from every cached version, at any depth under skills/ as skill_file matches; each resolves once below.
  names=$(find "$cache"/*/pstack/*/skills -name SKILL.md 2> /dev/null | awk -F/ '{print $(NF-1)}' | sort -u)
  for n in $names; do
    f=$(skill_file "pstack:$n") || continue
    found=1
    # Through the environment, not -v, which would expand a backslash in the path.
    N="$n" F="$f" awk '
      BEGIN { n = ENVIRON["N"]; f = ENVIRON["F"] }
      { t = substr($0, 1, 160) }
      index($0, "~/") || index($0, "$HOME/")                    { printf "%s\thome\t%s:%d: %s\n", n, f, FNR, t }
      index($0, "AskQuestion") || index($0, "AskUserQuestion")  { printf "%s\tasks\t%s:%d: %s\n", n, f, FNR, t }
    ' "$f"
  done
  [ -n "$found" ] || echo "skills: no installed pstack skill resolves (no pstack under $cache, or none in installed_plugins.json)"
  return 0
}

# ---- graders-check ----
# The loop strips the grader files' front matter and passes GRADER_MODEL and GRADER_EFFORT itself; a
# by-hand Agent call reads the front matter instead. This fails when judge.md or reviewer.md names another
# model or effort. The directory defaults to the checkout's plugin copy, relative to the working directory
# like EVALS_DIR, so bin/check compares one tree's agent files with the same tree's bin/factory.
# It also warns STALE, without failing, when <evals-dir>/scores.jsonl has no fresh two-way line for the
# grader file's sha256: an edit since the last replay, a replay over 30 days old (the served model drifts
# under a fixed hash) or dated ahead, or one with no clean or no mutant case (a grader that rejects
# everything scores perfectly on mutants alone). A warning, since every paid eval is a merge-checklist step.
cmd_graders_check() { # [--agents-dir D] [--evals-dir D]
  local dir=cultivation/marketplace/sam-cc-setup/agents evals=evals want g f got h why rc=0
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage graders-check
    case "$1" in
      --agents-dir) dir="$2" ;;
      --evals-dir)  evals="$2" ;;
      *)            usage graders-check ;;
    esac
    shift 2
  done
  # The defaults, not a FACTORY_GRADER_MODEL override in the caller's environment: re-source this file without it.
  want=$(env -u FACTORY_GRADER_MODEL FACTORY_SOURCED=1 "$BASH" -c '. "$0"; printf "%s/%s\n" "$GRADER_MODEL" "$GRADER_EFFORT"' "${BASH_SOURCE[0]}")
  for g in judge reviewer; do
    f="$dir/$g.md"
    [ -f "$f" ] || { echo "DRIFT $g: no $f"; rc=1; continue; }
    # model: and effort: from the first front-matter block only.
    got=$(awk '/^---$/ {if (++n == 2) exit; next} n == 1 && sub(/^model: */, "") {m = $0}
               n == 1 && sub(/^effort: */, "") {e = $0} END {print m "/" e}' "$f")
    [ "$got" = "$want" ] || { echo "DRIFT $g: $f says $got, bin/factory says $want"; rc=1; }
    h=$(sha256_of < "$f" | cut -d' ' -f1)
    # The newest line for this grader and hash decides; a malformed line is skipped, a missing file is none.
    why=$(cat "$evals/scores.jsonl" 2> /dev/null | jq -nrR --arg g "$g" --arg h "$h" '
      [inputs | fromjson? | objects | select(.grader == $g and .sha256 == $h)] | last
      | if . == null then "no scores line"
        else ((.date | strings | fromdate?) // null) as $t
        | if $t == null then "no readable date"
          elif now - $t > 30 * 86400 then "last replay over 30 days old"
          elif $t - now > 60 then "last replay dated in the future"
          elif ((.clean | numbers) // 0) == 0 then "last replay had no clean case"
          elif ((.mutants | numbers) // 0) == 0 then "last replay had no mutant case"
          else "" end end' 2>&1)
    [ -z "$why" ] || echo "WARN STALE $g: $why for sha256 $h in $evals/scores.jsonl"
  done
  [ "$rc" -eq 0 ] && echo "graders-check: OK"
  return "$rc"
}

usage() { # [cmd...] - one line per named command, all ten when none is named
  local c
  for c in ${@:-lint eval eval-freeze run status stop merge next graders-check skills}; do
    case "$c" in
      lint)   echo "usage: bin/factory [-C <repo>] lint <file|issue>" ;;
      eval)   echo "usage: bin/factory eval <grader> [--evals-dir D] [--graders-dir D] [--model M]" ;;
      eval-freeze) echo "usage: bin/factory eval-freeze [--evals-dir D] <run-dir>..." ;;
      run)    echo "usage: bin/factory [-C <repo>] run <issue|ticket-file>" ;;
      status) echo "usage: bin/factory [-C <repo>] status [--criteria]" ;;
      stop)   echo "usage: bin/factory [-C <repo>] stop <issue|ticket-stem>" ;;
      merge)  echo "usage: bin/factory [-C <repo>] merge <pr> <sha>" ;;
      next)   echo "usage: bin/factory [-C <repo>] next [--dry-run|--install]" ;;
      graders-check) echo "usage: bin/factory graders-check [--agents-dir D] [--evals-dir D]" ;;
      skills) echo "usage: bin/factory skills" ;;
      *)      echo "usage: bin/factory [-C <repo>] <lint|eval|eval-freeze|run|status|stop|merge|next|graders-check|skills>" ;;
    esac
  done >&2
  exit 2
}

# `FACTORY_SOURCED=1 . bin/factory` loads the functions for a test (bin/check's verdict gate, and the
# sourced tree_signature and file_backlog checks) without running a subcommand and without consuming the
# caller's positional parameters, which a `shift` here would strip from a no-arg source. `return` works
# only in a sourced script; 2> /dev/null hides the error if the guard is ever hit while the file runs as
# a program.
[ "${FACTORY_SOURCED:-}" = 1 ] && return 0 2> /dev/null
# lint, next and status read FACTORY_NET_TIMEOUT_SEC, and next FACTORY_MAX_PARALLEL, without apply_caps, so every
# FACTORY_<NAME> cap is checked here once, before any subcommand runs (#427).
env_caps_ok || exit 2
C_DIR=""
[ "${1:-}" = -C ] && { [ $# -ge 2 ] || usage; C_DIR="$2"; shift 2; }
CMD="${1:-}"
shift 2> /dev/null || true
[ "${1:-}" = -C ] && { [ $# -ge 2 ] || usage; C_DIR="$2"; shift 2; }
[ -z "$C_DIR" ] || use_target "$C_DIR" \
  || { echo "factory: -C $C_DIR is not a git checkout, or is another repository with no GitHub origin" >&2; exit 2; }
case "$CMD" in
  lint) [ $# -eq 1 ] || usage lint
        lint "$1" ;;
  eval) [ $# -ge 1 ] || usage eval
        GRADER="$1"; shift
        while [ $# -gt 0 ]; do
          [ $# -ge 2 ] || usage eval
          case "$1" in
            --evals-dir)   EVALS_DIR="$2" ;;
            --graders-dir) GRADERS_DIR="$2" ;;
            --model)       EVAL_MODEL="$2" ;;
            *)             usage eval ;;
          esac
          shift 2
        done
        run_eval "$GRADER" ;;
  eval-freeze)
        [ "${1:-}" = --evals-dir ] && { [ $# -ge 2 ] || usage eval-freeze; EVALS_DIR="$2"; shift 2; }
        [ $# -ge 1 ] || usage eval-freeze
        cmd_eval_freeze "$@" ;;
  run)    [ $# -eq 1 ] || usage run
          cmd_run "$1" ;;
  status) case "$#/${1:-}" in
            0/)           cmd_status ;;
            1/--criteria) cmd_criteria ;;
            *)            usage status ;;
          esac ;;
  stop)   [ $# -eq 1 ] || usage stop
          cmd_stop "$1" ;;
  merge)  [ $# -eq 2 ] || usage merge
          cmd_merge "$1" "$2" ;;
  next)   cmd_next "$@" ;;
  graders-check)
        cmd_graders_check "$@" ;;
  skills) [ $# -eq 0 ] || usage skills
          cmd_skills ;;
  *)      usage ;;
esac
