#!/usr/bin/env bash
# bin/factory - factory tooling. Subcommand: lint.
#   bin/factory lint <file|issue>   statically checks a ticket body against docs/factory/CONTRACT.md.
# Lint never executes a check; it reads the body and shells out only to `bash -n` and `gh`.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# The ticket sections, in contract order. Six are required; Approach, Merge checklist,
# and Rows measured are optional.
CANON=("Goal and why" "Do not touch" "Out of scope" "Approach" "Done checks" \
       "Merge checklist" "Rows measured" "Worker" "Decisions")
REQUIRED=("Goal and why" "Do not touch" "Out of scope" "Done checks" "Worker" "Decisions")
CAPS=" MAX_ROUNDS ROUND_BUDGET_USD GRADER_BUDGET_USD TICKET_BUDGET_USD DAILY_BUDGET_USD \
MAX_HOURS MAX_TURNS CALL_TIMEOUT_SEC MAX_PARALLEL "

SRC=""
BODY=""
ERRS=0

err() { echo "LINT $SRC: $*" >&2; ERRS=$((ERRS + 1)); }

# The body above the first section: title, Brief:/Part of, Blocked by:.
header() { awk '/^## /{exit} {print}' <<<"$BODY"; }

# The body of one section, without its heading.
section() { awk -v want="## $1" '$0 == want {inb=1; next} /^## /{inb=0} inb {print}' <<<"$BODY"; }

# The done-checks fenced block, without its fences.
dc_block() { awk '/^```done-checks$/{inb=1; next} /^```/{if (inb) exit} inb {print}' <<<"$BODY"; }

# Path-looking tokens in stdin: anything with a slash, backticks and sentence punctuation stripped.
# Tokens holding a glob or a shell expansion are not paths a ticket promises.
paths() {
  tr -s ' \t' '\n\n' | tr -d '`",' | sed 's/[.,;:)]*$//' \
    | grep -E '^[.A-Za-z0-9_][A-Za-z0-9_./-]*/[A-Za-z0-9_./-]*$' \
    | grep -vE '[*$?{}]' | sort -u
}

# ---- rules ----

check_sections() {
  local h j k prev=-1 r
  while IFS= read -r h; do
    j=-1
    for k in "${!CANON[@]}"; do [ "${CANON[$k]}" = "$h" ] && { j=$k; break; }; done
    if [ "$j" -lt 0 ]; then
      err "unknown section '## $h'"
    elif [ "$j" -le "$prev" ]; then
      err "section '## $h' is duplicated or out of contract order"
    else
      prev=$j
    fi
  done < <(grep '^## ' <<<"$BODY" | sed 's/^## //')
  for r in "${REQUIRED[@]}"; do
    grep -qxF "## $r" <<<"$BODY" || err "missing section '## $r'"
  done
}

check_header() {
  local head
  head=$(header)
  grep -qE '^(Brief:|Part of )' <<<"$head" || err "header has no 'Brief:' or 'Part of' line"
  grep -qE '^Blocked by:' <<<"$head" || err "header has no 'Blocked by:' line"
}

check_no_skip() {
  grep -qiE '(^|[^A-Za-z])skip' <<<"$BODY" && err "the body says 'skip'; a check leaves a ticket only through the abandon exit"
  return 0
}

check_block_syntax() {
  local n tmp
  n=$(grep -cxF '```done-checks' <<<"$BODY")
  if [ "$n" -ne 1 ]; then
    err "expected exactly one fenced done-checks block, found $n"
    return
  fi
  tmp=$(mktemp)
  { cat "$ROOT/bin/factory.d/lib.sh"; echo; dc_block; } > "$tmp"
  bash -n "$tmp" || err "the done-checks block plus lib.sh does not pass bash -n"
  rm -f "$tmp"
}

# Every check line reports through pass NAME and fail NAME, and a line that leans on a test
# file or on pytest may only name test paths the ticket already fenced off under Do not touch.
check_check_lines() {
  local line owned c covered e
  owned=$(section "Do not touch" | paths)
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    case "$line" in \#*) continue ;; esac
    grep -qE '(^|[[:space:]])pass[[:space:]]' <<<"$line" \
      || err "check line does not report a pass: $line"
    grep -qE '(^|[[:space:]])fail[[:space:]]' <<<"$line" \
      || err "check line does not report a fail: $line"
    grep -qE '(^|[[:space:]])pytest|[^[:space:]]*test[^[:space:]]*\.py|[^[:space:]]*_test\.sh' <<<"$line" || continue
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      case "$c" in *test*) ;; *) continue ;; esac
      covered=0
      while IFS= read -r e; do
        [ -n "$e" ] || continue
        e=${e%/}
        [ "$c" = "$e" ] || [ "${c#"$e"/}" != "$c" ] && covered=1
      done <<<"$owned"
      [ "$covered" = 1 ] || err "self-graded oracle: the check names $c, which Do not touch does not fence off"
    done < <(printf '%s\n' "$line" | paths)
  done < <(dc_block)
}

check_worker() {
  local w line name
  w=$(section Worker)
  grep -qE '^worker: (claude|codex)$' <<<"$w" || err "Worker has no 'worker: claude|codex' line"
  grep -qE '^codex-review: (yes|no)$' <<<"$w" || err "Worker has no 'codex-review: yes|no' line"
  grep -qE '^effort: (low|medium)$' <<<"$w" || err "Worker has no 'effort: low|medium' line"
  grep -qE '^goal: .*or stop after [0-9]+ turns$' <<<"$w" \
    || err "Worker has no 'goal:' line ending 'or stop after <N> turns'"
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    case "$line" in worker:*|codex-review:*|effort:*|goal:*|skills:*) continue ;; esac
    name=${line%%=*}
    if [ "$name" = "$line" ] || [ "${CAPS/ $name /}" = "$CAPS" ]; then
      err "unrecognized Worker line: $line"
    fi
  done <<<"$w"
}

check_merge_checklist() {
  local n
  grep -qE '^Track: B([[:space:]]|$)' <<<"$(header)" || return 0
  n=$(section "Merge checklist" | grep -c '[^[:space:]]')
  [ "$n" -le 3 ] || err "a Track B ticket allows at most three merge-checklist lines, found $n"
}

# Every path the ticket names must already be in the tree, or be one the ticket says it creates.
check_paths() {
  local p created
  created=$(section "Do not touch" | grep -F 'Except:' | paths)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$ROOT/$p" ] && continue
    grep -qxF "$p" <<<"$created" && continue
    err "names $p, which is not in the tree and is not one the ticket creates"
  done < <( { header | grep -E '^Where:'; section "Do not touch"; section Approach; } | paths)
}

lint() {
  SRC="$1"
  ERRS=0
  if [ -f "$SRC" ]; then
    BODY=$(cat "$SRC")
    grep -qE -m1 '^# ' <<<"$(head -n 1 "$SRC")" || err "first line is not a '# ' title"
  elif [ -n "$SRC" ]; then
    BODY=$(gh issue view "$SRC" --json body -q .body) \
      || { echo "LINT $SRC: could not read the issue body with gh" >&2; return 1; }
  else
    return 1
  fi

  check_sections
  check_header
  check_no_skip
  check_block_syntax
  check_check_lines
  check_worker
  check_merge_checklist
  # Fixture bodies are historical tickets that name paths later tickets removed.
  case "$SRC" in *bin/factory.d/fixtures/*) ;; *) check_paths ;; esac

  [ "$ERRS" -eq 0 ] || return 1
  echo "lint: OK $SRC"
}

case "${1:-}" in
  lint) [ $# -eq 2 ] || { echo "usage: bin/factory lint <file|issue>" >&2; exit 2; }
        lint "$2" ;;
  *)    echo "usage: bin/factory lint <file|issue>" >&2; exit 2 ;;
esac
