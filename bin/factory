#!/usr/bin/env bash
# bin/factory - factory tooling. Subcommands: lint, eval, run, status, stop.
#   bin/factory lint <file|issue>   statically checks a ticket body against docs/factory/CONTRACT.md.
#   bin/factory eval <grader>       replays the frozen evals/ cases through the production grader call.
#   bin/factory run <issue|file>    the supervisor: one ticket to a pull request (docs/factory/LOOP.md).
#   bin/factory status              run states, spend, denials, worktrees, PRs, preconditions.
#   bin/factory stop <issue>        writes FACTORY_STOP into the run dir; the run halts before its next call.
# Lint never executes a check; it reads the body and shells out only to `bash -n` and `gh`.
set -uo pipefail

# FACTORY_ROOT is set when a run execs its frozen copy of this file out of the run directory.
ROOT="${FACTORY_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
GIT_COMMON="$(cd "$ROOT" && cd "$(git rev-parse --git-common-dir 2> /dev/null || echo .)" && pwd)"
MAIN_CHECKOUT="$(dirname "$GIT_COMMON")"

# The ticket sections, in contract order. Six are required; Approach, Merge checklist,
# and Rows measured are optional.
CANON=("Goal and why" "Do not touch" "Out of scope" "Approach" "Done checks" \
       "Merge checklist" "Rows measured" "Worker" "Decisions")
REQUIRED=("Goal and why" "Do not touch" "Out of scope" "Done checks" "Worker" "Decisions")
CAPS=" MAX_ROUNDS ROUND_BUDGET_USD GRADER_BUDGET_USD TICKET_BUDGET_USD DAILY_BUDGET_USD \
MAX_HOURS MAX_TURNS CALL_TIMEOUT_SEC MAX_PARALLEL "

# `claude --output-format json` prints one object, or an array whose last result element is it.
RESULT_OBJ='if type == "array" then ((last(.[] | select(.type == "result")) // .[-1]) // {}) else . end'

SRC=""
BODY=""
ERRS=0

err() { echo "LINT $SRC: $*" >&2; ERRS=$((ERRS + 1)); }

# The body above the first section: title, Brief:/Part of, Blocked by:.
header() { awk '/^## /{exit} {print}' <<<"$BODY"; }

# The body of one section, without its heading.
section() { awk -v want="## $1" '$0 == want {inb=1; next} /^## /{inb=0} inb {print}' <<<"$BODY"; }

# The done-checks fenced block, without its fences.
dc_block() { awk '/^```done-checks$/{inb=1; next} /^```/{if (inb) exit} inb {print}' <<<"$BODY"; }

# Word-like tokens in stdin, backticks and sentence punctuation stripped. A token holding a glob or a
# shell expansion is not a path a ticket promises.
tokens() { tr -s ' \t' '\n\n' | tr -d '`",' | sed 's/[.,;:)]*$//' | grep -vE '[*$?{}]'; }

# Path-looking tokens: anything with a slash.
paths() { tokens | grep -E '^[.A-Za-z0-9_][A-Za-z0-9_./-]*/[A-Za-z0-9_./-]*$' | sort -u; }

# Keep only the tokens whose first segment is a tracked top-level entry: what a ticket really names.
only_tracked_tops() {
  local tops
  # tops is space-joined: macOS awk rejects a newline inside a -v value.
  tops=$(git -C "$ROOT" ls-files | cut -d/ -f1 | sort -u | tr '\n' ' ')
  awk -v tops="$tops" 'BEGIN {n = split(tops, a, " "); for (i = 1; i <= n; i++) t[a[i]] = 1}
                       {s = $0; sub(/\/.*/, "", s); if (s in t) print}'
}

# The paths a ticket promises: backtick-wrapped tokens that survive both filters.
promised_paths() { grep -o '`[^`]*`' | tr -d '`' | paths | only_tracked_tops; }

# ---- rules ----

check_sections() {
  local h j k prev=-1 r
  while IFS= read -r h; do
    j=-1
    for k in "${!CANON[@]}"; do [ "${CANON[$k]}" = "$h" ] && { j=$k; break; }; done
    if [ "$j" -lt 0 ]; then
      err "unknown section '## $h'"
    elif [ "$j" -le "$prev" ]; then
      err "section '## $h' is duplicated or out of contract order"
    else
      prev=$j
    fi
  done < <(grep '^## ' <<<"$BODY" | sed 's/^## //')
  for r in "${REQUIRED[@]}"; do
    grep -qxF "## $r" <<<"$BODY" || err "missing section '## $r'"
  done
}

check_header() {
  local head
  head=$(header)
  grep -qE '^(Brief:|Part of )' <<<"$head" || err "header has no 'Brief:' or 'Part of' line"
  grep -qE '^Blocked by:' <<<"$head" || err "header has no 'Blocked by:' line"
}

check_no_skip() {
  grep -qiE '(^|[^A-Za-z_-])skip(s|ped|ping)?([^A-Za-z_-]|$)' <<<"$BODY" && err "the body says 'skip'; a check leaves a ticket only through the abandon exit"
  return 0
}

check_block_syntax() {
  local n tmp
  n=$(grep -cxF '```done-checks' <<<"$BODY")
  if [ "$n" -ne 1 ]; then
    err "expected exactly one fenced done-checks block, found $n"
    return
  fi
  # bare mktemp ignores TMPDIR on macOS and fails inside the Claude Code sandbox
  tmp=$(mktemp "${TMPDIR:-/tmp}/factory-lint.XXXXXX")
  { cat "$ROOT/bin/factory.d/lib.sh"; echo; dc_block; } > "$tmp"
  bash -n "$tmp" || err "the done-checks block plus lib.sh does not pass bash -n"
  rm -f "$tmp"
}

# Every check line reports through pass NAME and fail NAME, and a line that leans on a test
# file or on pytest may only name test paths the ticket already fenced off under Do not touch.
check_check_lines() {
  local line owned c covered e
  owned=$(section "Do not touch" | paths)
  while IFS= read -r line; do
    line=${line#"${line%%[![:space:]]*}"}
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac
    grep -qE '(^|[[:space:]])pass[[:space:]]' <<<"$line" \
      || err "check line does not report a pass: $line"
    grep -qE '(^|[[:space:]])fail[[:space:]]' <<<"$line" \
      || err "check line does not report a fail: $line"
    grep -qE '(^|[[:space:]])pytest|[^[:space:]]*test[^[:space:]]*\.py|[^[:space:]]*_test\.sh' <<<"$line" || continue
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      case "$c" in *test*) ;; *) continue ;; esac
      covered=0
      while IFS= read -r e; do
        [ -n "$e" ] || continue
        e=${e%/}
        [ "$c" = "$e" ] || [ "${c#"$e"/}" != "$c" ] && covered=1
      done <<<"$owned"
      [ "$covered" = 1 ] || err "self-graded oracle: the check names $c, which Do not touch does not fence off"
    done < <(printf '%s\n' "$line" | paths)
  done < <(dc_block | sed -e :a -e '/\\$/N; s/\\\n//; ta')
}

check_worker() {
  local w line name skill
  w=$(section Worker)
  grep -qE '^worker: (claude|codex)$' <<<"$w" || err "Worker has no 'worker: claude|codex' line"
  grep -qE '^codex-review: (yes|no)$' <<<"$w" || err "Worker has no 'codex-review: yes|no' line"
  grep -qE '^effort: (low|medium|high|xhigh)$' <<<"$w" || err "Worker has no 'effort: low|medium|high|xhigh' line"
  grep -qE '^goal: .*or stop after [0-9]+ turns$' <<<"$w" \
    || err "Worker has no 'goal:' line ending 'or stop after <N> turns'"
  # `size:` is optional (default small); large routes round 1 through the fan-out workflow (F12).
  if grep -qE '^size:' <<<"$w"; then
    grep -qE '^size: (small|large)$' <<<"$w" || err "Worker 'size:' must be 'small' or 'large'"
  fi
  # Every `skills:` name is a line of bin/factory.d/skills.txt, matched byte for byte (#37).
  # Skipped under fixtures/, whose historical bodies predate the allowlist, as check_paths is (lint).
  case "$SRC" in *bin/factory.d/fixtures/*) ;; *)
    while IFS= read -r skill; do
      [ -n "$skill" ] || continue
      grep -qxF "$skill" "$ROOT/bin/factory.d/skills.txt" \
        || err "unknown skill '$skill': not a line of bin/factory.d/skills.txt"
    done < <(sed -n 's/^skills: *//p' <<<"$w" | head -1 | tr ',' '\n' | sed 's/^ *//;s/ *$//')
  ;; esac
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    case "$line" in worker:*|codex-review:*|effort:*|goal:*|skills:*|size:*) continue ;; esac
    name=${line%%=*}
    if [ "$name" = "$line" ] || [ "${CAPS/ $name /}" = "$CAPS" ]; then
      err "unrecognized Worker line: $line"
    fi
  done <<<"$w"
}

check_merge_checklist() {
  local n
  grep -qE '^Track: B([[:space:]]|$)' <<<"$(header)" || return 0
  n=$(section "Merge checklist" | grep -c '[^[:space:]]')
  [ "$n" -le 3 ] || err "a Track B ticket allows at most three merge-checklist lines, found $n"
}

# Every path the ticket names must already be in the tree, or be one the ticket says it creates.
check_paths() {
  local p created
  created=$(section "Do not touch" | grep -F 'Except:' | paths)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$ROOT/$p" ] && continue
    grep -qxF "$p" <<<"$created" && continue
    err "names $p, which is not in the tree and is not one the ticket creates"
  done < <( { { header | grep -E '^Where:'; } | paths; { section "Do not touch"; section Approach; } | promised_paths; } | sort -u)
}

# ---- eval ----
# Replays evals/<grader>/<case>/prompt.md through the grader call in docs/factory/LOOP.md and
# compares the verdict with expected.json. The rubric comes from the live grader file, so a
# grader prompt edit changes the result; that is the point (LOOP.md, Grader change protocol).

EVAL_MODEL=fable
EVALS_DIR=evals
GRADERS_DIR=""

# Graders are plugin agents; a run and an eval both resolve them from the installed plugin cache,
# so both grade with the version the ledger records. --graders-dir replaces the search.
grader_file() {
  local dirs=("$GRADERS_DIR") d f
  # The installed plugin first; the checkout's own marketplace copy is the fallback, so a run works
  # from a branch whose grader edits are not installed yet.
  [ -n "$GRADERS_DIR" ] || dirs=("$HOME"/.claude/plugins/cache/*/sam-cc-setup/*/agents \
                                 "$ROOT/cultivation/marketplace/sam-cc-setup/agents")
  for d in "${dirs[@]}"; do
    f="$d/$1.md"
    [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  echo "eval: found no $1.md in ${dirs[*]}" >&2
  return 1
}

# A worker's skill name (a line of bin/factory.d/skills.txt, lint-checked) -> its SKILL.md body path.
# A bare name lives under ~/.claude/skills/<name>/; a plugin:name lives in the installed plugin cache,
# the way grader_file resolves agents, newest version first. Plugin skills nest under a category dir
# (mattpocock-skills:research is skills/engineering/research/SKILL.md), so match SKILL.md at any depth
# under the plugin's skills tree, not only skills/<name>/.
skill_file() { # skill-name -> SKILL.md path on stdout, non-zero when it resolves to no file
  local name="$1" plugin sub f
  case "$name" in
    *:*)
      plugin=${name%%:*}; sub=${name#*:}
      f=$(find "$HOME"/.claude/plugins/cache/*/"$plugin"/*/skills -path "*/$sub/SKILL.md" 2> /dev/null | sort -rV | head -1)
      [ -n "$f" ] && { printf '%s\n' "$f"; return 0; } ;;
    *)
      f="$HOME/.claude/skills/$name/SKILL.md"
      [ -f "$f" ] && { printf '%s\n' "$f"; return 0; } ;;
  esac
  return 1
}

# A plugin agent file opens with frontmatter; strip it. One that asks for prose is also asked for the
# JSON form; judge.md and reviewer.md carry their own `## Output` section and keep it byte-identical.
grader_rubric() {
  # `sed '/./,$!d'` drops the blank line after the frontmatter, so the rubric a grader reads is the
  # agent file's body byte for byte.
  if [ "$(head -n 1 "$1")" = "---" ]; then
    awk 'f; /^---$/ { c++; if (c == 2) f = 1 }' "$1" | sed '/./,$!d'
  else cat "$1"; fi
  grep -qxF '## Output' "$1" && return 0
  printf '\n## Output for this call\n\nRespond with exactly one JSON object and nothing else: no prose before or after, no code fences, no closing sentence; put anything you could not verify in the "unverified" array. Scope: the diff below and the worker-authored files. Severity as defined above.\n'
}

run_eval() {
  local grader="$1" budget="${EVAL_BUDGET_USD:-10}" gf schema rubric dir name out res exp got erows grows
  local spent=0 cases=0 mism=0 ok attempt
  gf=$(grader_file "$grader") || return 2
  schema=$(schema_for "$grader" 2> /dev/null)
  [ -n "$schema" ] || { echo "eval: no bin/factory.d/$grader.schema.json" >&2; return 2; }
  [ -d "$EVALS_DIR/$grader" ] || { echo "eval: no cases under $EVALS_DIR/$grader" >&2; return 2; }
  rubric=$(mktemp "${TMPDIR:-/tmp}/factory-eval.XXXXXX")
  grader_rubric "$gf" > "$rubric"
  for dir in "$EVALS_DIR/$grader"/*/; do
    [ -f "$dir/prompt.md" ] && [ -f "$dir/expected.json" ] || continue
    if awk -v s="$spent" -v b="$budget" 'BEGIN {exit !(s >= b)}'; then
      echo "eval $grader: EVAL_BUDGET_USD $budget reached after \$$spent and $cases cases" >&2
      rm -f "$rubric"
      return 2
    fi
    name=$(basename "$dir")
    cases=$((cases + 1))
    # Two attempts, as the loop's grader call takes.
    for attempt in 1 2; do
      # The same flags as the production grader call (LOOP.md, Grader calls), so the replay grades the
      # way the loop does: --json-schema routes the reply through the schema, --strict-mcp-config and
      # --disable-slash-commands drop the prefix the grader never uses. Each call gets the remaining
      # headroom, so EVAL_BUDGET_USD caps the sum over cases.
      out=$(cat "$rubric" "$dir/prompt.md" | claude -p --model "$EVAL_MODEL" --effort medium \
        --tools Read,Grep,Glob --strict-mcp-config --disable-slash-commands --no-session-persistence \
        --json-schema "$schema" \
        --max-budget-usd "$(awk -v b="$budget" -v s="$spent" 'BEGIN {printf "%.4f", b - s}')" \
        --setting-sources user --output-format json 2>/dev/null)
      spent=$(awk -v a="$spent" -v b="$(jq -r "$RESULT_OBJ | .total_cost_usd // 0" <<<"$out" 2>/dev/null)" \
        'BEGIN {printf "%.4f", a + (b + 0)}')
      res=$(jq -r "$RESULT_OBJ | .result // \"\"" <<<"$out" 2>/dev/null)
      # Fallback: if a reply still carries code fences or prose around the object, the object runs
      # from the first brace to the last, so cut to those before parsing the verdict.
      if ! jq -e .verdict <<<"$res" > /dev/null 2>&1 && [ "${res#*\{}" != "$res" ]; then
        res="{${res#*\{}"; res="${res%\}*}}"
      fi
      # A usage limit or an API error answers with is_error and no cost. That is the environment,
      # not a verdict: say so and stop, rather than reporting it as a grader disagreement.
      if [ "$(jq -r "$RESULT_OBJ | .is_error // false" <<<"$out" 2>/dev/null)" = true ]; then
        echo "eval $grader/$name: the call failed: $res" >&2
        rm -f "$rubric"
        return 2
      fi
      jq -e .verdict <<<"$res" > /dev/null 2>&1 && break
      echo "eval $grader/$name: attempt $attempt output not parseable" >&2
    done
    exp=$(jq -r .verdict "$dir/expected.json")
    got=$(jq -r '.verdict // "unparseable"' <<<"$res" 2>/dev/null) || got=unparseable
    [ -n "$got" ] || got=unparseable
    ok=1
    [ "$got" = "$exp" ] || ok=0
    # The failing-row set is compared only for a case that lists one.
    if [ "$ok" = 1 ] && jq -e 'has("failing_rows")' "$dir/expected.json" > /dev/null 2>&1; then
      erows=$(jq -r '.failing_rows | sort | join(",")' "$dir/expected.json")
      grows=$(jq -r '[(.rows // {}) | to_entries[] | select(.value != "pass") | .key] | sort | join(",")' <<<"$res" 2>/dev/null)
      [ "$grows" = "$erows" ] || { ok=0; got="$got rows=[$grows]"; exp="$exp rows=[$erows]"; }
    fi
    if [ "$ok" = 1 ]; then
      echo "eval $grader/$name: OK $got"
    else
      echo "eval $grader/$name: MISMATCH got '$got', expected '$exp'"
      mism=$((mism + 1))
    fi
  done
  rm -f "$rubric"
  echo "eval $grader: $cases cases, $mism mismatch, \$$spent"
  [ "$cases" -gt 0 ] || return 2
  [ "$mism" -eq 0 ]
}

lint() {
  SRC="$1"
  ERRS=0
  if [ -f "$SRC" ]; then
    BODY=$(cat "$SRC")
    # A file may open with the front matter publish.sh reads: title:, then optional
    # labels: and blocked_by:, then ---. The body is what follows the --- line.
    if head -n 1 "$SRC" | grep -q '^title: '; then
      if grep -qxF -- '---' "$SRC"; then
        BODY=$(sed '1,/^---$/d' "$SRC")
      else
        err "front matter has no --- line"
      fi
    else
      head -n 1 "$SRC" | grep -q '^# ' || err "first line is not a '# ' title"
    fi
  elif [[ "$SRC" =~ ^[0-9]+$ ]]; then
    BODY=$(gh issue view "$SRC" --json body -q .body) \
      || { echo "LINT $SRC: could not read the issue body with gh" >&2; return 1; }
  else
    echo "no such file: $SRC" >&2
    return 1
  fi

  check_sections
  check_header
  check_no_skip
  check_block_syntax
  check_check_lines
  check_worker
  check_merge_checklist
  # Fixture bodies are historical tickets that name paths later tickets removed.
  case "$SRC" in *bin/factory.d/fixtures/*) ;; *) check_paths ;; esac

  [ "$ERRS" -eq 0 ] || return 1
  echo "lint: OK $SRC"
}

# ---- run, status, stop ----
# The supervisor: one ticket to a pull request, in the steps docs/factory/LOOP.md sets out.
# Run state lives under FACTORY_RUNS_ROOT, outside every checkout.

RUNS_ROOT="${FACTORY_RUNS_ROOT:-$HOME/.local/state/loam-factory/runs}"
CAP_NAMES="MAX_ROUNDS ROUND_BUDGET_USD GRADER_BUDGET_USD TICKET_BUDGET_USD DAILY_BUDGET_USD \
MAX_HOURS MAX_TURNS CALL_TIMEOUT_SEC MAX_PARALLEL"
# Defaults, then the ticket's Worker section, then FACTORY_<NAME> in the environment. The bare names
# are never read: a Claude Code session already exports WORKER_MODEL and CALL_TIMEOUT_SEC of its own.
MAX_ROUNDS=6; ROUND_BUDGET_USD=15; GRADER_BUDGET_USD=5; TICKET_BUDGET_USD=60
DAILY_BUDGET_USD=150; MAX_HOURS=8; MAX_TURNS=200; CALL_TIMEOUT_SEC=5400; MAX_PARALLEL=1
WORKER_MODEL="${FACTORY_WORKER_MODEL:-claude-opus-4-8[1m]}"   # ARCHITECTURE.md, Models and roles (2026-09-09)
GRADER_MODEL="${FACTORY_GRADER_MODEL:-fable}"
CODEX_MODEL="${FACTORY_CODEX_MODEL:-codex}"   # ledger label for a `worker: codex` round; Codex holds the real model in its own config, and its dollar cost is null (F4)
WORKER_ADVISOR="${FACTORY_WORKER_ADVISOR-fable}"   # mid-round advisor on the worker call; FACTORY_WORKER_ADVISOR= (explicit empty) disables the flag. No colon: :- could never disable. The bare name is never read.
WORKER_EFFORT=xhigh        # the ticket's `effort:` line overrides
GRADER_EFFORT=medium
GRADER_FAIL_ROUNDS=2      # grader-fail rounds allowed once the checks pass (LOOP.md, Grader-round cap)
FENCE='~~~~~~~~~~~~ evidence'   # fixed marker; never a per-run string (#38)

REPO=""; ISSUE=""; KEY=""; IS_FILE=0; RUN=""; ROUND=0; REVIEW_BLOCKED=0
LOG=/dev/null; LEDGER=""; DAILY=""; DECISIONS=""; WORKTREE=""; BRANCH=""
# Worker kind and the Codex review stage, read from the ticket in cmd_run (F4). CODEX_REVIEW_BLOCKED is
# separate from REVIEW_BLOCKED so a Claude-reviewer block never consumes the Codex review's one block.
WORKER_KIND=claude; CODEX_REVIEW=no; CODEX_REVIEW_BLOCKED=0
CODEX_PATH="$HOME/.local/bin"   # Codex is not on the non-interactive PATH (#41); every Codex call prepends this

now()   { date -u +%Y-%m-%dT%H:%M:%SZ; }
today() { date -u +%Y-%m-%d; }
log()   { printf '%s %s\n' "$(now)" "$*" | tee -a "$LOG" >&2; }
sha256_of() { if command -v sha256sum > /dev/null 2>&1; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }
set_status() { printf '%s\n' "$1" > "$RUN/status"; log "status: $1"; }

# Pushover when it is configured, else a comment on the ticket; a failure leaves notify.failed.
notify() { # title message
  local pe="$HOME/.config/loam-loops/pushover.env"
  log "[notify] $1: $2"
  [ "$IS_FILE" = 1 ] && return 0   # a file ticket is a rehearsal with no issue to comment on
  if [ -f "$pe" ]; then
    # shellcheck disable=SC1090
    . "$pe"
    if [ -n "${PUSHOVER_TOKEN:-}" ] && [ -n "${PUSHOVER_USER:-}" ] \
      && curl -s --max-time 15 -F "token=$PUSHOVER_TOKEN" -F "user=$PUSHOVER_USER" \
         -F "title=$1" -F "message=${2:0:1000}" https://api.pushover.net/1/messages.json > /dev/null; then return 0; fi
  elif [ -n "$ISSUE" ] && printf '**%s**\n\n%s\n' "$1" "$2" \
    | gh issue comment "$ISSUE" -R "$REPO" --body-file - > /dev/null 2>&1; then return 0
  fi
  printf '%s %s: %s\n' "$(now)" "$1" "$2" >> "$RUN/notify.failed"
}

# Exit code, status, and the final log line are decided together (LOOP.md, Exits).
finish() { # status message
  local code
  case "$1" in
    pr-opened) code=0 ;; ticket-defect) code=3 ;; stopped-environment) code=4 ;; abandon) code=5 ;; *) code=2 ;;
  esac
  set_status "$1"
  notify "$KEY $1" "$2"
  log "EXIT $1 ($code): $2"
  exit "$code"
}

# ---- the ticket -------------------------------------------------------------

load_ticket() { # <issue|file>
  SRC="$1"
  if [ -f "$SRC" ]; then
    IS_FILE=1
    BODY=$(cat "$SRC")
    head -n 1 "$SRC" | grep -q '^title: ' && BODY=$(sed '1,/^---$/d' "$SRC")
    KEY=$(basename "$SRC"); KEY=${KEY%.md}
  elif [[ "$SRC" =~ ^[0-9]+$ ]]; then
    ISSUE="$SRC"; KEY="$SRC"
    REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner) \
      || { echo "factory run: gh repo view failed; run it from a checkout with a remote" >&2; exit 4; }
    BODY=$(gh issue view "$ISSUE" -R "$REPO" --json body -q .body) \
      || { echo "factory run: could not read issue #$ISSUE" >&2; exit 4; }
  else
    echo "factory run: no such ticket file, and not an issue number: $SRC" >&2; exit 2
  fi
}

apply_caps() { # the ticket's Worker section, then any FACTORY_<NAME> override
  local line name v
  while IFS= read -r line; do
    case "$line" in *=*) name=${line%%=*} ;; *) continue ;; esac
    case " $CAP_NAMES " in *" $name "*) eval "$name=\${line#*=}" ;; esac
  done <<< "$(section Worker)"
  for name in $CAP_NAMES; do
    v="FACTORY_$name"
    [ -z "${!v:-}" ] || eval "$name=\${!v}"
  done
}

# What a ticket section fences off: like promised_paths, but a bare name (VERSION) counts too.
ticket_paths() { tokens | grep -E '^[.A-Za-z0-9_][A-Za-z0-9_./-]*$' | only_tracked_tops | sort -u; }

# The standing do-not-touch list, read from its one home (ARCHITECTURE.md).
standing_list() {
  awk '/^## Standing do-not-touch list$/ {inb = 1; next} /^## / {inb = 0} inb && /^- /' \
    "$ROOT/docs/factory/ARCHITECTURE.md" | ticket_paths
}

under() { # path list -> 0 when path equals or sits under a list entry
  local p="$1" e
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    e=${e%/}
    { [ "$p" = "$e" ] || [ "${p#"$e"/}" != "$p" ]; } && return 0
  done <<< "$2"
  return 1
}

# ---- steps 2 and 3: worktree, freeze ----------------------------------------

prepare_worktree() {
  local base
  if [ ! -s "$RUN/base.sha" ]; then
    git -C "$MAIN_CHECKOUT" fetch -q origin 2> /dev/null
    git -C "$MAIN_CHECKOUT" rev-parse origin/main > "$RUN/base.sha" 2> /dev/null \
      || git -C "$MAIN_CHECKOUT" rev-parse HEAD > "$RUN/base.sha"
  fi
  base=$(cat "$RUN/base.sha")
  if [ ! -d "$WORKTREE" ]; then
    # A file ticket is a rehearsal: it takes a detached worktree and leaves no branch behind.
    if [ "$IS_FILE" = 1 ]; then
      git -C "$MAIN_CHECKOUT" worktree add --detach "$WORKTREE" "$base" > /dev/null 2>&1
    elif git -C "$MAIN_CHECKOUT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$MAIN_CHECKOUT" worktree add "$WORKTREE" "$BRANCH" > /dev/null 2>&1
    else
      git -C "$MAIN_CHECKOUT" worktree add "$WORKTREE" -b "$BRANCH" "$base" > /dev/null 2>&1
    fi
    [ -d "$WORKTREE" ] || finish stopped-environment "could not create the worktree $WORKTREE from $base"
  fi
  [ "$IS_FILE" = 1 ] && return 0
  gh issue edit "$ISSUE" -R "$REPO" --add-assignee @me > /dev/null 2>&1 || log "could not assign #$ISSUE; continuing"
}

FROZEN_SET="factory lib.sh _common.md role-settings.json worker-settings.json checks.sh \
judge.md reviewer.md judge.schema.json reviewer.schema.json issue.md protected.txt exempt.txt \
factory-round.js review-output.schema.json codex-review.prompt.md"

freeze() {
  local g src
  [ -f "$RUN/frozen/sha256" ] && return 0
  printf '%s\n' "$BODY" > "$RUN/frozen/issue.md"
  cp "$ROOT/bin/factory" "$RUN/frozen/factory"
  cp "$ROOT/bin/factory.d/factory-round.js" "$RUN/frozen/factory-round.js"  # the worker runs its frozen copy, so it cannot edit the script (F12)
  cp "$ROOT/bin/factory.d/review-output.schema.json" "$RUN/frozen/review-output.schema.json"  # the Codex review reads the frozen copy, so a mid-run edit of it cannot change the review (#38, F4)
  cp "$ROOT/bin/factory.d/codex-review.prompt.md" "$RUN/frozen/codex-review.prompt.md"  # the Codex review reads the frozen prompt, so a mid-run edit of it cannot change the review (#38, F4)
  cp "$ROOT/bin/factory.d/lib.sh" "$RUN/frozen/lib.sh"
  cp "$ROOT/bin/factory.d/role-settings.json" "$RUN/frozen/role-settings.json"
  cp "$ROOT/bin/factory.d/worker-settings.json" "$RUN/frozen/worker-settings.json"
  sed -e "s|<issue>|${ISSUE:-$KEY}|g" -e "s|<decisions>|$DECISIONS|g" \
    "$ROOT/bin/factory.d/_common.md" > "$RUN/frozen/_common.md"
  for g in judge reviewer; do
    src=$(grader_file "$g") || finish stopped-environment "no $g.md in the installed plugin cache"
    grader_rubric "$src" > "$RUN/frozen/$g.md"
    schema_for "$g" > "$RUN/frozen/$g.schema.json"
    printf '{"ts":"%s","event":"grader","role":"%s","file":"%s","sha256":"%s"}\n' \
      "$(now)" "$g" "$src" "$(sha256_of < "$src" | cut -d' ' -f1)" >> "$LEDGER"
  done
  { cat "$RUN/frozen/lib.sh"; echo; dc_block; echo; echo 'exit $((n_fail > 0))'; } > "$RUN/frozen/checks.sh"
  { standing_list; section "Do not touch" | sed 's/[Ee]xcept:.*//' | ticket_paths; } | sort -u > "$RUN/frozen/protected.txt"
  section "Do not touch" | grep -o '[Ee]xcept:.*' | ticket_paths > "$RUN/frozen/exempt.txt"
  chmod +x "$RUN/frozen/checks.sh" "$RUN/frozen/factory"
  # shellcheck disable=SC2086
  ( cd "$RUN/frozen" && sha256_of $FROZEN_SET > sha256 )
  chmod a-w "$RUN/frozen"/*
}

check_frozen() {
  ( cd "$RUN/frozen" && sha256_of -c sha256 --status ) \
    || finish stopped-environment "the frozen set under $RUN/frozen changed mid-run"
}

# The supervisor runs its frozen copy, so a ticket that edits bin/factory takes effect next run.
exec_frozen() {
  [ "${FACTORY_FROZEN:-}" = "$RUN/frozen/factory" ] && return 0
  export FACTORY_FROZEN="$RUN/frozen/factory" FACTORY_ROOT="$ROOT"
  exec "$RUN/frozen/factory" run "$SRC"
}

# ---- ledger and caps --------------------------------------------------------

ticket_spent() { jq -s '[.[].cost_usd // 0] | add // 0' "$LEDGER"; }
daily_spent()  { jq -s --arg d "$(today)" '[.[] | select(.date == $d) | .cost_usd // 0] | add // 0' "$DAILY"; }

record() { # round role model result.json [advisor_calls] [advisor_usd] [workflow_agents] [workflow_usd] [codex]
  # workflow_agents and workflow_usd come from workflow_ledger (0 0 on every round but a claude worker's
  # round 1, and on every Codex round). codex is 1 for a Codex call: cost_usd is null (the dollar caps do
  # not bound Codex, #41) and `usage` carries its verbatim token counters; ticket_spent, daily_spent, and
  # cmd_status all read cost_usd // 0, so null is safe.
  local line acalls="${5:-0}" ausd="${6:-0}" wagents="${7:-0}" wusd="${8:-0}" codex="${9:-0}"
  line=$(jq -c --argjson round "$1" --arg role "$2" --arg model "$3" --arg ts "$(now)" \
    --argjson acalls "$acalls" --argjson ausd "$ausd" --argjson wagents "$wagents" --argjson wusd "$wusd" --argjson codex "$codex" \
    "$RESULT_OBJ | {round:\$round, role:\$role, model:\$model, cost_usd:(if \$codex == 1 then null else (.total_cost_usd // 0) end), \
duration_ms:(.duration_ms // 0), num_turns:(.num_turns // 0), denials:((.permission_denials // []) | length), \
subtype:(.subtype // \"unknown\"), usage:(.usage // null), advisor_calls:\$acalls, advisor_usd:\$ausd, \
workflow_agents:\$wagents, workflow_usd:\$wusd, \
ts:\$ts}" "$4" 2> /dev/null) \
    || line=$(jq -nc --argjson round "$1" --arg role "$2" --arg model "$3" --arg ts "$(now)" \
      --argjson acalls "$acalls" --argjson ausd "$ausd" --argjson wagents "$wagents" --argjson wusd "$wusd" --argjson codex "$codex" \
      '{round:$round, role:$role, model:$model, cost_usd:(if $codex == 1 then null else 0 end), duration_ms:0, num_turns:0, denials:0, subtype:"unknown", usage:null, advisor_calls:$acalls, advisor_usd:$ausd, workflow_agents:$wagents, workflow_usd:$wusd, ts:$ts}')
  printf '%s\n' "$line" >> "$LEDGER"
  printf '%s' "$line" | jq -c --arg date "$(today)" --arg ticket "$KEY" \
    '{date:$date, ticket:$ticket, role:.role, cost_usd:.cost_usd}' >> "$DAILY"
  log "$2 round $1: $(printf '%s' "$line" | jq -r '"cost=\(.cost_usd) usd, turns=\(.num_turns), denials=\(.denials), \(.duration_ms)ms, \(.subtype)" + (if .role == "worker" then ", advisor_calls=\(.advisor_calls), advisor_usd=\(.advisor_usd)" else "" end)')"
}

assert_caps() { # before every model call; the daily cap is "the next call could exceed it"
  local spent daily hours
  spent=$(ticket_spent); daily=$(daily_spent)
  jq -en --argjson a "$spent" --argjson b "$TICKET_BUDGET_USD" '$a >= $b' > /dev/null \
    && finish stopped-cap "ticket budget: spent $spent of $TICKET_BUDGET_USD usd"
  hours=$(( ( $(date -u +%s) - $(cat "$RUN/launched") ) / 3600 ))
  [ "$hours" -lt "$MAX_HOURS" ] || finish stopped-cap "wall clock: ${hours}h of ${MAX_HOURS}h since this launch"
  jq -en --argjson a "$daily" --argjson b "$ROUND_BUDGET_USD" --argjson c "$DAILY_BUDGET_USD" '($a + $b) > $c' > /dev/null \
    && finish stopped-cap "daily budget: $daily spent today, the next call could exceed $DAILY_BUDGET_USD usd"
  return 0
}

stop_requested() { [ -f "$RUN/FACTORY_STOP" ] || [ -f "$RUNS_ROOT/FACTORY_STOP" ]; }

# MAX_PARALLEL counts the other tickets already holding a slot: a run is live while its
# status reads running or waiting-limit.
assert_parallel() {
  local d n=0 st
  for d in "$RUNS_ROOT"/*/*/; do
    [ -f "$d/status" ] || continue
    [ "$(basename "$(dirname "$d")")" = "$KEY" ] && continue
    st=$(cat "$d/status")
    [ "$st" = running ] || [ "$st" = waiting-limit ] || continue
    n=$((n + 1))
  done
  [ "$n" -lt "$MAX_PARALLEL" ] \
    || finish stopped-environment "parallel cap: $n other live run(s), MAX_PARALLEL=$MAX_PARALLEL"
}

# A call with no result event (killed by CALL_TIMEOUT_SEC, or crashed) is the environment, not a round.
assert_call_ok() { # role result.json
  local e
  e=$(jq -r "$RESULT_OBJ | if .is_error == true then (.result // \"unknown error\") \
elif .subtype == \"no-result\" then \"no result event (killed by CALL_TIMEOUT_SEC=$CALL_TIMEOUT_SEC, or crashed)\" \
else empty end" "$2" 2> /dev/null) || e=""
  [ -z "$e" ] || finish stopped-environment "the $1 call failed before doing work: $e"
}

# A usage-limit reply names its reset ("You've hit your session limit - resets 1:30pm (America/Los_Angeles)").
# Waiting for it is loop behavior, not a round: sleep to the reset, or 20 minutes, then repeat the same call.
limit_wait() { # result.json -> 0 after waiting, 1 when the reply is not a usage limit
  local e t tz at left secs=1200
  e=$(jq -r "$RESULT_OBJ | if .is_error == true then (.result // \"\") else empty end" "$1" 2> /dev/null) || e=""
  grep -qiE '(hit|reached) your .*limit' <<< "$e" || return 1
  t=$(grep -oiE 'resets? [0-9]{1,2}(:[0-9]{2})? ?[ap]m' <<< "$e" | head -1 | sed -E 's/^[Rr]esets? //')
  tz=$(grep -oE '\([A-Za-z_]+/[A-Za-z_]+\)' <<< "$e" | head -1 | tr -d '()')
  if [ -n "$t" ] && at=$(TZ="${tz:-UTC}" date -d "$t" +%s 2> /dev/null); then
    [ "$at" -gt "$(date +%s)" ] || at=$((at + 86400))
    secs=$((at - $(date +%s) + 60))
  fi
  left=$(( MAX_HOURS * 3600 - ( $(date +%s) - $(cat "$RUN/launched") ) ))
  [ "$secs" -le "$left" ] || finish stopped-environment "usage limit: $e; the reset is ${secs}s away, past MAX_HOURS=$MAX_HOURS"
  log "usage limit, not a round: $e; waiting ${secs}s"
  set_status waiting-limit
  sleep "$secs"
  return 0
}

# ---- step 4: round 0 --------------------------------------------------------
# Every non-guard check must fail on base; one that passes there cannot prove the ticket.

round_zero() {
  local out="$RUN/round-0.checks" guards name
  ( cd "$WORKTREE" && "$RUN/frozen/checks.sh" ) > "$out" 2>&1
  guards=$(dc_block | grep 'guard' | grep -oE '(^|[[:space:]])pass[[:space:]]+"?[A-Za-z0-9_.-]+' \
    | awk '{print $NF}' | tr -d '"' | sort -u)
  while read -r _ name _; do
    printf '%s\n' "$guards" | grep -qxF "$name" && continue
    finish ticket-defect "check $name passes on $(cut -c1-8 "$RUN/base.sha"), so it cannot prove the ticket; see $out"
  done < <(grep '^PASS ' "$out")
  log "round 0: every non-guard check fails on base"
}

# ---- steps 5 and 6: the worker round ----------------------------------------

# A large claude ticket runs round 1 as the fan-out workflow (F12); this is the one test of the three
# values (worker kind, size, round) that gate it. A Codex worker never fans out (it has no Workflow tool).
runs_workflow() { [ "$WORKER_KIND" = claude ] && [ "${WORKER_SIZE:-small}" = large ] && [ "$1" -eq 1 ]; }

# workflow_agents and workflow_usd for a worker round's ledger line. Only a claude worker's round 1 runs
# the fan-out; every other round and every Codex round is 0 0. workflow_agents is the Workflow tool_use
# blocks in the round's stream (the worker's own calls) plus one per builder artifact the integrator left
# under tasks/ when it wrote tasks/result.json - a lower bound, since a builder that wrote no artifact is
# counted unmet, not here (the planner and integrator are the Workflow's own subagents, absent from this
# round's subagent_stats). workflow_usd is the round's total cost only when result.json exists, else 0:
# the F4 run planned solo, wrote no result.json, and spent nothing on fan-out.
workflow_ledger() { # round stream.jsonl result.json -> "<agents> <usd>" on stdout
  local round="$1" stream="$2" resj="$3" agents=0 usd=0
  if runs_workflow "$round"; then
    agents=$(jq -s '[.[] | select(.type == "assistant") | .message.content[]?
      | select(.type == "tool_use" and .name == "Workflow")] | length' "$stream" 2> /dev/null)
    [ -n "$agents" ] || agents=0
    if [ -f "$RUN/tasks/result.json" ]; then
      agents=$(( agents + $(find "$RUN/tasks" -maxdepth 1 -name '[0-9]*.md' 2> /dev/null | wc -l) ))
      usd=$(jq -r "$RESULT_OBJ | .total_cost_usd // 0" "$resj" 2> /dev/null)
      [ -n "$usd" ] || usd=0
    fi
  fi
  printf '%s %s\n' "$agents" "$usd"
}

build_worker_prompt() { # round -> prompt path (pending until the call returns a result); non-zero when a Codex skill will not resolve
  local round="$1" pf="$RUN/pending.prompt.md" prev=$((round - 1)) s sf
  { printf '%s\n\n' "$BODY"; cat "$RUN/frozen/_common.md"; } > "$pf"
  # Skills per role (LOOP.md): a Claude worker gets one Skill-tool sentence per `skills:` name (never a
  # slash command, which would swallow the body, #37/#40); a Codex worker has no Skill tool and swallows
  # an unknown `/<skill>` line (#41), so it gets each named skill's body pasted (skill_file resolves it).
  if [ "$WORKER_KIND" = codex ]; then
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      if sf=$(skill_file "$s"); then
        printf '\n## Skill: %s\n\n%s\n' "$s" "$(cat "$sf")" >> "$pf"
      else
        # Lint guaranteed the name is a skills.txt line, so no resolution is an install gap, not a typo;
        # a "use the X skill" sentence Codex has no Skill tool to honor would be worse than stopping.
        # build_worker_prompt runs in $(...), so return non-zero; worker_round turns it into finish.
        log "skill \"$s\" resolves to no SKILL.md; a Codex worker cannot be given its body"
        return 3
      fi
    done < <(section Worker | sed -n 's/^skills: *//p' | head -1 | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep .)
  else
    section Worker | sed -n 's/^skills: *//p' | head -1 | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep . \
      | while read -r s; do printf 'Before the first edit, call the Skill tool with "%s".\n' "$s"; done >> "$pf"
  fi
  # A large claude ticket runs round 1 as the fan-out workflow; a Codex worker gets the ordinary round-1
  # prompt (runs_workflow is false for it). The F11 advisor is the Fable check on the split (F12).
  if runs_workflow "$round"; then
    {
      printf '\n\n## Large ticket, round 1: run the fan-out workflow\n\n'
      printf 'Run the Workflow tool with scriptPath `%s/frozen/factory-round.js` and args `{"ticket": "%s/frozen/issue.md", "run": "%s"}`. ' "$RUN" "$RUN" "$RUN"
      printf 'When it returns, read %s/tasks/result.json. If that file is absent, implement the ticket yourself as in any round. ' "$RUN"
      printf 'Otherwise the integrator has committed; copy its `unmet` and `abandoned` lists into %s.\n' "$DECISIONS"
    } >> "$pf"
  fi
  if [ "$round" -gt 1 ]; then
    {
      printf '\n\n## Previous round (%d)\n\n' "$prev"
      [ -f "$RUN/round-$prev.checks" ] && { printf 'Check lines that failed:\n\n```\n'
        grep '^FAIL' "$RUN/round-$prev.checks"; printf '```\n\n'; }
      [ -s "$RUN/round-$prev.fixes" ] && { printf 'Blocking findings, verbatim:\n\n'; cat "$RUN/round-$prev.fixes"; printf '\n'; }
    } >> "$pf"
  fi
  printf '%s\n' "$pf"
}

# Codex --json stream (round-<k>.jsonl) plus the exit code -> a result-shaped JSON on stdout that
# record and assert_call_ok read unchanged. The last `turn.completed` carries `usage`, passed through
# verbatim so the five token counters are not hardcoded (#41). No `turn.completed`, or a non-zero exit,
# is the environment, not a round (LOOP.md, Exits): subtype no-result / is_error true stops it.
codex_result() { # jsonl exit_code [duration_ms] -> result JSON on stdout; duration_ms is the caller's wall clock ($SECONDS), no sample shows a per-turn field (#41)
  jq -s --argjson rc "${2:-0}" --argjson dur "${3:-0}" '
    [.[] | select(.type == "turn.completed")] as $turns
    | [.[] | select(.type == "turn.failed" or .type == "error")] as $errs
    | {
        subtype: (if ($turns | length) > 0 then "success" else "no-result" end),
        is_error: ($rc != 0 or ($errs | length) > 0),
        num_turns: ($turns | length),
        duration_ms: $dur,
        total_cost_usd: null,
        usage: ($turns[-1].usage // null),
        result: ((($errs[-1].message // $errs[-1].error) // (if $rc != 0 then "codex worker call exited " + ($rc | tostring) else "" end)) // "")
      }' "$1" 2> /dev/null \
    || printf '{"subtype":"no-result","is_error":true,"num_turns":0,"duration_ms":0,"total_cost_usd":null,"usage":null,"result":"codex result parse failed"}\n'
}

worker_round() { # round; leaves round-N.* only once the call produced a result
  local round="$1" pf out="$RUN/pending.jsonl" res="$RUN/pending.result.json" t=() login_retried=0 le
  command -v timeout > /dev/null 2>&1 && t=(timeout --foreground "$CALL_TIMEOUT_SEC")
  # The first round this process runs; a login expired at launch retries only its call. A global,
  # not a local, so it survives the loop's later rounds.
  [ -n "${FIRST_WORKER_ROUND+x}" ] || FIRST_WORKER_ROUND="$round"
  # A retried round 1 must not inherit a builder artifact or result.json from an earlier attempt, which
  # workflow_ledger would count and the worker would read as an integrated round. The supervisor empties
  # tasks/ itself and keeps the directory: the integrator writes result.json under it and never recreates
  # it, and the worker cannot (rm -rf is denied by worker-settings.json). Codex review of #74.
  if runs_workflow "$round"; then
    find "$RUN/tasks" -mindepth 1 -delete 2> /dev/null || finish stopped-environment "could not empty $RUN/tasks before the fan-out round"
  fi
  pf=$(build_worker_prompt "$round") || finish ticket-defect "a skill this ticket names resolves to no SKILL.md under ~/.claude/skills or the plugin cache; see the log"
  if [ "$WORKER_KIND" = codex ]; then
    # The Codex worker: JSONL stream is stdout, -o is the last message, < /dev/null keeps Codex off the
    # caller's stdin (#41). No dollar budget bounds it (cost_usd null); CALL_TIMEOUT_SEC and MAX_HOURS do.
    local rc start wl wagents wusd swapped=0 codex_target cgd ccd add_dirs
    log "codex worker call: round $round model=$CODEX_MODEL (dollar caps do not bound it), prompt=$(wc -c < "$pf") bytes"
    rm -f "$out"
    # Codex's workspace-write sandbox mounts the workspace .codex read-only, and bubblewrap refuses the
    # root .codex because it is a symlink into seed/ (D12, #77). Swap it for a real copy of its target for
    # the call; it is restored before grading below. The worktree's commit also needs four git roots
    # writable: the worktree gitdir, plus objects/refs/logs under the common dir (probe C2).
    if [ -L "$WORKTREE/.codex" ]; then
      { codex_target=$(readlink -f "$WORKTREE/.codex") && rm "$WORKTREE/.codex" && cp -R "$codex_target" "$WORKTREE/.codex"; } \
        || finish stopped-environment "could not swap the .codex symlink for a real directory before the Codex round"
      swapped=1
      log "codex worker call: swapped the .codex symlink for a real copy of $codex_target for the workspace-write sandbox"
    fi
    cgd=$(git -C "$WORKTREE" rev-parse --absolute-git-dir)
    ccd=$(git -C "$WORKTREE" rev-parse --path-format=absolute --git-common-dir)
    add_dirs=(--add-dir "$cgd" --add-dir "$ccd/objects" --add-dir "$ccd/refs" --add-dir "$ccd/logs")
    start=$SECONDS
    ( cd "$WORKTREE" && PATH="$CODEX_PATH:$PATH" ${t[@]+"${t[@]}"} codex exec --json -s workspace-write "${add_dirs[@]}" "$(cat "$pf")" > "$out" -o "$RUN/round-$round.last.txt" < /dev/null ); rc=$?
    [ "$rc" -eq 0 ] || log "codex worker call exited $rc (the result decides)"
    # Restore the tracked .codex before codex_result so the clean-tree check and the graders see the
    # symlink, whatever the call's exit code (D12, #77). If the round committed the ` D .codex` deletion,
    # .codex has left the index, so there is nothing to check out and do_not_touch_hits counts the
    # committed change as a hit. A restore that fails is the environment, not a round.
    if [ "$swapped" -eq 1 ]; then
      rm -rf "$WORKTREE/.codex" || finish stopped-environment "could not remove the .codex copy after the Codex round"
      if git -C "$WORKTREE" ls-files --error-unmatch .codex > /dev/null 2>&1; then
        git -C "$WORKTREE" checkout -- .codex \
          || finish stopped-environment "could not restore the .codex symlink after the Codex round"
        log "codex worker call: restored the .codex symlink before grading"
      else
        log "codex worker call: the round removed the tracked .codex; do_not_touch_hits counts it as a hit"
      fi
    fi
    codex_result "$out" "$rc" "$(( (SECONDS - start) * 1000 ))" > "$res"
    wl=$(workflow_ledger "$round" "$out" "$res"); wagents=${wl% *}; wusd=${wl#* }
    record "$round" worker "$CODEX_MODEL" "$res" 0 0 "$wagents" "$wusd" 1
    assert_call_ok worker "$res"
    mv "$pf" "$RUN/round-$round.prompt.md"
    mv "$out" "$RUN/round-$round.jsonl"
    mv "$res" "$RUN/round-$round.result.json"
    return 0
  fi
  while :; do
    log "worker call: round $round model=$WORKER_MODEL effort=$WORKER_EFFORT advisor=${WORKER_ADVISOR:-off} budget=$ROUND_BUDGET_USD usd, prompt=$(wc -c < "$pf") bytes"
    rm -f "$out"
    ( cd "$WORKTREE" && LOAM_CHECKS="$RUN/frozen/checks.sh" CLAUDE_CODE_SUBAGENT_MODEL="$WORKER_MODEL" ${t[@]+"${t[@]}"} claude -p \
        --model "$WORKER_MODEL" --effort "$WORKER_EFFORT" ${WORKER_ADVISOR:+--advisor "$WORKER_ADVISOR"} --permission-mode bypassPermissions --strict-mcp-config \
        --setting-sources user --settings "$RUN/frozen/worker-settings.json" --max-turns "$MAX_TURNS" \
        --max-budget-usd "$ROUND_BUDGET_USD" --output-format stream-json --verbose --include-hook-events \
        < "$pf" > "$out" 2>> "$LOG" ) || log "worker exited non-zero (the result event decides)"
    jq -c 'select(.type == "result")' "$out" 2> /dev/null | tail -1 > "$res"
    [ -s "$res" ] || echo '{"subtype":"no-result"}' > "$res"
    # An `OAuth session expired` on the first call of a launch is a stale login, not a round: wait
    # once and relaunch the call. A second failure, or the same on a later round, stops as today.
    if ! limit_wait "$res"; then
      le=$(jq -r "$RESULT_OBJ | if .is_error == true then (.result // \"\") else empty end" "$res" 2> /dev/null) || le=""
      { [ "$round" -eq "$FIRST_WORKER_ROUND" ] && [ "$login_retried" -eq 0 ] && grep -q 'OAuth session expired' <<< "$le"; } || break
      login_retried=1
      log "login expired; waiting 60s and relaunching the call once"
      sleep 60
    fi
    assert_caps
  done
  # Advisor spend on this round: calls from the server_tool_use blocks in the stream, usd from the
  # result's modelUsage minus the worker's own line (docs/research/advisor-and-managed-agents.md).
  local acalls ausd
  acalls=$(jq -s '[.[] | select(.type == "assistant") | .message.content[]?
    | select(.type == "server_tool_use" and .name == "advisor")] | length' "$out" 2> /dev/null) || acalls=0
  [ -n "$acalls" ] || acalls=0
  ausd=$(jq -r --arg m "$WORKER_MODEL" \
    '[(.modelUsage // {}) | to_entries[] | select(.key != $m) | .value.costUSD] | add // 0' "$res" 2> /dev/null) || ausd=0
  [ -n "$ausd" ] || ausd=0
  # workflow_agents and workflow_usd for this round: 0 0 unless this is a large claude ticket's round 1 (F12).
  local wl wagents wusd
  wl=$(workflow_ledger "$round" "$out" "$res"); wagents=${wl% *}; wusd=${wl#* }
  record "$round" worker "$WORKER_MODEL" "$res" "$acalls" "$ausd" "$wagents" "$wusd"
  assert_call_ok worker "$res"
  mv "$pf" "$RUN/round-$round.prompt.md"
  mv "$out" "$RUN/round-$round.jsonl"
  mv "$res" "$RUN/round-$round.result.json"
}

do_not_touch_hits() { # -> the changed paths the ticket fenced off
  local f
  git -C "$WORKTREE" diff --name-only "$(cat "$RUN/base.sha")...HEAD" | while IFS= read -r f; do
    under "$f" "$(cat "$RUN/frozen/protected.txt")" || continue
    under "$f" "$(cat "$RUN/frozen/exempt.txt")" && continue
    printf '%s ' "$f"
  done
}

measure_rows() { # round; Rows measured is `<row>: <command> | <baseline>` per line (CONTRACT.md)
  local out="$RUN/round-$1.measure" line row rest
  : > "$out"
  while IFS= read -r line; do
    line=${line#- }
    [ -n "${line//[[:space:]]/}" ] || continue
    row=${line%%:*}; rest=${line#*:}
    printf 'MEASURE %s %s (baseline %s)\n' "$row" \
      "$( cd "$WORKTREE" && eval "${rest%%|*}" 2>&1 | tail -1 )" "$(printf '%s' "${rest#*|}" | tr -d ' ')" \
      | tee -a "$out" >&2
  done <<< "$(section "Rows measured")"
}

# ---- step 7: the graders ----------------------------------------------------

# --json-schema routes the grader's last message through a structured-output tool, so .result is the
# bare object whatever the rubric's prose default asks for. Each schema's one home is its file next to
# the running factory (bin/factory.d/), not under $ROOT: an eval run from a worktree reads that
# worktree's schema even though the supervisor exports FACTORY_ROOT pointing at the main checkout.
# freeze copies judge's and reviewer's into frozen/; the eval reads them directly.
schema_for() { cat "$(dirname "$0")/factory.d/$1.schema.json"; }  # judge|reviewer|lean-critic -> JSON Schema on stdout

build_evidence() { # rubric_file diff_cap -> stdout
  local rubric="$1" cap="$2" base names stat_only content paths diff="$RUN/round-$ROUND.diff"
  base=$(cat "$RUN/base.sha")
  cat "$rubric"
  printf '\n\n## Ticket\n\n%s\n' "$FENCE"; cat "$RUN/frozen/issue.md"; printf '\n%s\n' "$FENCE"
  printf '\n## Checks output\n\n%s\n' "$FENCE"; cat "$RUN/round-$ROUND.checks"; printf '\n%s\n' "$FENCE"
  printf '\n## Rows measured\n\n%s\n' "$FENCE"; cat "$RUN/round-$ROUND.measure" 2> /dev/null; printf '\n%s\n' "$FENCE"
  printf '\n## decisions.md (worker-authored)\n\n%s\n' "$FENCE"; cat "$DECISIONS"; printf '\n%s\n' "$FENCE"
  # Data files pass as stat only: evals/**/prompt.md and any added file over 400 lines (LOOP.md, Grader calls),
  # so a frozen grader prompt or a large fixture never floods the diff a grader reads.
  names=$( cd "$WORKTREE" && git diff -M --name-only --diff-filter=AMR "$base...HEAD" )
  stat_only=$( { grep -E '^evals/.*/prompt\.md$' <<< "$names" || true
                 ( cd "$WORKTREE" && git diff --numstat --diff-filter=A "$base...HEAD" ) \
                   | awk -F'\t' '$1 + 0 > 400 {print $3}'; } | sort -u )
  content=$( grep -vxF -f <(printf '%s\n' "$stat_only") <<< "$names" || true )
  printf '\n## Diff (%s...HEAD)\n\n%s\n' "${base:0:8}" "$FENCE"
  ( cd "$WORKTREE" && git diff -M --stat=200 "$base...HEAD" ); printf '\n'
  [ -z "$stat_only" ] || printf '[stat only, content omitted as data: %s]\n\n' "$(printf '%s' "$stat_only" | tr '\n' ' ')"
  if [ -n "$content" ]; then
    mapfile -t paths <<< "$content"
    ( cd "$WORKTREE" && git diff -M --diff-filter=AMR "$base...HEAD" -- "${paths[@]}" ) > "$diff"
    head -"$cap" "$diff"
    [ "$(wc -l < "$diff")" -le "$cap" ] || printf '\n[content diff capped at %s lines; the stat above is complete]\n' "$cap"
  fi
  printf '%s\n' "$FENCE"
}

# A pass with fixes to apply, or a fail with nothing to point at, refutes itself (LOOP.md, precedence).
verdict_consistent() { # json file
  jq -e '(.verdict // "") as $v
    | (((.fixes // []) | length) + ([.findings[]? | select(.severity == "high")] | length)) as $blocking
    | (((.backlog // []) | length) + ((.findings // []) | length)) as $other
    | if ($v == "pass" or $v == "merge") then $blocking == 0
      elif ($v == "fail" or $v == "fix") then ($blocking > 0 or $other > 0)
      else true end' "$1" > /dev/null 2>&1
}

call_json() { # round stem role prompt_file schema_file
  local round="$1" stem="$2" role="$3" pf="$4" schema="$5" final="$RUN/round-$1.$2.json" out res attempt=0
  while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    out="$RUN/round-$round.$stem.raw.$attempt.json"
    assert_caps
    stop_requested && finish stopped "FACTORY_STOP before the $role call"
    log "$role call (attempt $attempt): model=$GRADER_MODEL effort=$GRADER_EFFORT"
    # --tools Read,Grep,Glob is what makes a grader read-only (#40); with no MCP schemas and no
    # skills listing its prefix is 9.9k tokens instead of 27k (probed 2026-09-09). --setting-sources
    # user is what keeps the worktree's own hooks out, so a grader can still read the tree it grades.
    ( cd "$WORKTREE" && ${TIMEOUT_G[@]+"${TIMEOUT_G[@]}"} claude -p --model "$GRADER_MODEL" --effort "$GRADER_EFFORT" \
        --tools Read,Grep,Glob --strict-mcp-config --disable-slash-commands --no-session-persistence \
        --json-schema "$(cat "$schema")" \
        --max-budget-usd "$GRADER_BUDGET_USD" --setting-sources user --settings "$RUN/frozen/role-settings.json" \
        --output-format json < "$pf" > "$out" 2>> "$LOG" ) || log "$role exited non-zero"
    if limit_wait "$out"; then attempt=$((attempt - 1)); continue; fi
    record "$round" "$role" "$GRADER_MODEL" "$out"
    res=$(jq -r "$RESULT_OBJ | .result // \"\"" "$out" 2> /dev/null | sed -e 's/^```json//' -e 's/^```//' -e 's/```$//') || res=""
    if printf '%s' "$res" | jq -e '.verdict' > /dev/null 2>&1; then
      printf '%s' "$res" | jq '.' > "$final"
      verdict_consistent "$final" && return 0
      log "$role verdict is inconsistent with its own lists; calling once more with the refutation"
      printf '\n\n## Refutation\n\nYour previous reply was `%s`, which contradicts the fixes, findings, and backlog you listed. Grade again and return a consistent object.\n' \
        "$(jq -c '{verdict, fixes: (.fixes // []), findings: ((.findings // []) | length), backlog: (.backlog // [])}' "$final")" >> "$pf"
      continue
    fi
    log "$role output not parseable"
  done
  # An absent or unparseable grader is a fail with one high finding, never a pass (LOOP.md).
  log "$role output unparseable or inconsistent after 3 attempts; see $out"
  jq -n --arg r "$role" '{verdict: (if $r == "judge" then "fail" else "fix" end), unparseable: true,
    rows: {}, evidence: {}, fixes: [], backlog: [],
    findings: [{severity: "high", file: "-", line: 0, defect: ($r + " output unparseable"),
                fix: ("rerun the " + $r + " on this round")}]}' > "$final"
}

run_judge() { # round -> 0 on a pass verdict
  local round="$1" pf="$RUN/round-$1.judge.prompt.md" f="$RUN/round-$1.judge.json"
  build_evidence "$RUN/frozen/judge.md" 4000 > "$pf"
  call_json "$round" judge judge "$pf" "$RUN/frozen/judge.schema.json"
  jq -r '.fixes[]? | "- " + .' "$f" > "$RUN/round-$round.fixes"
  log "judge verdict: $(jq -r .verdict "$f") rows=$(jq -c '.rows // {}' "$f")"
  [ "$(jq -r .verdict "$f")" = pass ]
}

run_review() { # round -> 0 when nothing blocks
  local round="$1" pf="$RUN/round-$1.review.prompt.md" f="$RUN/round-$1.review.json" highs
  build_evidence "$RUN/frozen/reviewer.md" 6000 > "$pf"
  call_json "$round" review reviewer "$pf" "$RUN/frozen/reviewer.schema.json"
  highs=$(jq '[.findings[]? | select(.severity == "high")] | length' "$f")
  log "reviewer verdict: $(jq -r .verdict "$f") findings=$(jq '(.findings // []) | length' "$f") blocking=$highs"
  [ "$highs" -gt 0 ] || return 0
  if [ "$REVIEW_BLOCKED" = 1 ]; then
    log "the reviewer already blocked once on this ticket; its findings go to the backlog"
    return 0
  fi
  REVIEW_BLOCKED=1
  jq -r '[.findings[]? | select(.severity == "high")] | .[]
    | "- " + (.file // "?") + ":" + ((.line // 0) | tostring) + " " + .defect + " Fix: " + .fix' "$f" >> "$RUN/round-$round.fixes"
  return 1
}

run_codex_review() { # round -> 0 when nothing blocks; needs-attention with a critical or high finding blocks once (LOOP.md)
  local round="$1" f="$RUN/round-$1.codex-review.json" jsonl="$RUN/round-$1.codex-review.jsonl" res="$RUN/round-$1.codex-review.result.json" base blocking rc start
  base=$(cat "$RUN/base.sha")
  assert_caps
  stop_requested && finish stopped "FACTORY_STOP before the Codex review call"
  log "codex review call: round $round schema=frozen/review-output.schema.json"
  # A review needs no write access, so it runs read-only: under workspace-write it could edit the tree the
  # judge and reviewer already graded. `codex exec review` ignores --output-schema, so the review is plain
  # `codex exec` with the schema (#41): the -o file holds the schema-validated JSON, the JSONL stream
  # (stdout) carries usage for the ledger. The one-line prompt is the frozen file with <base> filled in.
  start=$SECONDS
  ( cd "$WORKTREE" && PATH="$CODEX_PATH:$PATH" ${TIMEOUT_G[@]+"${TIMEOUT_G[@]}"} codex exec --json --output-schema "$RUN/frozen/review-output.schema.json" -o "$f" -s read-only "$(sed "s/<base>/$base/" "$RUN/frozen/codex-review.prompt.md")" > "$jsonl" < /dev/null ); rc=$?
  [ "$rc" -eq 0 ] || log "codex review call exited $rc"
  codex_result "$jsonl" "$rc" "$(( (SECONDS - start) * 1000 ))" > "$res"
  record "$round" codex-review "$CODEX_MODEL" "$res" 0 0 0 0 1
  blocking=$(jq '[.findings[]? | select(.severity == "critical" or .severity == "high")] | length' "$f" 2> /dev/null) || blocking=0
  [ -n "$blocking" ] || blocking=0
  log "codex review verdict: $(jq -r '.verdict // "unparseable"' "$f" 2> /dev/null) findings=$(jq '(.findings // []) | length' "$f" 2> /dev/null) blocking=$blocking"
  [ "$blocking" -gt 0 ] || return 0
  if [ "$CODEX_REVIEW_BLOCKED" = 1 ]; then
    log "the Codex review already blocked once on this ticket; its findings go to the backlog"
    return 0
  fi
  CODEX_REVIEW_BLOCKED=1
  jq -r '[.findings[]? | select(.severity == "critical" or .severity == "high")] | .[]
    | "- " + (.file // "?") + ":" + ((.line_start // 0) | tostring) + " [" + .severity + "] " + .title + ": " + .body + " Fix: " + (.recommendation // "-")' "$f" >> "$RUN/round-$round.fixes"
  return 1
}

graders() { # round -> 0 when the judge passes and nothing blocks
  local ok=0
  run_judge "$1" || ok=1
  run_review "$1" || ok=1
  [ "$CODEX_REVIEW" = yes ] && { run_codex_review "$1" || ok=1; }
  return "$ok"
}

# ---- step 8: the pull request -----------------------------------------------

open_pr() {
  local body="$RUN/pr-body.md" base url num title
  base=$(cat "$RUN/base.sha")
  {
    [ "$IS_FILE" = 1 ] || printf 'Closes #%s\n\n' "$ISSUE"
    printf '## Goal\n\n%s\n\n' "$(section Worker | sed -n 's/^goal: //p' | head -1)"
    printf '## Commits\n\n```\n%s\n```\n\n' "$(git -C "$WORKTREE" log --oneline "$base..HEAD")"
    [ -s "$RUN/round-$ROUND.measure" ] && { printf '## Rows measured\n\n```\n'; cat "$RUN/round-$ROUND.measure"; printf '```\n\n'; }
    printf '## Merge checklist\n\n'; section "Merge checklist" | grep '^- ' | sed 's/^- /- [ ] /'; printf '\n'
    printf '## Decisions\n\n```\n'; cat "$DECISIONS"; printf '```\n\n'
    printf '## Judge\n\n```json\n%s\n```\n\n' "$(jq -c '{verdict, rows: (.rows // {}), evidence: (.evidence // {})}' "$RUN/round-$ROUND.judge.json")"
    printf '## Reviewer\n\n'
    jq -r '.findings[]? | "- [" + .severity + "] " + (.file // "?") + ":" + ((.line // 0) | tostring) + " " + .defect + " Fix: " + .fix' "$RUN/round-$ROUND.review.json"
    jq -r '.unverified[]? | "- unverified: " + .' "$RUN/round-$ROUND.review.json"
    if [ "$CODEX_REVIEW" = yes ]; then
      printf '\n## Codex review\n\n'
      if [ -s "$RUN/round-$ROUND.codex-review.json" ] && jq -e . "$RUN/round-$ROUND.codex-review.json" > /dev/null 2>&1; then
        printf 'verdict: %s\n\n%s\n\n' "$(jq -r '.verdict // "?"' "$RUN/round-$ROUND.codex-review.json")" "$(jq -r '.summary // ""' "$RUN/round-$ROUND.codex-review.json")"
        jq -r '.findings[]? | "- [" + .severity + "] " + (.file // "?") + ":" + ((.line_start // 0) | tostring) + " " + .title + ": " + .body + " Fix: " + (.recommendation // "-")' "$RUN/round-$ROUND.codex-review.json"
      else
        printf '(no Codex review output for round %s)\n' "$ROUND"
      fi
    fi
    if [ "$WORKER_KIND" = codex ]; then
      printf '\n## Codex worker notes\n\n'
      printf -- '- Cost: the Codex worker rounds carry `cost_usd: null` in the ledger; the dollar caps (ROUND_BUDGET_USD, TICKET_BUDGET_USD, DAILY_BUDGET_USD) do not bound a Codex worker. Only token counts are recorded.\n'
      printf -- '- `.env` is readable by the Codex worker (D8, #41). No deny is configured; recorded risk.\n'
    fi
    printf '\n## Backlog\n\n'; jq -r '.backlog[]? | "- " + .' "$RUN/round-$ROUND.judge.json"
    printf '\n## Metrics\n\nrounds: %s, spend: %s usd, wall: %s min, denials: %s\nrun directory: %s\n' \
      "$ROUND" "$(ticket_spent)" "$(( ( $(date -u +%s) - $(cat "$RUN/started") ) / 60 ))" \
      "$(jq -s '[.[].denials // 0] | add // 0' "$LEDGER")" "$RUN"
  } > "$body"
  [ "$IS_FILE" = 1 ] && finish pr-opened "file ticket: no GitHub call; the PR body is at $body"
  git -C "$WORKTREE" push -u origin "$BRANCH" >> "$LOG" 2>&1 || finish stopped-environment "git push of $BRANCH failed"
  if num=$(gh pr view "$BRANCH" -R "$REPO" --json number --jq .number 2> /dev/null) && [ -n "$num" ]; then
    # gh pr edit has failed on a GraphQL deprecation; PR bodies are updated through the REST API.
    gh api -X PATCH "repos/$REPO/pulls/$num" -f "body=$(cat "$body")" > /dev/null \
      || finish stopped-environment "could not update the body of PR #$num"
    url="https://github.com/$REPO/pull/$num"
  else
    title=$(grep -m1 '^# ' "$RUN/frozen/issue.md" | sed 's/^# //')
    url=$(gh pr create -R "$REPO" --head "$BRANCH" --base main --title "${title:-$KEY}" --body-file "$body" 2>&1) \
      || finish stopped-environment "gh pr create for $BRANCH failed: $url"
    url=$(printf '%s\n' "$url" | tail -1)
  fi
  finish pr-opened "$url after $ROUND rounds, $(ticket_spent) usd"
}

# ---- the loop ---------------------------------------------------------------

main_loop() {
  local prev_fails="" prev_sig="" grader_fails=0 fails dirty touched checks sig_now
  notify "$KEY run started" "$KEY on $BRANCH in $WORKTREE; caps: $MAX_ROUNDS rounds, $TICKET_BUDGET_USD usd, ${MAX_HOURS}h"
  while :; do
    ROUND=$((ROUND + 1))
    [ "$ROUND" -le "$MAX_ROUNDS" ] || finish stopped-cap "round cap: $MAX_ROUNDS rounds"
    set_status running
    log "===== round $ROUND ====="
    check_frozen
    assert_caps
    stop_requested && finish stopped "FACTORY_STOP before the round-$ROUND call"
    worker_round "$ROUND"
    # Step 6, in order: abandon, the frozen set, a clean tree, do-not-touch, then the checks.
    grep -q '^ABANDON ' "$DECISIONS" && finish abandon "$(grep -m1 '^ABANDON ' "$DECISIONS")"
    check_frozen
    # The round signature is HEAD plus the digest of decisions.md, so a round that only relabels
    # decisions.md after a grader-only fail (#78) proceeds to the checks and graders; no-change fires
    # only when both are unchanged since the previous round.
    sig_now="$(git -C "$WORKTREE" rev-parse HEAD) $(sha256_of < "$DECISIONS" | cut -d' ' -f1)"
    [ "$sig_now" = "$prev_sig" ] && finish no-change "HEAD and decisions.md are unchanged since round $((ROUND - 1))"
    prev_sig="$sig_now"
    checks="$RUN/round-$ROUND.checks"
    dirty=$(git -C "$WORKTREE" status --porcelain)
    touched=$(do_not_touch_hits)
    if [ -n "$dirty" ]; then
      printf 'FAIL worktree-dirty: %s\n' "$(printf '%s' "$dirty" | tr '\n' ' ')" > "$checks"
    elif [ -n "$touched" ]; then
      printf 'FAIL do-not-touch %s\n' "$touched" > "$checks"
    else
      ( cd "$WORKTREE" && "$RUN/frozen/checks.sh" ) > "$checks" 2>&1
    fi
    if grep -q '^FAIL' "$checks"; then
      fails=$(grep '^FAIL' "$checks" | awk '{print $2}' | tr -d ':' | sort -u | tr '\n' ',')
      log "checks failing: $fails"
      [ "$fails" = "$prev_fails" ] && finish stuck "the same checks failed twice: $fails"
      prev_fails="$fails"
      [ $((ROUND % 2)) -eq 0 ] && notify "$KEY checks failing after round $ROUND" "$(grep '^FAIL' "$checks" | head -10)"
      continue
    fi
    prev_fails=""
    log "checks: all pass"
    measure_rows "$ROUND"
    graders "$ROUND" && open_pr
    grader_fails=$((grader_fails + 1))
    [ "$grader_fails" -lt "$GRADER_FAIL_ROUNDS" ] \
      || { log "grader-round cap: $GRADER_FAIL_ROUNDS grader-fail rounds; the rest goes to the PR backlog"; open_pr; }
  done
}

cmd_run() {
  load_ticket "$1"
  apply_caps
  WORKER_EFFORT=$(section Worker | sed -n 's/^effort: *//p' | head -1)
  [ -n "$WORKER_EFFORT" ] || WORKER_EFFORT=xhigh
  WORKER_SIZE=$(section Worker | sed -n 's/^size: *//p' | head -1)   # small|large; large routes round 1 to the workflow (F12)
  [ -n "$WORKER_SIZE" ] || WORKER_SIZE=small
  WORKER_KIND=$(section Worker | sed -n 's/^worker: *//p' | head -1)   # claude|codex; codex routes the worker call to Codex (F4)
  [ -n "$WORKER_KIND" ] || WORKER_KIND=claude
  CODEX_REVIEW=$(section Worker | sed -n 's/^codex-review: *//p' | head -1)   # yes adds a Codex review stage after the graders (F4)
  [ -n "$CODEX_REVIEW" ] || CODEX_REVIEW=no
  RUN="$RUNS_ROOT/$KEY/$(printf '%s' "$BODY" | sha256_of | cut -c1-8)"
  mkdir -p "$RUN/frozen" "$RUN/worker" "$RUN/tasks" || { echo "factory run: cannot create $RUN" >&2; exit 4; }
  LOG="$RUN/factory.log"; LEDGER="$RUN/ledger.jsonl"; DAILY="$RUNS_ROOT/ledger-daily.jsonl"
  DECISIONS="$RUN/worker/decisions.md"
  touch "$LOG" "$LEDGER" "$DAILY" "$DECISIONS"
  BRANCH="factory/$KEY"
  WORKTREE="${FACTORY_WORKTREE:-$MAIN_CHECKOUT-$(printf '%s' "$KEY" | tr '[:upper:]' '[:lower:]')}"
  [ -f "$RUN/started" ] || date -u +%s > "$RUN/started"
  date -u +%s > "$RUN/launched"
  stop_requested && finish stopped "FACTORY_STOP is present at launch"
  assert_parallel
  prepare_worktree
  freeze
  exec_frozen
  BODY=$(cat "$RUN/frozen/issue.md")   # from here on the frozen body is the ticket
  [ "$IS_FILE" = 1 ] && trap 'git -C "$MAIN_CHECKOUT" worktree remove --force "$WORKTREE" > /dev/null 2>&1' EXIT
  TIMEOUT_G=()
  command -v timeout > /dev/null 2>&1 && TIMEOUT_G=(timeout --foreground "$CALL_TIMEOUT_SEC")
  # The advisor attaches through a feature flag claude fetches; two env vars turn it silently off.
  # Refuse to launch rather than run a worker that thinks it has an advisor and does not (F11).
  if [ -n "$WORKER_ADVISOR" ]; then
    { [ -n "${DISABLE_TELEMETRY+x}" ] || [ -n "${CLAUDE_CODE_DISABLE_ADVISOR_TOOL+x}" ]; } \
      && finish stopped-environment "the advisor would be silently off: DISABLE_TELEMETRY or CLAUDE_CODE_DISABLE_ADVISOR_TOOL is set"
    log "advisor: $WORKER_ADVISOR (the first worker call proves it attaches)"
  fi
  # A relaunch reuses the worktree at branch HEAD, where the checks may already pass:
  # round 0 belongs to base only, and ROUND resumes past the rounds already on disk.
  if [ ! -f "$RUN/round-0.checks" ]; then
    round_zero
  else
    ROUND=$(find "$RUN" -maxdepth 1 -name 'round-*.checks' | sed -n 's/.*round-\([0-9][0-9]*\)\.checks$/\1/p' \
      | sort -n | tail -1)
    log "resuming after round $ROUND"
  fi
  main_loop
}

cmd_stop() { # <issue|stem>
  local d n=0
  for d in "$RUNS_ROOT/$1"/*/; do
    [ -d "$d" ] || continue
    : > "$d/FACTORY_STOP"; n=$((n + 1))
    echo "FACTORY_STOP written to $d"
  done
  [ "$n" -gt 0 ] || { echo "factory stop: no run directory under $RUNS_ROOT/$1" >&2; return 1; }
}

cmd_status() {
  local d led st rounds spend wall den grader notes
  printf '%-14s %-9s %-20s %6s %8s %6s %8s %-22s %s\n' \
    ticket sha8 status rounds spend wall denials first-failing-grader notes
  for d in "$RUNS_ROOT"/*/*/; do
    [ -f "$d/status" ] || continue
    led="$d/ledger.jsonl"
    st=$(cat "$d/status")
    rounds=$(find "$d" -maxdepth 1 -name 'round-*.checks' 2> /dev/null | grep -vc 'round-0' || true)
    spend=$(jq -s '[.[].cost_usd // 0] | add // 0 | . * 100 | round / 100' "$led" 2> /dev/null || echo 0)
    wall=$(( ( $(date -u +%s) - $(cat "$d/started" 2> /dev/null || date -u +%s) ) / 60 ))
    den=$(jq -s '[.[].denials // 0] | add // 0' "$led" 2> /dev/null || echo 0)
    grader=$(grader_first_fail "$d")
    notes=""
    [ -f "$d/notify.failed" ] && notes="notify.failed"
    [ -f "$d/FACTORY_STOP" ] && notes="$notes FACTORY_STOP"
    printf '%-14s %-9s %-20s %6s %8s %5sm %8s %-22s %s\n' \
      "$(basename "$(dirname "$d")")" "$(basename "$d")" "$st" "$rounds" "$spend" "$wall" "$den" "${grader:--}" "$notes"
  done
  printf '\n== worktrees and PRs\n'
  git -C "$MAIN_CHECKOUT" worktree list 2> /dev/null | sed 's/^/  /'
  gh pr list --json number,headRefName,title \
    --jq '.[] | select(.headRefName | startswith("factory/")) | "  #\(.number) \(.headRefName) \(.title)"' 2> /dev/null \
    || echo "  (no PR list: gh is unavailable from here; run status on the runner)"
  printf '\n== preconditions\n'
  precondition_lines
}

grader_first_fail() { # run dir -> the first grader item that failed in the last graded round
  local j r
  j=$(find "$1" -maxdepth 1 -name 'round-*.judge.json' 2> /dev/null | sort -V | tail -1)
  [ -n "$j" ] || return 0
  r=$(jq -r 'first((.rows // {}) | to_entries[] | select(.value != "pass") | "judge:" + .key) // empty' "$j" 2> /dev/null)
  [ -n "$r" ] || r=$(jq -r 'first(.findings[]? | select(.severity == "high") | "review:" + (.file // "?")) // empty' \
    "${j%judge.json}review.json" 2> /dev/null)
  printf '%s' "$r"
}

precondition_lines() { # LOOP.md, Preconditions
  local t
  for t in claude gh git jq python3 uv tmux timeout socat node; do
    command -v "$t" > /dev/null 2>&1 && echo "  PASS $t on PATH" || echo "  FAIL $t not on PATH"
  done
  # claude on PATH is not claude logged in: a logged-out Claude fails every worker call while claude
  # stays on PATH (#78). claude auth status prints JSON with a loggedIn boolean and exits 0 either way.
  if claude auth status 2> /dev/null | jq -e '.loggedIn' > /dev/null 2>&1; then
    echo "  PASS claude login"
  else
    echo "  FAIL claude login: claude auth status reports logged out; run claude login on the runner"
  fi
  gh api rate_limit > /dev/null 2>&1 && echo "  PASS gh api rate_limit" || echo "  FAIL gh api rate_limit"
  claude -p --help 2>&1 | grep -q -- '--json-schema' && echo "  PASS claude -p accepts --json-schema" \
    || echo "  FAIL claude -p lacks --json-schema; every grader call needs it"
  for t in judge reviewer; do
    grader_file "$t" > /dev/null 2>&1 && echo "  PASS $t.md in the plugin cache" || echo "  FAIL no $t.md in the plugin cache"
  done
  # Every worker skills.txt line must resolve to a SKILL.md, or a `worker: codex` ticket naming it stops
  # at build_worker_prompt (skill_file); a bare name and a plugin:name both, newest version first.
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    skill_file "$t" > /dev/null 2>&1 && echo "  PASS skill $t resolves" || echo "  INFO skill $t resolves to no SKILL.md (a worker: codex ticket naming it stops)"
  done < "$ROOT/bin/factory.d/skills.txt"
  # Codex login: Codex is not on the bare PATH (#41), so probe it under CODEX_PATH. Only a worker: codex
  # ticket needs it, so a logged-out or absent Codex is INFO here, not FAIL.
  if PATH="$CODEX_PATH:$PATH" command -v codex > /dev/null 2>&1; then
    if PATH="$CODEX_PATH:$PATH" codex login status > /dev/null 2>&1; then
      echo "  PASS codex login status"
    else
      echo "  INFO codex login status reports logged out; a worker: codex ticket needs a login"
    fi
  else
    echo "  INFO codex not on PATH; only a worker: codex ticket needs it"
  fi
  # With the advisor off (FACTORY_WORKER_ADVISOR= empty) the env check and probe are moot: neither
  # would run --advisor, so report the choice and skip both rather than FAIL a deliberate off (#68).
  if [ -n "$WORKER_ADVISOR" ]; then
    if [ -n "${DISABLE_TELEMETRY+x}" ]; then
      echo "  FAIL DISABLE_TELEMETRY is set; the advisor stays off"
    elif [ -n "${CLAUDE_CODE_DISABLE_ADVISOR_TOOL+x}" ]; then
      echo "  FAIL CLAUDE_CODE_DISABLE_ADVISOR_TOOL is set; --advisor has no effect"
    else
      echo "  PASS advisor env clean"
    fi
    if [ "${FACTORY_STATUS_PROBE:-}" = 1 ]; then
      # One paid Opus call with no --settings: the frozen worker settings carry a Stop hook that blocks
      # a one-turn probe. success means --advisor attached (docs/research/advisor-and-managed-agents.md).
      # Wrapped in timeout like every other model call; a hung probe must not hang status (#68).
      local pe po rc pt=()
      command -v timeout > /dev/null 2>&1 && pt=(timeout --foreground 120)
      pe=$(mktemp "${TMPDIR:-/tmp}/factory-probe.XXXXXX")
      po=$(${pt[@]+"${pt[@]}"} claude -p --model "$WORKER_MODEL" --advisor "$WORKER_ADVISOR" --max-turns 1 --output-format json \
        --strict-mcp-config --no-session-persistence 'Reply with the single word ok' 2> "$pe"); rc=$?
      if [ "$rc" -eq 124 ]; then
        echo "  FAIL advisor: probe timed out after 120s"
      elif [ "$rc" -eq 0 ] && [ "$(jq -r "$RESULT_OBJ | .subtype // \"\"" <<< "$po" 2> /dev/null)" = success ]; then
        echo "  PASS advisor attaches"
      else
        echo "  FAIL advisor: $(head -1 "$pe")"
      fi
      rm -f "$pe"
    else
      echo "  INFO advisor probe not run; FACTORY_STATUS_PROBE=1 bin/factory status runs it (one paid Opus call)"
    fi
  else
    echo "  INFO advisor off (FACTORY_WORKER_ADVISOR is empty)"
  fi
  [ -f "$HOME/.config/loam-loops/pushover.env" ] && echo "  INFO pushover.env present" \
    || echo "  INFO no pushover.env; notifications comment on the ticket"
}

usage() { # [cmd...] - one line per named command, all five when none is named
  local c
  for c in ${@:-lint eval run status stop}; do
    case "$c" in
      lint)   echo "usage: bin/factory lint <file|issue>" ;;
      eval)   echo "usage: bin/factory eval <grader> [--evals-dir D] [--graders-dir D] [--model M]" ;;
      run)    echo "usage: bin/factory run <issue|ticket-file>" ;;
      status) echo "usage: bin/factory status" ;;
      stop)   echo "usage: bin/factory stop <issue|ticket-stem>" ;;
      *)      echo "usage: bin/factory <lint|eval|run|status|stop>" ;;
    esac
  done >&2
  exit 2
}

CMD="${1:-}"
shift 2> /dev/null || true
# `FACTORY_SOURCED=1 . bin/factory` loads the functions for a test (bin/check's verdict gate) without
# running a subcommand. `return` works only in a sourced script; 2> /dev/null hides the error if the
# guard is ever hit while the file runs as a program.
[ "${FACTORY_SOURCED:-}" = 1 ] && return 0 2> /dev/null
case "$CMD" in
  lint) [ $# -eq 1 ] || usage lint
        lint "$1" ;;
  eval) [ $# -ge 1 ] || usage eval
        GRADER="$1"; shift
        while [ $# -gt 0 ]; do
          [ $# -ge 2 ] || usage eval
          case "$1" in
            --evals-dir)   EVALS_DIR="$2" ;;
            --graders-dir) GRADERS_DIR="$2" ;;
            --model)       EVAL_MODEL="$2" ;;
            *)             usage eval ;;
          esac
          shift 2
        done
        run_eval "$GRADER" ;;
  run)    [ $# -eq 1 ] || usage run
          cmd_run "$1" ;;
  status) [ $# -eq 0 ] || usage status
          cmd_status ;;
  stop)   [ $# -eq 1 ] || usage stop
          cmd_stop "$1" ;;
  *)      usage ;;
esac
