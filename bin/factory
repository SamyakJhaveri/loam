#!/usr/bin/env bash
# bin/factory - factory tooling. Subcommands: lint, eval.
#   bin/factory lint <file|issue>   statically checks a ticket body against docs/factory/CONTRACT.md.
#   bin/factory eval <grader>       replays the frozen evals/ cases through the production grader call.
# Lint never executes a check; it reads the body and shells out only to `bash -n` and `gh`.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# The ticket sections, in contract order. Six are required; Approach, Merge checklist,
# and Rows measured are optional.
CANON=("Goal and why" "Do not touch" "Out of scope" "Approach" "Done checks" \
       "Merge checklist" "Rows measured" "Worker" "Decisions")
REQUIRED=("Goal and why" "Do not touch" "Out of scope" "Done checks" "Worker" "Decisions")
CAPS=" MAX_ROUNDS ROUND_BUDGET_USD GRADER_BUDGET_USD TICKET_BUDGET_USD DAILY_BUDGET_USD \
MAX_HOURS MAX_TURNS CALL_TIMEOUT_SEC MAX_PARALLEL "

# `claude --output-format json` prints one object, or an array whose last result element is it.
RESULT_OBJ='if type == "array" then ((last(.[] | select(.type == "result")) // .[-1]) // {}) else . end'

SRC=""
BODY=""
ERRS=0

err() { echo "LINT $SRC: $*" >&2; ERRS=$((ERRS + 1)); }

# The body above the first section: title, Brief:/Part of, Blocked by:.
header() { awk '/^## /{exit} {print}' <<<"$BODY"; }

# The body of one section, without its heading.
section() { awk -v want="## $1" '$0 == want {inb=1; next} /^## /{inb=0} inb {print}' <<<"$BODY"; }

# The done-checks fenced block, without its fences.
dc_block() { awk '/^```done-checks$/{inb=1; next} /^```/{if (inb) exit} inb {print}' <<<"$BODY"; }

# Path-looking tokens in stdin: anything with a slash, backticks and sentence punctuation stripped.
# Tokens holding a glob or a shell expansion are not paths a ticket promises.
paths() {
  tr -s ' \t' '\n\n' | tr -d '`",' | sed 's/[.,;:)]*$//' \
    | grep -E '^[.A-Za-z0-9_][A-Za-z0-9_./-]*/[A-Za-z0-9_./-]*$' \
    | grep -vE '[*$?{}]' | sort -u
}

# The paths a ticket promises: backtick-wrapped tokens whose first segment is a tracked top-level entry.
promised_paths() {
  local tops
  # tops is space-joined: macOS awk rejects a newline inside a -v value.
  tops=$(git -C "$ROOT" ls-files | cut -d/ -f1 | sort -u | tr '\n' ' ')
  grep -o '`[^`]*`' | tr -d '`' | paths \
    | awk -v tops="$tops" 'BEGIN {n = split(tops, a, " "); for (i = 1; i <= n; i++) t[a[i]] = 1}
                           {s = $0; sub(/\/.*/, "", s); if (s in t) print}'
}

# ---- rules ----

check_sections() {
  local h j k prev=-1 r
  while IFS= read -r h; do
    j=-1
    for k in "${!CANON[@]}"; do [ "${CANON[$k]}" = "$h" ] && { j=$k; break; }; done
    if [ "$j" -lt 0 ]; then
      err "unknown section '## $h'"
    elif [ "$j" -le "$prev" ]; then
      err "section '## $h' is duplicated or out of contract order"
    else
      prev=$j
    fi
  done < <(grep '^## ' <<<"$BODY" | sed 's/^## //')
  for r in "${REQUIRED[@]}"; do
    grep -qxF "## $r" <<<"$BODY" || err "missing section '## $r'"
  done
}

check_header() {
  local head
  head=$(header)
  grep -qE '^(Brief:|Part of )' <<<"$head" || err "header has no 'Brief:' or 'Part of' line"
  grep -qE '^Blocked by:' <<<"$head" || err "header has no 'Blocked by:' line"
}

check_no_skip() {
  grep -qiE '(^|[^A-Za-z_-])skip(s|ped|ping)?([^A-Za-z_-]|$)' <<<"$BODY" && err "the body says 'skip'; a check leaves a ticket only through the abandon exit"
  return 0
}

check_block_syntax() {
  local n tmp
  n=$(grep -cxF '```done-checks' <<<"$BODY")
  if [ "$n" -ne 1 ]; then
    err "expected exactly one fenced done-checks block, found $n"
    return
  fi
  # bare mktemp ignores TMPDIR on macOS and fails inside the Claude Code sandbox
  tmp=$(mktemp "${TMPDIR:-/tmp}/factory-lint.XXXXXX")
  { cat "$ROOT/bin/factory.d/lib.sh"; echo; dc_block; } > "$tmp"
  bash -n "$tmp" || err "the done-checks block plus lib.sh does not pass bash -n"
  rm -f "$tmp"
}

# Every check line reports through pass NAME and fail NAME, and a line that leans on a test
# file or on pytest may only name test paths the ticket already fenced off under Do not touch.
check_check_lines() {
  local line owned c covered e
  owned=$(section "Do not touch" | paths)
  while IFS= read -r line; do
    line=${line#"${line%%[![:space:]]*}"}
    [ -n "$line" ] || continue
    case "$line" in \#*) continue ;; esac
    grep -qE '(^|[[:space:]])pass[[:space:]]' <<<"$line" \
      || err "check line does not report a pass: $line"
    grep -qE '(^|[[:space:]])fail[[:space:]]' <<<"$line" \
      || err "check line does not report a fail: $line"
    grep -qE '(^|[[:space:]])pytest|[^[:space:]]*test[^[:space:]]*\.py|[^[:space:]]*_test\.sh' <<<"$line" || continue
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      case "$c" in *test*) ;; *) continue ;; esac
      covered=0
      while IFS= read -r e; do
        [ -n "$e" ] || continue
        e=${e%/}
        [ "$c" = "$e" ] || [ "${c#"$e"/}" != "$c" ] && covered=1
      done <<<"$owned"
      [ "$covered" = 1 ] || err "self-graded oracle: the check names $c, which Do not touch does not fence off"
    done < <(printf '%s\n' "$line" | paths)
  done < <(dc_block | sed -e :a -e '/\\$/N; s/\\\n//; ta')
}

check_worker() {
  local w line name
  w=$(section Worker)
  grep -qE '^worker: (claude|codex)$' <<<"$w" || err "Worker has no 'worker: claude|codex' line"
  grep -qE '^codex-review: (yes|no)$' <<<"$w" || err "Worker has no 'codex-review: yes|no' line"
  grep -qE '^effort: (low|medium|high)$' <<<"$w" || err "Worker has no 'effort: low|medium|high' line"
  grep -qE '^goal: .*or stop after [0-9]+ turns$' <<<"$w" \
    || err "Worker has no 'goal:' line ending 'or stop after <N> turns'"
  while IFS= read -r line; do
    [ -n "${line//[[:space:]]/}" ] || continue
    case "$line" in worker:*|codex-review:*|effort:*|goal:*|skills:*) continue ;; esac
    name=${line%%=*}
    if [ "$name" = "$line" ] || [ "${CAPS/ $name /}" = "$CAPS" ]; then
      err "unrecognized Worker line: $line"
    fi
  done <<<"$w"
}

check_merge_checklist() {
  local n
  grep -qE '^Track: B([[:space:]]|$)' <<<"$(header)" || return 0
  n=$(section "Merge checklist" | grep -c '[^[:space:]]')
  [ "$n" -le 3 ] || err "a Track B ticket allows at most three merge-checklist lines, found $n"
}

# Every path the ticket names must already be in the tree, or be one the ticket says it creates.
check_paths() {
  local p created
  created=$(section "Do not touch" | grep -F 'Except:' | paths)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$ROOT/$p" ] && continue
    grep -qxF "$p" <<<"$created" && continue
    err "names $p, which is not in the tree and is not one the ticket creates"
  done < <( { { header | grep -E '^Where:'; } | paths; { section "Do not touch"; section Approach; } | promised_paths; } | sort -u)
}

# ---- eval ----
# Replays evals/<grader>/<case>/prompt.md through the grader call in docs/factory/LOOP.md and
# compares the verdict with expected.json. The rubric comes from the live grader file, so a
# grader prompt edit changes the result; that is the point (LOOP.md, Grader change protocol).

EVAL_MODEL=fable
EVALS_DIR=evals
GRADERS_DIR=""

# The installed plugin's agents dir ships lean-critic.md; judge.md and reviewer.md live with the
# lean-v3 loop until F1 moves them into the plugin. --graders-dir replaces the whole search.
grader_file() {
  local dirs=("$GRADERS_DIR") d f
  [ -n "$GRADERS_DIR" ] || dirs=("$HOME"/.claude/plugins/cache/*/sam-cc-setup/*/agents \
                                 "${LOAM_LOOPS_DIR:-$ROOT/../loam/.superpowers/lean-v3/loops}")
  for d in "${dirs[@]}"; do
    f="$d/$1.md"
    [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  echo "eval: found no $1.md in ${dirs[*]}" >&2
  return 1
}

# A plugin agent file opens with frontmatter and asks for prose; strip the one and ask for the JSON
# form, the same two edits the lean-v3 loop's run_lean makes. judge.md and reviewer.md need neither.
grader_rubric() {
  [ "$(head -n 1 "$1")" = "---" ] || { cat "$1"; return; }
  awk 'f; /^---$/ { c++; if (c == 2) f = 1 }' "$1"
  printf '\n## Output for this call\n\nRespond with exactly one JSON object and nothing else: no prose before or after, no code fences, no closing sentence; put anything you could not verify in the "unverified" array. Scope: the diff below and the worker-authored files. Severity as defined above.\n'
}

run_eval() {
  local grader="$1" budget="${EVAL_BUDGET_USD:-10}" gf rubric dir name out res exp got erows grows
  local spent=0 cases=0 mism=0 ok attempt
  gf=$(grader_file "$grader") || return 2
  [ -d "$EVALS_DIR/$grader" ] || { echo "eval: no cases under $EVALS_DIR/$grader" >&2; return 2; }
  rubric=$(mktemp "${TMPDIR:-/tmp}/factory-eval.XXXXXX")
  grader_rubric "$gf" > "$rubric"
  for dir in "$EVALS_DIR/$grader"/*/; do
    [ -f "$dir/prompt.md" ] && [ -f "$dir/expected.json" ] || continue
    if awk -v s="$spent" -v b="$budget" 'BEGIN {exit !(s >= b)}'; then
      echo "eval $grader: EVAL_BUDGET_USD $budget reached after \$$spent and $cases cases" >&2
      rm -f "$rubric"
      return 2
    fi
    name=$(basename "$dir")
    cases=$((cases + 1))
    # Two attempts, as the loop's grader call takes.
    for attempt in 1 2; do
      # Each call gets the remaining headroom, so EVAL_BUDGET_USD caps the sum over cases.
      out=$(cat "$rubric" "$dir/prompt.md" | claude -p --model "$EVAL_MODEL" --effort medium \
        --tools Read,Grep,Glob --no-session-persistence \
        --max-budget-usd "$(awk -v b="$budget" -v s="$spent" 'BEGIN {printf "%.4f", b - s}')" \
        --setting-sources user --output-format json 2>/dev/null)
      spent=$(awk -v a="$spent" -v b="$(jq -r "$RESULT_OBJ | .total_cost_usd // 0" <<<"$out" 2>/dev/null)" \
        'BEGIN {printf "%.4f", a + (b + 0)}')
      res=$(jq -r "$RESULT_OBJ | .result // \"\"" <<<"$out" 2>/dev/null)
      # Without --json-schema (F3) a reply sometimes wraps the object in code fences or
      # prose. The object runs from the first brace to the last, so cut to those.
      if ! jq -e .verdict <<<"$res" > /dev/null 2>&1 && [ "${res#*\{}" != "$res" ]; then
        res="{${res#*\{}"; res="${res%\}*}}"
      fi
      # A usage limit or an API error answers with is_error and no cost. That is the environment,
      # not a verdict: say so and stop, rather than reporting it as a grader disagreement.
      if [ "$(jq -r "$RESULT_OBJ | .is_error // false" <<<"$out" 2>/dev/null)" = true ]; then
        echo "eval $grader/$name: the call failed: $res" >&2
        rm -f "$rubric"
        return 2
      fi
      jq -e .verdict <<<"$res" > /dev/null 2>&1 && break
      echo "eval $grader/$name: attempt $attempt output not parseable" >&2
    done
    exp=$(jq -r .verdict "$dir/expected.json")
    got=$(jq -r '.verdict // "unparseable"' <<<"$res" 2>/dev/null) || got=unparseable
    [ -n "$got" ] || got=unparseable
    ok=1
    [ "$got" = "$exp" ] || ok=0
    # The failing-row set is compared only for a case that lists one.
    if [ "$ok" = 1 ] && jq -e 'has("failing_rows")' "$dir/expected.json" > /dev/null 2>&1; then
      erows=$(jq -r '.failing_rows | sort | join(",")' "$dir/expected.json")
      grows=$(jq -r '[(.rows // {}) | to_entries[] | select(.value != "pass") | .key] | sort | join(",")' <<<"$res" 2>/dev/null)
      [ "$grows" = "$erows" ] || { ok=0; got="$got rows=[$grows]"; exp="$exp rows=[$erows]"; }
    fi
    if [ "$ok" = 1 ]; then
      echo "eval $grader/$name: OK $got"
    else
      echo "eval $grader/$name: MISMATCH got '$got', expected '$exp'"
      mism=$((mism + 1))
    fi
  done
  rm -f "$rubric"
  echo "eval $grader: $cases cases, $mism mismatch, \$$spent"
  [ "$cases" -gt 0 ] || return 2
  [ "$mism" -eq 0 ]
}

lint() {
  SRC="$1"
  ERRS=0
  if [ -f "$SRC" ]; then
    BODY=$(cat "$SRC")
    # A file may open with the front matter publish.sh reads: title:, then optional
    # labels: and blocked_by:, then ---. The body is what follows the --- line.
    if head -n 1 "$SRC" | grep -q '^title: '; then
      if grep -qxF -- '---' "$SRC"; then
        BODY=$(sed '1,/^---$/d' "$SRC")
      else
        err "front matter has no --- line"
      fi
    else
      head -n 1 "$SRC" | grep -q '^# ' || err "first line is not a '# ' title"
    fi
  elif [[ "$SRC" =~ ^[0-9]+$ ]]; then
    BODY=$(gh issue view "$SRC" --json body -q .body) \
      || { echo "LINT $SRC: could not read the issue body with gh" >&2; return 1; }
  else
    echo "no such file: $SRC" >&2
    return 1
  fi

  check_sections
  check_header
  check_no_skip
  check_block_syntax
  check_check_lines
  check_worker
  check_merge_checklist
  # Fixture bodies are historical tickets that name paths later tickets removed.
  case "$SRC" in *bin/factory.d/fixtures/*) ;; *) check_paths ;; esac

  [ "$ERRS" -eq 0 ] || return 1
  echo "lint: OK $SRC"
}

usage() {
  echo "usage: bin/factory lint <file|issue>" >&2
  echo "       bin/factory eval <grader> [--evals-dir D] [--graders-dir D] [--model M]" >&2
  exit 2
}

CMD="${1:-}"
shift 2> /dev/null || true
case "$CMD" in
  lint) [ $# -eq 1 ] || usage
        lint "$1" ;;
  eval) [ $# -ge 1 ] || usage
        GRADER="$1"; shift
        while [ $# -gt 0 ]; do
          [ $# -ge 2 ] || usage
          case "$1" in
            --evals-dir)   EVALS_DIR="$2" ;;
            --graders-dir) GRADERS_DIR="$2" ;;
            --model)       EVAL_MODEL="$2" ;;
            *)             usage ;;
          esac
          shift 2
        done
        run_eval "$GRADER" ;;
  *)    usage ;;
esac
