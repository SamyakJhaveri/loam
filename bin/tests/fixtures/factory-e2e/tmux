#!/usr/bin/env python3
"""tmux for bin/tests/test_factory_e2e.py: `has-session -t NAME` and `new-session -d -s NAME [-e K=V]... CMD`.

A real tmux needs its server's AF_UNIX socket, which the worker's Bash sandbox refuses, so this one opens none.
new-session starts CMD with $SHELL or /bin/sh, detached in a session of its own with no terminal, in the environment
the server started with plus each -e, as a tmux server does: the server starts with the environment of the first
new-session, keeps it while any session lives, and exits with its last session, so the next new-session starts a new
one. A session lives while the process CMD started lives. State is under $E2E_STATE/tmux; each call appends its argv
to $E2E_STATE/tmux.log. A subcommand or flag this file does not know exits 2 and is appended to $E2E_STATE/unknown.log,
which the test reads.
"""

import json
import os
import subprocess
import sys

STATE = os.environ["E2E_STATE"]
DIR = os.path.join(STATE, "tmux")
SERVER_ENV = os.path.join(DIR, "server-env.json")


class Unknown(Exception):
    """A call this stand-in does not know."""


def append(name: str, record: dict) -> None:
    with open(os.path.join(STATE, name), "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")


def start_time(pid: int) -> str | None:
    """The process's start time in clock ticks (/proc/<pid>/stat field 22), or None when it is gone or a zombie."""
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8") as f:
            stat = f.read()
    except OSError:
        return None
    fields = stat[stat.rindex(")") + 2:].split()
    return None if fields[0] in ("Z", "X") else fields[19]


def alive(name: str) -> bool:
    try:
        with open(os.path.join(DIR, f"{name}.session.json"), encoding="utf-8") as f:
            rec = json.load(f)
    except (OSError, ValueError):
        return False
    return start_time(rec["pid"]) == rec["start"]


def any_alive() -> bool:
    return any(alive(f.removesuffix(".session.json")) for f in os.listdir(DIR) if f.endswith(".session.json"))


def has_session(args: list[str]) -> int:
    if len(args) != 2 or args[0] != "-t":
        raise Unknown(f"has-session {args}")
    if alive(args[1]):
        return 0
    print(f"can't find session: {args[1]}", file=sys.stderr)
    return 1


def new_session(args: list[str]) -> int:
    detached, name, extra, cmd = False, None, {}, []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-d":
            detached = True
        elif a in ("-s", "-e") and i + 1 < len(args):
            i += 1
            if a == "-s":
                name = args[i]
            else:
                k, eq, v = args[i].partition("=")
                if not eq:
                    raise Unknown(f"-e {args[i]}")
                extra[k] = v
        elif a.startswith("-"):
            raise Unknown(f"new-session flag {a}")
        else:
            cmd.append(a)
        i += 1
    if not detached or name is None or len(cmd) != 1:
        raise Unknown(f"new-session {args}: bin/factory starts one detached, named session running one shell command")
    if alive(name):
        print(f"duplicate session: {name}", file=sys.stderr)
        return 1
    if not any_alive():
        with open(SERVER_ENV, "w", encoding="utf-8") as f:
            json.dump(dict(os.environ), f)
    with open(SERVER_ENV, encoding="utf-8") as f:
        env = {**json.load(f), **extra}
    proc = subprocess.Popen([env.get("SHELL") or "/bin/sh", "-c", cmd[0]], env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    with open(os.path.join(DIR, f"{name}.session.json"), "w", encoding="utf-8") as f:
        json.dump({"pid": proc.pid, "start": start_time(proc.pid), "env": extra}, f)
    return 0


def main(argv: list[str]) -> int:
    append("tmux.log", {"argv": argv})
    os.makedirs(DIR, exist_ok=True)
    try:
        if argv[:1] == ["has-session"]:
            return has_session(argv[1:])
        if argv[:1] == ["new-session"]:
            return new_session(argv[1:])
        raise Unknown(f"subcommand {argv[:1]}")
    except Unknown as why:
        append("unknown.log", {"tool": "tmux", "argv": argv, "why": str(why)})
        print(f"tmux stand-in: unknown {why}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
